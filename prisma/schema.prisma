// The Growth Project — Prisma Schema
// PostgreSQL with Supabase Auth integration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL  → Supabase pgbouncer pooler (port 6543, ?pgbouncer=true)
  //                 Used by the runtime app for all query traffic.
  // DIRECT_URL    → Supabase direct connection (port 5432, no pgbouncer param)
  //                 Used only by `prisma migrate deploy` in the Fly release_command.
  //                 Migrations require a real Postgres session, not a pooled one.
  //                 Set this in Fly with:
  //                   fly secrets set DIRECT_URL="postgres://postgres.<ref>:<pw>@aws-0-us-west-1.pooler.supabase.com:5432/postgres"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Phase 1A platform pivot: add the `owner` tier above `coach` so the
// platform can be operated as Healthie-style OWNER -> COACH -> CLIENT
// without breaking existing rows. Existing rows stay valid (`coach`,
// `student`); the new `owner` value is opt-in and only set by the
// bootstrap-owners script or the OWNER promote endpoint.
enum Role {
  coach
  student
  owner
}

// Phase 1A: subscription state for a coach's $300/mo seat. Stored as
// strings on CoachProfile so the column reads naturally in raw SQL and
// admin tooling without a Prisma-only enum mapping.
enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  paused
}

enum Sex {
  male
  female
  prefer_not_to_say
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum GoalType {
  fat_loss
  muscle_gain
  maintenance
  performance
}

enum WorkoutExperience {
  beginner
  intermediate
  advanced
}

enum FoodCategory {
  generic
  packaged
  fast_food
  restaurant
  recipe_ingredient
}

// Canonical basis for the macro columns on FoodItem.
//   PER_100G    — calories/protein/carbs/fat are expressed per 100g of the food.
//                 This is the basis USDA FDC and OpenFoodFacts return; the
//                 backend stores them verbatim. Mobile multiplies by
//                 (grams_consumed / 100) at log time.
//   PER_SERVING — macros are expressed per one `serving_size_grams` unit.
//                 Reserved for legacy / hand-curated entries where per-100g
//                 data is unavailable. New rows default to PER_100G.
// See README "Food logger — canonical nutrient basis" for the contract.
enum NutrientBasis {
  PER_100G
  PER_SERVING
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum Intensity {
  light
  moderate
  hard
  max
}

enum MuscleGroup {
  chest
  back
  legs
  shoulders
  arms
  core
  cardio
  full_body
}

enum CheckInType {
  morning
  evening
}

// CoachPracticeType — Stage-3 cross-pillar federation gate.
//
// What kind of practice the coach runs across the TGP product family
// (Body / Wealth). The cross-pillar surface in `/api/coach/cross-pillar/*`
// is gated on `both`; coaches with `fitness_only` or `finance_only` see
// their existing single-product coach console unchanged. `null` on the
// User row means the coach has not yet selected — the cross-pillar
// surface returns `403 PRACTICE_NOT_SELECTED` and the mobile app routes
// them through the practice-selection flow.
enum CoachPracticeType {
  fitness_only
  finance_only
  both
}

// Hybrid pricing tier for coaches (§3 spec v1.0.0).
// 'enterprise' is reserved for future use — no logic enforces it today.
// The column exists so future enterprise features do not require a schema migration.
enum CoachTier {
  free
  pro
  enterprise
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                        String             @id @default(uuid())
  supabase_id               String             @unique
  email                     String             @unique
  name                      String
  phone                     String?
  role                      Role               @default(student)
  // coach_id now a proper self-relation FK instead of an orphan string column.
  // Preserves prior behavior — still nullable, still points at another User.id.
  coach_id                  String?
  coach                     User?              @relation("CoachToStudents", fields: [coach_id], references: [id])
  students                  User[]             @relation("CoachToStudents")
  // Stage-3 cross-pillar federation. Only meaningful when `role = coach`
  // or `owner`; ignored for students. Null = not yet selected.
  coach_practice_type       CoachPracticeType?
  created_at                DateTime           @default(now())
  archived_at               DateTime?
  // GDPR delete-account flow. Two-phase: deletion_scheduled_at marks the
  // grace-period start (account locked but recoverable); deleted_at marks
  // the irreversible PII scrub. Existing rows stay valid (both null).
  deletion_scheduled_at     DateTime?
  deleted_at                DateTime?
  // Phase 10 — explicit user/admin-initiated right-to-erasure flow.
  // deletion_token_hash/expires_at drive the confirmation link email;
  // deletion_requested_at/confirmed_at drive the state machine.
  // Columns added by migration 20260507100000_add_gdpr_deletion_flow.
  deletion_token_hash       String?
  deletion_token_expires_at DateTime?
  deletion_requested_at     DateTime?
  deletion_confirmed_at     DateTime?
  // Push notifications — Expo push token registered from the mobile app.
  // Null means the user has not granted permission or has signed out.
  expo_push_token           String?

  profile                  UserProfile?
  logged_entries           LoggedFoodEntry[]
  workouts                 WorkoutSession[]
  fasting_windows          FastingWindow[]
  weight_logs              WeightLog[]
  notification_prefs       NotificationPreferences?
  preferences              UserPreferences?
  habits                   Habit[]
  lesson_completions       LessonCompletion[]
  check_ins                CheckIn[]
  water_logs               WaterLog[]
  created_routines         WorkoutRoutine[]         @relation("RoutineCreator")
  coached_lessons          Lesson[]                 @relation("LessonCoach")
  invite_codes             InviteCode[]             @relation("CoachInviteCodes")
  coach_messages_as_coach  CoachMessage[]           @relation("CoachMessagesAsCoach")
  coach_messages_as_client CoachMessage[]           @relation("CoachMessagesAsClient")
  coach_messages_sent      CoachMessage[]           @relation("CoachMessagesSender")
  // Apple 1.2 — safety: reports filed by this user, blocks they have set,
  // and inbound blocks against them. The reviewer relation is owner-staff only.
  reports_filed            MessageReport[]          @relation("MessageReportReporter")
  reports_reviewed         MessageReport[]          @relation("MessageReportReviewer")
  blocks_set               UserBlock[]              @relation("UserBlockBlocker")
  blocks_received          UserBlock[]              @relation("UserBlockBlocked")
  coach_nudges_as_coach    CoachNudge[]             @relation("CoachNudgesAsCoach")
  coach_nudges_as_client   CoachNudge[]             @relation("CoachNudgesAsClient")
  meal_plans_as_coach      MealPlan[]               @relation("MealPlanCoach")
  meal_plans_as_client     MealPlan[]               @relation("MealPlanClient")
  community_wins           CommunityWin[]           @relation("CommunityWinAuthor")
  community_wins_as_coach  CommunityWin[]           @relation("CommunityWinCoach")
  guidelines_as_coach      CoachGuideline[]         @relation("CoachGuidelineCoach")
  guidelines_as_client     CoachGuideline[]         @relation("CoachGuidelineClient")
  created_recipes          Recipe[]                 @relation("RecipeCreator")
  saved_recipes            SavedRecipe[]
  list_items               ListItem[]
  // Phase 1A: 1:1 coach metadata. Only present for users with role=coach.
  // The relation stays optional so the existing student/owner rows do not
  // need a CoachProfile row (and the bootstrap script can backfill coaches
  // additively).
  coach_profile            CoachProfile?            @relation("CoachProfileUser")
  owners_created_profiles  CoachProfile[]           @relation("CoachProfileCreatedBy")

  // SaaS billing additions (1:1 with coach users; null for clients/owners).
  coach_subscription           CoachSubscription?
  invoices                     Invoice[]
  payment_failures             PaymentFailure[]
  // Phase 1 Connect — 1:1 Stripe Express account per coach. Null until the
  // coach kicks off Connect onboarding via POST /v1/connect/accounts/create.
  connect_account              ConnectAccount?
  // Phase 2-3 Connect — coach packages, client purchases, and saved
  // payment methods. A coach owns many CoachPackages (their offers);
  // a client owns many ClientPurchases (their bought packages) and at
  // most one ConnectCustomer mirror (Stripe Customer on the platform
  // account used to attach saved payment methods).
  coach_packages               CoachPackage[]       @relation("CoachPackageCoach")
  purchases_as_client          ClientPurchase[]     @relation("ClientPurchaseClient")
  purchases_as_coach           ClientPurchase[]     @relation("ClientPurchaseCoach")
  // B5 — Digital Contracts. A coach owns ContractTemplates and authors
  // (coach-side) envelopes; a client signs (client-side) envelopes. The
  // platform liability waiver layer is modeled via ContractTemplate.is_platform
  // (coach_id points at the seeded TGP system-coach user for those rows).
  contract_templates           ContractTemplate[]   @relation("ContractTemplateCoach")
  contract_envelopes_as_coach  ContractEnvelope[]   @relation("CoachEnvelopes")
  contract_envelopes_as_client ContractEnvelope[]   @relation("ClientEnvelopes")
  connect_customer             ConnectCustomer?
  // Phase 4-5 Connect — fee policy override, ledger payee back-refs,
  // outbound transfer destination, and payment reminder recipient.
  fee_policy                   FeePolicy?           @relation("FeePolicyCoach")
  split_entries_as_payee       SplitLedgerEntry[]   @relation("SplitLedgerPayee")
  transfers_as_destination     ConnectTransfer[]    @relation("ConnectTransferDestination")
  payment_reminders            PaymentReminder[]    @relation("PaymentReminderRecipient")
  // Phase 6 Connect — payout readiness snapshot per coach (cached
  // Stripe Connect balance + pending payout), refund + dispute back-refs.
  payout_snapshot              PayoutSnapshot?      @relation("PayoutSnapshotCoach")
  // Bank-Account Payouts v2 (spec §2.2-§2.3) — coach-linked payout methods
  // (Stripe Connect Custom bank accounts via Financial Connections) plus the
  // single nullable FK to the coach's default method. ALL nullable / optional
  // so the migration is additive and back-compatible: a coach with no
  // PayoutMethod row falls through to the existing Stripe Express flow
  // unchanged. Whatever Stripe Express account id / payout-schedule fields
  // exist today (ConnectAccount) stay exactly as they are — v1 introduces no
  // destructive schema change. The whole surface is gated behind
  // FEATURE_BANK_PAYOUTS_V2 (default OFF).
  payout_methods               PayoutMethod[]       @relation("CoachPayoutMethods")
  default_payout_method_id     String?
  default_payout_method        PayoutMethod?        @relation("UserDefaultPayoutMethod", fields: [default_payout_method_id], references: [id])
  drafts_as_coach              MessageDraft[]       @relation("MessageDraftCoach")
  drafts_as_client             MessageDraft[]       @relation("MessageDraftClient")
  // Phase 11 — Coach↔Client direct messaging. Sender/recipient are both Users
  // (coach or client); RLS enforces per-row access (see Message model).
  messages_sent                Message[]            @relation("MessageSender")
  messages_received            Message[]            @relation("MessageRecipient")
  activity_events_actor        ActivityEvent[]      @relation("ActivityEventActor")
  activity_events_coach        ActivityEvent[]      @relation("ActivityEventCoach")
  activity_events_client       ActivityEvent[]      @relation("ActivityEventClient")
  audit_logs_actor             AuditLog[]           @relation("AuditLogActor")
  audit_logs_target            AuditLog[]           @relation("AuditLogTarget")
  data_export_requests         DataExportRequest[]
  consents_as_client           ClientCoachConsent[] @relation("ConsentClient")
  consents_as_coach            ClientCoachConsent[] @relation("ConsentCoach")
  bloodwork_panels_as_client   BloodworkPanel[]     @relation("BloodworkPanelClient")
  bloodwork_panels_as_coach    BloodworkPanel[]     @relation("BloodworkPanelCoach")
  bloodwork_panels_reviewed    BloodworkPanel[]     @relation("BloodworkPanelReviewer")

  // Phase 1 PTM (Predictive Tracking Model). Append-only signal log,
  // outcome labels (taught by OWNERs/coaches), and append-only score
  // history. See `src/ptm/README.md` and `docs/ptm.md` for the doctrine.
  ptm_signals           ClientSignal[]
  ptm_outcomes_target   ClientOutcome[] @relation("PtmOutcomeTarget")
  ptm_outcomes_labelled ClientOutcome[] @relation("PtmOutcomeLabeller")
  ptm_predictions       PtmPrediction[]

  // Phase 6A/6B coach signals. Effectiveness scores (per coach, append-
  // only history) and red-flag alerts (per coach about a specific client).
  // Both relations stay optional — students/owners do not own rows here.
  coach_effectiveness_scores CoachEffectivenessScore[] @relation("CoachEffectivenessOwner")
  coach_alerts_as_coach      CoachAlert[]              @relation("CoachAlertCoach")
  coach_alerts_as_client     CoachAlert[]              @relation("CoachAlertClient")

  // Phase 6D — Coach Onboarding Wizard. 1:1 with users that have ever held
  // role='coach'. Auto-created by AdminService.promoteUser when a user is
  // promoted (gated by COACH_ONBOARDING_AUTO_START); subsequent promotes are
  // idempotent. Stays null for students/owners until/unless they're promoted.
  coach_onboarding_progress CoachOnboardingProgress? @relation("CoachOnboardingCoach")

  // Phase 7A — Day 1 Win Sequence. Set once on first win completion; never
  // cleared. Gates the Day1WinScreen in the mobile app: if non-null the screen
  // is permanently skipped on cold start. Null for all pre-existing users
  // (they skip the screen automatically because we treat null === not a new user
  // in the mobile gating logic by also checking created_at age).
  first_win_completed_at DateTime?

  // Phase 7C — Peer Leaderboard opt-in fields.
  // show_on_leaderboard defaults to false — explicit opt-in required.
  // leaderboard_display_name is nullable; if null, the service derives
  // "{firstName} {lastInitial}." from the single `name` field at read time.
  // NEVER surfaces raw weight, body-fat, or finance data on the leaderboard.
  show_on_leaderboard      Boolean @default(false)
  leaderboard_display_name String?

  // Phase 9 — Notification Center + Digest
  // notifications receives all inbox rows; digest_logs tracks sent digest windows.
  notifications              Notification[]
  digest_logs                NotificationDigestLog[]
  notification_delivery_logs NotificationDeliveryLog[]
  // NUDGE-V1 — behavioral nudge ledger (one row per decision: sent / suppressed / deferred).
  nudge_logs                 NudgeLog[]

  // Sprint B — Workout Builder relations.
  workout_plans_as_coach           WorkoutPlan[]                  @relation("CoachWorkoutPlans")
  workout_assignments_as_client    ClientWorkoutAssignment[]      @relation("ClientWorkoutAssignments")
  workout_assignments_as_coach     ClientWorkoutAssignment[]      @relation("CoachWorkoutAssignments")
  workout_builder_idempotency_keys WorkoutBuilderIdempotencyKey[] @relation("WorkoutBuilderIdempotencyUser")

  // Team Mode — head-coach <-> sub-coach assignments and audit events.
  // A coach may appear on either side (head coach in one team, sub-coach
  // in another). The capped many-to-many constraint (sub-coach assigned
  // under at most 2 head coaches) is enforced both by a service-layer
  // guard and a partial unique index added in the team-mode migration.
  sub_coach_assignments_as_head TeamSubCoachAssignment[] @relation("TeamSubCoachAssignmentHead")
  sub_coach_assignments_as_sub  TeamSubCoachAssignment[] @relation("TeamSubCoachAssignmentSub")
  team_audit_events_as_actor    TeamAuditEvent[]         @relation("TeamAuditEventActor")
  team_audit_events_as_target   TeamAuditEvent[]         @relation("TeamAuditEventTarget")
  invite_codes_invited_by       InviteCode[]             @relation("InviteCodeInvitedBy")

  // Phase 8 Connect — head-coach team profile (business name, public team
  // code, capacity mirror) and sub-coach invitations. One TeamProfile per
  // head coach. Sub-coach invites are 1:N from the issuing head coach.
  team_profile               TeamProfile?     @relation("TeamProfileHeadCoach")
  sub_coach_invites_issued   SubCoachInvite[] @relation("SubCoachInviteIssuer")
  sub_coach_invites_accepted SubCoachInvite[] @relation("SubCoachInviteAccepter")

  // Sprint B — Macro targets, real meal plans, holistic insights cache.
  macro_targets_as_client          MacroTarget[]             @relation("MacroTargetClient")
  macro_targets_as_coach           MacroTarget[]             @relation("MacroTargetCoach")
  meal_templates_as_coach          MealTemplate[]            @relation("MealTemplateCoach")
  daily_meal_plans_as_coach        DailyMealPlan[]           @relation("DailyMealPlanCoach")
  daily_meal_assignments_as_client DailyMealPlanAssignment[] @relation("DailyMealPlanAssignmentClient")
  daily_meal_assignments_as_coach  DailyMealPlanAssignment[] @relation("DailyMealPlanAssignmentCoach")
  holistic_insights_caches         HolisticInsightCache[]
  // AI gateway: requester / subject of an AI call, and approver / drafter of
  // a human-approval-gated AI action. All optional; rows are SetNull on
  // user delete so audit history survives PII scrub.
  ai_requests_as_requester         AiRequestAudit[]          @relation("AiRequestRequester")
  ai_requests_as_subject           AiRequestAudit[]          @relation("AiRequestSubject")
  ai_drafts_authored               AiActionDraft[]           @relation("AiDraftRequester")
  ai_drafts_decided                AiActionDraft[]           @relation("AiDraftDecidedBy")
  // Coach AI v1 — generation drafts (workout / meal plan / insight) and
  // per-call cost log. AIDraft uses onDelete: Cascade on both coachId and
  // clientId FKs (the cascade rarely fires in practice because the GDPR
  // scrubber soft-deletes User rows — see GdprScrubService.scrubOne which
  // issues an explicit deleteMany for AIDraft before tombstoning the User).
  // AICallLog uses onDelete: SetNull so cost history outlives a deleted
  // user account.
  coach_ai_drafts_as_coach         AIDraft[]                 @relation("AIDraftCoach")
  coach_ai_drafts_as_client        AIDraft[]                 @relation("AIDraftClient")
  ai_call_logs_as_coach            AICallLog[]               @relation("AICallLogCoach")
  ai_call_logs_as_client           AICallLog[]               @relation("AICallLogClient")

  // Concierge scheduling (PR #142). Back-relations only; FKs live on
  // the scheduling-side rows. Coach and client both read from User;
  // the relation name disambiguates.
  coach_session_types          SessionType[]               @relation("SessionTypeCoach")
  coach_availability           CoachAvailability[]         @relation("CoachAvailability")
  coach_availability_overrides CoachAvailabilityOverride[] @relation("CoachAvailabilityOverrideCoach")
  sessions_as_coach            CoachingSession[]           @relation("CoachingSessionCoach")
  sessions_as_client           CoachingSession[]           @relation("CoachingSessionClient")
  session_participations       SessionParticipant[]        @relation("SessionParticipantUser")
  calendar_connections         CalendarConnection[]        @relation("CalendarConnectionUser")

  // Phase 11 — Sub-coach overlay relations. Sub-coach assignments live in
  // SubCoachAssignment so User.coach_id stays pinned to the head coach.
  // Field names are prefixed `sub_coach_overlay_*` to avoid collision with
  // the Team Mode `sub_coach_assignments_as_*` fields above, which point at
  // the older TeamSubCoachAssignment model.
  sub_coach_overlay_as_head     SubCoachAssignment[]          @relation("SubCoachAssignmentHead")
  sub_coach_overlay_as_sub      SubCoachAssignment[]          @relation("SubCoachAssignmentSub")
  sub_coach_overlay_as_client   SubCoachAssignment[]          @relation("SubCoachAssignmentClient")
  sub_coach_overlay_as_actor    SubCoachAssignment[]          @relation("SubCoachAssignmentActor")
  sub_coach_idempotency_records SubCoachMutationIdempotency[] @relation("SubCoachIdempotencyActor")

  // Coach Command Center — churn intervention drafts the coach has
  // generated for at-risk clients, and the inverse for clients who have
  // received them. Both relations are optional; only coaches author
  // ChurnIntervention rows and only students receive them.
  churn_interventions_as_coach  ChurnIntervention[] @relation("ChurnInterventionCoach")
  churn_interventions_as_client ChurnIntervention[] @relation("ChurnInterventionClient")

  // R43 Storefront Phase 1 — User rows minted from a guest checkout point
  // back at the originating GuestCheckout row. SetNull on GuestCheckout
  // when this User is hard-deleted so audit history survives PII scrub.
  guest_checkouts_created GuestCheckout[] @relation("GuestCheckoutUser")

  // R43 — Coach Brief. One brief row per (coach, brief_date); one log row
  // per (coach, log_date); at most one preferences row per coach.
  coach_briefs            CoachBrief[]           @relation("CoachBriefCoach")
  coach_daily_logs        CoachDailyLog[]        @relation("CoachDailyLogCoach")
  coach_brief_preferences CoachBriefPreferences? @relation("CoachBriefPrefsCoach")
  coach_brief_push_ledger CoachBriefPushLedger?  @relation("CoachBriefPushLedgerCoach")

  // R46 — Coach Landing Page Builder. A coach owns many landing pages and
  // many CRM integrations. Both relations are optional; only users with
  // role='coach' will have rows here. onDelete Cascade is set on the
  // FK side so all a coach's pages + integrations vanish on account hard-delete.
  landing_pages    CoachLandingPage[]    @relation("CoachLandingPagesCoach")
  crm_integrations CoachCrmIntegration[] @relation("CoachCrmCoach")

  // Stream 1 — AI credits. Combined coach+client per-period AI budget +
  // Stripe-backed pack purchases. 1:1 on head coaches; sub-coaches share
  // the head coach's row via CoachAIBudget.coach_user_id.
  coach_ai_budget    CoachAIBudget?            @relation("CoachAIBudgetUser")
  coach_credit_packs CoachCreditPackPurchase[] @relation("CoachCreditPackUser")

  // PR-3 Packages & Drip-Feed foundation. Coach-uploaded media library
  // (PDFs, videos) that gets attached to sellable packages via
  // CoachPackageContent. Only meaningful for users with role='coach'.
  media_assets CoachMediaAsset[] @relation("CoachMediaAssetCoach")

  // Wave-0 (A1) — per-user DAILY AI token quota rows. One row per
  // (user, quota_date). Optional back-ref; rows cascade on user hard-delete.
  ai_quotas UserAIQuota[] @relation("UserAIQuotaUser")

  // Wave-0 (LTV-3) — 1:1 persisted LTV peak (zero-churn streak + all-time
  // peak RPCM) for coaches. Null for students/owners until first computed.
  ltv_peak CoachLtvPeak? @relation("CoachLtvPeakCoach")

  // PR-HK-0 — Wearables / HealthKit foundation. Back-relations ONLY (no
  // column changes to User). All wearable rows belong to a client (the
  // subject user) and cascade on user hard-delete. Coaches read a client's
  // rows via RLS (`app.is_current_coach_of`), not via a relation field.
  wearable_connections        WearableConnection[]           @relation("WearableConnectionUser")
  wearable_samples            WearableSample[]               @relation("WearableSampleUser")
  wearable_insights           WearableInsightCache[]         @relation("WearableInsightUser")
  wearable_metric_preferences WearableUserMetricPreference[] @relation("WearablePrefUser")

  // Community Expansion v1-1 — back-relations only (FKs live on the
  // community-side rows). A coach owns workspaces; any user authors
  // messages/posts/events/challenges and holds memberships, RSVPs, and
  // challenge participations. Author/sender relations are RESTRICT on the
  // FK side so content history is never silently orphaned; membership and
  // participation rows cascade on user hard-delete; moderation reporter/
  // actor relations are SetNull so audit rows survive a PII scrub.
  community_workspaces_as_coach      CommunityWorkspace[]              @relation("CommunityWorkspaceCoach")
  community_memberships              CommunityMembership[]             @relation("CommunityMembershipUser")
  community_messages_sent            CommunityMessage[]                @relation("community_message_sender")
  community_messages_received        CommunityMessage[]                @relation("community_message_recipient")
  community_posts_authored           CommunityPost[]                   @relation("CommunityPostAuthor")
  community_responses                CommunityResponse[]               @relation("CommunityResponseUser")
  community_events_created           CommunityEvent[]                  @relation("CommunityEventCreatedBy")
  community_event_rsvps              CommunityEventRsvp[]              @relation("CommunityEventRsvpUser")
  community_challenges_created       CommunityChallenge[]              @relation("CommunityChallengeCreatedBy")
  community_challenge_participations CommunityChallengeParticipation[] @relation("CommunityChallengeParticipationUser")
  community_reports_filed            CommunityModerationAction[]       @relation("community_reporter")
  community_moderation_actions       CommunityModerationAction[]       @relation("community_moderator")

  // Roman Phase 1 — Chat MVP. A user owns Roman chat sessions (one active
  // session per (userId, surface) day-key). Each session holds an ordered
  // message log. Both relations are optional and additive: pre-existing rows
  // own zero Roman sessions and behave exactly as before. The whole surface
  // is gated behind FEATURE_ROMAN_CHAT_ENABLED (default OFF) — see
  // src/roman/roman.feature.ts. RLS scopes every row to userId at the DB
  // layer (migration 20261216000000_add_roman_chat).
  roman_sessions RomanSession[] @relation("RomanSessionUser")
  roman_messages RomanMessage[] @relation("RomanMessageUser")

  @@index([coach_id])
  @@index([deletion_scheduled_at])
}

// Phase 1A: per-coach business + billing + branding metadata. The User
// table still holds `role` and the coach->client linkage; this table holds
// everything Healthie-style that does not belong on every user row.
//
// `invite_code` is the coach's shareable, URL-safe code (e.g. GP-A1B2C3).
// It mirrors InviteCode rows (which can have many per coach with
// expirations and per-code limits); CoachProfile.invite_code is the one
// "default" link a coach can hand out without bookkeeping. Backfill
// generates a unique value per coach.
//
// stripe_* and subscription_status are wired into Phase 2A; they are
// nullable here so this migration can ship before Stripe is provisioned.
model CoachProfile {
  id                         String              @id @default(uuid())
  user_id                    String              @unique
  user                       User                @relation("CoachProfileUser", fields: [user_id], references: [id])
  business_name              String?
  bio                        String?
  timezone                   String?
  branding_accent_color      String?
  branding_logo_url          String?
  invite_code                String              @unique
  stripe_customer_id         String?
  stripe_subscription_id     String?
  subscription_status        SubscriptionStatus?
  plan_tier                  String              @default("flat_300")
  current_period_end         DateTime?
  trial_end                  DateTime?
  ai_monthly_spend_cap_cents Int                 @default(5000)
  created_by_owner_id        String?
  created_by_owner           User?               @relation("CoachProfileCreatedBy", fields: [created_by_owner_id], references: [id])
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @updatedAt

  @@index([invite_code])
  @@index([subscription_status])
  @@index([created_by_owner_id])
}

// Coach SaaS subscription mirror. Stripe is source of truth; this is a
// denormalized projection so the coach console reads subscription state
// without touching Stripe directly. Complements CoachProfile.stripe_* fields
// with the longer-form mirror used by the v1 coach-console BFF.
model CoachSubscription {
