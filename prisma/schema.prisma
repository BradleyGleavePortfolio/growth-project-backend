// ============================================================
// COMPLIANCE / AUDIT
// ============================================================

// Append-only audit log for sensitive actions: role changes, account
// deletions, data exports, ownership transfers, coach impersonation, etc.
// Distinct from ActivityEvent (which feeds the coach-console activity
// feed and is mutable in spirit) — AuditLog is the immutable record used
// for compliance, incident review, and tenant-isolation audits. Rows are
// never updated or deleted; PII scrub on user delete sets actor/target
// FKs to NULL but preserves the row + actor_email_snapshot.
//
// `tenant_coach_id` is the coach whose tenant the action affected, so
// queries can scope the audit log to a single coach's roster without a
// join (e.g. owner reviews "all sensitive actions inside coach X's
// tenant"). Nullable for platform-level events that have no tenant
// (owner login, system jobs).
model AuditLog {
  id                   String   @id @default(uuid())
  action               String // e.g. "user.role_changed", "user.account_deletion_scheduled"
  actor_id             String?
  actor                User?    @relation("AuditLogActor", fields: [actor_id], references: [id], onDelete: SetNull)
  actor_role           String?
  actor_email_snapshot String? // preserved post-PII-scrub for forensic review
  target_user_id       String?
  target_user          User?    @relation("AuditLogTarget", fields: [target_user_id], references: [id], onDelete: SetNull)
  target_type          String? // "user" | "coach_profile" | "subscription" | …
  target_id            String? // free-form id of the target resource
  tenant_coach_id      String? // coach whose tenant the action touched, if any
  ip                   String?
  user_agent           String?
  metadata             Json?
  created_at           DateTime @default(now())

  @@index([action, created_at])
  @@index([actor_id, created_at])
  @@index([target_user_id, created_at])
  @@index([tenant_coach_id, created_at])
}

// GDPR / CCPA personal data export requests. A request is created when a
// user calls POST /users/me/data-export. Status starts at `pending`;
// when the request is fulfilled the row is updated with the rendered
// Phase 10 — GDPR data portability. Status lifecycle for DataExportRequest.
enum DataExportStatus {
  PENDING // Request received; export not yet started.
  RUNNING // Export is being assembled.
  READY // File uploaded to storage; signed URL available for 7 days.
  EXPIRED // 7-day window has passed; file deleted from storage.
  FAILED // Export failed; user can request again.
}

// Phase 10 — GDPR Article 20 right to data portability. One row per export
// request. The file lives in S3-compatible storage; this table tracks
// its lifecycle. Only the requesting user can download via a signed URL
// that expires after 7 days. The nightly cleanup cron marks READY rows
// EXPIRED and deletes the file from storage when expires_at passes.
//
// Rate limit: one PENDING or READY request per user per 24 h is enforced
// in DataExportService.requestExport — the controller returns 409 when
// the guard fires.
//
// GDPR dependency: this module is a hard dependency for the GDPR delete
// flow. Users should download their data BEFORE requesting account
// deletion. The delete-account module (src/gdpr/) checks for a READY
// export and surfaces a warning if none exists in the last 7 days.
model DataExportRequest {
  id              String           @id @default(uuid())
  user_id         String
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status          DataExportStatus @default(PENDING)
  // Signed S3 URL stored for status polling. Never served through the API
  // process — clients are redirected to this URL directly. Null until READY.
  file_url        String?
  created_at      DateTime         @default(now())
  completed_at    DateTime?
  // 7 days after completed_at. Nightly cron expires rows past this point.
  expires_at      DateTime?
  file_size_bytes Int?
  // SHA-256 hex digest of the JSON file for integrity verification.
  sha256          String?

  @@index([user_id, created_at])
  @@index([status, expires_at])
  @@map("data_export_request")
}

// Consent layer v1: per-(client, coach, scope) record of whether the
// client has granted the coach access to a given slice of their data.
//
// Effective state is derived: granted iff `revoked_at IS NULL OR
// revoked_at < granted_at`. Both timestamps are kept (not a single
// boolean) so the row itself preserves the most recent transition; the
// canonical history is in AuditLog under consent.granted / consent.revoked.
//
// Scope strings live in the service layer (ConsentScope) and are not an
// enum at the SQL level — adding a new scope should not require a
// migration. Today's scopes:
//   fitness.profile, fitness.body_metrics, fitness.workouts,
//   fitness.food_macros, fitness.habits_progress,
//   finance.summary, finance.balances, finance.transaction_categories,
//   finance.transaction_line_items, finance.reports
model ClientCoachConsent {
  id         String    @id @default(uuid())
  client_id  String
  client     User      @relation("ConsentClient", fields: [client_id], references: [id], onDelete: Cascade)
  coach_id   String
  coach      User      @relation("ConsentCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  scope      String
  granted_at DateTime?
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt

  @@unique([client_id, coach_id, scope], name: "ClientCoachConsent_client_coach_scope_key")
  @@index([client_id])
  @@index([coach_id])
}

// ============================================================
// PTM — Predictive Tracking Model (Phase 1)
// ============================================================
//
// Doctrine (see src/ptm/README.md and docs/ptm.md):
//   * ClientSignal is APPEND-ONLY. Every behavioral signal (check-in
//     submitted, check-in missed, weight logged, message sent, workout
//     logged, meal logged, finance EOD, app open, coach note received,
//     etc.) is recorded with its raw value + metadata. We never UPDATE
//     a signal in place; corrections are written as a new row.
//   * ClientOutcome is the teaching set — the labels OWNERs and coaches
//     attach to a client's eventual journey (churned, completed_90day,
//     upgraded, referred, milestone_hit, dropped_off, renewed). Exactly
//     one row per (user_id) — re-labelling overwrites the prior row,
//     and AuditLog (`ptm.outcome_labelled`) keeps the canonical history.
//   * PtmPrediction is APPEND-ONLY. Every score recompute writes a new
//     row so the operator can see how a client's risk drifted over
//     time. `prediction_basis` distinguishes heuristic_v1 (Phase 1B)
//     from weighted_v2 (Phase 1D, activates at >= 20 outcomes) and
//     reserves model_v3 for a future ML pass.
//
// PTM scores are advisory-only. The mobile client never sees raw
// risk_score or factors — those are OWNER/COACH surfaces only.

// Enumerated signal types. Strings are kept Prisma-side as a Postgres
// enum so a typo at the call site fails at the DB boundary, not at
// dashboard read time. New signal types require a Prisma migration —
// that is by design: the heuristic and weighted services key off this
// enum and a silent typo would skew scores.
enum PtmSignalType {
  checkin_streak // a check-in was submitted; value = streak length on submit
  checkin_miss // a missed-check-in window crossed (3+ days, etc.); value = missed days
  weight_logged // weight log; value = delta vs prior log (kg) or 0 on first log
  weight_skipped // a 14-day no-log threshold crossed; value = days since last log
  message_sent // client → coach message; value = chars
  message_received // coach → client message; value = chars
  coach_note_received // coach guideline / nudge / draft delivered; value = 1
  workout_logged // workout session completed; value = total volume kg
  workout_skipped // 10-day no-workout threshold crossed; value = days since last
  meal_logged // logged food entry; value = calories
  meal_skipped // 7-day no-meal-log threshold crossed; value = days since last
  finance_eod // finance app end-of-day check-in; value = 1
  finance_milestone // finance milestone hit; value = 1
  app_open // first app-open of the day; value = seconds since last open
  consistency_low // 30-day consistency score dropped below 60%; value = consistency_pct
  streak_dropped // active streak dropped 50%+ from prior week; value = drop_pct
}

// Enumerated outcome labels. The teaching set is intentionally small;
// new outcomes require a migration so the weighted service does not
// silently see an unweighted label.
enum PtmOutcomeType {
  churned // client cancelled / disengaged before goal
  completed_90day // client completed the 90-day program
  upgraded // client upgraded plan / extended commitment
  referred // client referred a new client (a measurable success)
  milestone_hit // client hit a major personal milestone (goal weight, etc.)
  dropped_off // client did not formally cancel but stopped engaging
  renewed // client renewed for another cycle
}

// Enumerated prediction basis tags. Drives the version selector in the
// admin dashboard and lets the recompute job log which engine produced
// a row without parsing the factors blob.
enum PtmPredictionBasis {
  heuristic_v1 // Phase 1B: hand-tuned weights + protective factors
  weighted_v2 // Phase 1D: frequency-analysis weights, activates at >= 20 outcomes
  model_v3 // Reserved for a future ML pass; not used in Phase 1
}

// Append-only behavioral signal. One row per discrete event we observed.
// `metadata` is JSON for engine-specific context (delta direction, source
// module, etc.) — keep it small and never put PII there.
//
// All signal writes are fire-and-forget at the call site (see
// PtmService.recordSignal): a failure to insert MUST NOT bubble back
// into the user-facing request. The service catches and logs.
//
// Index on (user_id, signal_type, recorded_at) supports the heuristic
// service's bounded windows (last 7 / 14 / 30 days, by signal type).
model ClientSignal {
  id          String        @id @default(uuid())
  user_id     String
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  signal_type PtmSignalType
  value       Float         @default(0)
  metadata    Json?
  recorded_at DateTime      @default(now())

  @@index([user_id, signal_type, recorded_at])
  @@index([signal_type, recorded_at])
}

// One outcome label per client. `labelled_by_id` is the OWNER or COACH
// who taught the model what happened. `signal_snapshot` captures the
// last-30-days signal counts at label time so the weighted service
// (1D) can train against a frozen window even if older signals are
// later GDPR-scrubbed.
//
// Re-labelling: upsert by user_id, then write a fresh AuditLog row
// (`ptm.outcome_labelled`) carrying both old and new outcomes in
// `metadata`. Treat AuditLog as the canonical history.
model ClientOutcome {
  id              String         @id @default(uuid())
  user_id         String         @unique
  user            User           @relation("PtmOutcomeTarget", fields: [user_id], references: [id], onDelete: Cascade)
  outcome_type    PtmOutcomeType
  labelled_by_id  String?
  labelled_by     User?          @relation("PtmOutcomeLabeller", fields: [labelled_by_id], references: [id], onDelete: SetNull)
  labelled_at     DateTime       @default(now())
  notes           String?
  signal_snapshot Json?

  @@index([outcome_type, labelled_at])
  @@index([labelled_by_id, labelled_at])
}

// Append-only prediction history. `factors` is a JSON blob the heuristic
// (or weighted) service writes so the admin "why is this client red?"
// drawer can show the contributing signals. Mobile clients NEVER see
// this row — it is OWNER/COACH-only by guard.
//
// risk_score and success_score are independent dimensions in [0.0, 1.0].
// They are NOT 1 - x of each other; a high-engagement, high-risk-of-
// burnout client can carry high success and high risk simultaneously.
//
// Index on (user_id, computed_at desc) supports "latest score per user"
// without a window function: ORDER BY computed_at DESC LIMIT 1 with
// composite index hits the single-page seek path.
model PtmPrediction {
  id               String             @id @default(uuid())
  user_id          String
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  risk_score       Float
  success_score    Float
  prediction_basis PtmPredictionBasis
  factors          Json?
  computed_at      DateTime           @default(now())

  @@index([user_id, computed_at])
  @@index([prediction_basis, computed_at])
}

// Phase 6A — Coach Effectiveness Score. Computed nightly by the
// CoachEffectivenessScheduler (default 05:00 UTC, one hour after the
// PTM recompute). APPEND-ONLY: every run inserts a fresh row so the
// admin console can chart drift over time. The latest row is read by
// ORDER BY computed_at DESC LIMIT 1; the composite index supports it.
//
// `factors` is a JSON blob containing each component's contribution
// (completion, risk_delta, retention, engagement) with both the raw
// observed value and the weighted contribution. The admin "why" drawer
// renders straight from this blob.
//
// Visible to OWNER only — coaches do not see their own score (avoids
// gaming). The /admin/coach-effectiveness endpoints are RolesGuard'd.
model CoachEffectivenessScore {
  id          String   @id @default(uuid())
  coach_id    String
  coach       User     @relation("CoachEffectivenessOwner", fields: [coach_id], references: [id], onDelete: Cascade)
  score       Float
  bucket      String // 'developing' | 'consistent' | 'high-performer'
  factors     Json?
  basis       String   @default("v1")
  computed_at DateTime @default(now())

  @@index([coach_id, computed_at])
  @@index([computed_at])
}

// Phase 6B — Proactive Red Flag Alert. Created by the PTM recompute
// hook when a client transitions green/amber → red, by the consecutive-
// miss detector, or by future signal observers. Coaches read their own
// alerts; OWNER sees aggregated.
//
// Dedup window: CoachAlertsService.createAlert short-circuits when an
// unacknowledged alert with the same (coach_id, client_id, alert_type)
// exists within the last 24h, so a flapping signal does not produce a
// notification storm.
//
// Index on (coach_id, created_at desc) supports the coach inbox view;
// (coach_id, acknowledged_at) supports the "unread only" filter.
model CoachAlert {
  id              String    @id @default(uuid())
  coach_id        String
  coach           User      @relation("CoachAlertCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  client_id       String
  client          User      @relation("CoachAlertClient", fields: [client_id], references: [id], onDelete: Cascade)
  alert_type      String // 'risk_red_transition' | 'consecutive_misses' | 'streak_dropped' | 'finance_eod_gap'
  severity        String    @default("warning") // 'info' | 'warning' | 'critical'
  message         String
  payload         Json?
  created_at      DateTime  @default(now())
  acknowledged_at DateTime?

  @@index([coach_id, created_at])
  @@index([coach_id, acknowledged_at])
  @@index([client_id, alert_type, created_at])
}

// Phase 6D — Coach Onboarding Wizard. Tracks where a newly promoted coach
// is in the 6-step setup flow:
//   1. Profile basics (business_name, bio, timezone)
//   2. Default invite code shown + copy reminder
//   3. Send first invite (action logged here; the actual invite send is a
//      separate API)
//   4. Create first message draft template
//   5. Set coach guideline preferences
//   6. Confirm completion
//
// Doctrine:
//   * 1:1 with the coach User row (`coach_id @unique`). Re-promoting the same
//     user is idempotent — the existing row is reused.
//   * `current_step` is enforced server-side: advanceStep(n) requires
//     n === current_step + 1 (or === current_step for resume on the same
//     step). Out-of-order writes return 400.
//   * `step_data` is a per-step JSON map keyed by step number. We never UPDATE
//     a key in place at completion; we keep the most recent value the coach
//     submitted for that step so the wizard can be resumed mid-flow.
//   * `completed_at` is set once and the row freezes — POST /steps/:n returns
//     409 after that.
model CoachOnboardingProgress {
  id           String    @id @default(uuid())
  coach_id     String    @unique
  coach        User      @relation("CoachOnboardingCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  started_at   DateTime  @default(now())
  completed_at DateTime?
  current_step Int       @default(1)
  step_data    Json?

  @@index([completed_at])
}

// =============================================================================
// Phase 3 — 40-point Diagnostic + AI roadmap
// =============================================================================
//
// Public lead-capture funnel: an anonymous visitor answers 40 Likert-scale
// questions (Income / Body / Lifestyle), the service computes per-section
// scores + an overall bucket, and an async AI call generates a personalized
// roadmap that lands on the same submission row.
//
// Design notes:
//   * `email` is captured for ALL submissions, including signed-up users — it
//     is the join key for "claim this lead later" and for the GDPR scrub. It
//     is NEVER returned by GET /diagnostic/questions and never echoed back in
//     /diagnostic/:id/result without authentication of the submitter.
//   * `user_id` is null until the lead signs up; on signup the existing
//     onboarding flow upserts by email and back-fills the column. No FK
//     cascade — if a user is deleted we keep the lead row so churn analytics
//     can still attribute it to a coach.
//   * `answers` and `scores` are JSON blobs. The shape is owned by the
//     diagnostic service; consumers must read through the typed DTOs in
//     src/diagnostic/diagnostic.dto.ts rather than touching `Json` directly.
//   * AiRoadmap is a separate row (1:1 with submission, but optional) so
//     a failed AI generation can leave the submission valid and the user
//     can hit a "retry" button without we re-write the scores.
//   * Append-only by convention. Re-submitting writes a fresh
//     DiagnosticSubmission (and a fresh AiRoadmap when the retry succeeds);
//     we never UPDATE in place. This keeps the lead history honest.
model DiagnosticSubmission {
  id           String   @id @default(uuid())
  email        String
  name         String?
  age          Int?
  // Free-form source tag. Examples: 'web', 'mobile_signup', 'invite_link',
  // 'lead_magnet'. Do not over-validate — operators add new sources via
  // marketing UTM links, and we do not want to ship a migration for each.
  source       String?
  // Full {question_id, answer} array, validated upstream against the seed
  // catalog. Stored verbatim so we can re-score historical submissions if
  // the bucket boundaries ever move.
  answers      Json
  // { income: 0-100, body: 0-100, lifestyle: 0-100, overall: 0-200 }
  scores       Json
  // { income: 'stuck'|'moving'|'compounding', body: ..., lifestyle: ..., overall: 'stuck'|'moving'|'compounding' }
  bucket       Json
  submitted_at DateTime @default(now())
  // Nullable FK to User. Anonymous lead → null. Signed-up lead → the user
  // we upserted by email. NO cascade so deleting a user does not delete
  // historical leads (we want the funnel attribution to survive).
  user_id      String?
  ip           String?
  user_agent   String?

  roadmap AiRoadmap?

  @@index([email, submitted_at])
  @@index([user_id])
  @@index([submitted_at])
}

// One AI roadmap per submission. Generation is async and fire-and-forget:
// the controller returns the submission_id immediately, the service kicks
// off the AI call in the background, and the row is upserted on completion.
// On failure the row is still written with payload=null and status='failed'
// so the GET endpoint can serve a deterministic "retry" state.
//
// `prompt_version` lets us A/B prompts without ambiguity in audit. Increment
// when the prompt template changes; the doctrine spec pins the canonical
// opening line so a silent edit fails CI.
model AiRoadmap {
  id             String               @id @default(uuid())
  submission_id  String               @unique
  submission     DiagnosticSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  generated_at   DateTime             @default(now())
  prompt_version String               @default("v1")
  status         String               @default("ready")
  // The structured AI response. Shape: { summary, top_strength,
  // biggest_gap, ninety_day_focus, raw_text }. Null when status='failed'.
  payload        Json?
  tokens_used    Int?
  model          String               @default("sonar-pro")
  error_message  String?

  @@index([submission_id])
}

// ─── Phase 4: Build Week (7-day guided coaching arc) ───────────────────────
//
// Three tables:
//   1. BuildWeekDay            — global day catalog (rows 1..7), seeded from
//                                prisma/seed-build-week.json by the migration.
//                                Read-only at runtime; new copy = new
//                                migration.
//   2. BuildWeekEnrollment     — one row per user. `current_day` advances as
//                                the user completes each day. Re-enrolling
//                                resets the same row in place (the unique
//                                constraint on user_id keeps history
//                                collapsed; the AuditLog is the durable
//                                history of state transitions).
//   3. BuildWeekDayCompletion  — one row per (enrollment, day_number). Holds
//                                the user's responses to the day's
//                                prompt_questions and their
//                                expected_artifact text.
//
// Tenancy:
//   * Catalog rows are global — no tenant scoping.
//   * Enrollment + completion rows belong to the user (FK to User.id).
//   * Coach reads go through the coach-build-week controller, which asserts
//     the target client belongs to the requesting coach (CoachGuard +
//     coach_id check). Owners bypass tenancy via the OWNER bypass on
//     CoachGuard — see src/auth/coach.guard.ts.
//
// PTM hook:
//   * Day 7 completion fires a `finance_milestone` PTM signal with
//     metadata { source: 'build_week', day_number: 7, total_days: 7 }.
//   * Days 1–6 do NOT emit PTM signals — the catalogue tracks itself; we
//     only emit when meaning matches a doctrine signal type.
model BuildWeekDay {
  id                String @id @default(uuid())
  day_number        Int    @unique
  title             String
  focus_area        String
  narrative         String
  prompt_questions  Json
  action_items      Json
  expected_artifact String

  @@index([day_number])
}

model BuildWeekEnrollment {
  id           String    @id @default(uuid())
  user_id      String    @unique
  started_at   DateTime  @default(now())
  current_day  Int       @default(1)
  status       String    @default("active")
  completed_at DateTime?

  completions BuildWeekDayCompletion[]

  @@index([status])
}

model BuildWeekDayCompletion {
  id            String              @id @default(uuid())
  enrollment_id String
  enrollment    BuildWeekEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  day_number    Int
  completed_at  DateTime            @default(now())
  responses     Json
  artifact_text String?

  @@unique([enrollment_id, day_number], name: "BuildWeekDayCompletion_enrollment_day_key")
  @@index([day_number])
}

// ──────────────────────────────────────────────────────────────────────────
// Phase 9 — Notification Center + Digest Idempotency
// ──────────────────────────────────────────────────────────────────────────
//
// Notification — per-user in-app inbox row. One row per discrete event.
// Emitters write here; the controller serves GET /notifications + mark-read.
//
// NotificationDigestLog — idempotency guard for digest email sends.
// One row per (user, kind, window_date). Unique constraint prevents duplicate
// emails when the cron fires more than once for the same day.

model Notification {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // kind: milestone_reached | message_received | missed_checkin |
  //   weight_trend_alert | checkin_submitted | build_week_day_unlocked |
  //   coach_alert | client_digest | coach_digest
  kind       String
  // Structured deep-link context. Never contains another user's PII.
  payload    Json?
  // Plain-text body, max 160 chars enforced by NotificationsService.createNotification.
  body       String
  // tgp:// deep-link, e.g. tgp://checkin/today
  deep_link  String?
  // Delivery channel: 'push' | 'email' | 'inapp'
  channel    String    @default("inapp")
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@index([kind, created_at])
}

model NotificationDigestLog {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // digest_kind: client_daily | coach_daily | weekly_client | weekly_coach
  digest_kind String
  // ISO-8601 date of the window, e.g. "2026-05-07"
  window_date String
  // status: sending | sent | failed | skipped
  status      String    @default("sending")
  sent_at     DateTime?
  error       String?
  created_at  DateTime  @default(now())

  @@unique([user_id, digest_kind, window_date])
  @@index([user_id, digest_kind, window_date])
  @@index([status, created_at])
}

// NotificationDeliveryLog — idempotency ledger for one-shot
// session-scoped notifications. Today used by the booking
// reminder cron (24h + 1h before start_at): the cron INSERTs
// before sending and treats a UniqueViolation as "already sent,
// skip". Row stays as a sent-receipts record for support
// debugging. Distinct from NotificationDigestLog which is
// keyed on a window_date rather than a session.
model NotificationDeliveryLog {
  id         String          @id @default(uuid())
  user_id    String
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session_id String
  session    CoachingSession @relation("DeliveryLogSession", fields: [session_id], references: [id], onDelete: Cascade)
  // kind matches NotificationKind values, e.g. booking_reminder_24h.
  kind       String
  created_at DateTime        @default(now())

  @@unique([session_id, user_id, kind], name: "NotificationDeliveryLog_session_user_kind_key")
  @@index([session_id])
  @@index([user_id, created_at])
}

// ============================================================
// Sprint B — coach toolset (workout builder, macros, real meal
// plans, holistic insights cache)
// ============================================================

enum WorkoutPlanType {
  strength
  cardio
  mobility
}

model WorkoutPlan {
  id                        String          @id @default(uuid())
  coach_id                  String
  coach                     User            @relation("CoachWorkoutPlans", fields: [coach_id], references: [id], onDelete: Cascade)
  name                      String
  type                      WorkoutPlanType
  duration_estimate_minutes Int?
  created_at                DateTime        @default(now())
  updated_at                DateTime        @updatedAt
  archived_at               DateTime?

  exercises   WorkoutPlanExercise[]
  assignments ClientWorkoutAssignment[]

  @@index([coach_id, archived_at])
  @@index([created_at])
}

model WorkoutPlanExercise {
  id                       String      @id @default(uuid())
  workout_plan_id          String
  workout_plan             WorkoutPlan @relation(fields: [workout_plan_id], references: [id], onDelete: Cascade)
  // ExerciseDB catalog identifier — NOT a FK to an internal table.
  exercise_external_id     String
  order                    Int
  sets                     Int
  // Dual-purpose: rep count (e.g. 12) or time-based duration (e.g. 60 seconds).
  reps_or_duration_seconds Int
  weight_lbs               Float?
  rest_seconds             Int?
  // Exercises sharing a superset_group_id are performed back-to-back.
  superset_group_id        String?
  notes                    String?

  @@unique([workout_plan_id, order], name: "WorkoutPlanExercise_plan_order_key")
  @@index([workout_plan_id])
  @@index([exercise_external_id])
}

model ClientWorkoutAssignment {
  id                   String      @id @default(uuid())
  workout_plan_id      String
  workout_plan         WorkoutPlan @relation(fields: [workout_plan_id], references: [id], onDelete: Cascade)
  client_id            String
  client               User        @relation("ClientWorkoutAssignments", fields: [client_id], references: [id], onDelete: Cascade)
  assigned_by_coach_id String
  assigned_by_coach    User        @relation("CoachWorkoutAssignments", fields: [assigned_by_coach_id], references: [id], onDelete: Cascade)
  scheduled_for        DateTime
  completed_at         DateTime?
  // Rating of Perceived Exertion 1–10; null until completed.
  post_rpe             Int?
  post_notes           String?

  @@index([client_id, scheduled_for])
  @@index([workout_plan_id])
  @@index([assigned_by_coach_id])
}

// ─── Sprint B: Macro targets ──────────────────────────────────────────────
//
// A coach sets calorie/macro targets for a client. effective_from is
// the start date for the target; we keep history (previous rows are
// not archived) so a client can see how their macros evolved over
// time. The "current" target for a client is the most recent row
// whose effective_from is <= today.
model MacroTarget {
  id             String    @id @default(uuid())
  client_id      String
  client         User      @relation("MacroTargetClient", fields: [client_id], references: [id], onDelete: Cascade)
  coach_id       String
  coach          User      @relation("MacroTargetCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  calories_kcal  Int
  protein_g      Int
  carbs_g        Int
  fats_g         Int
  fiber_g        Int?
  notes          String?
  effective_from DateTime  @default(now())
  created_at     DateTime  @default(now())
  archived_at    DateTime?

  @@index([client_id, effective_from])
  @@index([coach_id, created_at])
}

// ─── Sprint B: Real Meal Plans (templates + plans + assignments) ──────────
model MealTemplate {
  id            String    @id @default(uuid())
  coach_id      String
  coach         User      @relation("MealTemplateCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  name          String
  description   String?
  calories_kcal Int
  protein_g     Int
  carbs_g       Int
  fats_g        Int
  fiber_g       Int?
  items         Json?
  created_at    DateTime  @default(now())
  archived_at   DateTime?

  meal_plan_slots DailyMealPlanSlot[]

  @@index([coach_id, archived_at])
}

model DailyMealPlan {
  id          String    @id @default(uuid())
  coach_id    String
  coach       User      @relation("DailyMealPlanCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  created_at  DateTime  @default(now())
  archived_at DateTime?

  slots       DailyMealPlanSlot[]
  assignments DailyMealPlanAssignment[]

  @@index([coach_id, archived_at])
}

model DailyMealPlanSlot {
  id                 String        @id @default(uuid())
  daily_meal_plan_id String
  daily_meal_plan    DailyMealPlan @relation(fields: [daily_meal_plan_id], references: [id], onDelete: Cascade)
  meal_template_id   String
  meal_template      MealTemplate  @relation(fields: [meal_template_id], references: [id], onDelete: Restrict)
  slot_label         String
  order              Int           @default(0)

  @@unique([daily_meal_plan_id, slot_label, order])
  @@index([daily_meal_plan_id])
  @@index([meal_template_id])
}

model DailyMealPlanAssignment {
  id                   String        @id @default(uuid())
  daily_meal_plan_id   String
  daily_meal_plan      DailyMealPlan @relation(fields: [daily_meal_plan_id], references: [id], onDelete: Cascade)
  client_id            String
  client               User          @relation("DailyMealPlanAssignmentClient", fields: [client_id], references: [id], onDelete: Cascade)
  assigned_by_coach_id String
  assigned_by_coach    User          @relation("DailyMealPlanAssignmentCoach", fields: [assigned_by_coach_id], references: [id], onDelete: Cascade)
  starts_on            DateTime      @db.Date
  ends_on              DateTime?     @db.Date
  created_at           DateTime      @default(now())

  @@index([client_id, starts_on])
  @@index([daily_meal_plan_id])
  @@index([assigned_by_coach_id])
}

// ─── Sprint B: Holistic Insights cache ────────────────────────────────────
model HolisticInsightCache {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  window_days  Int
  payload      Json
  generated_at DateTime @default(now())
  expires_at   DateTime

  @@unique([user_id, window_days])
  @@index([expires_at])
}

// ============================================================
// AI GATEWAY — request audit + human-approval drafts
// ============================================================

// Per-call audit row written for every AI gateway invocation. This is
// distinct from AuditLog (which records sensitive ADMIN actions): an AI
// request audit captures the inputs, retrieval scope, redaction summary,
// and the provider route. The full prompt and response bodies are
// deliberately NOT stored — we keep counts and hashes so the row is safe
// to retain long-term and so PII does not accumulate in the audit table.
//
// Tenant scoping fields (subject_user_id + tenant_coach_id) let the owner
// surface scope an AI audit query to a single coach's roster without a
// join, mirroring AuditLog.tenant_coach_id.
model AiRequestAudit {
  id                      String         @id @default(uuid())
  request_id              String         @unique // client-supplied or generated; idempotency key
  capability              String // e.g. "chat.client_coach", "draft.coach_message"
  requester_id            String?
  requester               User?          @relation("AiRequestRequester", fields: [requester_id], references: [id], onDelete: SetNull)
  requester_role          String?
  subject_user_id         String? // the client whose data was the subject of the call
  subject_user            User?          @relation("AiRequestSubject", fields: [subject_user_id], references: [id], onDelete: SetNull)
  tenant_coach_id         String? // coach whose tenant the call touched, if any
  provider                String // "stub" | "perplexity" | "openai" | "anthropic" | …
  model                   String? // model id reported by the provider (or "disabled")
  enabled                 Boolean        @default(false) // false = fail-closed stub path
  context_source_count    Int            @default(0)
  context_source_refs     Json? // [{ source, ref, hash, count }] — refs only, no payload
  redactions_applied      Json? // { email: 2, phone: 1, ssn: 0, ... }
  prompt_token_estimate   Int?
  response_token_estimate Int?
  prompt_hash             String? // sha256 of the redacted prompt for replay/dedupe
  response_hash           String?
  approval_status         String         @default("not_required") // not_required | pending | approved | rejected | expired
  approval_draft_id       String?        @unique
  approval_draft          AiActionDraft? @relation("AiAuditDraft", fields: [approval_draft_id], references: [id], onDelete: SetNull)
  error                   String?
  ip                      String?
  user_agent              String?
  metadata                Json?
  created_at              DateTime       @default(now())

  @@index([capability, created_at])
  @@index([requester_id, created_at])
  @@index([subject_user_id, created_at])
  @@index([tenant_coach_id, created_at])
  @@index([approval_status, created_at])
}

// Human-approval workflow row. Consequential AI outputs (a coach message
// the AI drafted, a meal-plan adjustment, a flag escalation) land here
// as `pending` and require an authorized human (coach or owner) to
// approve before downstream action. AI cannot self-approve — the
// service guards on `decided_by_id != requester_id`.
//
// `expires_at` is set at creation; a sweep job (out of scope for this
// PR) marks stale rows `expired`. `payload` carries the proposed action
// in a capability-specific shape; `redacted_inputs` records the
// gateway-side redaction summary so reviewers can verify what the AI
// actually saw.
model AiActionDraft {
  id              String          @id @default(uuid())
  capability      String // e.g. "draft.coach_message"
  status          String          @default("pending") // pending | approved | rejected | expired
  requester_id    String?
  requester       User?           @relation("AiDraftRequester", fields: [requester_id], references: [id], onDelete: SetNull)
  subject_user_id String? // client whose data the draft concerns
  tenant_coach_id String?
  payload         Json // capability-specific proposed action
  rationale       String? // model-emitted reasoning (kept short, redacted)
  redacted_inputs Json? // { email: n, phone: n, ... } summary
  provenance      Json? // [{ source, ref, hash }] retrieval references
  decided_by_id   String?
  decided_by      User?           @relation("AiDraftDecidedBy", fields: [decided_by_id], references: [id], onDelete: SetNull)
  decided_at      DateTime?
  decision_note   String?
  audit_row       AiRequestAudit? @relation("AiAuditDraft")
  expires_at      DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @default(now()) @updatedAt

  @@index([status, created_at])
  @@index([requester_id, created_at])
  @@index([subject_user_id, created_at])
  @@index([tenant_coach_id, created_at])
  @@index([capability, status])
}

// ============================================================
// Coach AI v1 — per-client generation drafts + per-call cost log
// ============================================================
//
// Distinct from `AiActionDraft` (the generic gateway approval row): an
// `AIDraft` is the Coach AI v1 generation surface. A coach asks the
// engine to draft a workout program, meal plan, or weekly client
// insight; the row carries the snapshot of context the model saw, the
// model identifier, the generated payload, and a small status machine
// (DRAFT -> APPROVED|REJECTED|EXPIRED). On APPROVE the controller
// materializes the relevant downstream rows (WorkoutPlan +
// WorkoutPlanExercise[] for WORKOUT_PROGRAM; MealPlan for MEAL_PLAN;
// no materialization for INSIGHT).
enum AIDraftType {
  WORKOUT_PROGRAM
  MEAL_PLAN
  INSIGHT
}

enum AIDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  EXPIRED
}

model AIDraft {
  id               String         @id @default(uuid())
  coachId          String
  coach            User           @relation("AIDraftCoach", fields: [coachId], references: [id], onDelete: Cascade)
  clientId         String
  client           User           @relation("AIDraftClient", fields: [clientId], references: [id], onDelete: Cascade)
  type             AIDraftType
  inputContext     Json
  modelUsed        String
  promptVersion    String
  generatedPayload Json
  status           AIDraftStatus  @default(DRAFT)
  // FK to the materialized WorkoutPlan / MealPlan id (or null for
  // INSIGHT drafts that do not materialize). Kept as a plain string
  // (not a relation) so a single column can point at multiple tables.
  approvedAsId     String?
  rejectionReason  String?
  tokensIn         Int            @default(0)
  tokensOut        Int            @default(0)
  costCents        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([coachId, clientId, type, status])
}

// Per-call cost + latency log. Written for every AnthropicAdapter
// invocation (success or failure). Powers the per-coach $20/month
// budget alarm; aggregated by coach_id + capability + day.
model AICallLog {
  id           String   @id @default(uuid())
  model        String
  tokensIn     Int
  tokensOut    Int
  costCents    Int
  latencyMs    Int
  success      Boolean
  errorMessage String?
  coachId      String?
  coach        User?    @relation("AICallLogCoach", fields: [coachId], references: [id], onDelete: SetNull)
  clientId     String?
  client       User?    @relation("AICallLogClient", fields: [clientId], references: [id], onDelete: SetNull)
  capability   String
  createdAt    DateTime @default(now())

  @@index([coachId, createdAt])
  @@index([capability, createdAt])
}

// ============================================================
// Team Mode — sub-coach assignments + curated audit events
// ============================================================
//
// ADR-0001 §10 resolutions (locked 2026-05-10):
//   Q1 — Pro tier: each staff seat is a paid Stripe quantity line.
//        Enterprise tier: included unlimited.
//        Growth tier: feature gated (controllers return 403).
//   Q2 — Sub-coach is a many-to-many of head coaches, capped at 2.
//   Q3 — Removal auto-reassigns the sub-coach's clients to the
//        initiating head coach in a single transaction.
//   Q4 — Audit log is a curated event ledger, not a CRUD firehose.
//        See TeamAuditEventKind below for the 15 event_kinds.
//   Q5 — Sub-coaches may invite clients directly. Attribution is
//        carried by InviteCode.invited_by_user_id (added above).
//   Q6 — Tier gate at controller level via existing tier resolver.

enum TeamAuditEventKind {
  session_held
  message_sent
  plan_assigned
  checkin_logged
  macro_target_set
  meal_plan_assigned
  workout_assigned
  client_progress_logged
  sub_coach_assigned
  sub_coach_removed
  client_reassigned
  invite_sent_by_sub_coach
  tier_changed
  staff_seat_added
  staff_seat_removed
}

// Head coach <-> sub-coach assignment. The (sub_coach_id, head_coach_id)
// pair is unique. The "at most 2 head coaches per sub-coach" cap is
// enforced by the service-layer assignment path AND by a database
// trigger added in the migration so a concurrent double-write cannot
// exceed the cap.
model TeamSubCoachAssignment {
  id                          String    @id @default(uuid())
  head_coach_id               String
  head_coach                  User      @relation("TeamSubCoachAssignmentHead", fields: [head_coach_id], references: [id], onDelete: Cascade)
  sub_coach_id                String
  sub_coach                   User      @relation("TeamSubCoachAssignmentSub", fields: [sub_coach_id], references: [id], onDelete: Cascade)
  // Stripe subscription_item id (Pro tier only — null on Enterprise
  // because the staff seat is included; null on Growth because the
  // assignment never lands).
  stripe_subscription_item_id String?
  created_at                  DateTime  @default(now())
  archived_at                 DateTime?

  @@unique([head_coach_id, sub_coach_id])
  @@index([head_coach_id, archived_at])
  @@index([sub_coach_id, archived_at])
}

// Curated audit feed for the head coach's team. NOT a generic action
// log. Each row is a meaningful event a head coach would care about
// in a weekly review (sessions held, plans assigned, sub-coach added/
// removed, tier changes). 15 event_kinds total.
//
// Indexed for two read patterns:
//   1. Head coach's full feed (head_coach_id, occurred_at DESC).
//   2. Drill-down by event_kind within a head coach's feed.
//   3. Per-client filter (target_client_id, occurred_at DESC).
model TeamAuditEvent {
  id               String             @id @default(uuid())
  head_coach_id    String
  head_coach       User               @relation("TeamAuditEventActor", fields: [head_coach_id], references: [id], onDelete: Cascade)
  // The user who actually performed the action (may be the head coach
  // themselves, may be a sub-coach acting under them, may be the
  // platform OWNER for tier_changed events). Always set.
  actor_user_id    String
  // The client the event concerns. Null for events that are not
  // client-scoped (e.g. sub_coach_assigned, staff_seat_added).
  target_client_id String?
  target_client    User?              @relation("TeamAuditEventTarget", fields: [target_client_id], references: [id], onDelete: SetNull)
  event_kind       TeamAuditEventKind
  // Free-form short summary for the feed UI. Service-side templates
  // produce this so the wording stays consistent. Not user input.
  summary          String
  // Optional structured payload (e.g. {"reassigned_client_count": 3}).
  metadata         Json?
  occurred_at      DateTime           @default(now())

  @@index([head_coach_id, occurred_at])
  @@index([head_coach_id, event_kind, occurred_at])
  @@index([target_client_id, occurred_at])
}

// Client-entered bloodwork panel. v1 is manual entry only — no EHR import,
// no OCR, no lab integration. A panel is a logical grouping of biomarker
// results from a single draw (so "CBC + lipid on 2026-04-15" is one panel
// with N BloodworkResult rows).
//
// Tenancy: the (client_id, coach_id) pair pins the panel to the coach
// that was current when the panel was submitted, mirroring the CheckIn
// model. coach_id is nullable because a client can submit labs before
// they have a coach assigned.
//
// Source/provenance: `source` is free-form ("manual_entry", "lab_pdf",
// "photo_self_report"). v1 only writes "manual_entry" but the column is
// open so future ingestion paths land in the same table.
//
// Review state machine (string, not SQL enum, so adding states is cheap):
//   draft         — client is still editing; not visible to coach
//   submitted     — client finalized; appears in coach review queue
//   needs_info    — coach asked for clarification; back to client
//   reviewed      — coach has read it (no clinical opinion)
//   flagged       — coach flagged for follow-up
//   hidden        — coach hid from active surface
//
// Disclaimer level (string): drives which legal copy the mobile app
// renders. v1 always sets "educational_only" — labs are coaching context,
// never diagnosis or treatment.
//
// Validation status: per-panel rollup of result-level validation
// ("ok", "warnings", "errors"). Coach approval/visibility is gated on
// validation_status != 'errors' AND attachment_scan_status in ('clean',
// null) — see BloodworkService.assertReviewable.
//
// Encryption-aware fields: encryption_key_ref + kms_key_version are
// metadata pointers only — the actual KMS bindings live in env/config
// (see docs/bloodwork.md). v1 stores values in plaintext columns;
// production deploys MUST set BLOODWORK_KMS_KEY_REF and migrate to a
// column-level encryption strategy. Not a regression of current posture
// since no labs exist in prod yet.
model BloodworkPanel {
  id                    String    @id @default(uuid())
  client_id             String
  client                User      @relation("BloodworkPanelClient", fields: [client_id], references: [id], onDelete: Cascade)
  coach_id              String?
  coach                 User?     @relation("BloodworkPanelCoach", fields: [coach_id], references: [id], onDelete: SetNull)
  collection_date       DateTime
  source                String    @default("manual_entry") // manual_entry | lab_pdf | photo_self_report | ehr_import
  panel_label           String? // free-form ("CBC", "lipid", "annual physical")
  notes                 String? // client-supplied context (limited to 4000 chars in DTO)
  review_state          String    @default("draft") // draft | submitted | needs_info | reviewed | flagged | hidden
  reviewed_by_id        String?
  reviewed_by           User?     @relation("BloodworkPanelReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at           DateTime?
  review_note           String? // coach-supplied note attached to the most recent review action
  disclaimer_level      String    @default("educational_only") // educational_only | none (reserved)
  validation_status     String    @default("ok") // ok | warnings | errors
  is_stale              Boolean   @default(false)
  stale_marked_at       DateTime?
  source_missing        Boolean   @default(false) // true when client could not provide an attachment / lab source
  ai_processing_allowed Boolean   @default(false) // mirrors per-panel AI scope at submit time; AI service must re-check live consent
  encryption_key_ref    String? // pointer/alias for the KMS key envelope; null in non-prod
  kms_key_version       String? // version string of the key used to encrypt sensitive fields, when applicable
  // KMS-wrapped variants of the two free-text PII-bearing fields above.
  // Application dual-writes the plaintext + encrypted columns and reads
  // the encrypted column first with a plaintext fallback. A follow-up
  // cutover migration drops the plaintext columns once backfilled.
  encrypted_notes       String?
  encrypted_review_note String?
  submitted_at          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  results     BloodworkResult[]
  attachments BloodworkAttachment[]

  @@index([client_id, collection_date])
  @@index([coach_id, review_state])
  @@index([review_state, submitted_at])
  @@index([is_stale])
}

// Per-biomarker row inside a BloodworkPanel. `marker_name` is free-form
// ("hemoglobin", "ldl_c", …) — v1 deliberately avoids a curated dictionary
// because the source of truth for naming is the lab printout the client
// transcribed.
//
// `value_numeric` is the typed numeric value when the lab printed one;
// `value_text` is the raw client-entered text (e.g. ">200", "see notes")
// for cases where the value is qualitative or above-range. At least one
// of the two is required at the DTO layer.
model BloodworkResult {
  id                 String         @id @default(uuid())
  panel_id           String
  panel              BloodworkPanel @relation(fields: [panel_id], references: [id], onDelete: Cascade)
  marker_name        String
  marker_code        String? // optional standardized code (LOINC etc.) — never required
  value_numeric      Decimal?       @db.Decimal(20, 6)
  value_text         String?
  unit               String?
  reference_low      Decimal?       @db.Decimal(20, 6)
  reference_high     Decimal?       @db.Decimal(20, 6)
  reference_text     String? // free-form when low/high don't apply ("negative", "<5")
  out_of_range       Boolean        @default(false) // computed at write time when low/high are present
  validation_status  String         @default("ok") // ok | warnings | errors
  validation_message String?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  @@index([panel_id])
  @@index([marker_name])
}

// Attachment metadata pointer for a panel (e.g. a photo/PDF of the lab
// printout). v1 does NOT implement upload/storage; this table holds the
// metadata + scan state machine that downstream upload code can plug in.
//
// Scan state machine:
//   pending_scan  — uploaded, awaiting AV / content scan
//   clean         — passed scan; safe to expose to coach
//   rejected      — scan failed; client must replace
//   quarantined   — flagged for human review; not coach-visible
//   unavailable   — file removed / link broken
//
// `storage_ref` is an opaque pointer (S3 key, Supabase storage path, etc).
// Never write a presigned URL here — controllers mint short-lived URLs at
// read time when a coach accesses a clean attachment.
model BloodworkAttachment {
  id              String         @id @default(uuid())
  panel_id        String
  panel           BloodworkPanel @relation(fields: [panel_id], references: [id], onDelete: Cascade)
  storage_ref     String? // opaque storage pointer (bucket/key)
  storage_backend String? // "supabase" | "s3" | "stub" — null in v1
  content_type    String?
  byte_size       Int?
  scan_status     String         @default("pending_scan") // pending_scan | clean | rejected | quarantined | unavailable
  scan_message    String?
  scanned_at      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  @@index([panel_id])
  @@index([scan_status])
}

// ============================================================
// CONCIERGE SCHEDULING (PR #142)
// ============================================================
//
// TGP is a private coaching concierge — clients schedule Zoom or Google
// Meet calls with the coach who already manages them, coaches set their
// availability, and admins see fulfillment org-wide. This is *not* a
// generic Calendly clone: the only people who can request a session
// with a coach are clients already linked via `User.coach_id`, and the
// coach approves every booking unless they have explicitly marked a
// SessionType as `auto_approve`.
//
// All provider integrations (Google Calendar, Google Meet, Zoom) ship
// behind a stub adapter by default. No real API calls are made unless
// the corresponding env vars are set; see docs/session-scheduling.md.

enum SessionStatus {
  // Client requested; awaiting coach approval. Default landing state
  // for any session not auto-approved.
  requested
  // Coach approved (or auto-approved) — calendar/video provisioning is
  // attempted on transition. Stays in `scheduled` once provisioned.
  scheduled
  // Coach (or admin) declined the requested session. Terminal.
  declined
  // Either party canceled before start. Terminal.
  canceled
  // Coach (or admin) marked the session as not-attended after start_at
  // passed. Distinct from `canceled` for fulfillment reporting.
  no_show
  // Coach (or admin) marked the session complete. Terminal happy path.
  completed
  // Background provider call is in flight (calendar event create/update
  // or video link mint). Used so a transient retry does not double-book.
  pending_provider
}

enum VideoProvider {
  // Default — no real video link, the API returns a stub URL of the form
  // tgp-stub://session/<id>. The mobile/web client treats this as "the
  // coach has not attached a real link yet" and surfaces a manual-link
  // affordance to the coach.
  stub
  google_meet
  zoom
  // Coach pasted a custom link (Whereby, FaceTime, phone, etc.). The
  // link is stored verbatim and never re-minted by a provider job.
  manual
}

enum CalendarProvider {
  stub
  google_calendar
  // Apple/Outlook reserved as future enums; intentionally commented out
  // until adapters land — Prisma migrations forbid removing values, so
  // we add them when we ship the adapter.
}

enum SessionParticipantRole {
  coach
  client
  // Admin observer (owner role). Sub-coaches join as `assistant_coach`.
  admin
  assistant_coach
}

// SessionType — the offering the coach exposes (e.g. "30 min check-in",
// "Initial intake", "Quarterly review"). Owned by a coach. Clients pick
// from this list when requesting a session.
model SessionType {
  id                     String        @id @default(uuid())
  coach_id               String
  coach                  User          @relation("SessionTypeCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  duration_minutes       Int           @default(30)
  // Auto-approve client requests (skip the `requested` -> `scheduled`
  // gate). Defaults to false — coaches consciously turn this on per
  // session type, since the doctrine here is "coach approves every
  // booking" until the coach decides otherwise.
  auto_approve           Boolean       @default(false)
  // Default video provider for sessions of this type. Concrete sessions
  // may override (e.g. coach pastes a manual link for one).
  default_video_provider VideoProvider @default(stub)
  // Soft-disable so historic sessions still link back to their type.
  archived_at            DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @default(now()) @updatedAt

  sessions CoachingSession[] @relation("CoachingSessionType")

  @@index([coach_id])
}

// CoachAvailability — recurring weekly availability windows for a coach.
// Per-day-of-week (0 = Sunday … 6 = Saturday) plus start/end minute-of-
// day. Stored as integers (not DateTime) so daylight-savings transitions
// don't shift the recurring window. The coach's timezone lives on
// CoachProfile.timezone; this row is interpreted relative to that tz.
//
// One-off blackouts and exceptions are deliberately *not* modeled here
// yet — the next iteration adds CoachAvailabilityException rows. For
// now, a coach who needs to block a single day uses the calendar-sync
// job seam (manually) or marks individual conflicting requests declined.
model CoachAvailability {
  id              String   @id @default(uuid())
  coach_id        String
  coach           User     @relation("CoachAvailability", fields: [coach_id], references: [id], onDelete: Cascade)
  day_of_week     Int // 0=Sun … 6=Sat
  start_minute    Int // minutes from midnight local
  end_minute      Int
  // Allows the coach to mark a window as "intake only" or similar via a
  // session-type filter. NULL = applies to any session type.
  session_type_id String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@index([coach_id, day_of_week])
}

// CoachAvailabilityOverride — date-keyed exceptions to the recurring
// weekly availability. Three semantics:
//
//   HOLIDAY  — the coach is OFF for this date (whole day or window).
//              Bookings cannot be placed inside the override window.
//   BLOCK    — same effect as HOLIDAY but the coach can attach a note
//              ("focus time", "personal", etc.) the UI may surface.
//   EXTRA    — the coach is AVAILABLE on this date in a window that is
//              not part of their recurring weekly availability (e.g.
//              "Saturday 9-11am this week only").
//
// One row per (coach_id, date, start_minute). The scheduling service
// merges overrides with CoachAvailability when computing slots: EXTRA
// adds to the recurring window, HOLIDAY/BLOCK subtract from it.
//
// Stored as date + minute-of-day in the coach's timezone (read from
// CoachProfile.timezone) so daylight-savings transitions do not shift
// the override. The migration adds a CHECK constraint on the kind
// column rather than a Prisma enum so adding new kinds in a follow-up
// does not require an enum migration.
model CoachAvailabilityOverride {
  id           String   @id @default(uuid())
  coach_id     String
  coach        User     @relation("CoachAvailabilityOverrideCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  // Calendar date in the coach's timezone (YYYY-MM-DD). Not a
  // DateTime: time-of-day lives on the minute columns below so the
  // row is unambiguous across DST.
  date         DateTime @db.Date
  // Minutes from midnight local. Null on a HOLIDAY/BLOCK that covers
  // the entire day.
  start_minute Int?
  end_minute   Int?
  // 'holiday' | 'block' | 'extra' — enforced by a CHECK constraint in
  // the migration. Adding a new kind is an additive migration with no
  // Prisma-generated enum churn.
  kind         String
  note         String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@unique([coach_id, date, start_minute, kind], name: "CoachAvailabilityOverride_coach_date_start_kind_key")
  @@index([coach_id, date])
}

// CoachingSession — a concrete scheduled (or requested) session.
model CoachingSession {
  id                       String           @id @default(uuid())
  coach_id                 String
  coach                    User             @relation("CoachingSessionCoach", fields: [coach_id], references: [id])
  // The primary client. Group sessions are modeled via SessionParticipant
  // rows; the `client_id` here is the lead client (the one who requested
  // it, or the one the coach booked it for). Nullable so admin-created
  // group sessions without a single lead client are valid.
  client_id                String?
  client                   User?            @relation("CoachingSessionClient", fields: [client_id], references: [id])
  session_type_id          String?
  session_type             SessionType?     @relation("CoachingSessionType", fields: [session_type_id], references: [id])
  status                   SessionStatus    @default(requested)
  start_at                 DateTime
  end_at                   DateTime
  // Free-form title shown to the client (defaults to session_type.name
  // at creation time but can be edited by the coach).
  title                    String
  // Internal coach-only notes; client-visible recap lives in
  // `client_recap_md` (gated behind a human-approval step under the AI
  // gateway doctrine — never auto-published).
  coach_notes_md           String?
  client_recap_md          String?
  // Provider-side identifiers. Populated only when a real adapter
  // attaches; stub provider leaves these null.
  video_provider           VideoProvider    @default(stub)
  video_url                String?
  video_meeting_id         String?
  calendar_provider        CalendarProvider @default(stub)
  calendar_event_id        String?
  // Idempotency key for provider-side create calls. The scheduler sets
  // this once on first transition into `pending_provider`; retries reuse
  // it so the provider does not create duplicate calendar events.
  provider_idempotency_key String?
  // When the coach approved the request (null while `requested`).
  approved_at              DateTime?
  // When the session terminated (canceled / declined / no_show / completed).
  ended_at                 DateTime?
  // Reason captured on cancel/decline/no_show (free-form, optional).
  end_reason               String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @default(now()) @updatedAt

  participants  SessionParticipant[]      @relation("SessionParticipantSession")
  delivery_logs NotificationDeliveryLog[] @relation("DeliveryLogSession")

  // Hot paths:
  //   - "list this coach's upcoming sessions" → (coach_id, start_at)
  //   - "list this client's upcoming sessions" → (client_id, start_at)
  //   - "fulfillment dashboard, today's no-shows" → (status, start_at)
  @@index([coach_id, start_at])
  @@index([client_id, start_at])
  @@index([status, start_at])
}

// SessionParticipant — extra attendees beyond the lead coach/client.
// Used for sub-coach shadowing, admin observation, or future group
// sessions. The lead coach + lead client are *not* duplicated here.
model SessionParticipant {
  id         String                 @id @default(uuid())
  session_id String
  session    CoachingSession        @relation("SessionParticipantSession", fields: [session_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User                   @relation("SessionParticipantUser", fields: [user_id], references: [id])
  role       SessionParticipantRole
  created_at DateTime               @default(now())

  @@unique([session_id, user_id], name: "SessionParticipant_session_user_key")
  @@index([user_id])
}

// CalendarConnection — metadata only. Real OAuth tokens are deliberately
// NOT stored in this row in this PR; the `credentials_secret_ref` field
// holds an opaque pointer to whichever secret store the deployment uses
// (Fly secrets, AWS SM, etc.). The stub adapter ignores this entirely.
model CalendarConnection {
  id                      String           @id @default(uuid())
  user_id                 String
  user                    User             @relation("CalendarConnectionUser", fields: [user_id], references: [id], onDelete: Cascade)
  provider                CalendarProvider
  // External calendar account identifier (e.g. Google account email).
  // Deliberately *not* the raw token.
  external_account_id     String?
  // Pointer to the secret-store entry holding the OAuth credentials.
  // Null on stub connections.
  credentials_secret_ref  String?
  // KMS-wrapped Google OAuth refresh token. Encrypted via KmsService
  // (see src/common/kms/) using AES-256-GCM with an envelope shaped as
  // base64(JSON({v,iv,tag,ct})). Prior to this column the refresh token
  // lived only in process memory; this column lets a process restart
  // reuse a previously linked account without forcing a re-link.
  encrypted_refresh_token String?
  // Last time the calendar-sync job seam successfully reconciled this
  // connection. Null until the real adapter ships.
  last_synced_at          DateTime?
  // Soft-disconnect so audit history survives a re-link.
  disconnected_at         DateTime?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @default(now()) @updatedAt

  @@unique([user_id, provider, external_account_id], name: "CalendarConnection_user_provider_account_key")
  @@index([user_id])
}

// ─── Phase 10: Secrets Rotation Log ────────────────────────────────────────
//
// Immutable audit trail for every secret rotation event. The admin endpoint
// GET /admin/secrets/status reads this table to surface "last rotated" dates
// per secret. No secret values are stored here — only metadata.
//
// rotated_by_user_id is nullable so that automated script rotations (e.g.
// scripts/secrets/rotate-jwt.ts) can be recorded without a user context.
//
// The secret_name column is a free-text identifier matching the Fly secret
// name exactly (e.g. "JWT_SIGNING_KEY", "DATABASE_URL"). This keeps the
// table schema stable even as new secrets are added.
model SecretRotationLog {
  id                 String   @id @default(uuid())
  secret_name        String
  rotated_at         DateTime @default(now())
  rotated_by_user_id String?
  notes              String?

  @@index([secret_name])
  @@index([rotated_at])
  @@index([rotated_by_user_id])
  @@map("secret_rotation_log")
}

// ─── Video library: ExerciseCatalogItem ────────────────────────────────────
//
// Canonical, owner-curated exercise catalog used by the mobile workout flow.
// Coexists with the legacy ExerciseDB proxy in src/exercise-library: this
// table is the source of truth for any exercise the platform has its own
// demo video for, while the ExerciseDB proxy remains as a wide-catalog
// fallback for the workout builder.
//
// Video state machine:
//
//   none       — no Mux asset yet. mux_* columns null. playbackUrl=null.
//   uploading  — owner created a direct-upload URL; Mux has not finalized
//                the asset yet (no asset id in webhook fan-out).
//   processing — asset created on Mux; transcoding in flight. mux_asset_id
//                is set, but mux_playback_id is not yet usable.
//   ready      — webhook `video.asset.ready` landed; mux_playback_id is
//                usable. The /exercise-catalog/:idOrSlug detail route
//                mints a playback URL when this state is reached.
//   errored    — webhook `video.asset.errored` landed. mux_error_message
//                carries the upstream reason. Treated identically to
//                `none` for playback (playbackUrl=null).
//
// Slugs are hand-derived from the seed catalog (`seed:push-001` →
// "barbell-bench-press") and used by the mobile client when navigating
// from a workout assignment row to the exercise detail screen. Slugs are
// unique and stable; renaming requires a migration.
model ExerciseCatalogItem {
  id                  String                  @id @default(uuid())
  // Stable URL slug — e.g. "barbell-bench-press". Mobile client navigates
  // via /exercise-catalog/:idOrSlug so either the uuid or the slug works.
  slug                String                  @unique
  name                String
  category            String
  primary_muscle      String
  secondary_muscles   String[]                @default([])
  equipment           String[]                @default([])
  // Free-text label (beginner | intermediate | advanced). Not an enum so
  // we can extend without a migration.
  difficulty          String                  @default("beginner")
  instructions        String[]                @default([])
  // Optional source pointer for provenance — e.g. "seed:push-001" when the
  // catalog row was derived from SEED_EXERCISES, or "wger:75" if a future
  // import path lands.
  source_ref          String?

  // Mux state. All four are null until an owner attaches a video.
  mux_asset_id        String?
  mux_playback_id     String?
  // 'public' (direct HLS) or 'signed' (requires MUX_SIGNING_KEY). The
  // detail route uses this to decide whether to mint a JWT or hand back
  // the bare URL. Defaults to 'public' for v1 simplicity.
  mux_playback_policy String                  @default("public")
  mux_asset_status    ExerciseVideoStatus     @default(none)
  mux_duration_seconds Float?
  mux_error_message   String?
  // Direct-upload bookkeeping: when an owner POSTs /video/upload we
  // create a Mux Direct Upload and remember its id so the webhook can
  // resolve the upload back to the catalog row when the asset is born.
  mux_upload_id       String?                 @unique

  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt

  @@index([category])
  @@index([primary_muscle])
  @@index([mux_asset_id])
}

enum ExerciseVideoStatus {
  none
  uploading
  processing
  ready
  errored
}

// ─── Email Send Log ─────────────────────────────────────────────────────
//
// Idempotency + send-receipts ledger for transactional email.
//
// One row per send attempt. The `idempotency_key` is a stable opaque
// caller-supplied string (e.g. "invite:<invite_code_id>"). A unique
// constraint on the key makes EmailService.send a no-op on retry — the
// second insert hits P2002 and the call returns status:'skipped' without
// re-hitting the provider.
//
// status lifecycle:
//   sending → sent     (provider 2xx)
//   sending → failed   (provider non-2xx or render error)
//   sending → logged   (EMAIL_TRANSPORT=log; payload only printed)
//
// We never delete rows — support uses this table to confirm "did we send
// the X email to Y on date Z" without needing to query the provider.
model EmailSendLog {
  id                  String    @id @default(uuid())
  idempotency_key     String    @unique
  // One of EmailTemplateKey values (free-text on the DB side to keep
  // adding new templates from a single source — src/email/email.types.ts).
  template_key        String
  // Lower-cased at write time. Indexed for support lookups.
  recipient_email     String
  // sending | sent | failed | logged
  status              String    @default("sending")
  // Provider message id when status='sent'. Null otherwise.
  provider_message_id String?
  // Truncated to 500 chars by the service layer. Null when no error.
  error               String?
  sent_at             DateTime?
  created_at          DateTime  @default(now())

  @@index([recipient_email, created_at])
  @@index([template_key, created_at])
  @@index([status, created_at])
}
