  created_by User                 @relation("CommunityEventCreatedBy", fields: [created_by_id], references: [id], onDelete: Restrict)
  rsvps      CommunityEventRsvp[]

  // Upcoming-events board filtered by state.
  @@index([workspace_id, state, starts_at])
  // Cohort calendar.
  @@index([cohort_id, starts_at])
  // Global transition jobs (tomorrow/live sweeps).
  @@index([starts_at])
  @@map("community_events")
}

model CommunityEventRsvp {
  id           String                   @id @default(uuid()) @db.Uuid
  workspace_id String                   @db.Uuid
  event_id     String                   @db.Uuid
  user_id      String                   @db.Uuid
  status       CommunityEventRsvpStatus
  reminded_at  DateTime?                @db.Timestamptz(6)
  created_at   DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                 @updatedAt @db.Timestamptz(6)

  workspace CommunityWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  event     CommunityEvent     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user      User               @relation("CommunityEventRsvpUser", fields: [user_id], references: [id], onDelete: Cascade)

  // One RSVP per user per event.
  @@unique([event_id, user_id])
  // "My RSVPs" within a workspace.
  @@index([workspace_id, user_id, status])
  // Reminder sweeps for unsent reminders.
  @@index([workspace_id, status, reminded_at])
  @@map("community_event_rsvps")
}

model CommunityChallenge {
  id                  String                   @id @default(uuid()) @db.Uuid
  workspace_id        String                   @db.Uuid
  cohort_id           String?                  @db.Uuid
  created_by_id       String                   @db.Uuid
  title               String                   @db.VarChar(160)
  description         String?                  @db.Text
  status              CommunityChallengeStatus @default(draft)
  starts_at           DateTime?                @db.Timestamptz(6)
  ends_at             DateTime?                @db.Timestamptz(6)
  metric_key          String?                  @db.VarChar(80)
  target_value        Decimal?                 @db.Decimal(12, 2)
  unit                String?                  @db.VarChar(40)
  leaderboard_enabled Boolean                  @default(false)
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                 @updatedAt @db.Timestamptz(6)
  archived_at         DateTime?                @db.Timestamptz(6)

  workspace    CommunityWorkspace                @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  cohort       CommunityCohort?                  @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  created_by   User                              @relation("CommunityChallengeCreatedBy", fields: [created_by_id], references: [id], onDelete: Restrict)
  participants CommunityChallengeParticipation[]

  // Active-challenge board.
  @@index([workspace_id, status, starts_at])
  // Cohort challenge list.
  @@index([cohort_id, status])
  @@map("community_challenges")
}

model CommunityChallengeParticipation {
  id             String    @id @default(uuid()) @db.Uuid
  workspace_id   String    @db.Uuid
  challenge_id   String    @db.Uuid
  user_id        String    @db.Uuid
  progress_value Decimal   @default(0) @db.Decimal(12, 2)
  completed_at   DateTime? @db.Timestamptz(6)
  last_logged_at DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  workspace CommunityWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  challenge CommunityChallenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  user      User               @relation("CommunityChallengeParticipationUser", fields: [user_id], references: [id], onDelete: Cascade)

  // One participation row per user per challenge.
  @@unique([challenge_id, user_id])
  // "My participations" within a workspace.
  @@index([workspace_id, user_id])
  // Leaderboard ordering by progress.
  @@index([challenge_id, progress_value])
  @@map("community_challenge_participations")
}

model CommunityModerationAction {
  id             String                        @id @default(uuid()) @db.Uuid
  workspace_id   String                        @db.Uuid
  target_type    CommunityModerationTargetType
  target_id      String                        @db.Uuid
  reported_by_id String?                       @db.Uuid
  actor_id       String?                       @db.Uuid
  status         CommunityModerationStatus     @default(open)
  reason         String                        @db.VarChar(80)
  notes          String?                       @db.Text
  action         String?                       @db.VarChar(80)
  created_at     DateTime                      @default(now()) @db.Timestamptz(6)
  resolved_at    DateTime?                     @db.Timestamptz(6)

  workspace   CommunityWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  // Reporter/actor are SetNull so the audit row survives a user scrub.
  reported_by User?              @relation("community_reporter", fields: [reported_by_id], references: [id], onDelete: SetNull)
  actor       User?              @relation("community_moderator", fields: [actor_id], references: [id], onDelete: SetNull)

  // Coach moderation queue ordered by recency, filtered by status.
  @@index([workspace_id, status, created_at])
  // Lookup actions for a specific target.
  @@index([target_type, target_id])
  // A reporter's filed reports.
  @@index([reported_by_id, created_at])
  @@map("community_moderation_actions")
}

// ─── B5 — Digital Contracts + E-Signatures (HelloSign Embedded) ───────────────
//
// Two-layer contract scope:
//   Layer 1 — Platform Liability Waiver (TGP ↔ Client): REQUIRED once per
//             client. Modeled as a ContractTemplate with is_platform=true,
//             owned by the seeded TGP "system coach" user. A client who has
//             a SIGNED platform-waiver envelope at the current template
//             version is grandfathered and never re-signs.
//   Layer 2 — Coach Service Agreement (Coach ↔ Client): OPT-IN per package
//             via CoachPackage.requires_contract + contract_template_id.
//
// Provider-agnostic by construction (spec §11): the models, controllers,
// state machine, checkout integration and audit log do not know which
// SignatureProvider is bound. Only the adapter changes (HelloSign v1;
// DocuSign / native-canvas are future flag-flips, shipped here as stubs).
//
// FEATURE_CONTRACTS_ENABLED is the global go-live gate (default OFF in prod);
// it is enforced as a server-side code-level invariant in
// ContractEnvelopeService.createEnvelope() and the webhook handler.

enum ContractEnvelopeStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
}

model ContractTemplate {
  id                  String   @id @default(cuid())
  // For coach templates this is the authoring coach. For the platform
  // liability waiver (is_platform=true) this points at the seeded TGP
  // system-coach user so the FK stays NOT NULL and the relation is uniform.
  coach_id            String
  // B5 Layer-1 marker. true = TGP↔Client platform liability waiver (one
  // per client, version-grandfathered). false = coach-authored Layer-2
  // service agreement. Default false keeps coach CRUD behavior unchanged.
  is_platform         Boolean  @default(false)
  name                String
  body_markdown       String
  version             Int      @default(1)
  dynamic_fields_json Json
  requires_signature  Boolean  @default(true)
  created_at          DateTime @default(now())

  coach     User               @relation("ContractTemplateCoach", fields: [coach_id], references: [id])
  envelopes ContractEnvelope[]
  packages  CoachPackage[]     @relation("PackageContractTemplate")

  @@index([coach_id])
  @@index([is_platform, version])
}

model ContractEnvelope {
  id                   String                 @id @default(cuid())
  template_id          String
  // Locked at send time (spec §5.2): a coach editing a template never
  // mutates a contract a client was already sent or signed.
  template_version     Int
  client_id            String
  coach_id             String
  // Nullable — set ONLY after Stripe payment success (spec §3.3 / §4.1).
  purchase_id          String?
  status               ContractEnvelopeStatus @default(DRAFT)
  // Carries the ACTIVE provider's request id regardless of provider
  // (DocuSign envelope id / native-canvas job id when those flags are on).
  // Column name kept per operator spec for migration stability; treated as
  // a generic provider-request-id at the code layer.
  hellosign_request_id String?
  signed_pdf_url       String?
  ip                   String?
  user_agent           String?
  signed_at            DateTime?
  // Default now()+7d at SENT (set in code, not as a column default).
  expires_at           DateTime?
  created_at           DateTime               @default(now())

  template ContractTemplate     @relation(fields: [template_id], references: [id])
  client   User                 @relation("ClientEnvelopes", fields: [client_id], references: [id])
  coach    User                 @relation("CoachEnvelopes", fields: [coach_id], references: [id])
  events   ContractAuditEvent[]
  purchase ClientPurchase?      @relation("PurchaseContractEnvelope")

  @@index([client_id])
  @@index([coach_id])
  @@index([status])
  @@index([hellosign_request_id])
  // Idempotency spine for the Layer-1 grandfather check: find a client's
  // SIGNED platform-waiver envelope by template + version fast.
  @@index([client_id, template_id, template_version, status])
}

model ContractAuditEvent {
  id          String   @id @default(cuid())
  envelope_id String
  // null for system / provider-originated events.
  actor_id    String?
  // VIEW | SIGN | DECLINE | SEND | EXPIRE | WEBHOOK
  action      String
  ip          String?
  user_agent  String?
  created_at  DateTime @default(now())

  envelope ContractEnvelope @relation(fields: [envelope_id], references: [id])

  @@index([envelope_id])
}

// ============================================================
// ROMAN — Phase 1 chat MVP (additive; gated behind
// FEATURE_ROMAN_CHAT_ENABLED, default OFF). See src/roman/.
// ============================================================

// Which app surface a Roman session belongs to. One Roman, two framings:
// `client` (the TGP client app) and `coach` (the coach app). Surface drives
// the system-prompt framing only — the voice contract is identical.
enum RomanSurface {
  client
  coach
}

// Author of a single chat turn. `user` = the human; `roman` = the single AI
// persona. Stored lowercase so raw SQL / admin tooling reads naturally.
enum RomanMessageRole {
  user
  roman
}

// A persistent Roman chat session. Idempotent on (user_id, surface, day_key):
// the service opens at most one active session per user/surface/day. Soft
// delete via deleted_at (never hard-deleted from the chat surface).
model RomanSession {
  id      String       @id @default(cuid())
  user_id String
  surface RomanSurface

  // Idempotency key for "open or resume" — the UTC calendar day (YYYY-MM-DD)
  // the session was opened. The unique index below makes "one active session
  // per (user, surface, day)" a database invariant, not just service logic.
  day_key String

  // Lightweight session bookkeeping. message_count is denormalised for cheap
  // listing; last_activity_at advances on every appended turn.
  message_count    Int      @default(0)
  started_at       DateTime @default(now())
  last_activity_at DateTime @default(now())

  // Voice-contract self-rate-limiting state (spec §1.5 / brief §2). The
  // service surfaces these to the model so it can honour the per-session quip
  // allowance and the single-exclamation budget.
  quips_in_session Int     @default(0)
  exclamation_used Boolean @default(false)

  // Optional brief/subject context blob (e.g. a coach brief) the session was
  // opened against. Nullable — most sessions carry none.
  subject_context_json Json?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  // Soft-delete tombstone. Non-null = session is hidden from the chat surface
  // but retained for audit/budget history.
  deleted_at DateTime?

  user     User           @relation("RomanSessionUser", fields: [user_id], references: [id], onDelete: Cascade)
  messages RomanMessage[]

  // Idempotency spine for open-or-resume: at most one row per
  // (user, surface, day_key). The partial-by-convention uniqueness is enforced
  // in full (including soft-deleted rows) so a deleted session does not free
  // the day-key for a duplicate; the service resumes a live one or opens the
  // next day.
  @@unique([user_id, surface, day_key], name: "roman_session_user_surface_day")
  // Listing index: a user's sessions for a surface, newest first.
  @@index([user_id, surface, created_at(sort: Desc)])
}

// A single chat turn within a Roman session. Append-only in practice; an
// assistant turn may be marked `interrupted` when the client disconnects
// mid-stream (partial content persisted).
model RomanMessage {
  id         String           @id @default(cuid())
  session_id String
  // Denormalised owner for direct RLS scoping (avoids a join through session
  // on the hot read path). Always equals the parent session's user_id; the
  // RLS policy enforces both the direct predicate AND the session-join.
  user_id    String
  role       RomanMessageRole
  content    String

  // Token accounting for future budgeting (brief §3). Null on a user turn
  // (no model call) until/unless we attribute prompt tokens to the turn.
  prompt_tokens     Int?
  completion_tokens Int?
  // The Anthropic model id that produced an assistant turn (null on user
  // turns). Persisted so a later model upgrade is auditable per-message.
  model_id          String?

  // True when an assistant turn was persisted from a partial stream because
  // the client disconnected before completion (brief §1.3 streaming rule).
  interrupted Boolean @default(false)

  // Optional branch pointer for future message-tree editing. Nullable; Phase 1
  // never sets it but the column ships now so branching is additive later.
  parent_message_id String?

  created_at DateTime @default(now())

  session RomanSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user    User           @relation("RomanMessageUser", fields: [user_id], references: [id], onDelete: Cascade)
  parent  RomanMessage?  @relation("RomanMessageParent", fields: [parent_message_id], references: [id])
  replies RomanMessage[] @relation("RomanMessageParent")

  // Hot read path: a session's messages in chronological order (the controller
  // paginates newest-first by reversing a created_at cursor over this index).
  @@index([session_id, created_at])
  // Direct owner scope for RLS / per-user budget queries.
  @@index([user_id])
  @@index([parent_message_id])
}
