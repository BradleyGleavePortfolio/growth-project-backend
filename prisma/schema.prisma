// The Growth Project — Prisma Schema
// PostgreSQL with Supabase Auth integration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Phase 1A platform pivot: add the `owner` tier above `coach` so the
// platform can be operated as Healthie-style OWNER -> COACH -> CLIENT
// without breaking existing rows. Existing rows stay valid (`coach`,
// `student`); the new `owner` value is opt-in and only set by the
// bootstrap-owners script or the OWNER promote endpoint.
enum Role {
  coach
  student
  owner
}

// Phase 1A: subscription state for a coach's $300/mo seat. Stored as
// strings on CoachProfile so the column reads naturally in raw SQL and
// admin tooling without a Prisma-only enum mapping.
enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  paused
}

enum Sex {
  male
  female
  prefer_not_to_say
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum GoalType {
  fat_loss
  muscle_gain
  maintenance
  performance
}

enum WorkoutExperience {
  beginner
  intermediate
  advanced
}

enum FoodCategory {
  generic
  packaged
  fast_food
  restaurant
  recipe_ingredient
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum Intensity {
  light
  moderate
  hard
  max
}

enum MuscleGroup {
  chest
  back
  legs
  shoulders
  arms
  core
  cardio
  full_body
}

enum CheckInType {
  morning
  evening
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                    String    @id @default(uuid())
  supabase_id           String    @unique
  email                 String    @unique
  name                  String
  phone                 String?
  role                  Role      @default(student)
  // coach_id now a proper self-relation FK instead of an orphan string column.
  // Preserves prior behavior — still nullable, still points at another User.id.
  coach_id              String?
  coach                 User?     @relation("CoachToStudents", fields: [coach_id], references: [id])
  students              User[]    @relation("CoachToStudents")
  created_at            DateTime  @default(now())
  archived_at           DateTime?
  // GDPR delete-account flow. Two-phase: deletion_scheduled_at marks the
  // grace-period start (account locked but recoverable); deleted_at marks
  // the irreversible PII scrub. Existing rows stay valid (both null).
  deletion_scheduled_at DateTime?
  deleted_at            DateTime?

  profile                  UserProfile?
  logged_entries           LoggedFoodEntry[]
  workouts                 WorkoutSession[]
  fasting_windows          FastingWindow[]
  weight_logs              WeightLog[]
  notification_prefs       NotificationPreferences?
  preferences              UserPreferences?
  habits                   Habit[]
  lesson_completions       LessonCompletion[]
  check_ins                CheckIn[]
  water_logs               WaterLog[]
  created_routines         WorkoutRoutine[]         @relation("RoutineCreator")
  coached_lessons          Lesson[]                 @relation("LessonCoach")
  invite_codes             InviteCode[]             @relation("CoachInviteCodes")
  coach_messages_as_coach  CoachMessage[]           @relation("CoachMessagesAsCoach")
  coach_messages_as_client CoachMessage[]           @relation("CoachMessagesAsClient")
  coach_messages_sent      CoachMessage[]           @relation("CoachMessagesSender")
  coach_nudges_as_coach    CoachNudge[]             @relation("CoachNudgesAsCoach")
  coach_nudges_as_client   CoachNudge[]             @relation("CoachNudgesAsClient")
  meal_plans_as_coach      MealPlan[]               @relation("MealPlanCoach")
  meal_plans_as_client     MealPlan[]               @relation("MealPlanClient")
  community_wins           CommunityWin[]           @relation("CommunityWinAuthor")
  community_wins_as_coach  CommunityWin[]           @relation("CommunityWinCoach")
  guidelines_as_coach      CoachGuideline[]         @relation("CoachGuidelineCoach")
  guidelines_as_client     CoachGuideline[]         @relation("CoachGuidelineClient")
  created_recipes          Recipe[]                 @relation("RecipeCreator")
  saved_recipes            SavedRecipe[]
  list_items               ListItem[]
  // Phase 1A: 1:1 coach metadata. Only present for users with role=coach.
  // The relation stays optional so the existing student/owner rows do not
  // need a CoachProfile row (and the bootstrap script can backfill coaches
  // additively).
  coach_profile            CoachProfile?            @relation("CoachProfileUser")
  owners_created_profiles  CoachProfile[]           @relation("CoachProfileCreatedBy")

  // SaaS billing additions (1:1 with coach users; null for clients/owners).
  coach_subscription     CoachSubscription?
  invoices               Invoice[]
  payment_failures       PaymentFailure[]
  drafts_as_coach        MessageDraft[]       @relation("MessageDraftCoach")
  drafts_as_client       MessageDraft[]       @relation("MessageDraftClient")
  activity_events_actor  ActivityEvent[]      @relation("ActivityEventActor")
  activity_events_coach  ActivityEvent[]      @relation("ActivityEventCoach")
  activity_events_client ActivityEvent[]      @relation("ActivityEventClient")
  audit_logs_actor       AuditLog[]           @relation("AuditLogActor")
  audit_logs_target      AuditLog[]           @relation("AuditLogTarget")
  data_export_requests   DataExportRequest[]
  consents_as_client     ClientCoachConsent[] @relation("ConsentClient")
  consents_as_coach      ClientCoachConsent[] @relation("ConsentCoach")

  // Phase 1 PTM (Predictive Tracking Model). Append-only signal log,
  // outcome labels (taught by OWNERs/coaches), and append-only score
  // history. See `src/ptm/README.md` and `docs/ptm.md` for the doctrine.
  ptm_signals           ClientSignal[]
  ptm_outcomes_target   ClientOutcome[] @relation("PtmOutcomeTarget")
  ptm_outcomes_labelled ClientOutcome[] @relation("PtmOutcomeLabeller")
  ptm_predictions       PtmPrediction[]

  // Phase 6A/6B coach signals. Effectiveness scores (per coach, append-
  // only history) and red-flag alerts (per coach about a specific client).
  // Both relations stay optional — students/owners do not own rows here.
  coach_effectiveness_scores CoachEffectivenessScore[] @relation("CoachEffectivenessOwner")
  coach_alerts_as_coach      CoachAlert[]              @relation("CoachAlertCoach")
  coach_alerts_as_client     CoachAlert[]              @relation("CoachAlertClient")

  // Phase 6D — Coach Onboarding Wizard. 1:1 with users that have ever held
  // role='coach'. Auto-created by AdminService.promoteUser when a user is
  // promoted (gated by COACH_ONBOARDING_AUTO_START); subsequent promotes are
  // idempotent. Stays null for students/owners until/unless they're promoted.
  coach_onboarding_progress CoachOnboardingProgress? @relation("CoachOnboardingCoach")

  // Phase 7A — Day 1 Win Sequence. Set once on first win completion; never
  // cleared. Gates the Day1WinScreen in the mobile app: if non-null the screen
  // is permanently skipped on cold start. Null for all pre-existing users
  // (they skip the screen automatically because we treat null === not a new user
  // in the mobile gating logic by also checking created_at age).
  first_win_completed_at DateTime?

  @@index([coach_id])
  @@index([deletion_scheduled_at])
}

// Phase 1A: per-coach business + billing + branding metadata. The User
// table still holds `role` and the coach->client linkage; this table holds
// everything Healthie-style that does not belong on every user row.
//
// `invite_code` is the coach's shareable, URL-safe code (e.g. GP-A1B2C3).
// It mirrors InviteCode rows (which can have many per coach with
// expirations and per-code limits); CoachProfile.invite_code is the one
// "default" link a coach can hand out without bookkeeping. Backfill
// generates a unique value per coach.
//
// stripe_* and subscription_status are wired into Phase 2A; they are
// nullable here so this migration can ship before Stripe is provisioned.
model CoachProfile {
  id                         String              @id @default(uuid())
  user_id                    String              @unique
  user                       User                @relation("CoachProfileUser", fields: [user_id], references: [id])
  business_name              String?
  bio                        String?
  timezone                   String?
  branding_accent_color      String?
  branding_logo_url          String?
  invite_code                String              @unique
  stripe_customer_id         String?
  stripe_subscription_id     String?
  subscription_status        SubscriptionStatus?
  plan_tier                  String              @default("flat_300")
  current_period_end         DateTime?
  trial_end                  DateTime?
  ai_monthly_spend_cap_cents Int                 @default(5000)
  created_by_owner_id        String?
  created_by_owner           User?               @relation("CoachProfileCreatedBy", fields: [created_by_owner_id], references: [id])
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @updatedAt

  @@index([invite_code])
  @@index([subscription_status])
  @@index([created_by_owner_id])
}

// Coach SaaS subscription mirror. Stripe is source of truth; this is a
// denormalized projection so the coach console reads subscription state
// without touching Stripe directly. Complements CoachProfile.stripe_* fields
// with the longer-form mirror used by the v1 coach-console BFF.
model CoachSubscription {
  id                         String    @id @default(uuid())
  coach_id                   String    @unique
  coach                      User      @relation(fields: [coach_id], references: [id])
  stripe_customer_id         String?
  stripe_subscription_id     String?   @unique
  stripe_price_id            String?
  status                     String    @default("incomplete") // active | trialing | past_due | canceled | paused | incomplete | unpaid
  current_period_end         DateTime?
  trial_end                  DateTime?
  cancel_at_period_end       Boolean   @default(false)
  last_payment_failed_at     DateTime?
  failed_payments_this_month Int       @default(0)
  billing_email              String?
  card_last4                 String?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  @@index([status])
}

model Invoice {
  id                 String    @id @default(uuid())
  coach_id           String
  coach              User      @relation(fields: [coach_id], references: [id])
  stripe_invoice_id  String    @unique
  stripe_customer_id String?
  amount_paid_cents  Int       @default(0)
  amount_due_cents   Int       @default(0)
  currency           String    @default("usd")
  status             String    @default("open") // open | paid | void | uncollectible
  hosted_invoice_url String?
  invoice_pdf        String?
  period_start       DateTime?
  period_end         DateTime?
  paid_at            DateTime?
  created_at         DateTime  @default(now())

  @@index([coach_id, created_at])
}

model PaymentFailure {
  id                String   @id @default(uuid())
  coach_id          String
  coach             User     @relation(fields: [coach_id], references: [id])
  stripe_invoice_id String?
  stripe_event_id   String?
  amount_due_cents  Int      @default(0)
  reason            String?
  occurred_at       DateTime @default(now())

  @@index([coach_id, occurred_at])
}

// Idempotency table for Stripe webhook delivery. Stripe retries deliveries on
// timeouts, so we record every event id and short-circuit duplicates.
model StripeProcessedEvent {
  stripe_event_id String   @id
  type            String
  processed_at    DateTime @default(now())

  @@index([processed_at])
}

// Coach message draft. Idempotent on (coach_id, client_id) — a coach has one
// draft per thread; autosave overwrites in place.
model MessageDraft {
  id         String   @id @default(uuid())
  coach_id   String
  coach      User     @relation("MessageDraftCoach", fields: [coach_id], references: [id])
  client_id  String
  client     User     @relation("MessageDraftClient", fields: [client_id], references: [id])
  body       String
  snippet_id String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@unique([coach_id, client_id], name: "MessageDraft_coach_client_key")
  @@index([coach_id])
}

// Audit/activity event stream. Used by the coach console to render the recent
// activity feed and by future fan-out workers for push/email notifications.
// Schema follows the integration notes: actor, coach, client, type, summary,
// payload (jsonb).
model ActivityEvent {
  id         String   @id @default(uuid())
  actor_id   String?
  actor      User?    @relation("ActivityEventActor", fields: [actor_id], references: [id])
  actor_role String?
  coach_id   String?
  coach      User?    @relation("ActivityEventCoach", fields: [coach_id], references: [id])
  client_id  String?
  client     User?    @relation("ActivityEventClient", fields: [client_id], references: [id])
  type       String
  summary    String?
  payload    Json?
  created_at DateTime @default(now())

  @@index([coach_id, created_at])
  @@index([client_id, created_at])
  @@index([type, created_at])
}

model InviteCode {
  id         String    @id @default(uuid())
  code       String    @unique
  coach_id   String
  coach      User      @relation("CoachInviteCodes", fields: [coach_id], references: [id])
  created_at DateTime  @default(now())
  expires_at DateTime?
  max_uses   Int?
  used_count Int       @default(0)
  revoked    Boolean   @default(false)

  @@index([coach_id])
  @@index([code])
}

model UserProfile {
  id                     String            @id @default(uuid())
  user_id                String            @unique
  user                   User              @relation(fields: [user_id], references: [id])
  height_cm              Float?
  current_weight_lbs     Float?
  target_weight_lbs      Float?
  date_of_birth          DateTime?
  sex                    Sex               @default(prefer_not_to_say)
  activity_level         ActivityLevel     @default(moderate)
  goal_type              GoalType          @default(fat_loss)
  workout_experience     WorkoutExperience @default(beginner)
  has_gym_membership     Boolean           @default(false)
  preferred_snacks       String[]
  // Free-form so a future "low-FODMAP", "halal", etc. value does not require
  // a schema migration. The DTO restricts new writes to a curated list of
  // values; legacy reads stay valid even if the list grows.
  dietary_pattern        String?
  // Allergens / avoid-list. Empty array is the default — explicit "no
  // restrictions" rather than null so the AI can distinguish unset (don't
  // know) from confirmed-empty (no restrictions).
  dietary_restrictions   String[]
  // Self-reported weekly training cadence. Nullable so a freshly-onboarded
  // user without a value does not seed a misleading 0.
  workout_days_per_week  Int?
  // Granular equipment availability. `has_gym_membership` only answers
  // "gym vs not"; this lets the AI choose between barbell, dumbbell-only,
  // band, and pure-bodyweight programming. Free-form TEXT[] (not an enum)
  // so future tokens (e.g. "trx", "sandbag") do not require a migration.
  // The DTO restricts new writes to a curated vocabulary; legacy reads of
  // any token stay valid. Default `[]` so the AI can distinguish unset
  // (don't know) from confirmed-empty (no equipment beyond bodyweight).
  equipment_access       String[]
  macro_target_calories  Float?
  macro_target_protein_g Float?
  macro_target_carbs_g   Float?
  macro_target_fat_g     Float?
  avatar_url             String?
  bio                    String?
  weight_unit            String?           @default("lbs")
  meals_per_day          Int?
  water_goal_oz          Float?
  calorie_display        String?           @default("net")
  onboardingCompleted    Boolean?          @default(false)
  updated_at             DateTime          @updatedAt
}

model FoodItem {
  id                  String            @id @default(uuid())
  name                String
  brand_or_restaurant String?
  category            FoodCategory      @default(generic)
  serving_description String
  serving_size_grams  Float
  calories            Float
  protein_g           Float
  carbs_g             Float
  fat_g               Float
  saturated_fat_g     Float?
  mono_fat_g          Float?
  poly_fat_g          Float?
  fiber_g             Float?
  sugar_g             Float?
  sodium_mg           Float?
  tags                String[]
  search_aliases      String[]
  image_url           String?
  barcode             String?           @unique
  created_at          DateTime          @default(now())
  log_entries         LoggedFoodEntry[]
}

model LoggedFoodEntry {
  id                  String   @id @default(uuid())
  user_id             String
  user                User     @relation(fields: [user_id], references: [id])
  date                DateTime @db.Date
  meal_type           MealType
  food_item_id        String
  food_item           FoodItem @relation(fields: [food_item_id], references: [id])
  quantity_multiplier Float    @default(1.0)
  notes               String?
  logged_at           DateTime @default(now())

  // Hot path: LogService.getDaily + CoachService.getClientSummary both query by (user_id, date).
  @@index([user_id, date])
}

model WorkoutSession {
  id               String        @id @default(uuid())
  user_id          String
  user             User          @relation(fields: [user_id], references: [id])
  date             DateTime      @db.Date
  workout_name     String
  workout_type     String
  duration_minutes Int?
  intensity        Intensity     @default(moderate)
  notes            String?
  exercises        ExerciseSet[]
  created_at       DateTime      @default(now())

  // Hot path: coach alerts, community leaderboard, workout history all filter by (user_id, date).
  @@index([user_id, date])
}

model ExerciseSet {
  id             String         @id @default(uuid())
  workout_id     String
  workout        WorkoutSession @relation(fields: [workout_id], references: [id])
  exercise_name  String
  muscle_group   MuscleGroup
  sets_completed Int
  reps_per_set   Int[]
  weight_per_set Float[]
  rpe            Float?
  notes          String?
  video_url      String?
}

model WorkoutRoutine {
  id          String            @id @default(uuid())
  // creator_id now a proper FK — previously an orphan string; app code relied on it referencing User.id.
  creator_id  String
  creator     User              @relation("RoutineCreator", fields: [creator_id], references: [id])
  name        String
  description String?
  exercises   RoutineExercise[]
  is_template Boolean           @default(false)
  created_at  DateTime          @default(now())

  @@index([creator_id])
}

model RoutineExercise {
  id                   String         @id @default(uuid())
  routine_id           String
  routine              WorkoutRoutine @relation(fields: [routine_id], references: [id])
  exercise_name        String
  muscle_group         MuscleGroup
  default_sets         Int
  default_reps         Int
  default_rest_seconds Int            @default(90)
  video_url            String?
  order_index          Int
}

model FastingWindow {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  start_time DateTime
  end_time   DateTime?
  protocol   String?
  notes      String?
}

model WeightLog {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  date       DateTime @db.Date
  weight_lbs Float
  notes      String?
  logged_at  DateTime @default(now())

  // Hot path: weight charts query by (user_id, date desc).
  @@index([user_id, date])
}

model NotificationPreferences {
  id                     String  @id @default(uuid())
  user_id                String  @unique
  user                   User    @relation(fields: [user_id], references: [id])
  water_enabled          Boolean @default(true)
  workout_enabled        Boolean @default(true)
  eat_enabled            Boolean @default(true)
  mindset_enabled        Boolean @default(true)
  fasting_enabled        Boolean @default(true)
  daily_checkin_enabled  Boolean @default(true)
  weekly_summary_enabled Boolean @default(true)
  new_client_alerts      Boolean @default(true)
  quiet_hours_start      String  @default("22:00")
  quiet_hours_end        String  @default("06:00")
  timezone               String  @default("America/Los_Angeles")
}

model Habit {
  id           String     @id @default(uuid())
  user_id      String
  user         User       @relation(fields: [user_id], references: [id])
  name         String
  category     String     @default("custom")
  target_value Float?
  unit         String?
  logs         HabitLog[]
}

model HabitLog {
  id        String   @id @default(uuid())
  habit_id  String
  habit     Habit    @relation(fields: [habit_id], references: [id])
  date      DateTime @db.Date
  value     Float?
  completed Boolean  @default(false)
  logged_at DateTime @default(now())

  // Hot path: habit completion queries filter by (habit_id, date).
  @@index([habit_id, date])
}

model Lesson {
  id          String             @id @default(uuid())
  // coach_id now a proper FK to User.id (was orphan string).
  coach_id    String
  coach       User               @relation("LessonCoach", fields: [coach_id], references: [id])
  title       String
  description String?
  video_url   String?
  article_url String?
  tags        String[]
  goal_tags   GoalType[]
  order_index Int                @default(0)
  completions LessonCompletion[]
  created_at  DateTime           @default(now())

  @@index([coach_id])
}

model LessonCompletion {
  id           String   @id @default(uuid())
  lesson_id    String
  lesson       Lesson   @relation(fields: [lesson_id], references: [id])
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  completed_at DateTime @default(now())
}

// Daily/weekly check-ins logged by clients. Original mobile flow used `mood`,
// `energy`, `soreness`, and `type` (morning/evening). Tier-2 adds server-side
// upsert semantics and coach visibility, which required three additive columns:
//   - coach_id (nullable, indexed) — denormalized from the client's current
//     coach at creation time so historical check-ins stay attached to the
//     coach-of-record even if the client later switches coaches. Nullable
//     because a client may check in before being assigned to any coach.
//   - sleep_hours (nullable) — Float hours slept
//   - weight_kg   (nullable) — optional body-weight reading
// The pre-existing `mood`/`energy` columns were relaxed from NOT NULL to
// NULLABLE because the new Tier-2 POST /check-ins endpoint treats every
// subjective field as optional; `soreness`/`type` are retained for the
// existing mobile morning/evening flow and keep their prior NOT-NULL/defaults.
// A unique (client_id, date) constraint turns POST /check-ins into an idempotent
// daily upsert.
model CheckIn {
  id          String      @id @default(uuid())
  user_id     String
  user        User        @relation(fields: [user_id], references: [id])
  coach_id    String?
  date        DateTime    @db.Date
  mood        Int? // 1-5, optional
  energy      Int? // 1-5, optional
  soreness    Int // 1-5 — retained for existing mobile flow
  sleep_hours Float?
  weight_kg   Float?
  notes       String?
  type        CheckInType @default(morning)
  logged_at   DateTime    @default(now())

  @@unique([user_id, date], name: "CheckIn_user_id_date_key")
  // Hot path: daily check-in lookups by (user_id, date).
  @@index([user_id, date])
  @@index([coach_id, date])
}

// Server-persisted meal plans assigned by a coach to a specific client. Tier-2
// addition: previously the mobile coach UI wrote these to local SQLite only,
// so a coach's plans were per-device and never visible to the client. Schema is
// intentionally loose on `items` (Json) so the mobile UI can evolve item shape
// without a migration — validation enforces the expected fields at the DTO
// boundary (name required, everything else optional). `archived_at` gives a
// soft-delete so a plan history survives deletion.
model MealPlan {
  id          String    @id @default(uuid())
  coach_id    String
  coach       User      @relation("MealPlanCoach", fields: [coach_id], references: [id])
  client_id   String
  client      User      @relation("MealPlanClient", fields: [client_id], references: [id])
  title       String
  notes       String?
  items       Json
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime?

  @@index([coach_id])
  @@index([client_id])
  @@index([coach_id, client_id, created_at])
}

model WaterLog {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  amount_ml  Int
  logged_at  DateTime @default(now()) @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  // Hot path: water intake summaries filter by (user_id, logged_at).
  @@index([user_id, logged_at])
  @@map("water_logs")
}

// Direct messages between a coach and one of their clients. `coach_id` /
// `client_id` identify the thread participants (always the same two users for a
// given thread, regardless of direction); `sender_id` records who actually
// wrote the message. `read_at` is set when the *other* party marks the thread
// as read. The composite index on (coach_id, client_id, created_at) makes the
// paginated-thread query a single index seek.
model CoachMessage {
  id                 String    @id @default(uuid())
  coach_id           String
  coach              User      @relation("CoachMessagesAsCoach", fields: [coach_id], references: [id])
  client_id          String
  client             User      @relation("CoachMessagesAsClient", fields: [client_id], references: [id])
  sender_id          String
  sender             User      @relation("CoachMessagesSender", fields: [sender_id], references: [id])
  // Phase 6C: body becomes optional when a voice attachment is present. The
  // service still requires at least one of `body` or `voice_url` to be set so
  // we never persist an empty thread row. Doctrine: voice metadata
  // (duration_sec, size_bytes, content_type) is set server-side from the
  // accepted upload — never trusted from the client at send time.
  body               String?
  voice_url          String?
  voice_duration_sec Int?
  voice_size_bytes   Int?
  voice_content_type String?
  created_at         DateTime  @default(now())
  read_at            DateTime?

  @@index([coach_id])
  @@index([client_id])
  @@index([created_at])
  @@index([coach_id, client_id, created_at])
}

// In-app "nudge" notifications a coach sends to one of their clients — the
// real backing for the mobile coach's Send Notification button (previously
// written only to the coach's local SQLite). `read_at` is set when the client
// marks a single nudge as read. Index on client_id + created_at backs the
// newest-first listing; index on (client_id, read_at) backs the unread-count
// query.
model CoachNudge {
  id         String    @id @default(uuid())
  coach_id   String
  coach      User      @relation("CoachNudgesAsCoach", fields: [coach_id], references: [id])
  client_id  String
  client     User      @relation("CoachNudgesAsClient", fields: [client_id], references: [id])
  title      String
  body       String
  created_at DateTime  @default(now())
  read_at    DateTime?

  @@index([coach_id])
  @@index([client_id])
  @@index([created_at])
  @@index([client_id, created_at])
  @@index([client_id, read_at])
}

// Tier-2: Community wins are first-class posts authored by a client and
// scoped to the coach's roster feed. Previously `postWin` was a no-op stub;
// `getFeed` was returning Lessons (which also leaked per-client Lesson hacks
// used by the old guidelines pathway). `coach_id` is denormalized at write
// time from the author's current coach so a win stays attached to the right
// roster feed even if the client later switches coaches. Nullable because
// an unassigned client can still post a personal win — those simply do not
// appear in any coach's feed.
model CommunityWin {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation("CommunityWinAuthor", fields: [user_id], references: [id])
  coach_id    String?
  coach       User?    @relation("CommunityWinCoach", fields: [coach_id], references: [id])
  title       String
  description String
  visibility  String   @default("circle") // "circle" | "public"
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([coach_id, created_at])
}

// Tier-2: Per-(coach, client) guidelines as a first-class resource. Replaces
// the prior hack of writing a Lesson row tagged with `client:<id>`. The
// composite unique on (coach_id, client_id) makes write semantics an upsert:
// each coach gets exactly one guidelines doc per client. `updated_at`
// auto-updates on overwrite so callers can show "last updated" without an
// extra column.
model CoachGuideline {
  id         String   @id @default(uuid())
  coach_id   String
  coach      User     @relation("CoachGuidelineCoach", fields: [coach_id], references: [id])
  client_id  String
  client     User     @relation("CoachGuidelineClient", fields: [client_id], references: [id])
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([coach_id, client_id], name: "CoachGuideline_coach_client_key")
  @@index([client_id])
}

// ============================================================
// UX PSYCHOLOGY #4 — Preference-Controlled Personalization
// ============================================================

// Stores per-user UI/UX personalization preferences.
// homeModules: ordered array of visible home sections (default full set).
// notificationCadence: coarse cadence override (individual toggles still live in NotificationPreferences).
// motivationalTone: drives copy variants in HeroAction.
// units: metric vs imperial display.
// firstDayOfWeek: 0=Sun, 1=Mon, 6=Sat.
model UserPreferences {
  id                   String   @id @default(uuid())
  user_id              String   @unique
  user                 User     @relation(fields: [user_id], references: [id])
  home_modules         String[] @default(["hero", "milestone", "trustcues", "secondary"])
  notification_cadence String   @default("daily") // "daily" | "weekly" | "off"
  motivational_tone    String   @default("direct") // "gentle" | "direct" | "drill"
  units                String   @default("imperial") // "metric" | "imperial"
  first_day_of_week    Int      @default(1) // 0=Sun, 1=Mon, 6=Sat
  updated_at           DateTime @updatedAt

  @@index([user_id])
}

// ============================================================
// WAVE 3 MODELS
// ============================================================

// F12 — Recipes: coach-created recipe library with save/bookmark support.
// ingredients and instructions stored as String[] (mapped to jsonb in Postgres).
// tags drive filter chips in the mobile UI.
model Recipe {
  id            String        @id @default(uuid())
  title         String
  description   String?
  image_url     String?
  prep_time_min Int
  cook_time_min Int
  servings      Int
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  ingredients   String[]
  instructions  String[]
  tags          String[]
  is_public     Boolean       @default(true)
  created_by_id String
  created_by    User          @relation("RecipeCreator", fields: [created_by_id], references: [id])
  saved_by      SavedRecipe[]
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  @@index([created_by_id])
  @@index([is_public])
}

// Join table: user bookmarks/saves a recipe.
model SavedRecipe {
  id        String   @id @default(uuid())
  user_id   String
  user      User     @relation(fields: [user_id], references: [id])
  recipe_id String
  recipe    Recipe   @relation(fields: [recipe_id], references: [id])
  saved_at  DateTime @default(now())

  @@unique([user_id, recipe_id])
  @@index([user_id])
}

// F13 — Grocery & Shopping lists: per-user, per-type list items.
// listType enum: 'grocery' | 'shopping'.
// sourceRecipeId links items that were generated from a recipe (PrepGuide → grocery).

enum ListType {
  grocery
  shopping
}

model ListItem {
  id               String   @id @default(uuid())
  user_id          String
  user             User     @relation(fields: [user_id], references: [id])
  list_type        ListType
  name             String
  quantity         Float    @default(1)
  unit             String?
  is_checked       Boolean  @default(false)
  source_recipe_id String?
  added_at         DateTime @default(now())

  @@index([user_id, list_type])
}

// ============================================================
// COMPLIANCE / AUDIT
// ============================================================

// Append-only audit log for sensitive actions: role changes, account
// deletions, data exports, ownership transfers, coach impersonation, etc.
// Distinct from ActivityEvent (which feeds the coach-console activity
// feed and is mutable in spirit) — AuditLog is the immutable record used
// for compliance, incident review, and tenant-isolation audits. Rows are
// never updated or deleted; PII scrub on user delete sets actor/target
// FKs to NULL but preserves the row + actor_email_snapshot.
//
// `tenant_coach_id` is the coach whose tenant the action affected, so
// queries can scope the audit log to a single coach's roster without a
// join (e.g. owner reviews "all sensitive actions inside coach X's
// tenant"). Nullable for platform-level events that have no tenant
// (owner login, system jobs).
model AuditLog {
  id                   String   @id @default(uuid())
  action               String // e.g. "user.role_changed", "user.account_deletion_scheduled"
  actor_id             String?
  actor                User?    @relation("AuditLogActor", fields: [actor_id], references: [id], onDelete: SetNull)
  actor_role           String?
  actor_email_snapshot String? // preserved post-PII-scrub for forensic review
  target_user_id       String?
  target_user          User?    @relation("AuditLogTarget", fields: [target_user_id], references: [id], onDelete: SetNull)
  target_type          String? // "user" | "coach_profile" | "subscription" | …
  target_id            String? // free-form id of the target resource
  tenant_coach_id      String? // coach whose tenant the action touched, if any
  ip                   String?
  user_agent           String?
  metadata             Json?
  created_at           DateTime @default(now())

  @@index([action, created_at])
  @@index([actor_id, created_at])
  @@index([target_user_id, created_at])
  @@index([tenant_coach_id, created_at])
}

// GDPR / CCPA personal data export requests. A request is created when a
// user calls POST /users/me/data-export. Status starts at `pending`;
// when the request is fulfilled the row is updated with the rendered
// JSON payload (kept inline for now — file-storage upload is the next
// hardening step, but persisting the payload here is enough to honor
// the legal request). `payload` is nullable so the row can record the
// request even if export later fails, and so the payload can be purged
// after delivery.
model DataExportRequest {
  id           String    @id @default(uuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id])
  status       String    @default("pending") // pending | ready | delivered | failed
  payload      Json?
  error        String?
  requested_at DateTime  @default(now())
  fulfilled_at DateTime?
  delivered_at DateTime?

  @@index([user_id, requested_at])
  @@index([status])
}

// Consent layer v1: per-(client, coach, scope) record of whether the
// client has granted the coach access to a given slice of their data.
//
// Effective state is derived: granted iff `revoked_at IS NULL OR
// revoked_at < granted_at`. Both timestamps are kept (not a single
// boolean) so the row itself preserves the most recent transition; the
// canonical history is in AuditLog under consent.granted / consent.revoked.
//
// Scope strings live in the service layer (ConsentScope) and are not an
// enum at the SQL level — adding a new scope should not require a
// migration. Today's scopes:
//   fitness.profile, fitness.body_metrics, fitness.workouts,
//   fitness.food_macros, fitness.habits_progress,
//   finance.summary, finance.balances, finance.transaction_categories,
//   finance.transaction_line_items, finance.reports
model ClientCoachConsent {
  id         String    @id @default(uuid())
  client_id  String
  client     User      @relation("ConsentClient", fields: [client_id], references: [id], onDelete: Cascade)
  coach_id   String
  coach      User      @relation("ConsentCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  scope      String
  granted_at DateTime?
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt

  @@unique([client_id, coach_id, scope], name: "ClientCoachConsent_client_coach_scope_key")
  @@index([client_id])
  @@index([coach_id])
}

// ============================================================
// PTM — Predictive Tracking Model (Phase 1)
// ============================================================
//
// Doctrine (see src/ptm/README.md and docs/ptm.md):
//   * ClientSignal is APPEND-ONLY. Every behavioral signal (check-in
//     submitted, check-in missed, weight logged, message sent, workout
//     logged, meal logged, finance EOD, app open, coach note received,
//     etc.) is recorded with its raw value + metadata. We never UPDATE
//     a signal in place; corrections are written as a new row.
//   * ClientOutcome is the teaching set — the labels OWNERs and coaches
//     attach to a client's eventual journey (churned, completed_90day,
//     upgraded, referred, milestone_hit, dropped_off, renewed). Exactly
//     one row per (user_id) — re-labelling overwrites the prior row,
//     and AuditLog (`ptm.outcome_labelled`) keeps the canonical history.
//   * PtmPrediction is APPEND-ONLY. Every score recompute writes a new
//     row so the operator can see how a client's risk drifted over
//     time. `prediction_basis` distinguishes heuristic_v1 (Phase 1B)
//     from weighted_v2 (Phase 1D, activates at >= 20 outcomes) and
//     reserves model_v3 for a future ML pass.
//
// PTM scores are advisory-only. The mobile client never sees raw
// risk_score or factors — those are OWNER/COACH surfaces only.

// Enumerated signal types. Strings are kept Prisma-side as a Postgres
// enum so a typo at the call site fails at the DB boundary, not at
// dashboard read time. New signal types require a Prisma migration —
// that is by design: the heuristic and weighted services key off this
// enum and a silent typo would skew scores.
enum PtmSignalType {
  checkin_streak // a check-in was submitted; value = streak length on submit
  checkin_miss // a missed-check-in window crossed (3+ days, etc.); value = missed days
  weight_logged // weight log; value = delta vs prior log (kg) or 0 on first log
  weight_skipped // a 14-day no-log threshold crossed; value = days since last log
  message_sent // client → coach message; value = chars
  message_received // coach → client message; value = chars
  coach_note_received // coach guideline / nudge / draft delivered; value = 1
  workout_logged // workout session completed; value = total volume kg
  workout_skipped // 10-day no-workout threshold crossed; value = days since last
  meal_logged // logged food entry; value = calories
  meal_skipped // 7-day no-meal-log threshold crossed; value = days since last
  finance_eod // finance app end-of-day check-in; value = 1
  finance_milestone // finance milestone hit; value = 1
  app_open // first app-open of the day; value = seconds since last open
  consistency_low // 30-day consistency score dropped below 60%; value = consistency_pct
  streak_dropped // active streak dropped 50%+ from prior week; value = drop_pct
}

// Enumerated outcome labels. The teaching set is intentionally small;
// new outcomes require a migration so the weighted service does not
// silently see an unweighted label.
enum PtmOutcomeType {
  churned // client cancelled / disengaged before goal
  completed_90day // client completed the 90-day program
  upgraded // client upgraded plan / extended commitment
  referred // client referred a new client (a measurable success)
  milestone_hit // client hit a major personal milestone (goal weight, etc.)
  dropped_off // client did not formally cancel but stopped engaging
  renewed // client renewed for another cycle
}

// Enumerated prediction basis tags. Drives the version selector in the
// admin dashboard and lets the recompute job log which engine produced
// a row without parsing the factors blob.
enum PtmPredictionBasis {
  heuristic_v1 // Phase 1B: hand-tuned weights + protective factors
  weighted_v2 // Phase 1D: frequency-analysis weights, activates at >= 20 outcomes
  model_v3 // Reserved for a future ML pass; not used in Phase 1
}

// Append-only behavioral signal. One row per discrete event we observed.
// `metadata` is JSON for engine-specific context (delta direction, source
// module, etc.) — keep it small and never put PII there.
//
// All signal writes are fire-and-forget at the call site (see
// PtmService.recordSignal): a failure to insert MUST NOT bubble back
// into the user-facing request. The service catches and logs.
//
// Index on (user_id, signal_type, recorded_at) supports the heuristic
// service's bounded windows (last 7 / 14 / 30 days, by signal type).
model ClientSignal {
  id          String        @id @default(uuid())
  user_id     String
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  signal_type PtmSignalType
  value       Float         @default(0)
  metadata    Json?
  recorded_at DateTime      @default(now())

  @@index([user_id, signal_type, recorded_at])
  @@index([signal_type, recorded_at])
}

// One outcome label per client. `labelled_by_id` is the OWNER or COACH
// who taught the model what happened. `signal_snapshot` captures the
// last-30-days signal counts at label time so the weighted service
// (1D) can train against a frozen window even if older signals are
// later GDPR-scrubbed.
//
// Re-labelling: upsert by user_id, then write a fresh AuditLog row
// (`ptm.outcome_labelled`) carrying both old and new outcomes in
// `metadata`. Treat AuditLog as the canonical history.
model ClientOutcome {
  id              String         @id @default(uuid())
  user_id         String         @unique
  user            User           @relation("PtmOutcomeTarget", fields: [user_id], references: [id], onDelete: Cascade)
  outcome_type    PtmOutcomeType
  labelled_by_id  String?
  labelled_by     User?          @relation("PtmOutcomeLabeller", fields: [labelled_by_id], references: [id], onDelete: SetNull)
  labelled_at     DateTime       @default(now())
  notes           String?
  signal_snapshot Json?

  @@index([outcome_type, labelled_at])
  @@index([labelled_by_id, labelled_at])
}

// Append-only prediction history. `factors` is a JSON blob the heuristic
// (or weighted) service writes so the admin "why is this client red?"
// drawer can show the contributing signals. Mobile clients NEVER see
// this row — it is OWNER/COACH-only by guard.
//
// risk_score and success_score are independent dimensions in [0.0, 1.0].
// They are NOT 1 - x of each other; a high-engagement, high-risk-of-
// burnout client can carry high success and high risk simultaneously.
//
// Index on (user_id, computed_at desc) supports "latest score per user"
// without a window function: ORDER BY computed_at DESC LIMIT 1 with
// composite index hits the single-page seek path.
model PtmPrediction {
  id               String             @id @default(uuid())
  user_id          String
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  risk_score       Float
  success_score    Float
  prediction_basis PtmPredictionBasis
  factors          Json?
  computed_at      DateTime           @default(now())

  @@index([user_id, computed_at])
  @@index([prediction_basis, computed_at])
}

// Phase 6A — Coach Effectiveness Score. Computed nightly by the
// CoachEffectivenessScheduler (default 05:00 UTC, one hour after the
// PTM recompute). APPEND-ONLY: every run inserts a fresh row so the
// admin console can chart drift over time. The latest row is read by
// ORDER BY computed_at DESC LIMIT 1; the composite index supports it.
//
// `factors` is a JSON blob containing each component's contribution
// (completion, risk_delta, retention, engagement) with both the raw
// observed value and the weighted contribution. The admin "why" drawer
// renders straight from this blob.
//
// Visible to OWNER only — coaches do not see their own score (avoids
// gaming). The /admin/coach-effectiveness endpoints are RolesGuard'd.
model CoachEffectivenessScore {
  id          String   @id @default(uuid())
  coach_id    String
  coach       User     @relation("CoachEffectivenessOwner", fields: [coach_id], references: [id], onDelete: Cascade)
  score       Float
  bucket      String // 'developing' | 'consistent' | 'high-performer'
  factors     Json?
  basis       String   @default("v1")
  computed_at DateTime @default(now())

  @@index([coach_id, computed_at])
  @@index([computed_at])
}

// Phase 6B — Proactive Red Flag Alert. Created by the PTM recompute
// hook when a client transitions green/amber → red, by the consecutive-
// miss detector, or by future signal observers. Coaches read their own
// alerts; OWNER sees aggregated.
//
// Dedup window: CoachAlertsService.createAlert short-circuits when an
// unacknowledged alert with the same (coach_id, client_id, alert_type)
// exists within the last 24h, so a flapping signal does not produce a
// notification storm.
//
// Index on (coach_id, created_at desc) supports the coach inbox view;
// (coach_id, acknowledged_at) supports the "unread only" filter.
model CoachAlert {
  id              String    @id @default(uuid())
  coach_id        String
  coach           User      @relation("CoachAlertCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  client_id       String
  client          User      @relation("CoachAlertClient", fields: [client_id], references: [id], onDelete: Cascade)
  alert_type      String // 'risk_red_transition' | 'consecutive_misses' | 'streak_dropped' | 'finance_eod_gap'
  severity        String    @default("warning") // 'info' | 'warning' | 'critical'
  message         String
  payload         Json?
  created_at      DateTime  @default(now())
  acknowledged_at DateTime?

  @@index([coach_id, created_at])
  @@index([coach_id, acknowledged_at])
  @@index([client_id, alert_type, created_at])
}

// Phase 6D — Coach Onboarding Wizard. Tracks where a newly promoted coach
// is in the 6-step setup flow:
//   1. Profile basics (business_name, bio, timezone)
//   2. Default invite code shown + copy reminder
//   3. Send first invite (action logged here; the actual invite send is a
//      separate API)
//   4. Create first message draft template
//   5. Set coach guideline preferences
//   6. Confirm completion
//
// Doctrine:
//   * 1:1 with the coach User row (`coach_id @unique`). Re-promoting the same
//     user is idempotent — the existing row is reused.
//   * `current_step` is enforced server-side: advanceStep(n) requires
//     n === current_step + 1 (or === current_step for resume on the same
//     step). Out-of-order writes return 400.
//   * `step_data` is a per-step JSON map keyed by step number. We never UPDATE
//     a key in place at completion; we keep the most recent value the coach
//     submitted for that step so the wizard can be resumed mid-flow.
//   * `completed_at` is set once and the row freezes — POST /steps/:n returns
//     409 after that.
model CoachOnboardingProgress {
  id           String    @id @default(uuid())
  coach_id     String    @unique
  coach        User      @relation("CoachOnboardingCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  started_at   DateTime  @default(now())
  completed_at DateTime?
  current_step Int       @default(1)
  step_data    Json?

  @@index([completed_at])
}

// =============================================================================
// Phase 3 — 40-point Diagnostic + AI roadmap
// =============================================================================
//
// Public lead-capture funnel: an anonymous visitor answers 40 Likert-scale
// questions (Income / Body / Lifestyle), the service computes per-section
// scores + an overall bucket, and an async AI call generates a personalized
// roadmap that lands on the same submission row.
//
// Design notes:
//   * `email` is captured for ALL submissions, including signed-up users — it
//     is the join key for "claim this lead later" and for the GDPR scrub. It
//     is NEVER returned by GET /diagnostic/questions and never echoed back in
//     /diagnostic/:id/result without authentication of the submitter.
//   * `user_id` is null until the lead signs up; on signup the existing
//     onboarding flow upserts by email and back-fills the column. No FK
//     cascade — if a user is deleted we keep the lead row so churn analytics
//     can still attribute it to a coach.
//   * `answers` and `scores` are JSON blobs. The shape is owned by the
//     diagnostic service; consumers must read through the typed DTOs in
//     src/diagnostic/diagnostic.dto.ts rather than touching `Json` directly.
//   * AiRoadmap is a separate row (1:1 with submission, but optional) so
//     a failed AI generation can leave the submission valid and the user
//     can hit a "retry" button without we re-write the scores.
//   * Append-only by convention. Re-submitting writes a fresh
//     DiagnosticSubmission (and a fresh AiRoadmap when the retry succeeds);
//     we never UPDATE in place. This keeps the lead history honest.
model DiagnosticSubmission {
  id           String   @id @default(uuid())
  email        String
  name         String?
  age          Int?
  // Free-form source tag. Examples: 'web', 'mobile_signup', 'invite_link',
  // 'lead_magnet'. Do not over-validate — operators add new sources via
  // marketing UTM links, and we do not want to ship a migration for each.
  source       String?
  // Full {question_id, answer} array, validated upstream against the seed
  // catalog. Stored verbatim so we can re-score historical submissions if
  // the bucket boundaries ever move.
  answers      Json
  // { income: 0-100, body: 0-100, lifestyle: 0-100, overall: 0-200 }
  scores       Json
  // { income: 'stuck'|'moving'|'compounding', body: ..., lifestyle: ..., overall: 'stuck'|'moving'|'compounding' }
  bucket       Json
  submitted_at DateTime @default(now())
  // Nullable FK to User. Anonymous lead → null. Signed-up lead → the user
  // we upserted by email. NO cascade so deleting a user does not delete
  // historical leads (we want the funnel attribution to survive).
  user_id      String?
  ip           String?
  user_agent   String?

  roadmap AiRoadmap?

  @@index([email, submitted_at])
  @@index([user_id])
  @@index([submitted_at])
}

// One AI roadmap per submission. Generation is async and fire-and-forget:
// the controller returns the submission_id immediately, the service kicks
// off the AI call in the background, and the row is upserted on completion.
// On failure the row is still written with payload=null and status='failed'
// so the GET endpoint can serve a deterministic "retry" state.
//
// `prompt_version` lets us A/B prompts without ambiguity in audit. Increment
// when the prompt template changes; the doctrine spec pins the canonical
// opening line so a silent edit fails CI.
model AiRoadmap {
  id             String               @id @default(uuid())
  submission_id  String               @unique
  submission     DiagnosticSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  generated_at   DateTime             @default(now())
  prompt_version String               @default("v1")
  status         String               @default("ready")
  // The structured AI response. Shape: { summary, top_strength,
  // biggest_gap, ninety_day_focus, raw_text }. Null when status='failed'.
  payload        Json?
  tokens_used    Int?
  model          String               @default("sonar-pro")
  error_message  String?

  @@index([submission_id])
}

// ─── Phase 4: Build Week (7-day guided coaching arc) ───────────────────────
//
// Three tables:
//   1. BuildWeekDay            — global day catalog (rows 1..7), seeded from
//                                prisma/seed-build-week.json by the migration.
//                                Read-only at runtime; new copy = new
//                                migration.
//   2. BuildWeekEnrollment     — one row per user. `current_day` advances as
//                                the user completes each day. Re-enrolling
//                                resets the same row in place (the unique
//                                constraint on user_id keeps history
//                                collapsed; the AuditLog is the durable
//                                history of state transitions).
//   3. BuildWeekDayCompletion  — one row per (enrollment, day_number). Holds
//                                the user's responses to the day's
//                                prompt_questions and their
//                                expected_artifact text.
//
// Tenancy:
//   * Catalog rows are global — no tenant scoping.
//   * Enrollment + completion rows belong to the user (FK to User.id).
//   * Coach reads go through the coach-build-week controller, which asserts
//     the target client belongs to the requesting coach (CoachGuard +
//     coach_id check). Owners bypass tenancy via the OWNER bypass on
//     CoachGuard — see src/auth/coach.guard.ts.
//
// PTM hook:
//   * Day 7 completion fires a `finance_milestone` PTM signal with
//     metadata { source: 'build_week', day_number: 7, total_days: 7 }.
//   * Days 1–6 do NOT emit PTM signals — the catalogue tracks itself; we
//     only emit when meaning matches a doctrine signal type.
model BuildWeekDay {
  id                String @id @default(uuid())
  day_number        Int    @unique
  title             String
  focus_area        String
  narrative         String
  prompt_questions  Json
  action_items      Json
  expected_artifact String

  @@index([day_number])
}

model BuildWeekEnrollment {
  id           String    @id @default(uuid())
  user_id      String    @unique
  started_at   DateTime  @default(now())
  current_day  Int       @default(1)
  status       String    @default("active")
  completed_at DateTime?

  completions BuildWeekDayCompletion[]

  @@index([status])
}

model BuildWeekDayCompletion {
  id            String              @id @default(uuid())
  enrollment_id String
  enrollment    BuildWeekEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  day_number    Int
  completed_at  DateTime            @default(now())
  responses     Json
  artifact_text String?

  @@unique([enrollment_id, day_number], name: "BuildWeekDayCompletion_enrollment_day_key")
  @@index([day_number])
}
