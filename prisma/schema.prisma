// The Growth Project — Prisma Schema
// PostgreSQL with Supabase Auth integration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Phase 1A platform pivot: add the `owner` tier above `coach` so the
// platform can be operated as Healthie-style OWNER -> COACH -> CLIENT
// without breaking existing rows. Existing rows stay valid (`coach`,
// `student`); the new `owner` value is opt-in and only set by the
// bootstrap-owners script or the OWNER promote endpoint.
enum Role {
  coach
  student
  owner
}

// Phase 1A: subscription state for a coach's $300/mo seat. Stored as
// strings on CoachProfile so the column reads naturally in raw SQL and
// admin tooling without a Prisma-only enum mapping.
enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  paused
}

enum Sex {
  male
  female
  prefer_not_to_say
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum GoalType {
  fat_loss
  muscle_gain
  maintenance
  performance
}

enum WorkoutExperience {
  beginner
  intermediate
  advanced
}

enum FoodCategory {
  generic
  packaged
  fast_food
  restaurant
  recipe_ingredient
}

// Canonical basis for the macro columns on FoodItem.
//   PER_100G    — calories/protein/carbs/fat are expressed per 100g of the food.
//                 This is the basis USDA FDC and OpenFoodFacts return; the
//                 backend stores them verbatim. Mobile multiplies by
//                 (grams_consumed / 100) at log time.
//   PER_SERVING — macros are expressed per one `serving_size_grams` unit.
//                 Reserved for legacy / hand-curated entries where per-100g
//                 data is unavailable. New rows default to PER_100G.
// See README "Food logger — canonical nutrient basis" for the contract.
enum NutrientBasis {
  PER_100G
  PER_SERVING
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum Intensity {
  light
  moderate
  hard
  max
}

enum MuscleGroup {
  chest
  back
  legs
  shoulders
  arms
  core
  cardio
  full_body
}

enum CheckInType {
  morning
  evening
}

// CoachPracticeType — Stage-3 cross-pillar federation gate.
//
// What kind of practice the coach runs across the TGP product family
// (Body / Wealth). The cross-pillar surface in `/api/coach/cross-pillar/*`
// is gated on `both`; coaches with `fitness_only` or `finance_only` see
// their existing single-product coach console unchanged. `null` on the
// User row means the coach has not yet selected — the cross-pillar
// surface returns `403 PRACTICE_NOT_SELECTED` and the mobile app routes
// them through the practice-selection flow.
enum CoachPracticeType {
  fitness_only
  finance_only
  both
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                        String             @id @default(uuid())
  supabase_id               String             @unique
  email                     String             @unique
  name                      String
  phone                     String?
  role                      Role               @default(student)
  // coach_id now a proper self-relation FK instead of an orphan string column.
  // Preserves prior behavior — still nullable, still points at another User.id.
  coach_id                  String?
  coach                     User?              @relation("CoachToStudents", fields: [coach_id], references: [id])
  students                  User[]             @relation("CoachToStudents")
  // Stage-3 cross-pillar federation. Only meaningful when `role = coach`
  // or `owner`; ignored for students. Null = not yet selected.
  coach_practice_type       CoachPracticeType?
  created_at                DateTime           @default(now())
  archived_at               DateTime?
  // GDPR delete-account flow. Two-phase: deletion_scheduled_at marks the
  // grace-period start (account locked but recoverable); deleted_at marks
  // the irreversible PII scrub. Existing rows stay valid (both null).
  deletion_scheduled_at     DateTime?
  deleted_at                DateTime?
  // Phase 10 — explicit user/admin-initiated right-to-erasure flow.
  // deletion_token_hash/expires_at drive the confirmation link email;
  // deletion_requested_at/confirmed_at drive the state machine.
  // Columns added by migration 20260507100000_add_gdpr_deletion_flow.
  deletion_token_hash       String?
  deletion_token_expires_at DateTime?
  deletion_requested_at     DateTime?
  deletion_confirmed_at     DateTime?

  profile                  UserProfile?
  logged_entries           LoggedFoodEntry[]
  workouts                 WorkoutSession[]
  fasting_windows          FastingWindow[]
  weight_logs              WeightLog[]
  notification_prefs       NotificationPreferences?
  preferences              UserPreferences?
  habits                   Habit[]
  lesson_completions       LessonCompletion[]
  check_ins                CheckIn[]
  water_logs               WaterLog[]
  created_routines         WorkoutRoutine[]         @relation("RoutineCreator")
  coached_lessons          Lesson[]                 @relation("LessonCoach")
  invite_codes             InviteCode[]             @relation("CoachInviteCodes")
  coach_messages_as_coach  CoachMessage[]           @relation("CoachMessagesAsCoach")
  coach_messages_as_client CoachMessage[]           @relation("CoachMessagesAsClient")
  coach_messages_sent      CoachMessage[]           @relation("CoachMessagesSender")
  coach_nudges_as_coach    CoachNudge[]             @relation("CoachNudgesAsCoach")
  coach_nudges_as_client   CoachNudge[]             @relation("CoachNudgesAsClient")
  meal_plans_as_coach      MealPlan[]               @relation("MealPlanCoach")
  meal_plans_as_client     MealPlan[]               @relation("MealPlanClient")
  community_wins           CommunityWin[]           @relation("CommunityWinAuthor")
  community_wins_as_coach  CommunityWin[]           @relation("CommunityWinCoach")
  guidelines_as_coach      CoachGuideline[]         @relation("CoachGuidelineCoach")
  guidelines_as_client     CoachGuideline[]         @relation("CoachGuidelineClient")
  created_recipes          Recipe[]                 @relation("RecipeCreator")
  saved_recipes            SavedRecipe[]
  list_items               ListItem[]
  // Phase 1A: 1:1 coach metadata. Only present for users with role=coach.
  // The relation stays optional so the existing student/owner rows do not
  // need a CoachProfile row (and the bootstrap script can backfill coaches
  // additively).
  coach_profile            CoachProfile?            @relation("CoachProfileUser")
  owners_created_profiles  CoachProfile[]           @relation("CoachProfileCreatedBy")

  // SaaS billing additions (1:1 with coach users; null for clients/owners).
  coach_subscription         CoachSubscription?
  invoices                   Invoice[]
  payment_failures           PaymentFailure[]
  // Phase 1 Connect — 1:1 Stripe Express account per coach. Null until the
  // coach kicks off Connect onboarding via POST /v1/connect/accounts/create.
  connect_account            ConnectAccount?
  drafts_as_coach            MessageDraft[]       @relation("MessageDraftCoach")
  drafts_as_client           MessageDraft[]       @relation("MessageDraftClient")
  activity_events_actor      ActivityEvent[]      @relation("ActivityEventActor")
  activity_events_coach      ActivityEvent[]      @relation("ActivityEventCoach")
  activity_events_client     ActivityEvent[]      @relation("ActivityEventClient")
  audit_logs_actor           AuditLog[]           @relation("AuditLogActor")
  audit_logs_target          AuditLog[]           @relation("AuditLogTarget")
  data_export_requests       DataExportRequest[]
  consents_as_client         ClientCoachConsent[] @relation("ConsentClient")
  consents_as_coach          ClientCoachConsent[] @relation("ConsentCoach")
  bloodwork_panels_as_client BloodworkPanel[]     @relation("BloodworkPanelClient")
  bloodwork_panels_as_coach  BloodworkPanel[]     @relation("BloodworkPanelCoach")
  bloodwork_panels_reviewed  BloodworkPanel[]     @relation("BloodworkPanelReviewer")

  // Phase 1 PTM (Predictive Tracking Model). Append-only signal log,
  // outcome labels (taught by OWNERs/coaches), and append-only score
  // history. See `src/ptm/README.md` and `docs/ptm.md` for the doctrine.
  ptm_signals           ClientSignal[]
  ptm_outcomes_target   ClientOutcome[] @relation("PtmOutcomeTarget")
  ptm_outcomes_labelled ClientOutcome[] @relation("PtmOutcomeLabeller")
  ptm_predictions       PtmPrediction[]

  // Phase 6A/6B coach signals. Effectiveness scores (per coach, append-
  // only history) and red-flag alerts (per coach about a specific client).
  // Both relations stay optional — students/owners do not own rows here.
  coach_effectiveness_scores CoachEffectivenessScore[] @relation("CoachEffectivenessOwner")
  coach_alerts_as_coach      CoachAlert[]              @relation("CoachAlertCoach")
  coach_alerts_as_client     CoachAlert[]              @relation("CoachAlertClient")

  // Phase 6D — Coach Onboarding Wizard. 1:1 with users that have ever held
  // role='coach'. Auto-created by AdminService.promoteUser when a user is
  // promoted (gated by COACH_ONBOARDING_AUTO_START); subsequent promotes are
  // idempotent. Stays null for students/owners until/unless they're promoted.
  coach_onboarding_progress CoachOnboardingProgress? @relation("CoachOnboardingCoach")

  // Phase 7A — Day 1 Win Sequence. Set once on first win completion; never
  // cleared. Gates the Day1WinScreen in the mobile app: if non-null the screen
  // is permanently skipped on cold start. Null for all pre-existing users
  // (they skip the screen automatically because we treat null === not a new user
  // in the mobile gating logic by also checking created_at age).
  first_win_completed_at DateTime?

  // Phase 7C — Peer Leaderboard opt-in fields.
  // show_on_leaderboard defaults to false — explicit opt-in required.
  // leaderboard_display_name is nullable; if null, the service derives
  // "{firstName} {lastInitial}." from the single `name` field at read time.
  // NEVER surfaces raw weight, body-fat, or finance data on the leaderboard.
  show_on_leaderboard      Boolean @default(false)
  leaderboard_display_name String?

  // Phase 9 — Notification Center + Digest
  // notifications receives all inbox rows; digest_logs tracks sent digest windows.
  notifications              Notification[]
  digest_logs                NotificationDigestLog[]
  notification_delivery_logs NotificationDeliveryLog[]

  // Sprint B — Workout Builder relations.
  workout_plans_as_coach        WorkoutPlan[]             @relation("CoachWorkoutPlans")
  workout_assignments_as_client ClientWorkoutAssignment[] @relation("ClientWorkoutAssignments")
  workout_assignments_as_coach  ClientWorkoutAssignment[] @relation("CoachWorkoutAssignments")

  // Team Mode — head-coach <-> sub-coach assignments and audit events.
  // A coach may appear on either side (head coach in one team, sub-coach
  // in another). The capped many-to-many constraint (sub-coach assigned
  // under at most 2 head coaches) is enforced both by a service-layer
  // guard and a partial unique index added in the team-mode migration.
  sub_coach_assignments_as_head TeamSubCoachAssignment[] @relation("TeamSubCoachAssignmentHead")
  sub_coach_assignments_as_sub  TeamSubCoachAssignment[] @relation("TeamSubCoachAssignmentSub")
  team_audit_events_as_actor    TeamAuditEvent[]         @relation("TeamAuditEventActor")
  team_audit_events_as_target   TeamAuditEvent[]         @relation("TeamAuditEventTarget")
  invite_codes_invited_by       InviteCode[]             @relation("InviteCodeInvitedBy")

  // Sprint B — Macro targets, real meal plans, holistic insights cache.
  macro_targets_as_client          MacroTarget[]             @relation("MacroTargetClient")
  macro_targets_as_coach           MacroTarget[]             @relation("MacroTargetCoach")
  meal_templates_as_coach          MealTemplate[]            @relation("MealTemplateCoach")
  daily_meal_plans_as_coach        DailyMealPlan[]           @relation("DailyMealPlanCoach")
  daily_meal_assignments_as_client DailyMealPlanAssignment[] @relation("DailyMealPlanAssignmentClient")
  daily_meal_assignments_as_coach  DailyMealPlanAssignment[] @relation("DailyMealPlanAssignmentCoach")
  holistic_insights_caches         HolisticInsightCache[]
  // AI gateway: requester / subject of an AI call, and approver / drafter of
  // a human-approval-gated AI action. All optional; rows are SetNull on
  // user delete so audit history survives PII scrub.
  ai_requests_as_requester         AiRequestAudit[]          @relation("AiRequestRequester")
  ai_requests_as_subject           AiRequestAudit[]          @relation("AiRequestSubject")
  ai_drafts_authored               AiActionDraft[]           @relation("AiDraftRequester")
  ai_drafts_decided                AiActionDraft[]           @relation("AiDraftDecidedBy")
  // Coach AI v1 — generation drafts (workout / meal plan / insight) and
  // per-call cost log. Both relations are SetNull-on-delete so the cost
  // history and approved drafts outlive a deleted user account.
  coach_ai_drafts_as_coach   AIDraft[]   @relation("AIDraftCoach")
  coach_ai_drafts_as_client  AIDraft[]   @relation("AIDraftClient")
  ai_call_logs_as_coach      AICallLog[] @relation("AICallLogCoach")
  ai_call_logs_as_client     AICallLog[] @relation("AICallLogClient")

  // Concierge scheduling (PR #142). Back-relations only; FKs live on
  // the scheduling-side rows. Coach and client both read from User;
  // the relation name disambiguates.
  coach_session_types          SessionType[]               @relation("SessionTypeCoach")
  coach_availability           CoachAvailability[]         @relation("CoachAvailability")
  coach_availability_overrides CoachAvailabilityOverride[] @relation("CoachAvailabilityOverrideCoach")
  sessions_as_coach            CoachingSession[]           @relation("CoachingSessionCoach")
  sessions_as_client           CoachingSession[]           @relation("CoachingSessionClient")
  session_participations       SessionParticipant[]        @relation("SessionParticipantUser")
  calendar_connections         CalendarConnection[]        @relation("CalendarConnectionUser")

  @@index([coach_id])
  @@index([deletion_scheduled_at])
}

// Phase 1A: per-coach business + billing + branding metadata. The User
// table still holds `role` and the coach->client linkage; this table holds
// everything Healthie-style that does not belong on every user row.
//
// `invite_code` is the coach's shareable, URL-safe code (e.g. GP-A1B2C3).
// It mirrors InviteCode rows (which can have many per coach with
// expirations and per-code limits); CoachProfile.invite_code is the one
// "default" link a coach can hand out without bookkeeping. Backfill
// generates a unique value per coach.
//
// stripe_* and subscription_status are wired into Phase 2A; they are
// nullable here so this migration can ship before Stripe is provisioned.
model CoachProfile {
  id                         String              @id @default(uuid())
  user_id                    String              @unique
  user                       User                @relation("CoachProfileUser", fields: [user_id], references: [id])
  business_name              String?
  bio                        String?
  timezone                   String?
  branding_accent_color      String?
  branding_logo_url          String?
  invite_code                String              @unique
  stripe_customer_id         String?
  stripe_subscription_id     String?
  subscription_status        SubscriptionStatus?
  plan_tier                  String              @default("flat_300")
  current_period_end         DateTime?
  trial_end                  DateTime?
  ai_monthly_spend_cap_cents Int                 @default(5000)
  created_by_owner_id        String?
  created_by_owner           User?               @relation("CoachProfileCreatedBy", fields: [created_by_owner_id], references: [id])
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @updatedAt

  @@index([invite_code])
  @@index([subscription_status])
  @@index([created_by_owner_id])
}

// Coach SaaS subscription mirror. Stripe is source of truth; this is a
// denormalized projection so the coach console reads subscription state
// without touching Stripe directly. Complements CoachProfile.stripe_* fields
// with the longer-form mirror used by the v1 coach-console BFF.
model CoachSubscription {
  id                         String    @id @default(uuid())
  coach_id                   String    @unique
  coach                      User      @relation(fields: [coach_id], references: [id])
  stripe_customer_id         String?
  stripe_subscription_id     String?   @unique
  stripe_price_id            String?
  status                     String    @default("incomplete") // active | trialing | past_due | canceled | paused | incomplete | unpaid
  current_period_end         DateTime?
  trial_end                  DateTime?
  cancel_at_period_end       Boolean   @default(false)
  last_payment_failed_at     DateTime?
  failed_payments_this_month Int       @default(0)
  billing_email              String?
  card_last4                 String?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  @@index([status])
}

model Invoice {
  id                 String    @id @default(uuid())
  coach_id           String
  coach              User      @relation(fields: [coach_id], references: [id])
  stripe_invoice_id  String    @unique
  stripe_customer_id String?
  amount_paid_cents  Int       @default(0)
  amount_due_cents   Int       @default(0)
  currency           String    @default("usd")
  status             String    @default("open") // open | paid | void | uncollectible
  hosted_invoice_url String?
  invoice_pdf        String?
  period_start       DateTime?
  period_end         DateTime?
  paid_at            DateTime?
  created_at         DateTime  @default(now())

  @@index([coach_id, created_at])
}

model PaymentFailure {
  id                String   @id @default(uuid())
  coach_id          String
  coach             User     @relation(fields: [coach_id], references: [id])
  stripe_invoice_id String?
  stripe_event_id   String?
  amount_due_cents  Int      @default(0)
  reason            String?
  occurred_at       DateTime @default(now())

  @@index([coach_id, occurred_at])
}

// Idempotency table for Stripe webhook delivery. Stripe retries deliveries on
// timeouts, so we record every event id and short-circuit duplicates.
model StripeProcessedEvent {
  stripe_event_id String   @id
  type            String
  processed_at    DateTime @default(now())

  @@index([processed_at])
}

// Phase 1 Connect — Stripe Express account per coach. The coach goes through
// Stripe-hosted onboarding via accountLinks; we mirror the resulting account
// state from webhooks (`account.updated`, `capability.updated`,
// `account.application.deauthorized`). is_fully_onboarded is derived at read
// time from (charges_enabled && payouts_enabled && details_submitted).
//
// requirements_due stores Stripe's `requirements` object verbatim for
// diagnostics — never used to make business decisions, only surfaced so the
// coach/owner knows what is still owed.
model ConnectAccount {
  id                String    @id @default(uuid())
  coach_user_id     String    @unique
  coach             User      @relation(fields: [coach_user_id], references: [id])
  stripe_account_id String    @unique
  country           String    @default("US")
  default_currency  String    @default("usd")
  charges_enabled   Boolean   @default(false)
  payouts_enabled   Boolean   @default(false)
  details_submitted Boolean   @default(false)
  requirements_due  Json?
  disabled_reason   String?
  deauthorized_at   DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([stripe_account_id])
}

// Coach message draft. Idempotent on (coach_id, client_id) — a coach has one
// draft per thread; autosave overwrites in place.
model MessageDraft {
  id         String   @id @default(uuid())
  coach_id   String
  coach      User     @relation("MessageDraftCoach", fields: [coach_id], references: [id])
  client_id  String
  client     User     @relation("MessageDraftClient", fields: [client_id], references: [id])
  body       String
  snippet_id String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@unique([coach_id, client_id], name: "MessageDraft_coach_client_key")
  @@index([coach_id])
}

// Audit/activity event stream. Used by the coach console to render the recent
// activity feed and by future fan-out workers for push/email notifications.
// Schema follows the integration notes: actor, coach, client, type, summary,
// payload (jsonb).
model ActivityEvent {
  id         String   @id @default(uuid())
  actor_id   String?
  actor      User?    @relation("ActivityEventActor", fields: [actor_id], references: [id])
  actor_role String?
  coach_id   String?
  coach      User?    @relation("ActivityEventCoach", fields: [coach_id], references: [id])
  client_id  String?
  client     User?    @relation("ActivityEventClient", fields: [client_id], references: [id])
  type       String
  summary    String?
  payload    Json?
  created_at DateTime @default(now())

  @@index([coach_id, created_at])
  @@index([client_id, created_at])
  @@index([type, created_at])
}

model InviteCode {
  id                 String    @id @default(uuid())
  code               String    @unique
  coach_id           String
  coach              User      @relation("CoachInviteCodes", fields: [coach_id], references: [id])
  // Team Mode — sub-coach attribution. When a sub-coach creates an invite
  // their user_id lands here while coach_id remains the head coach who
  // owns the team. Null on legacy rows where the head coach issued the
  // invite directly. The audit feed reads this to show "Invited by sub-
  // coach <name>" without joining a separate ledger.
  invited_by_user_id String?
  invited_by         User?     @relation("InviteCodeInvitedBy", fields: [invited_by_user_id], references: [id])
  created_at         DateTime  @default(now())
  expires_at         DateTime?
  max_uses           Int?
  used_count         Int       @default(0)
  revoked            Boolean   @default(false)

  @@index([coach_id])
  @@index([code])
  @@index([invited_by_user_id])
}

model UserProfile {
  id                     String            @id @default(uuid())
  user_id                String            @unique
  user                   User              @relation(fields: [user_id], references: [id])
  height_cm              Float?
  current_weight_lbs     Float?
  target_weight_lbs      Float?
  date_of_birth          DateTime?
  sex                    Sex               @default(prefer_not_to_say)
  activity_level         ActivityLevel     @default(moderate)
  goal_type              GoalType          @default(fat_loss)
  workout_experience     WorkoutExperience @default(beginner)
  has_gym_membership     Boolean           @default(false)
  preferred_snacks       String[]
  // Free-form so a future "low-FODMAP", "halal", etc. value does not require
  // a schema migration. The DTO restricts new writes to a curated list of
  // values; legacy reads stay valid even if the list grows.
  dietary_pattern        String?
  // Allergens / avoid-list. Empty array is the default — explicit "no
  // restrictions" rather than null so the AI can distinguish unset (don't
  // know) from confirmed-empty (no restrictions).
  dietary_restrictions   String[]
  // Self-reported weekly training cadence. Nullable so a freshly-onboarded
  // user without a value does not seed a misleading 0.
  workout_days_per_week  Int?
  // Granular equipment availability. `has_gym_membership` only answers
  // "gym vs not"; this lets the AI choose between barbell, dumbbell-only,
  // band, and pure-bodyweight programming. Free-form TEXT[] (not an enum)
  // so future tokens (e.g. "trx", "sandbag") do not require a migration.
  // The DTO restricts new writes to a curated vocabulary; legacy reads of
  // any token stay valid. Default `[]` so the AI can distinguish unset
  // (don't know) from confirmed-empty (no equipment beyond bodyweight).
  equipment_access       String[]
  macro_target_calories  Float?
  macro_target_protein_g Float?
  macro_target_carbs_g   Float?
  macro_target_fat_g     Float?
  avatar_url             String?
  bio                    String?
  weight_unit            String?           @default("lbs")
  meals_per_day          Int?
  water_goal_oz          Float?
  calorie_display        String?           @default("net")
  onboardingCompleted    Boolean?          @default(false)
  // Coach AI v1 — structured fields the Claude prompt needs that previously
  // only lived in coach notes or free-form `bio`. Empty-array / null defaults
  // so an unset value is distinguishable from "confirmed none".
  injuries               String[]          @default([])
  food_preferences       Json?
  preferred_training_time String?
  updated_at             DateTime          @updatedAt
}

model FoodItem {
  id                  String            @id @default(uuid())
  name                String
  brand_or_restaurant String?
  category            FoodCategory      @default(generic)
  serving_description String
  serving_size_grams  Float
  calories            Float
  protein_g           Float
  carbs_g             Float
  fat_g               Float
  saturated_fat_g     Float?
  mono_fat_g          Float?
  poly_fat_g          Float?
  fiber_g             Float?
  sugar_g             Float?
  sodium_mg           Float?
  tags                String[]
  search_aliases      String[]
  image_url           String?
  barcode             String?           @unique
  // Canonical basis for the macro columns above. Defaults to PER_100G because
  // both upstreams (USDA FDC, OpenFoodFacts) return per-100g values; existing
  // rows are also per-100g (the buggy mobile code assumed as much). See the
  // NutrientBasis enum doc and README "Food logger — canonical nutrient basis".
  nutrient_basis      NutrientBasis     @default(PER_100G)
  created_at          DateTime          @default(now())
  log_entries         LoggedFoodEntry[]
}

model LoggedFoodEntry {
  id                  String   @id @default(uuid())
  user_id             String
  user                User     @relation(fields: [user_id], references: [id])
  date                DateTime @db.Date
  meal_type           MealType
  food_item_id        String
  food_item           FoodItem @relation(fields: [food_item_id], references: [id])
  quantity_multiplier Float    @default(1.0)
  // Original user-entered quantity + unit (e.g. 6 + "oz", 0.5 + "cup"). Stored
  // alongside the canonical `quantity_multiplier` so coaches see "6 oz chicken"
  // instead of "1.7008x chicken". Optional — pre-existing rows have nulls.
  original_quantity   Float?
  original_unit       String?
  notes               String?
  logged_at           DateTime @default(now())

