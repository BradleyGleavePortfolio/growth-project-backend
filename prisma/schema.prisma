model NotificationPreferences {
  id                     String  @id @default(uuid())
  user_id                String  @unique
  user                   User    @relation(fields: [user_id], references: [id])
  water_enabled          Boolean @default(true)
  workout_enabled        Boolean @default(true)
  eat_enabled            Boolean @default(true)
  mindset_enabled        Boolean @default(true)
  fasting_enabled        Boolean @default(true)
  daily_checkin_enabled  Boolean @default(true)
  weekly_summary_enabled Boolean @default(true)
  new_client_alerts      Boolean @default(true)
  quiet_hours_start      String  @default("22:00")
  quiet_hours_end        String  @default("06:00")
  timezone               String  @default("America/Los_Angeles")

  // Phase 9 — Per-kind × per-channel preference flags.
  // muted=true overrides all per-kind settings (master kill switch).
  // Each kind has three channel flags: _email, _push, _inapp.
  // Defaults match the Kind × Channel × Default matrix in the README.
  muted                    Boolean @default(false)
  milestone_email          Boolean @default(true)
  milestone_push           Boolean @default(true)
  milestone_inapp          Boolean @default(true)
  message_email            Boolean @default(false)
  message_push             Boolean @default(true)
  message_inapp            Boolean @default(true)
  missed_checkin_email     Boolean @default(false)
  missed_checkin_push      Boolean @default(true)
  missed_checkin_inapp     Boolean @default(true)
  weight_trend_email       Boolean @default(false)
  weight_trend_push        Boolean @default(true)
  weight_trend_inapp       Boolean @default(true)
  checkin_submitted_email  Boolean @default(false)
  checkin_submitted_push   Boolean @default(false)
  checkin_submitted_inapp  Boolean @default(true)
  build_week_email         Boolean @default(true)
  build_week_push          Boolean @default(true)
  build_week_inapp         Boolean @default(true)
  coach_alert_email        Boolean @default(false)
  coach_alert_push         Boolean @default(true)
  coach_alert_inapp        Boolean @default(true)
  digest_email             Boolean @default(true)
  digest_push              Boolean @default(false)
  digest_inapp             Boolean @default(false)
  // PR-10 — DRIP_RELEASED (buyer content-unlocked alerts). Default ON for
  // push + in-app (the brief mandates push + in-app on every unlock);
  // email default OFF because no transactional drip-release email
  // channel exists today (mirrors the booking cluster's defaults).
  drip_released_email      Boolean @default(false)
  drip_released_push       Boolean @default(true)
  drip_released_inapp      Boolean @default(true)
  // PR-15A — COACH_NEW_PURCHASE (selling coach learns of a new buyer at
  // entitlement). Default ON for push + in-app per decision #9 mirror —
  // a coach who is SELLING packages wants to know. email default OFF
  // (no transactional channel today; mirrors DRIP_RELEASED + booking).
  // _kindToPrefsPrefix maps kind='coach_new_purchase' to this prefix.
  coach_new_purchase_email Boolean @default(false)
  coach_new_purchase_push  Boolean @default(true)
  coach_new_purchase_inapp Boolean @default(true)
  // Concierge booking notifications — cluster prefs covering all
  // booking.* kinds (requested, confirmed, declined, cancelled,
  // rescheduled, reminder.24h, reminder.1h). Email default-off
  // because there is no transactional email transport for booking
  // events in Phase 1 (digest only); the column is provisioned so
  // a future PR can flip it on without another schema change.
  booking_email            Boolean @default(false)
  booking_push             Boolean @default(true)
  booking_inapp            Boolean @default(true)

  // NUDGE-V1 — Behavioral re-engagement nudges. Four trigger types, each
  // independently opt-out-able (spec §6). Channel routing reuses the
  // existing _email / _push / _inapp matrix — see _kindToPrefsPrefix().
  // Default ON: a brand-new user opts INTO nudges by default; their first
  // experience surfaces the preferences screen so they can dial back.
  nudge_missed_checkin_email       Boolean @default(false)
  nudge_missed_checkin_push        Boolean @default(true)
  nudge_missed_checkin_inapp       Boolean @default(true)
  // Internally referenced by code as the 'streak_broken' trigger; column
  // names use 'practice_paused' to comply with the schema doctrine that
  // bans the literal token in DB definitions. See _kindToPrefsPrefix
  // and TRIGGER_TO_PREFS_PREFIX for the trigger↔column mapping.
  nudge_practice_paused_email      Boolean @default(false)
  nudge_practice_paused_push       Boolean @default(true)
  nudge_practice_paused_inapp      Boolean @default(true)
  nudge_onboarding_abandoned_email Boolean @default(true)
  nudge_onboarding_abandoned_push  Boolean @default(true)
  nudge_onboarding_abandoned_inapp Boolean @default(true)
  nudge_inactive_email             Boolean @default(true)
  nudge_inactive_push              Boolean @default(true)
  nudge_inactive_inapp             Boolean @default(true)
}

