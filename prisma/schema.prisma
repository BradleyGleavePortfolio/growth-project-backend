// Idempotency table for Stripe webhook delivery. Stripe retries deliveries on
// timeouts, so we record every event id and short-circuit duplicates.
//
// Audit #3 P1-7 — event-receipt is recorded immediately (processed_at is
// always present), but handler-completion is recorded separately via
// handler_completed_at. The webhook treats an event as durably processed
// only when both columns are set. If the handler crashes after insert
// but before completion, the reconciliation worker picks the row up by
// scanning for handler_completed_at IS NULL plus an age threshold, and
// Stripe may also redeliver (we still 200 on the redelivery, because the
// reconciliation worker covers the re-fulfilment path — see
// GuestCheckoutReconciliationService).
model StripeProcessedEvent {
  stripe_event_id      String    @id
  type                 String
  processed_at         DateTime  @default(now())
  handler_completed_at DateTime?

  @@index([processed_at])
  @@index([handler_completed_at])
}

// Phase 1 Connect — Stripe Express account per coach. The coach goes through
// Stripe-hosted onboarding via accountLinks; we mirror the resulting account
// state from webhooks (`account.updated`, `capability.updated`,
// `account.application.deauthorized`). is_fully_onboarded is derived at read
// time from (charges_enabled && payouts_enabled && details_submitted).
//
// requirements_due stores Stripe's `requirements` object verbatim for
// diagnostics — never used to make business decisions, only surfaced so the
// coach/owner knows what is still owed.
model ConnectAccount {
  id                String    @id @default(uuid())
  coach_user_id     String    @unique
  coach             User      @relation(fields: [coach_user_id], references: [id])
  stripe_account_id String    @unique
  country           String    @default("US")
  default_currency  String    @default("usd")
  charges_enabled   Boolean   @default(false)
  payouts_enabled   Boolean   @default(false)
  details_submitted Boolean   @default(false)
  requirements_due  Json?
  disabled_reason   String?
  deauthorized_at   DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([stripe_account_id])
}

// Coach message draft. Idempotent on (coach_id, client_id) — a coach has one
// draft per thread; autosave overwrites in place.
model MessageDraft {
  id         String   @id @default(uuid())
  coach_id   String
  coach      User     @relation("MessageDraftCoach", fields: [coach_id], references: [id])
  client_id  String
  client     User     @relation("MessageDraftClient", fields: [client_id], references: [id])
  body       String
  snippet_id String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@unique([coach_id, client_id], name: "MessageDraft_coach_client_key")
  @@index([coach_id])
}

// Coach ↔ client direct messages. Two-party only (no group threads in v1).
// `read` is set true the moment the recipient opens the thread; coaches see
// a per-client unread count derived from rows where recipient_id = coach AND
// read = false. RLS (next migration) enforces sender OR recipient access only.
model Message {
  id           String    @id @default(uuid())
  sender_id    String
  sender       User      @relation("MessageSender", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipient_id String
  recipient    User      @relation("MessageRecipient", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  body         String
  read         Boolean   @default(false)
  read_at      DateTime?
  created_at   DateTime  @default(now())

  // Dashboard hot path: count unread messages addressed to a coach.
  @@index([recipient_id, read])
  // Conversation hot path: load thread between two users ordered by time.
  // The OR query (sender=$A AND recipient=$B) OR (sender=$B AND recipient=$A)
  // needs BOTH directions indexed so Postgres can use two index scans + merge
  // instead of one index scan + one seq scan. (Finding 5 — HIGH, audit 2026-05-19)
  @@index([sender_id, recipient_id, created_at])
  @@index([recipient_id, sender_id, created_at])
}

// Audit/activity event stream. Used by the coach console to render the recent
