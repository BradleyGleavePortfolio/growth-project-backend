// Daily/weekly check-ins logged by clients. Original mobile flow used `mood`,
// `energy`, `soreness`, and `type` (morning/evening). Tier-2 adds server-side
// upsert semantics and coach visibility, which required three additive columns:
//   - coach_id (nullable, indexed) — denormalized from the client's current
//     coach at creation time so historical check-ins stay attached to the
//     coach-of-record even if the client later switches coaches. Nullable
//     because a client may check in before being assigned to any coach.
//   - sleep_hours (nullable) — Float hours slept
//   - weight_kg   (nullable) — optional body-weight reading
// The pre-existing `mood`/`energy` columns were relaxed from NOT NULL to
// NULLABLE because the new Tier-2 POST /check-ins endpoint treats every
// subjective field as optional; `soreness`/`type` are retained for the
// existing mobile morning/evening flow and keep their prior NOT-NULL/defaults.
// A unique (client_id, date) constraint turns POST /check-ins into an idempotent
// daily upsert.
model CheckIn {
  id                String      @id @default(uuid())
  user_id           String
  user              User        @relation(fields: [user_id], references: [id])
  coach_id          String?
  date              DateTime    @db.Date
  mood              Int? // 1-5, optional
  energy            Int? // 1-5, optional
  soreness          Int // 1-5 — retained for existing mobile flow
  sleep_hours       Float?
  weight_kg         Float?
  notes             String?
  type              CheckInType @default(morning)
  logged_at         DateTime    @default(now())
  // Phase 11 — coach dashboard summary tracks whether a coach has
  // acknowledged this check-in. Defaults to false; flipped to true when
  // the coach reviews. Filtered on by getDashboardSummary in CoachService.
  reviewed_by_coach Boolean     @default(false)

  @@unique([user_id, date], name: "CheckIn_user_id_date_key")
  // Hot path: daily check-in lookups by (user_id, date).
  @@index([user_id, date])
  @@index([coach_id, date])
}

// Server-persisted meal plans assigned by a coach to a specific client. Tier-2
// addition: previously the mobile coach UI wrote these to local SQLite only,
// so a coach's plans were per-device and never visible to the client. Schema is
// intentionally loose on `items` (Json) so the mobile UI can evolve item shape
// without a migration — validation enforces the expected fields at the DTO
// boundary (name required, everything else optional). `archived_at` gives a
// soft-delete so a plan history survives deletion.
model MealPlan {
  id          String    @id @default(uuid())
  // coach_id / client_id are nullable + SetNull so a hard-deleted user
  // does not cascade away the historical plan rows (which other coaches
  // and operators may still want to inspect for support / compliance).
  // GDPR scrub does NOT hard-delete users today; the nullable FK + SET
  // NULL is the safe long-term posture if that ever changes.
  coach_id    String?
  coach       User?     @relation("MealPlanCoach", fields: [coach_id], references: [id], onDelete: SetNull)
  client_id   String?
  client      User?     @relation("MealPlanClient", fields: [client_id], references: [id], onDelete: SetNull)
  title       String
  notes       String?
  items       Json
  // Structured per-day meal plan. When an AI-generated plan is approved,
  // this field holds the full days[] from the AI payload so mobile can
  // render meals by day rather than a flat list. Null for manually-created
  // plans (legacy shape) — mobile should fall back to items[] in that case.
  days        Json?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime?

  @@index([coach_id])
  @@index([client_id])
  @@index([coach_id, client_id, created_at])
}

model WaterLog {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  amount_ml  Int
  logged_at  DateTime @default(now()) @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  // Hot path: water intake summaries filter by (user_id, logged_at).
  @@index([user_id, logged_at])
  @@map("water_logs")
}

// Direct messages between a coach and one of their clients. `coach_id` /
// `client_id` identify the thread participants (always the same two users for a
// given thread, regardless of direction); `sender_id` records who actually
// wrote the message. `read_at` is set when the *other* party marks the thread
// as read. The composite index on (coach_id, client_id, created_at) makes the
// paginated-thread query a single index seek.
model CoachMessage {
  id                 String          @id @default(uuid())
  // FK columns are nullable + SET NULL on delete so a hard-deleted user
  // does not cascade away the thread history. The GDPR scrub uses
  // soft-delete + PII zero-out today, so these typically remain non-null
  // in practice; SET NULL is the defensive posture if the worker is ever
  // changed to issue actual DELETEs.
  coach_id           String?
  coach              User?           @relation("CoachMessagesAsCoach", fields: [coach_id], references: [id], onDelete: SetNull)
  client_id          String?
  client             User?           @relation("CoachMessagesAsClient", fields: [client_id], references: [id], onDelete: SetNull)
  sender_id          String?
  sender             User?           @relation("CoachMessagesSender", fields: [sender_id], references: [id], onDelete: SetNull)
  // Phase 6C: body becomes optional when a voice attachment is present. The
  // service still requires at least one of `body` or `voice_url` to be set so
  // we never persist an empty thread row. Doctrine: voice metadata
  // (duration_sec, size_bytes, content_type) is set server-side from the
  // accepted upload — never trusted from the client at send time.
  body               String?
  voice_url          String?
  voice_duration_sec Int?
  voice_size_bytes   Int?
  voice_content_type String?
  created_at         DateTime        @default(now())
  read_at            DateTime?
  // Apple 1.2 safety — reverse relation for MessageReport.
  reports            MessageReport[] @relation("MessageReportTarget")

  // Stream 2 — AI execution capabilities. Set by `CoachMessageMaterializer`
  // when a `draft.coach_message` (or merged `draft.client_message`) is
  // approved. NULL for human-written messages. `@unique` is the schema-
  // level idempotency guard — two concurrent approve calls cannot
  // produce two CoachMessage rows; the second INSERT trips P2002 and
  // the materialiser falls through to its "already_materialised" branch.
  ai_draft_id String? @unique

  @@index([coach_id])
  @@index([client_id])
  @@index([created_at])
  @@index([coach_id, client_id, created_at])
}

// Apple App Review 1.2 — abuse-reporting for direct messages.
// A MessageReport row is created when a user files a report against a specific
// CoachMessage they have access to (i.e. they are either the coach or the
// client of the thread). Status drives a 'pending' → 'reviewed' workflow
// owned by platform admins; the action column records the moderation outcome
// (none / warning / suspended / removed) for the audit trail.
//
// The (reporter_id, message_id) composite unique enforces idempotency: a user
// who taps Report twice on the same bubble gets the existing row back, not a
// new one. messageId is indexed independently because admin tooling needs to
// look up "all reports against this message".
model MessageReport {
  id                   String       @id @default(uuid())
  reporter_id          String
  reporter             User         @relation("MessageReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  message_id           String
  message              CoachMessage @relation("MessageReportTarget", fields: [message_id], references: [id], onDelete: Cascade)
  // Denormalized thread participants at the moment the report was filed so
  // the admin console can scope reports to a coach without re-reading the
  // message row. coach_id is also the natural tenant key for the report.
  coach_id             String?
  client_id            String?
  reason               String // 'spam' | 'harassment' | 'sexual' | 'self_harm' | 'other'
  details              String? // optional free-text, capped to 1000 chars by DTO
  status               String       @default("pending") // 'pending' | 'reviewed' | 'dismissed'
  action               String? // 'none' | 'warning' | 'suspended' | 'removed'
  reviewed_at          DateTime?
  reviewed_by_admin_id String?
  reviewed_by_admin    User?        @relation("MessageReportReviewer", fields: [reviewed_by_admin_id], references: [id], onDelete: SetNull)
  created_at           DateTime     @default(now())

  @@unique([reporter_id, message_id], name: "MessageReport_reporter_message_key")
  @@index([reporter_id, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@index([message_id])
}

// Apple App Review 1.2 — user-initiated block list.
// A UserBlock row means `blocker_id` has blocked `blocked_id` from contacting
// them. Server-side enforcement: messaging list responses, unread-count, and
// new-message push fanout all suppress entries where the *other* party is
// blocked by the caller. The block is intentionally one-way and silent — the
// blocked party is never informed (matches iMessage / WhatsApp convention).
model UserBlock {
  id         String   @id @default(uuid())
  blocker_id String
  blocker    User     @relation("UserBlockBlocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked_id String
  blocked    User     @relation("UserBlockBlocked", fields: [blocked_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([blocker_id, blocked_id], name: "UserBlock_pair_key")
  @@index([blocked_id])
  @@index([blocker_id, created_at(sort: Desc)])
}

// In-app "nudge" notifications a coach sends to one of their clients — the
// real backing for the mobile coach's Send Notification button (previously
// written only to the coach's local SQLite). `read_at` is set when the client
// marks a single nudge as read. Index on client_id + created_at backs the
// newest-first listing; index on (client_id, read_at) backs the unread-count
// query.
model CoachNudge {
  id         String    @id @default(uuid())
  coach_id   String?
  coach      User?     @relation("CoachNudgesAsCoach", fields: [coach_id], references: [id], onDelete: SetNull)
  client_id  String?
  client     User?     @relation("CoachNudgesAsClient", fields: [client_id], references: [id], onDelete: SetNull)
  title      String
  body       String
  created_at DateTime  @default(now())
  read_at    DateTime?

  @@index([coach_id])
  @@index([client_id])
  @@index([created_at])
  @@index([client_id, created_at])
  @@index([client_id, read_at])
}

// Tier-2: Community wins are first-class posts authored by a client and
// scoped to the coach's roster feed. Previously `postWin` was a no-op stub;
// `getFeed` was returning Lessons (which also leaked per-client Lesson hacks
// used by the old guidelines pathway). `coach_id` is denormalized at write
// time from the author's current coach so a win stays attached to the right
// roster feed even if the client later switches coaches. Nullable because
// an unassigned client can still post a personal win — those simply do not
// appear in any coach's feed.
model CommunityWin {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation("CommunityWinAuthor", fields: [user_id], references: [id])
  coach_id    String?
  coach       User?    @relation("CommunityWinCoach", fields: [coach_id], references: [id])
  title       String
  description String
  visibility  String   @default("circle") // "circle" | "public"
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([coach_id, created_at])
}

// Tier-2: Per-(coach, client) guidelines as a first-class resource. Replaces
// the prior hack of writing a Lesson row tagged with `client:<id>`. The
// composite unique on (coach_id, client_id) makes write semantics an upsert:
// each coach gets exactly one guidelines doc per client. `updated_at`
// auto-updates on overwrite so callers can show "last updated" without an
// extra column.
model CoachGuideline {
  id         String   @id @default(uuid())
  coach_id   String?
  coach      User?    @relation("CoachGuidelineCoach", fields: [coach_id], references: [id], onDelete: SetNull)
  client_id  String?
  client     User?    @relation("CoachGuidelineClient", fields: [client_id], references: [id], onDelete: SetNull)
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([coach_id, client_id], name: "CoachGuideline_coach_client_key")
  @@index([client_id])
}

// ============================================================
// UX PSYCHOLOGY #4 — Preference-Controlled Personalization
// ============================================================

// Stores per-user UI/UX personalization preferences.
// homeModules: ordered array of visible home sections (default full set).
// notificationCadence: coarse cadence override (individual toggles still live in NotificationPreferences).
// motivationalTone: drives copy variants in HeroAction.
// units: metric vs imperial display.
// firstDayOfWeek: 0=Sun, 1=Mon, 6=Sat.
model UserPreferences {
  id                   String   @id @default(uuid())
  user_id              String   @unique
  user                 User     @relation(fields: [user_id], references: [id])
  home_modules         String[] @default(["hero", "milestone", "trustcues", "secondary"])
  notification_cadence String   @default("daily") // "daily" | "weekly" | "off"
  motivational_tone    String   @default("direct") // "gentle" | "direct" | "drill"
  units                String   @default("imperial") // "metric" | "imperial"
  first_day_of_week    Int      @default(1) // 0=Sun, 1=Mon, 6=Sat
  updated_at           DateTime @updatedAt

  @@index([user_id])
}

// ============================================================
// WAVE 3 MODELS
// ============================================================

// F12 — Recipes: coach-created recipe library with save/bookmark support.
// ingredients and instructions stored as String[] (mapped to jsonb in Postgres).
// tags drive filter chips in the mobile UI.
model Recipe {
  id            String        @id @default(uuid())
  title         String
  description   String?
  image_url     String?
  prep_time_min Int
  cook_time_min Int
  servings      Int
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  ingredients   String[]
  instructions  String[]
  tags          String[]
  is_public     Boolean       @default(true)
  created_by_id String
  created_by    User          @relation("RecipeCreator", fields: [created_by_id], references: [id])
  saved_by      SavedRecipe[]
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  @@index([created_by_id])
  @@index([is_public])
}

// Join table: user bookmarks/saves a recipe.
model SavedRecipe {
  id        String   @id @default(uuid())
  user_id   String
  user      User     @relation(fields: [user_id], references: [id])
  recipe_id String
  recipe    Recipe   @relation(fields: [recipe_id], references: [id])
  saved_at  DateTime @default(now())

  @@unique([user_id, recipe_id])
  @@index([user_id])
}

// F13 — Grocery & Shopping lists: per-user, per-type list items.
// listType enum: 'grocery' | 'shopping'.
// sourceRecipeId links items that were generated from a recipe (PrepGuide → grocery).

enum ListType {
  grocery
  shopping
}

model ListItem {
  id               String   @id @default(uuid())
  user_id          String
  user             User     @relation(fields: [user_id], references: [id])
  list_type        ListType
  name             String
  quantity         Float    @default(1)
  unit             String?
  is_checked       Boolean  @default(false)
  source_recipe_id String?
  added_at         DateTime @default(now())

  @@index([user_id, list_type])
}

// ============================================================
// COMPLIANCE / AUDIT
// ============================================================

// Append-only audit log for sensitive actions: role changes, account
// deletions, data exports, ownership transfers, coach impersonation, etc.
// Distinct from ActivityEvent (which feeds the coach-console activity
// feed and is mutable in spirit) — AuditLog is the immutable record used
// for compliance, incident review, and tenant-isolation audits. Rows are
// never updated or deleted; PII scrub on user delete sets actor/target
// FKs to NULL but preserves the row + actor_email_snapshot.
//
// `tenant_coach_id` is the coach whose tenant the action affected, so
// queries can scope the audit log to a single coach's roster without a
// join (e.g. owner reviews "all sensitive actions inside coach X's
// tenant"). Nullable for platform-level events that have no tenant
// (owner login, system jobs).
model AuditLog {
  id                   String   @id @default(uuid())
  action               String // e.g. "user.role_changed", "user.account_deletion_scheduled"
  actor_id             String?
  actor                User?    @relation("AuditLogActor", fields: [actor_id], references: [id], onDelete: SetNull)
  actor_role           String?
  actor_email_snapshot String? // preserved post-PII-scrub for forensic review
  target_user_id       String?
  target_user          User?    @relation("AuditLogTarget", fields: [target_user_id], references: [id], onDelete: SetNull)
  target_type          String? // "user" | "coach_profile" | "subscription" | …
  target_id            String? // free-form id of the target resource
  tenant_coach_id      String? // coach whose tenant the action touched, if any
  ip                   String?
  user_agent           String?
  metadata             Json?
  created_at           DateTime @default(now())

  @@index([action, created_at])
  @@index([actor_id, created_at])
  @@index([target_user_id, created_at])
  @@index([tenant_coach_id, created_at])
}

// GDPR / CCPA personal data export requests. A request is created when a
// user calls POST /users/me/data-export. Status starts at `pending`;
// when the request is fulfilled the row is updated with the rendered
// Phase 10 — GDPR data portability. Status lifecycle for DataExportRequest.
enum DataExportStatus {
  PENDING // Request received; export not yet started.
  RUNNING // Export is being assembled.
  READY // File uploaded to storage; signed URL available for 7 days.
  EXPIRED // 7-day window has passed; file deleted from storage.
  FAILED // Export failed; user can request again.
}

// Phase 10 — GDPR Article 20 right to data portability. One row per export
// request. The file lives in S3-compatible storage; this table tracks
// its lifecycle. Only the requesting user can download via a signed URL
// that expires after 7 days. The nightly cleanup cron marks READY rows
// EXPIRED and deletes the file from storage when expires_at passes.
//
// Rate limit: one PENDING or READY request per user per 24 h is enforced
// in DataExportService.requestExport — the controller returns 409 when
// the guard fires.
//
// GDPR dependency: this module is a hard dependency for the GDPR delete
// flow. Users should download their data BEFORE requesting account
// deletion. The delete-account module (src/gdpr/) checks for a READY
// export and surfaces a warning if none exists in the last 7 days.
// NOTE (A1-C5-P1-2): A partial unique index enforcing at most one non-terminal
// (PENDING | RUNNING | READY) DataExportRequest per user exists in the raw
// migration `20260525170000_data_export_one_active_per_user`. Prisma DSL does
// NOT support partial indexes (WHERE-clause predicates), so the index is NOT
// representable here. Any @@unique declaration would be incorrect — refer to
// the migration SQL file for the authoritative constraint definition.
model DataExportRequest {
  id              String           @id @default(uuid())
  user_id         String
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status          DataExportStatus @default(PENDING)
  // Signed S3 URL stored for status polling. Never served through the API
  // process — clients are redirected to this URL directly. Null until READY.
  file_url        String?
  created_at      DateTime         @default(now())
  completed_at    DateTime?
  // 7 days after completed_at. Nightly cron expires rows past this point.
  expires_at      DateTime?
  file_size_bytes Int?
  // SHA-256 hex digest of the JSON file for integrity verification.
  sha256          String?

  @@index([user_id, created_at])
  @@index([status, expires_at])
  @@map("data_export_request")
}

// Consent layer v1: per-(client, coach, scope) record of whether the
// client has granted the coach access to a given slice of their data.
//
// Effective state is derived: granted iff `revoked_at IS NULL OR
// revoked_at < granted_at`. Both timestamps are kept (not a single
// boolean) so the row itself preserves the most recent transition; the
// canonical history is in AuditLog under consent.granted / consent.revoked.
//
// Scope strings live in the service layer (ConsentScope) and are not an
// enum at the SQL level — adding a new scope should not require a
// migration. Today's scopes:
//   fitness.profile, fitness.body_metrics, fitness.workouts,
//   fitness.food_macros, fitness.habits_progress,
//   finance.summary, finance.balances, finance.transaction_categories,
//   finance.transaction_line_items, finance.reports
model ClientCoachConsent {
  id         String    @id @default(uuid())
  client_id  String
  client     User      @relation("ConsentClient", fields: [client_id], references: [id], onDelete: Cascade)
  coach_id   String
  coach      User      @relation("ConsentCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  scope      String
  granted_at DateTime?
  revoked_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt

  @@unique([client_id, coach_id, scope], name: "ClientCoachConsent_client_coach_scope_key")
  @@index([client_id])
  @@index([coach_id])
}

// ============================================================
// PTM — Predictive Tracking Model (Phase 1)
// ============================================================
//
// Doctrine (see src/ptm/README.md and docs/ptm.md):
//   * ClientSignal is APPEND-ONLY. Every behavioral signal (check-in
//     submitted, check-in missed, weight logged, message sent, workout
//     logged, meal logged, finance EOD, app open, coach note received,
//     etc.) is recorded with its raw value + metadata. We never UPDATE
//     a signal in place; corrections are written as a new row.
//   * ClientOutcome is the teaching set — the labels OWNERs and coaches
//     attach to a client's eventual journey (churned, completed_90day,
//     upgraded, referred, milestone_hit, dropped_off, renewed). Exactly
//     one row per (user_id) — re-labelling overwrites the prior row,
//     and AuditLog (`ptm.outcome_labelled`) keeps the canonical history.
//   * PtmPrediction is APPEND-ONLY. Every score recompute writes a new
//     row so the operator can see how a client's risk drifted over
//     time. `prediction_basis` distinguishes heuristic_v1 (Phase 1B)
//     from weighted_v2 (Phase 1D, activates at >= 20 outcomes) and
//     reserves model_v3 for a future ML pass.
//
// PTM scores are advisory-only. The mobile client never sees raw
// risk_score or factors — those are OWNER/COACH surfaces only.

// Enumerated signal types. Strings are kept Prisma-side as a Postgres
// enum so a typo at the call site fails at the DB boundary, not at
// dashboard read time. New signal types require a Prisma migration —
// that is by design: the heuristic and weighted services key off this
// enum and a silent typo would skew scores.
enum PtmSignalType {
  checkin_streak // a check-in was submitted; value = streak length on submit
  checkin_miss // a missed-check-in window crossed (3+ days, etc.); value = missed days
  weight_logged // weight log; value = delta vs prior log (kg) or 0 on first log
  weight_skipped // a 14-day no-log threshold crossed; value = days since last log
  message_sent // client → coach message; value = chars
  message_received // coach → client message; value = chars
  coach_note_received // coach guideline / nudge / draft delivered; value = 1
  workout_logged // workout session completed; value = total volume kg
  workout_skipped // 10-day no-workout threshold crossed; value = days since last
  meal_logged // logged food entry; value = calories
  meal_skipped // 7-day no-meal-log threshold crossed; value = days since last
  finance_eod // finance app end-of-day check-in; value = 1
  finance_milestone // finance milestone hit; value = 1
  app_open // first app-open of the day; value = seconds since last open
  consistency_low // 30-day consistency score dropped below 60%; value = consistency_pct
  streak_dropped // active streak dropped 50%+ from prior week; value = drop_pct
}

// Enumerated outcome labels. The teaching set is intentionally small;
// new outcomes require a migration so the weighted service does not
// silently see an unweighted label.
enum PtmOutcomeType {
  churned // client cancelled / disengaged before goal
  completed_90day // client completed the 90-day program
  upgraded // client upgraded plan / extended commitment
  referred // client referred a new client (a measurable success)
  milestone_hit // client hit a major personal milestone (goal weight, etc.)
  dropped_off // client did not formally cancel but stopped engaging
  renewed // client renewed for another cycle
}

// Enumerated prediction basis tags. Drives the version selector in the
// admin dashboard and lets the recompute job log which engine produced
// a row without parsing the factors blob.
enum PtmPredictionBasis {
  heuristic_v1 // Phase 1B: hand-tuned weights + protective factors
  weighted_v2 // Phase 1D: frequency-analysis weights, activates at >= 20 outcomes
  model_v3 // Reserved for a future ML pass; not used in Phase 1
}

// Append-only behavioral signal. One row per discrete event we observed.
// `metadata` is JSON for engine-specific context (delta direction, source
// module, etc.) — keep it small and never put PII there.
//
// All signal writes are fire-and-forget at the call site (see
// PtmService.recordSignal): a failure to insert MUST NOT bubble back
// into the user-facing request. The service catches and logs.
//
// Index on (user_id, signal_type, recorded_at) supports the heuristic
// service's bounded windows (last 7 / 14 / 30 days, by signal type).
model ClientSignal {
  id          String        @id @default(uuid())
  user_id     String
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  signal_type PtmSignalType
  value       Float         @default(0)
  metadata    Json?
  recorded_at DateTime      @default(now())

  @@index([user_id, signal_type, recorded_at])
  @@index([signal_type, recorded_at])
}

// One outcome label per client. `labelled_by_id` is the OWNER or COACH
// who taught the model what happened. `signal_snapshot` captures the
// last-30-days signal counts at label time so the weighted service
// (1D) can train against a frozen window even if older signals are
// later GDPR-scrubbed.
//
// Re-labelling: upsert by user_id, then write a fresh AuditLog row
// (`ptm.outcome_labelled`) carrying both old and new outcomes in
// `metadata`. Treat AuditLog as the canonical history.
model ClientOutcome {
  id              String         @id @default(uuid())
  user_id         String         @unique
  user            User           @relation("PtmOutcomeTarget", fields: [user_id], references: [id], onDelete: Cascade)
  outcome_type    PtmOutcomeType
  labelled_by_id  String?
  labelled_by     User?          @relation("PtmOutcomeLabeller", fields: [labelled_by_id], references: [id], onDelete: SetNull)
  labelled_at     DateTime       @default(now())
  notes           String?
  signal_snapshot Json?

  @@index([outcome_type, labelled_at])
  @@index([labelled_by_id, labelled_at])
}

// Append-only prediction history. `factors` is a JSON blob the heuristic
// (or weighted) service writes so the admin "why is this client red?"
// drawer can show the contributing signals. Mobile clients NEVER see
// this row — it is OWNER/COACH-only by guard.
//
// risk_score and success_score are independent dimensions in [0.0, 1.0].
// They are NOT 1 - x of each other; a high-engagement, high-risk-of-
// burnout client can carry high success and high risk simultaneously.
//
// Index on (user_id, computed_at desc) supports "latest score per user"
// without a window function: ORDER BY computed_at DESC LIMIT 1 with
// composite index hits the single-page seek path.
model PtmPrediction {
  id               String             @id @default(uuid())
  user_id          String
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  risk_score       Float
  success_score    Float
  prediction_basis PtmPredictionBasis
  factors          Json?
  computed_at      DateTime           @default(now())

  @@index([user_id, computed_at])
  @@index([prediction_basis, computed_at])
}

// Phase 6A — Coach Effectiveness Score. Computed nightly by the
// CoachEffectivenessScheduler (default 05:00 UTC, one hour after the
// PTM recompute). APPEND-ONLY: every run inserts a fresh row so the
// admin console can chart drift over time. The latest row is read by
// ORDER BY computed_at DESC LIMIT 1; the composite index supports it.
//
// `factors` is a JSON blob containing each component's contribution
// (completion, risk_delta, retention, engagement) with both the raw
// observed value and the weighted contribution. The admin "why" drawer
// renders straight from this blob.
//
// Visible to OWNER only — coaches do not see their own score (avoids
// gaming). The /admin/coach-effectiveness endpoints are RolesGuard'd.
model CoachEffectivenessScore {
  id          String   @id @default(uuid())
  coach_id    String
  coach       User     @relation("CoachEffectivenessOwner", fields: [coach_id], references: [id], onDelete: Cascade)
  score       Float
  bucket      String // 'developing' | 'consistent' | 'high-performer'
  factors     Json?
  basis       String   @default("v1")
  computed_at DateTime @default(now())

  @@index([coach_id, computed_at])
  @@index([computed_at])
}

// Phase 6B — Proactive Red Flag Alert. Created by the PTM recompute
// hook when a client transitions green/amber → red, by the consecutive-
// miss detector, or by future signal observers. Coaches read their own
// alerts; OWNER sees aggregated.
//
// Dedup window: CoachAlertsService.createAlert short-circuits when an
// unacknowledged alert with the same (coach_id, client_id, alert_type)
// exists within the last 24h, so a flapping signal does not produce a
// notification storm.
//
// Index on (coach_id, created_at desc) supports the coach inbox view;
// (coach_id, acknowledged_at) supports the "unread only" filter.
model CoachAlert {
  id              String    @id @default(uuid())
  coach_id        String
  coach           User      @relation("CoachAlertCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  client_id       String
  client          User      @relation("CoachAlertClient", fields: [client_id], references: [id], onDelete: Cascade)
  alert_type      String // 'risk_red_transition' | 'consecutive_misses' | 'streak_dropped' | 'finance_eod_gap'
  severity        String    @default("warning") // 'info' | 'warning' | 'critical'
  message         String
  payload         Json?
  created_at      DateTime  @default(now())
  acknowledged_at DateTime?

  @@index([coach_id, created_at])
  @@index([coach_id, acknowledged_at])
  @@index([client_id, alert_type, created_at])
}

// Phase 6D — Coach Onboarding Wizard. Tracks where a newly promoted coach
// is in the 6-step setup flow:
//   1. Profile basics (business_name, bio, timezone)
//   2. Default invite code shown + copy reminder
//   3. Send first invite (action logged here; the actual invite send is a
//      separate API)
//   4. Create first message draft template
//   5. Set coach guideline preferences
//   6. Confirm completion
//
// Doctrine:
//   * 1:1 with the coach User row (`coach_id @unique`). Re-promoting the same
//     user is idempotent — the existing row is reused.
//   * `current_step` is enforced server-side: advanceStep(n) requires
//     n === current_step + 1 (or === current_step for resume on the same
//     step). Out-of-order writes return 400.
//   * `step_data` is a per-step JSON map keyed by step number. We never UPDATE
//     a key in place at completion; we keep the most recent value the coach
//     submitted for that step so the wizard can be resumed mid-flow.
//   * `completed_at` is set once and the row freezes — POST /steps/:n returns
//     409 after that.
model CoachOnboardingProgress {
  id           String    @id @default(uuid())
  coach_id     String    @unique
  coach        User      @relation("CoachOnboardingCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  started_at   DateTime  @default(now())
  completed_at DateTime?
  current_step Int       @default(1)
  step_data    Json?

  @@index([completed_at])
}

// =============================================================================
// Phase 3 — 40-point Diagnostic + AI roadmap
// =============================================================================
//
// Public lead-capture funnel: an anonymous visitor answers 40 Likert-scale
// questions (Income / Body / Lifestyle), the service computes per-section
// scores + an overall bucket, and an async AI call generates a personalized
// roadmap that lands on the same submission row.
//
// Design notes:
//   * `email` is captured for ALL submissions, including signed-up users — it
//     is the join key for "claim this lead later" and for the GDPR scrub. It
//     is NEVER returned by GET /diagnostic/questions and never echoed back in
//     /diagnostic/:id/result without authentication of the submitter.
//   * `user_id` is null until the lead signs up; on signup the existing
//     onboarding flow upserts by email and back-fills the column. No FK
//     cascade — if a user is deleted we keep the lead row so churn analytics
//     can still attribute it to a coach.
//   * `answers` and `scores` are JSON blobs. The shape is owned by the
//     diagnostic service; consumers must read through the typed DTOs in
//     src/diagnostic/diagnostic.dto.ts rather than touching `Json` directly.
//   * AiRoadmap is a separate row (1:1 with submission, but optional) so
//     a failed AI generation can leave the submission valid and the user
//     can hit a "retry" button without we re-write the scores.
//   * Append-only by convention. Re-submitting writes a fresh
//     DiagnosticSubmission (and a fresh AiRoadmap when the retry succeeds);
//     we never UPDATE in place. This keeps the lead history honest.
model DiagnosticSubmission {
  id           String   @id @default(uuid())
  email        String
  name         String?
  age          Int?
  // Free-form source tag. Examples: 'web', 'mobile_signup', 'invite_link',
  // 'lead_magnet'. Do not over-validate — operators add new sources via
  // marketing UTM links, and we do not want to ship a migration for each.
  source       String?
  // Full {question_id, answer} array, validated upstream against the seed
  // catalog. Stored verbatim so we can re-score historical submissions if
  // the bucket boundaries ever move.
  answers      Json
  // { income: 0-100, body: 0-100, lifestyle: 0-100, overall: 0-200 }
  scores       Json
  // { income: 'stuck'|'moving'|'compounding', body: ..., lifestyle: ..., overall: 'stuck'|'moving'|'compounding' }
  bucket       Json
  submitted_at DateTime @default(now())
  // Nullable FK to User. Anonymous lead → null. Signed-up lead → the user
  // we upserted by email. NO cascade so deleting a user does not delete
  // historical leads (we want the funnel attribution to survive).
  user_id      String?
  ip           String?
  user_agent   String?

  roadmap AiRoadmap?

  @@index([email, submitted_at])
  @@index([user_id])
  @@index([submitted_at])
}

// One AI roadmap per submission. Generation is async and fire-and-forget:
// the controller returns the submission_id immediately, the service kicks
// off the AI call in the background, and the row is upserted on completion.
// On failure the row is still written with payload=null and status='failed'
// so the GET endpoint can serve a deterministic "retry" state.
//
// `prompt_version` lets us A/B prompts without ambiguity in audit. Increment
// when the prompt template changes; the doctrine spec pins the canonical
// opening line so a silent edit fails CI.
model AiRoadmap {
  id             String               @id @default(uuid())
  submission_id  String               @unique
  submission     DiagnosticSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  generated_at   DateTime             @default(now())
  prompt_version String               @default("v1")
  status         String               @default("ready")
  // The structured AI response. Shape: { summary, top_strength,
  // biggest_gap, ninety_day_focus, raw_text }. Null when status='failed'.
  payload        Json?
  tokens_used    Int?
  model          String               @default("sonar-pro")
  error_message  String?

  @@index([submission_id])
}

// ─── Phase 4: Build Week (7-day guided coaching arc) ───────────────────────
//
// Three tables:
//   1. BuildWeekDay            — global day catalog (rows 1..7), seeded from
//                                prisma/seed-build-week.json by the migration.
//                                Read-only at runtime; new copy = new
//                                migration.
//   2. BuildWeekEnrollment     — one row per user. `current_day` advances as
//                                the user completes each day. Re-enrolling
//                                resets the same row in place (the unique
//                                constraint on user_id keeps history
//                                collapsed; the AuditLog is the durable
//                                history of state transitions).
//   3. BuildWeekDayCompletion  — one row per (enrollment, day_number). Holds
//                                the user's responses to the day's
//                                prompt_questions and their
//                                expected_artifact text.
//
// Tenancy:
//   * Catalog rows are global — no tenant scoping.
//   * Enrollment + completion rows belong to the user (FK to User.id).
//   * Coach reads go through the coach-build-week controller, which asserts
//     the target client belongs to the requesting coach (CoachGuard +
//     coach_id check). Owners bypass tenancy via the OWNER bypass on
//     CoachGuard — see src/auth/coach.guard.ts.
//
// PTM hook:
//   * Day 7 completion fires a `finance_milestone` PTM signal with
//     metadata { source: 'build_week', day_number: 7, total_days: 7 }.
//   * Days 1–6 do NOT emit PTM signals — the catalogue tracks itself; we
//     only emit when meaning matches a doctrine signal type.
model BuildWeekDay {
  id                String @id @default(uuid())
  day_number        Int    @unique
  title             String
  focus_area        String
  narrative         String
  prompt_questions  Json
  action_items      Json
  expected_artifact String

  @@index([day_number])
}

model BuildWeekEnrollment {
  id           String    @id @default(uuid())
  user_id      String    @unique
  started_at   DateTime  @default(now())
  current_day  Int       @default(1)
  status       String    @default("active")
  completed_at DateTime?

  completions BuildWeekDayCompletion[]

  @@index([status])
}

model BuildWeekDayCompletion {
  id            String              @id @default(uuid())
  enrollment_id String
  enrollment    BuildWeekEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  day_number    Int
  completed_at  DateTime            @default(now())
  responses     Json
  artifact_text String?

  @@unique([enrollment_id, day_number], name: "BuildWeekDayCompletion_enrollment_day_key")
  @@index([day_number])
}

// ──────────────────────────────────────────────────────────────────────────
// Phase 9 — Notification Center + Digest Idempotency
// ──────────────────────────────────────────────────────────────────────────
//
// Notification — per-user in-app inbox row. One row per discrete event.
// Emitters write here; the controller serves GET /notifications + mark-read.
//
// NotificationDigestLog — idempotency guard for digest email sends.
// One row per (user, kind, window_date). Unique constraint prevents duplicate
// emails when the cron fires more than once for the same day.

model Notification {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // kind: milestone_reached | message_received | missed_checkin |
  //   weight_trend_alert | checkin_submitted | build_week_day_unlocked |
  //   coach_alert | client_digest | coach_digest
  kind       String
  // Structured deep-link context. Never contains another user's PII.
  payload    Json?
  // Plain-text body, max 160 chars enforced by NotificationsService.createNotification.
  body       String
  // tgp:// deep-link, e.g. tgp://checkin/today
  deep_link  String?
  // Delivery channel: 'push' | 'email' | 'inapp'
  channel    String    @default("inapp")
  read_at    DateTime?
  created_at DateTime  @default(now())

  // Stream 2 — AI execution. Set by `SendNotificationMaterializer` when a
  // `draft.send_notification` is approved. NULL for system/automatic
  // notifications. Same `@unique`-on-nullable pattern as the other
  // Stream 2 ai_draft_id columns.
  ai_draft_id String? @unique

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@index([kind, created_at])
}

model NotificationDigestLog {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // digest_kind: client_daily | coach_daily | weekly_client | weekly_coach
  digest_kind String
  // ISO-8601 date of the window, e.g. "2026-05-07"
  window_date String
  // status: sending | sent | failed | skipped
  status      String    @default("sending")
  sent_at     DateTime?
  error       String?
  created_at  DateTime  @default(now())

  @@unique([user_id, digest_kind, window_date])
  @@index([user_id, digest_kind, window_date])
  @@index([status, created_at])
}

// NotificationDeliveryLog — idempotency ledger for one-shot
// session-scoped notifications. Today used by the booking
// reminder cron (24h + 1h before start_at): the cron INSERTs
// before sending and treats a UniqueViolation as "already sent,
// skip". Row stays as a sent-receipts record for support
// debugging. Distinct from NotificationDigestLog which is
// keyed on a window_date rather than a session.
model NotificationDeliveryLog {
  id         String          @id @default(uuid())
  user_id    String
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session_id String
  session    CoachingSession @relation("DeliveryLogSession", fields: [session_id], references: [id], onDelete: Cascade)
  // kind matches NotificationKind values, e.g. booking_reminder_24h.
  kind       String
  created_at DateTime        @default(now())

  @@unique([session_id, user_id, kind], name: "NotificationDeliveryLog_session_user_kind_key")
  @@index([session_id])
  @@index([user_id, created_at])
}

// ============================================================
// NUDGE-V1 — Behavioral re-engagement nudge ledger.
//
// One row per (user, trigger_type, signal_key) decision. The unique
// (user_id, trigger_type, signal_key) index is the idempotency guard:
// a retried scan that produces the same signal_key is a unique-violation
// the engine treats as a skip (status='suppressed_dedupe' on the existing row).
//
// status taxonomy:
//   sent                      — successfully delivered to at least one channel
//   suppressed_cap            — another nudge sent within the 48h frequency cap
//   suppressed_quiet_hours    — user local time outside 8am–9pm (rare; usually deferred instead)
//   suppressed_opt_out        — per-trigger pref disabled
//   suppressed_muted          — global mute on
//   suppressed_dedupe         — duplicate signal_key for an already-resolved candidate
//   deferred                  — quiet hours, will retry after deferred_until
//   failed                    — transport error on every channel attempted
// ============================================================
model NudgeLog {
  id             String    @id @default(uuid())
  user_id        String
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // trigger_type: 'missed_checkin' | 'streak_broken' | 'onboarding_abandoned' | 'inactive'
  trigger_type   String
  // Deterministic per-event id; collisions across retries are intentional dedupe.
  // e.g. 'missed_checkin:2026-05-08' or 'streak_broken:2026-05-07:14'.
  signal_key     String
  status         String
  // Channels that accepted delivery (subset of {'inapp','email','push'}).
  channels       String[]  @default([])
  attempted_at   DateTime  @default(now())
  sent_at        DateTime?
  // Set when status='deferred' — next scan after this UTC instant will retry.
  deferred_until DateTime?
  // 48h frequency-cap bucket (spec §3). Computed as floor(send_time / 48h)
  // and set ONLY when the engine commits to deliver (i.e. before the
  // delivery fan-out). The @@unique([user_id, cap_bucket]) constraint
  // makes the cap atomic across replicas: two concurrent triggers for the
  // same user racing through the gates will collide here, the loser gets
  // P2002 → status='suppressed_cap'. NULL on every non-sent decision so
  // multiple deferred / suppressed rows for the same user coexist (PG
  // treats NULL as distinct in unique indexes).
  cap_bucket     DateTime?
  created_at     DateTime  @default(now())

  @@unique([user_id, trigger_type, signal_key])
  @@unique([user_id, cap_bucket])
  @@index([user_id, sent_at])
  @@index([status, attempted_at])
  @@index([status, deferred_until])
}

// ============================================================
// Sprint B — coach toolset (workout builder, macros, real meal
// plans, holistic insights cache)
// ============================================================

enum WorkoutPlanType {
  strength
  cardio
  mobility
}

model WorkoutPlan {
  id                        String          @id @default(uuid())
  coach_id                  String
  coach                     User            @relation("CoachWorkoutPlans", fields: [coach_id], references: [id], onDelete: Cascade)
  name                      String
  type                      WorkoutPlanType
  duration_estimate_minutes Int?
  created_at                DateTime        @default(now())
  updated_at                DateTime        @updatedAt
  archived_at               DateTime?

  // ─── MWB-1 (Master Workout Builder Phase 1) — ADDITIVE ONLY ──────────────
  // Every column below is nullable or carries a default so existing rows
  // (program_id=null, is_template=false, version=1) keep behaving exactly as
  // before — the flat "quick plan" path is unchanged. See spec §3.1.
  // program_id null  => legacy standalone plan (old code path, no behaviour
  //                     change). Non-null => a "day" within a WorkoutProgram.
  program_id          String?
  program             WorkoutProgram? @relation("WorkoutProgramPlans", fields: [program_id], references: [id], onDelete: Cascade)
  week_index          Int?            // 0-based week within the program; null for standalone
  day_index           Int?            // 0-based day within the week; null for standalone
  is_template         Boolean         @default(false) // mirrors program.is_template for fast filtering
  version             Int             @default(1)      // per-plan optimistic-concurrency token (§6.4)
  head_revision_id    String?         // current WorkoutPlanRevision head pointer (§5)
  cloned_from_plan_id String?         // provenance for clone-to-client analytics

  exercises   WorkoutPlanExercise[]
  assignments ClientWorkoutAssignment[]
  revisions   WorkoutPlanRevision[]

  @@index([coach_id, archived_at, created_at(sort: Desc)], name: "WorkoutPlan_coach_id_archived_at_created_at_idx")
  @@index([program_id, week_index, day_index])
  @@index([coach_id, is_template, archived_at])
}

// ─── MWB-1 (Master Workout Builder Phase 1) — NEW MODELS, ADDITIVE ONLY ─────
//
// A WorkoutProgram is a multi-week / multi-day container of WorkoutPlans
// ("days"). Programs are template-first: a coach authors a master program
// (is_template=true), then clones it onto a client (cloned_from_id set,
// is_template=false). Legacy standalone plans (program_id=null) never touch
// any of this. See spec §3.
model WorkoutProgram {
  id          String  @id @default(uuid())
  // TENANT key — the coaching business this program belongs to. Used by RLS
  // tenant-sharing checks and as the head-coach ownership anchor.
  coach_id    String
  // OWNER key — the individual user (head coach or sub-coach) who authored /
  // owns this row. RLS write policy keys on this; forking writes a NEW owned
  // row so the fork passes the owner check.
  owner_user_id String
  // 'owner_only'  => only owner_user_id (and service_role) can read.
  // 'tenant_shared' => any coach/sub-coach in the same coach_id tenant may read.
  visibility    String  @default("owner_only")
  // Provenance when this program was forked from another template (§7.3).
  forked_from_id String?
  name          String
  description    String?
  weeks          Int
  days_per_week  Int
  // true => master template (authoring surface). false => a concrete program
  // cloned onto a client (cloned_from_id points at the master).
  is_template    Boolean   @default(true)
  cloned_from_id String?
  goal_tag       String?
  version        Int       @default(1)
  head_revision_id String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  archived_at    DateTime?

  plans     WorkoutPlan[]            @relation("WorkoutProgramPlans")
  revisions WorkoutProgramRevision[]

  @@index([coach_id, visibility, is_template, archived_at, updated_at(sort: Desc)])
  @@index([owner_user_id, archived_at])
  @@index([coach_id, cloned_from_id])
}

// Append-only revision log for a single WorkoutPlan ("day"). The head pointer
// lives on WorkoutPlan.head_revision_id. Used for undo / autosave history in
// later phases — MWB-1 only writes the 'initial' and 'clone' causes. See §5.
model WorkoutPlanRevision {
  id              String      @id @default(uuid())
  workout_plan_id String
  workout_plan    WorkoutPlan @relation(fields: [workout_plan_id], references: [id], onDelete: Cascade)
  // Monotonic per-plan revision counter (0-based).
  revision_index  Int
  // Full materialised snapshot of the plan's exercise rows at this revision.
  exercises_json  Json
  // Plan-level metadata snapshot (name, type, duration, week/day index…).
  plan_meta_json  Json
  author_id       String
  // 'coach' | 'sub_coach' | 'ai'
  author_kind     String
  // 'manual_edit' | 'autosave' | 'ai_apply' | 'undo' | 'clone' | 'initial'
  cause           String
  created_at      DateTime    @default(now())

  @@unique([workout_plan_id, revision_index])
  @@index([workout_plan_id, created_at(sort: Desc)])
}

// Append-only revision log for a WorkoutProgram's structure (week/day layout
// + plan references). See §5.
model WorkoutProgramRevision {
  id             String         @id @default(uuid())
  program_id     String
  program        WorkoutProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)
  revision_index Int
  structure_json Json
  author_id      String
  // 'coach' | 'sub_coach' | 'ai'
  author_kind    String
  // 'manual_edit' | 'autosave' | 'ai_apply' | 'undo' | 'clone' | 'initial'
  cause          String
  created_at     DateTime       @default(now())

  @@unique([program_id, revision_index])
  @@index([program_id, created_at(sort: Desc)])
}

// Immutable point-in-time snapshot of the plan a client was assigned, written
// inside the assign transaction (§3.3). Client read paths render from this so
// later coach edits to the source plan never mutate an active assignment. NULL
// for legacy assignments created before MWB-1 — read paths fall back to the
// live join in that case.
model ClientWorkoutAssignmentSnapshot {
  id            String                  @id @default(uuid())
  assignment_id String                  @unique
  assignment    ClientWorkoutAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  plan_name     String
  plan_type     WorkoutPlanType
  exercises_json Json
  source_plan_id String
  source_version Int
  created_at     DateTime                @default(now())
}

model WorkoutPlanExercise {
  id                       String      @id @default(uuid())
  workout_plan_id          String
  workout_plan             WorkoutPlan @relation(fields: [workout_plan_id], references: [id], onDelete: Cascade)
  // ExerciseDB catalog identifier — NOT a FK to an internal table.
  exercise_external_id     String
  order                    Int
  sets                     Int
  // Dual-purpose: rep count (e.g. 12) or time-based duration (e.g. 60 seconds).
  reps_or_duration_seconds Int
  weight_lbs               Float?
  rest_seconds             Int?
  // Exercises sharing a superset_group_id are performed back-to-back.
  superset_group_id        String?
  notes                    String?
  archived_at              DateTime?

  // (workout_plan_id, order) uniqueness is a *partial* unique index
  // declared in raw SQL (WHERE archived_at IS NULL) — Prisma cannot
  // express partial unique indexes.
  @@index([workout_plan_id])
  @@index([workout_plan_id, archived_at])
  @@index([exercise_external_id])
}

model ClientWorkoutAssignment {
  id                         String      @id @default(uuid())
  workout_plan_id            String
  workout_plan               WorkoutPlan @relation(fields: [workout_plan_id], references: [id], onDelete: Cascade)
  client_id                  String
  client                     User        @relation("ClientWorkoutAssignments", fields: [client_id], references: [id], onDelete: Cascade)
  assigned_by_coach_id       String
  assigned_by_coach          User        @relation("CoachWorkoutAssignments", fields: [assigned_by_coach_id], references: [id], onDelete: Cascade)
  scheduled_for              DateTime
  completed_at               DateTime?
  // Rating of Perceived Exertion 1–10; null until completed.
  post_rpe                   Int?
  post_notes                 String?
  idempotency_key            String?     @unique
  completion_payload         Json?
  started_at                 DateTime?
  completion_idempotency_key String?
  // R43 Coach Brief — coach has reviewed/approved a completed submission.
  // null while waiting on coach approval; set when coach taps approve.
  approved_by_coach_at       DateTime?

  // Stream 2 — AI execution. Set by `AssignWorkoutMaterializer` when a
  // `draft.assign_workout` is approved. NULL for human-assigned workouts.
  // `@unique` enforces single-emit at the schema layer (see CoachMessage
  // above for the same pattern + rationale).
  ai_draft_id String? @unique

  // MWB-1: immutable plan snapshot taken at assign time (§3.3). Optional —
  // legacy assignments have none and fall back to the live workout_plan join.
  snapshot ClientWorkoutAssignmentSnapshot? @relation()

  @@index([client_id, scheduled_for])
  @@index([workout_plan_id, scheduled_for])
  @@index([assigned_by_coach_id])
  @@index([assigned_by_coach_id, approved_by_coach_at])
}

// Generic idempotency ledger for workout-builder coach-side mutations.
// Stores the cached response and claim status keyed by
// (user_id, route_key, idempotency_key). Atomic insert is the dedup
// mechanism — see WorkoutBuilderService.withIdempotency().
model WorkoutBuilderIdempotencyKey {
  id              String   @id @default(uuid())
  user_id         String
  user            User     @relation("WorkoutBuilderIdempotencyUser", fields: [user_id], references: [id], onDelete: Cascade)
  route_key       String
  idempotency_key String
  // 'in_progress' while the protected operation runs, 'completed'
  // once the response is captured. Concurrent same-key callers see
  // 'in_progress' and return 409.
  status          String   @default("completed")
  response_json   Json?
  status_code     Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([user_id, route_key, idempotency_key], name: "WorkoutBuilderIdempotencyKey_user_route_key_key")
  @@index([created_at])
}

// ─── Sprint B: Macro targets ──────────────────────────────────────────────
//
// A coach sets calorie/macro targets for a client. effective_from is
// the start date for the target; we keep history (previous rows are
// not archived) so a client can see how their macros evolved over
// time. The "current" target for a client is the most recent row
// whose effective_from is <= today.
model MacroTarget {
  id             String    @id @default(uuid())
  client_id      String
  client         User      @relation("MacroTargetClient", fields: [client_id], references: [id], onDelete: Cascade)
  coach_id       String
  coach          User      @relation("MacroTargetCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  calories_kcal  Int
  protein_g      Int
  carbs_g        Int
  fats_g         Int
  fiber_g        Int?
  notes          String?
  effective_from DateTime  @default(now())
  created_at     DateTime  @default(now())
  archived_at    DateTime?

  @@index([client_id, effective_from])
  @@index([coach_id, created_at])
}

// ─── Sprint B: Real Meal Plans (templates + plans + assignments) ──────────
model MealTemplate {
  id            String    @id @default(uuid())
  coach_id      String
  coach         User      @relation("MealTemplateCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  name          String
  description   String?
  calories_kcal Int
  protein_g     Int
  carbs_g       Int
  fats_g        Int
  fiber_g       Int?
  items         Json?
  created_at    DateTime  @default(now())
  archived_at   DateTime?

  meal_plan_slots DailyMealPlanSlot[]

  @@index([coach_id, archived_at])
}

model DailyMealPlan {
  id          String    @id @default(uuid())
  coach_id    String
  coach       User      @relation("DailyMealPlanCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  created_at  DateTime  @default(now())
  archived_at DateTime?

  slots       DailyMealPlanSlot[]
  assignments DailyMealPlanAssignment[]

  @@index([coach_id, archived_at])
}

model DailyMealPlanSlot {
  id                 String        @id @default(uuid())
  daily_meal_plan_id String
  daily_meal_plan    DailyMealPlan @relation(fields: [daily_meal_plan_id], references: [id], onDelete: Cascade)
  meal_template_id   String
  meal_template      MealTemplate  @relation(fields: [meal_template_id], references: [id], onDelete: Restrict)
  slot_label         String
  order              Int           @default(0)

  @@unique([daily_meal_plan_id, slot_label, order])
  @@index([daily_meal_plan_id])
  @@index([meal_template_id])
}

model DailyMealPlanAssignment {
  id                   String        @id @default(uuid())
  daily_meal_plan_id   String
  daily_meal_plan      DailyMealPlan @relation(fields: [daily_meal_plan_id], references: [id], onDelete: Cascade)
  client_id            String
  client               User          @relation("DailyMealPlanAssignmentClient", fields: [client_id], references: [id], onDelete: Cascade)
  assigned_by_coach_id String
  assigned_by_coach    User          @relation("DailyMealPlanAssignmentCoach", fields: [assigned_by_coach_id], references: [id], onDelete: Cascade)
  starts_on            DateTime      @db.Date
  ends_on              DateTime?     @db.Date
  created_at           DateTime      @default(now())

  // Stream 2 — AI execution. Set by `AssignMealPlanMaterializer` when a
  // `draft.assign_meal_plan` is approved. Same `@unique`-on-nullable
  // pattern as `ClientWorkoutAssignment.ai_draft_id`.
  ai_draft_id String? @unique

  // PR-7 — Packages & Drip-Feed. Set by MealPlanAssetResolver when the
  // assignment is materialised from a `ScheduledDrop` (drip cron or
  // immediate-at-checkout fan-out). NULL for all pre-drip rows and for
  // manual coach-assigned plans, so this is a purely additive column.
  // The `@unique`-on-nullable lets us use the natural drip key as a
  // race guard: two concurrent retries of the same drop race on this
  // unique, the loser trips P2002, and the resolver re-reads the
  // winner's id. Mirrors the existing `ai_draft_id @unique` pattern.
  drip_drop_id String? @unique

  @@index([client_id, starts_on])
  @@index([daily_meal_plan_id])
  @@index([assigned_by_coach_id])
}

// ─── Sprint B: Holistic Insights cache ────────────────────────────────────
model HolisticInsightCache {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  window_days  Int
  payload      Json
  generated_at DateTime @default(now())
  expires_at   DateTime

  @@unique([user_id, window_days])
  @@index([expires_at])
}

// ============================================================
// AI GATEWAY — request audit + human-approval drafts
// ============================================================

// Per-call audit row written for every AI gateway invocation. This is
// distinct from AuditLog (which records sensitive ADMIN actions): an AI
// request audit captures the inputs, retrieval scope, redaction summary,
// and the provider route. The full prompt and response bodies are
// deliberately NOT stored — we keep counts and hashes so the row is safe
// to retain long-term and so PII does not accumulate in the audit table.
//
// Tenant scoping fields (subject_user_id + tenant_coach_id) let the owner
// surface scope an AI audit query to a single coach's roster without a
// join, mirroring AuditLog.tenant_coach_id.
model AiRequestAudit {
  id                      String         @id @default(uuid())
  request_id              String         @unique // client-supplied or generated; idempotency key
  capability              String // e.g. "chat.client_coach", "draft.coach_message"
  requester_id            String?
  requester               User?          @relation("AiRequestRequester", fields: [requester_id], references: [id], onDelete: SetNull)
  requester_role          String?
  subject_user_id         String? // the client whose data was the subject of the call
  subject_user            User?          @relation("AiRequestSubject", fields: [subject_user_id], references: [id], onDelete: SetNull)
  tenant_coach_id         String? // coach whose tenant the call touched, if any
  provider                String // "stub" | "perplexity" | "openai" | "anthropic" | …
  model                   String? // model id reported by the provider (or "disabled")
  enabled                 Boolean        @default(false) // false = fail-closed stub path
  context_source_count    Int            @default(0)
  context_source_refs     Json? // [{ source, ref, hash, count }] — refs only, no payload
  redactions_applied      Json? // { email: 2, phone: 1, ssn: 0, ... }
  prompt_token_estimate   Int?
  response_token_estimate Int?
  prompt_hash             String? // sha256 of the redacted prompt for replay/dedupe
  response_hash           String?
  approval_status         String         @default("not_required") // not_required | pending | approved | rejected | expired
  approval_draft_id       String?        @unique
  approval_draft          AiActionDraft? @relation("AiAuditDraft", fields: [approval_draft_id], references: [id], onDelete: SetNull)
  error                   String?
  ip                      String?
  user_agent              String?
  metadata                Json?
  created_at              DateTime       @default(now())

  @@index([capability, created_at])
  @@index([requester_id, created_at])
  @@index([subject_user_id, created_at])
  @@index([tenant_coach_id, created_at])
  @@index([approval_status, created_at])
}

// Human-approval workflow row. Consequential AI outputs (a coach message
// the AI drafted, a meal-plan adjustment, a flag escalation) land here
// as `pending` and require an authorized human (coach or owner) to
// approve before downstream action. AI cannot self-approve — the
// service guards on `decided_by_id != requester_id`.
//
// `expires_at` is set at creation; a sweep job (out of scope for this
// PR) marks stale rows `expired`. `payload` carries the proposed action
// in a capability-specific shape; `redacted_inputs` records the
// gateway-side redaction summary so reviewers can verify what the AI
// actually saw.
model AiActionDraft {
  id               String          @id @default(uuid())
  capability       String // e.g. "draft.coach_message"
  status           String          @default("pending") // pending | approved | rejected | expired
  requester_id     String?
  requester        User?           @relation("AiDraftRequester", fields: [requester_id], references: [id], onDelete: SetNull)
  subject_user_id  String? // client whose data the draft concerns
  tenant_coach_id  String?
  payload          Json // capability-specific proposed action
  rationale        String? // model-emitted reasoning (kept short, redacted)
  redacted_inputs  Json? // { email: n, phone: n, ... } summary
  provenance       Json? // [{ source, ref, hash }] retrieval references
  decided_by_id    String?
  decided_by       User?           @relation("AiDraftDecidedBy", fields: [decided_by_id], references: [id], onDelete: SetNull)
  decided_at       DateTime?
  decision_note    String?
  audit_row        AiRequestAudit? @relation("AiAuditDraft")
  expires_at       DateTime?
  // PR AI-3 PRODUCT-1: when capability materialisation succeeds (e.g.
  // draft.coach_message → sendAsCoach), this timestamp is set. It is the
  // single source of truth that an approved draft was actually executed
  // — separate from `status='approved'` which only records the decision.
  // A non-null value also serves as the idempotency marker so concurrent
  // approvals cannot double-materialise.
  materialised_at  DateTime?
  // PR AI-3: identifier of the downstream row produced by materialisation
  // (e.g. CoachMessage.id when capability=draft.coach_message). Nullable
  // because not every capability emits a single addressable row.
  materialised_ref String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @default(now()) @updatedAt

  @@index([status, created_at])
  @@index([requester_id, created_at])
  @@index([subject_user_id, created_at])
  @@index([tenant_coach_id, created_at])
  @@index([capability, status])
}

// ============================================================
// Coach AI v1 — per-client generation drafts + per-call cost log
// ============================================================
//
// Distinct from `AiActionDraft` (the generic gateway approval row): an
// `AIDraft` is the Coach AI v1 generation surface. A coach asks the
// engine to draft a workout program, meal plan, or weekly client
// insight; the row carries the snapshot of context the model saw, the
// model identifier, the generated payload, and a small status machine
// (DRAFT -> APPROVED|REJECTED|EXPIRED). On APPROVE the controller
// materializes the relevant downstream rows (WorkoutPlan +
// WorkoutPlanExercise[] for WORKOUT_PROGRAM; MealPlan for MEAL_PLAN;
// no materialization for INSIGHT).
enum AIDraftType {
  WORKOUT_PROGRAM
  MEAL_PLAN
  INSIGHT
}

enum AIDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  EXPIRED
}

model AIDraft {
  id               String        @id @default(uuid())
  coachId          String
  coach            User          @relation("AIDraftCoach", fields: [coachId], references: [id], onDelete: Cascade)
  clientId         String
  client           User          @relation("AIDraftClient", fields: [clientId], references: [id], onDelete: Cascade)
  type             AIDraftType
  inputContext     Json
  modelUsed        String
  promptVersion    String
  generatedPayload Json
  status           AIDraftStatus @default(DRAFT)
  // FK to the materialized WorkoutPlan / MealPlan id (or null for
  // INSIGHT drafts that do not materialize). Kept as a plain string
  // (not a relation) so a single column can point at multiple tables.
  approvedAsId     String?
  rejectionReason  String?
  tokensIn         Int           @default(0)
  tokensOut        Int           @default(0)
  costCents        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([coachId, clientId, type, status])
}

// Per-call cost + latency log. Written for every AnthropicAdapter
// invocation (success or failure). Powers the per-coach $20/month
// budget alarm; aggregated by coach_id + capability + day.
model AICallLog {
  id           String   @id @default(uuid())
  model        String
  tokensIn     Int
  tokensOut    Int
  costCents    Int
  latencyMs    Int
  success      Boolean
  errorMessage String?
  coachId      String?
  coach        User?    @relation("AICallLogCoach", fields: [coachId], references: [id], onDelete: SetNull)
  clientId     String?
  client       User?    @relation("AICallLogClient", fields: [clientId], references: [id], onDelete: SetNull)
  capability   String
  createdAt    DateTime @default(now())

  @@index([coachId, createdAt])
  @@index([capability, createdAt])
}

// ============================================================
// Team Mode — sub-coach assignments + curated audit events
// ============================================================
//
// ADR-0001 §10 resolutions (locked 2026-05-10):
//   Q1 — Pro tier: each staff seat is a paid Stripe quantity line.
//        Enterprise tier: included unlimited.
//        Growth tier: feature gated (controllers return 403).
//   Q2 — Sub-coach is a many-to-many of head coaches, capped at 2.
//   Q3 — Removal auto-reassigns the sub-coach's clients to the
//        initiating head coach in a single transaction.
//   Q4 — Audit log is a curated event ledger, not a CRUD firehose.
//        See TeamAuditEventKind below for the 15 event_kinds.
//   Q5 — Sub-coaches may invite clients directly. Attribution is
//        carried by InviteCode.invited_by_user_id (added above).
//   Q6 — Tier gate at controller level via existing tier resolver.

enum TeamAuditEventKind {
  session_held
  message_sent
  plan_assigned
  checkin_logged
  macro_target_set
  meal_plan_assigned
  workout_assigned
  client_progress_logged
  sub_coach_assigned
  sub_coach_removed
  client_reassigned
  invite_sent_by_sub_coach
  tier_changed
  staff_seat_added
  staff_seat_removed
  revenue_sharing_changed
}

// Head coach <-> sub-coach assignment. The (sub_coach_id, head_coach_id)
// pair is unique. The "at most 2 head coaches per sub-coach" cap is
// enforced by the service-layer assignment path AND by a database
// trigger added in the migration so a concurrent double-write cannot
// exceed the cap.
model TeamSubCoachAssignment {
  id                          String    @id @default(uuid())
  head_coach_id               String
  head_coach                  User      @relation("TeamSubCoachAssignmentHead", fields: [head_coach_id], references: [id], onDelete: Cascade)
  sub_coach_id                String
  sub_coach                   User      @relation("TeamSubCoachAssignmentSub", fields: [sub_coach_id], references: [id], onDelete: Cascade)
  // Stripe subscription_item id (Pro tier only — null on Enterprise
  // because the staff seat is included; null on Growth because the
  // assignment never lands).
  stripe_subscription_item_id String?
  created_at                  DateTime  @default(now())
  archived_at                 DateTime?

  @@unique([head_coach_id, sub_coach_id])
  @@index([head_coach_id, archived_at])
  @@index([sub_coach_id, archived_at])
}

// Curated audit feed for the head coach's team. NOT a generic action
// log. Each row is a meaningful event a head coach would care about
// in a weekly review (sessions held, plans assigned, sub-coach added/
// removed, tier changes). 15 event_kinds total.
//
// Indexed for two read patterns:
//   1. Head coach's full feed (head_coach_id, occurred_at DESC).
//   2. Drill-down by event_kind within a head coach's feed.
//   3. Per-client filter (target_client_id, occurred_at DESC).
model TeamAuditEvent {
  id               String             @id @default(uuid())
  head_coach_id    String
  head_coach       User               @relation("TeamAuditEventActor", fields: [head_coach_id], references: [id], onDelete: Cascade)
  // The user who actually performed the action (may be the head coach
  // themselves, may be a sub-coach acting under them, may be the
  // platform OWNER for tier_changed events). Always set.
  actor_user_id    String
  // The client the event concerns. Null for events that are not
  // client-scoped (e.g. sub_coach_assigned, staff_seat_added).
  target_client_id String?
  target_client    User?              @relation("TeamAuditEventTarget", fields: [target_client_id], references: [id], onDelete: SetNull)
  event_kind       TeamAuditEventKind
  // Free-form short summary for the feed UI. Service-side templates
  // produce this so the wording stays consistent. Not user input.
  summary          String
  // Optional structured payload (e.g. {"reassigned_client_count": 3}).
  metadata         Json?
  occurred_at      DateTime           @default(now())

  @@index([head_coach_id, occurred_at])
  @@index([head_coach_id, event_kind, occurred_at])
  @@index([target_client_id, occurred_at])
}

// Client-entered bloodwork panel. v1 is manual entry only — no EHR import,
// no OCR, no lab integration. A panel is a logical grouping of biomarker
// results from a single draw (so "CBC + lipid on 2026-04-15" is one panel
// with N BloodworkResult rows).
//
// Tenancy: the (client_id, coach_id) pair pins the panel to the coach
// that was current when the panel was submitted, mirroring the CheckIn
// model. coach_id is nullable because a client can submit labs before
// they have a coach assigned.
//
// Source/provenance: `source` is free-form ("manual_entry", "lab_pdf",
// "photo_self_report"). v1 only writes "manual_entry" but the column is
// open so future ingestion paths land in the same table.
//
// Review state machine (string, not SQL enum, so adding states is cheap):
//   draft         — client is still editing; not visible to coach
//   submitted     — client finalized; appears in coach review queue
//   needs_info    — coach asked for clarification; back to client
//   reviewed      — coach has read it (no clinical opinion)
//   flagged       — coach flagged for follow-up
//   hidden        — coach hid from active surface
//
// Disclaimer level (string): drives which legal copy the mobile app
// renders. v1 always sets "educational_only" — labs are coaching context,
// never diagnosis or treatment.
//
// Validation status: per-panel rollup of result-level validation
// ("ok", "warnings", "errors"). Coach approval/visibility is gated on
// validation_status != 'errors' AND attachment_scan_status in ('clean',
// null) — see BloodworkService.assertReviewable.
//
// Encryption-aware fields: encryption_key_ref + kms_key_version are
// metadata pointers only — the actual KMS bindings live in env/config
// (see docs/bloodwork.md). v1 stores values in plaintext columns;
// production deploys MUST set BLOODWORK_KMS_KEY_REF and migrate to a
// column-level encryption strategy. Not a regression of current posture
// since no labs exist in prod yet.
model BloodworkPanel {
  id                    String    @id @default(uuid())
  client_id             String
  client                User      @relation("BloodworkPanelClient", fields: [client_id], references: [id], onDelete: Cascade)
  coach_id              String?
  coach                 User?     @relation("BloodworkPanelCoach", fields: [coach_id], references: [id], onDelete: SetNull)
  collection_date       DateTime
  source                String    @default("manual_entry") // manual_entry | lab_pdf | photo_self_report | ehr_import
  panel_label           String? // free-form ("CBC", "lipid", "annual physical")
  notes                 String? // client-supplied context (limited to 4000 chars in DTO)
  review_state          String    @default("draft") // draft | submitted | needs_info | reviewed | flagged | hidden
  reviewed_by_id        String?
  reviewed_by           User?     @relation("BloodworkPanelReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at           DateTime?
  review_note           String? // coach-supplied note attached to the most recent review action
  disclaimer_level      String    @default("educational_only") // educational_only | none (reserved)
  validation_status     String    @default("ok") // ok | warnings | errors
  is_stale              Boolean   @default(false)
  stale_marked_at       DateTime?
  source_missing        Boolean   @default(false) // true when client could not provide an attachment / lab source
  ai_processing_allowed Boolean   @default(false) // mirrors per-panel AI scope at submit time; AI service must re-check live consent
  encryption_key_ref    String? // pointer/alias for the KMS key envelope; null in non-prod
  kms_key_version       String? // version string of the key used to encrypt sensitive fields, when applicable
  // KMS-wrapped variants of the two free-text PII-bearing fields above.
  // Application dual-writes the plaintext + encrypted columns and reads
  // the encrypted column first with a plaintext fallback. A follow-up
  // cutover migration drops the plaintext columns once backfilled.
  encrypted_notes       String?
  encrypted_review_note String?
  submitted_at          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  results     BloodworkResult[]
  attachments BloodworkAttachment[]

  @@index([client_id, collection_date])
  @@index([coach_id, review_state])
  @@index([review_state, submitted_at])
  @@index([is_stale])
}

// Per-biomarker row inside a BloodworkPanel. `marker_name` is free-form
// ("hemoglobin", "ldl_c", …) — v1 deliberately avoids a curated dictionary
// because the source of truth for naming is the lab printout the client
// transcribed.
//
// `value_numeric` is the typed numeric value when the lab printed one;
// `value_text` is the raw client-entered text (e.g. ">200", "see notes")
// for cases where the value is qualitative or above-range. At least one
// of the two is required at the DTO layer.
model BloodworkResult {
  id                 String         @id @default(uuid())
  panel_id           String
  panel              BloodworkPanel @relation(fields: [panel_id], references: [id], onDelete: Cascade)
  marker_name        String
  marker_code        String? // optional standardized code (LOINC etc.) — never required
  value_numeric      Decimal?       @db.Decimal(20, 6)
  value_text         String?
  unit               String?
  reference_low      Decimal?       @db.Decimal(20, 6)
  reference_high     Decimal?       @db.Decimal(20, 6)
  reference_text     String? // free-form when low/high don't apply ("negative", "<5")
  out_of_range       Boolean        @default(false) // computed at write time when low/high are present
  validation_status  String         @default("ok") // ok | warnings | errors
  validation_message String?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  @@index([panel_id])
  @@index([marker_name])
}

// Attachment metadata pointer for a panel (e.g. a photo/PDF of the lab
// printout). v1 does NOT implement upload/storage; this table holds the
// metadata + scan state machine that downstream upload code can plug in.
//
// Scan state machine:
//   pending_scan  — uploaded, awaiting AV / content scan
//   clean         — passed scan; safe to expose to coach
//   rejected      — scan failed; client must replace
//   quarantined   — flagged for human review; not coach-visible
//   unavailable   — file removed / link broken
//
// `storage_ref` is an opaque pointer (S3 key, Supabase storage path, etc).
// Never write a presigned URL here — controllers mint short-lived URLs at
// read time when a coach accesses a clean attachment.
model BloodworkAttachment {
  id              String         @id @default(uuid())
  panel_id        String
  panel           BloodworkPanel @relation(fields: [panel_id], references: [id], onDelete: Cascade)
  storage_ref     String? // opaque storage pointer (bucket/key)
  storage_backend String? // "supabase" | "s3" | "stub" — null in v1
  content_type    String?
  byte_size       Int?
  scan_status     String         @default("pending_scan") // pending_scan | clean | rejected | quarantined | unavailable
  scan_message    String?
  scanned_at      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  @@index([panel_id])
  @@index([scan_status])
}

// ============================================================
// CONCIERGE SCHEDULING (PR #142)
// ============================================================
//
// TGP is a private coaching concierge — clients schedule Zoom or Google
// Meet calls with the coach who already manages them, coaches set their
// availability, and admins see fulfillment org-wide. This is *not* a
// generic Calendly clone: the only people who can request a session
// with a coach are clients already linked via `User.coach_id`, and the
// coach approves every booking unless they have explicitly marked a
// SessionType as `auto_approve`.
//
// All provider integrations (Google Calendar, Google Meet, Zoom) ship
// behind a stub adapter by default. No real API calls are made unless
// the corresponding env vars are set; see docs/session-scheduling.md.

enum SessionStatus {
  // Client requested; awaiting coach approval. Default landing state
  // for any session not auto-approved.
  requested
  // Coach approved (or auto-approved) — calendar/video provisioning is
  // attempted on transition. Stays in `scheduled` once provisioned.
  scheduled
  // Coach (or admin) declined the requested session. Terminal.
  declined
  // Either party canceled before start. Terminal.
  canceled
  // Coach (or admin) marked the session as not-attended after start_at
  // passed. Distinct from `canceled` for fulfillment reporting.
  no_show
  // Coach (or admin) marked the session complete. Terminal happy path.
  completed
  // Background provider call is in flight (calendar event create/update
  // or video link mint). Used so a transient retry does not double-book.
  pending_provider
}

enum VideoProvider {
  // Default — no real video link, the API returns a stub URL of the form
  // tgp-stub://session/<id>. The mobile/web client treats this as "the
  // coach has not attached a real link yet" and surfaces a manual-link
  // affordance to the coach.
  stub
  google_meet
  zoom
  // Coach pasted a custom link (Whereby, FaceTime, phone, etc.). The
  // link is stored verbatim and never re-minted by a provider job.
  manual
}

enum CalendarProvider {
  stub
  google_calendar
  // Apple/Outlook reserved as future enums; intentionally commented out
  // until adapters land — Prisma migrations forbid removing values, so
  // we add them when we ship the adapter.
}

enum SessionParticipantRole {
  coach
  client
  // Admin observer (owner role). Sub-coaches join as `assistant_coach`.
  admin
  assistant_coach
}

// SessionType — the offering the coach exposes (e.g. "30 min check-in",
// "Initial intake", "Quarterly review"). Owned by a coach. Clients pick
// from this list when requesting a session.
model SessionType {
  id                     String        @id @default(uuid())
  coach_id               String
  coach                  User          @relation("SessionTypeCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  duration_minutes       Int           @default(30)
  // Auto-approve client requests (skip the `requested` -> `scheduled`
  // gate). Defaults to false — coaches consciously turn this on per
  // session type, since the doctrine here is "coach approves every
  // booking" until the coach decides otherwise.
  auto_approve           Boolean       @default(false)
  // Default video provider for sessions of this type. Concrete sessions
  // may override (e.g. coach pastes a manual link for one).
  default_video_provider VideoProvider @default(stub)
  // Soft-disable so historic sessions still link back to their type.
  archived_at            DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @default(now()) @updatedAt

  sessions CoachingSession[] @relation("CoachingSessionType")

  @@index([coach_id])
}

// CoachAvailability — recurring weekly availability windows for a coach.
// Per-day-of-week (0 = Sunday … 6 = Saturday) plus start/end minute-of-
// day. Stored as integers (not DateTime) so daylight-savings transitions
// don't shift the recurring window. The coach's timezone lives on
// CoachProfile.timezone; this row is interpreted relative to that tz.
//
// One-off blackouts and exceptions are deliberately *not* modeled here
// yet — the next iteration adds CoachAvailabilityException rows. For
// now, a coach who needs to block a single day uses the calendar-sync
// job seam (manually) or marks individual conflicting requests declined.
model CoachAvailability {
  id              String   @id @default(uuid())
  coach_id        String
  coach           User     @relation("CoachAvailability", fields: [coach_id], references: [id], onDelete: Cascade)
  day_of_week     Int // 0=Sun … 6=Sat
  start_minute    Int // minutes from midnight local
  end_minute      Int
  // Allows the coach to mark a window as "intake only" or similar via a
  // session-type filter. NULL = applies to any session type.
  session_type_id String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@index([coach_id, day_of_week])
}

// CoachAvailabilityOverride — date-keyed exceptions to the recurring
// weekly availability. Three semantics:
//
//   HOLIDAY  — the coach is OFF for this date (whole day or window).
//              Bookings cannot be placed inside the override window.
//   BLOCK    — same effect as HOLIDAY but the coach can attach a note
//              ("focus time", "personal", etc.) the UI may surface.
//   EXTRA    — the coach is AVAILABLE on this date in a window that is
//              not part of their recurring weekly availability (e.g.
//              "Saturday 9-11am this week only").
//
// One row per (coach_id, date, start_minute). The scheduling service
// merges overrides with CoachAvailability when computing slots: EXTRA
// adds to the recurring window, HOLIDAY/BLOCK subtract from it.
//
// Stored as date + minute-of-day in the coach's timezone (read from
// CoachProfile.timezone) so daylight-savings transitions do not shift
// the override. The migration adds a CHECK constraint on the kind
// column rather than a Prisma enum so adding new kinds in a follow-up
// does not require an enum migration.
model CoachAvailabilityOverride {
  id           String   @id @default(uuid())
  coach_id     String
  coach        User     @relation("CoachAvailabilityOverrideCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  // Calendar date in the coach's timezone (YYYY-MM-DD). Not a
  // DateTime: time-of-day lives on the minute columns below so the
  // row is unambiguous across DST.
  date         DateTime @db.Date
  // Minutes from midnight local. Null on a HOLIDAY/BLOCK that covers
  // the entire day.
  start_minute Int?
  end_minute   Int?
  // 'holiday' | 'block' | 'extra' — enforced by a CHECK constraint in
  // the migration. Adding a new kind is an additive migration with no
  // Prisma-generated enum churn.
  kind         String
  note         String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@unique([coach_id, date, start_minute, kind], name: "CoachAvailabilityOverride_coach_date_start_kind_key")
  @@index([coach_id, date])
}

// CoachingSession — a concrete scheduled (or requested) session.
model CoachingSession {
  id                       String           @id @default(uuid())
  coach_id                 String
  coach                    User             @relation("CoachingSessionCoach", fields: [coach_id], references: [id])
  // The primary client. Group sessions are modeled via SessionParticipant
  // rows; the `client_id` here is the lead client (the one who requested
  // it, or the one the coach booked it for). Nullable so admin-created
  // group sessions without a single lead client are valid.
  client_id                String?
  client                   User?            @relation("CoachingSessionClient", fields: [client_id], references: [id])
  session_type_id          String?
  session_type             SessionType?     @relation("CoachingSessionType", fields: [session_type_id], references: [id])
  status                   SessionStatus    @default(requested)
  start_at                 DateTime
  end_at                   DateTime
  // Free-form title shown to the client (defaults to session_type.name
  // at creation time but can be edited by the coach).
  title                    String
  // Internal coach-only notes; client-visible recap lives in
  // `client_recap_md` (gated behind a human-approval step under the AI
  // gateway doctrine — never auto-published).
  coach_notes_md           String?
  client_recap_md          String?
  // Provider-side identifiers. Populated only when a real adapter
  // attaches; stub provider leaves these null.
  video_provider           VideoProvider    @default(stub)
  video_url                String?
  video_meeting_id         String?
  calendar_provider        CalendarProvider @default(stub)
  calendar_event_id        String?
  // Idempotency key for provider-side create calls. The scheduler sets
  // this once on first transition into `pending_provider`; retries reuse
  // it so the provider does not create duplicate calendar events.
  provider_idempotency_key String?
  // When the coach approved the request (null while `requested`).
  approved_at              DateTime?
  // When the session terminated (canceled / declined / no_show / completed).
  ended_at                 DateTime?
  // Reason captured on cancel/decline/no_show (free-form, optional).
  end_reason               String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @default(now()) @updatedAt

  participants  SessionParticipant[]      @relation("SessionParticipantSession")
  delivery_logs NotificationDeliveryLog[] @relation("DeliveryLogSession")

  // Hot paths:
  //   - "list this coach's upcoming sessions" → (coach_id, start_at)
  //   - "list this client's upcoming sessions" → (client_id, start_at)
  //   - "fulfillment dashboard, today's no-shows" → (status, start_at)
  @@index([coach_id, start_at])
  @@index([client_id, start_at])
  @@index([status, start_at])
}

// SessionParticipant — extra attendees beyond the lead coach/client.
// Used for sub-coach shadowing, admin observation, or future group
// sessions. The lead coach + lead client are *not* duplicated here.
model SessionParticipant {
  id         String                 @id @default(uuid())
  session_id String
  session    CoachingSession        @relation("SessionParticipantSession", fields: [session_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User                   @relation("SessionParticipantUser", fields: [user_id], references: [id])
  role       SessionParticipantRole
  created_at DateTime               @default(now())

  @@unique([session_id, user_id], name: "SessionParticipant_session_user_key")
  @@index([user_id])
}

// CalendarConnection — metadata only. Real OAuth tokens are deliberately
// NOT stored in this row in this PR; the `credentials_secret_ref` field
// holds an opaque pointer to whichever secret store the deployment uses
// (Fly secrets, AWS SM, etc.). The stub adapter ignores this entirely.
model CalendarConnection {
  id                      String           @id @default(uuid())
  user_id                 String
  user                    User             @relation("CalendarConnectionUser", fields: [user_id], references: [id], onDelete: Cascade)
  provider                CalendarProvider
  // External calendar account identifier (e.g. Google account email).
  // Deliberately *not* the raw token.
  external_account_id     String?
  // Pointer to the secret-store entry holding the OAuth credentials.
  // Null on stub connections.
  credentials_secret_ref  String?
  // KMS-wrapped Google OAuth refresh token. Encrypted via KmsService
  // (see src/common/kms/) using AES-256-GCM with an envelope shaped as
  // base64(JSON({v,iv,tag,ct})). Prior to this column the refresh token
  // lived only in process memory; this column lets a process restart
  // reuse a previously linked account without forcing a re-link.
  encrypted_refresh_token String?
  // Google Calendar push-channel tracking (B3). Populated after a
  // successful events.watch() call; null until the watch is opened.
  //   channel_id       — UUID we minted when calling watch(); Google
  //                      echoes it back on every push notification via
  //                      X-Goog-Channel-ID. Used to look up the owning
  //                      connection on inbound webhooks.
  //   resource_id      — Opaque Google identifier for the resource
  //                      being watched. Required for stopWatch() calls.
  //   channel_expires_at — Google channels expire after ≤7 days. The
  //                      channel-renewal cron (B5) queries this column
  //                      to find channels that need refreshing.
  channel_id              String?          @unique
  resource_id             String?
  channel_expires_at      DateTime?
  // Last time the calendar-sync job seam successfully reconciled this
  // connection. Null until the real adapter ships.
  last_synced_at          DateTime?
  // Soft-disconnect so audit history survives a re-link.
  disconnected_at         DateTime?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @default(now()) @updatedAt

  @@unique([user_id, provider, external_account_id], name: "CalendarConnection_user_provider_account_key")
  @@index([user_id])
}

// ─── Phase 10: Secrets Rotation Log ────────────────────────────────────────
//
// Immutable audit trail for every secret rotation event. The admin endpoint
// GET /admin/secrets/status reads this table to surface "last rotated" dates
// per secret. No secret values are stored here — only metadata.
//
// rotated_by_user_id is nullable so that automated script rotations (e.g.
// scripts/secrets/rotate-jwt.ts) can be recorded without a user context.
//
// The secret_name column is a free-text identifier matching the Fly secret
// name exactly (e.g. "JWT_SIGNING_KEY", "DATABASE_URL"). This keeps the
// table schema stable even as new secrets are added.
model SecretRotationLog {
  id                 String   @id @default(uuid())
  secret_name        String
  rotated_at         DateTime @default(now())
  rotated_by_user_id String?
  notes              String?

  @@index([secret_name])
  @@index([rotated_at])
  @@index([rotated_by_user_id])
  @@map("secret_rotation_log")
}

// Phase 2 Connect — Coach offers / packages.
//
// A package is what a client buys from a coach. Two billing shapes:
//   - one_time: a single Stripe Payment (PaymentIntent) — e.g. a 12-week
//     transformation program billed up front.
//   - recurring: a Stripe Subscription with a Price — e.g. $199/mo
//     ongoing coaching.
//
// Pricing is denormalized into amount_cents + currency + interval so that
// the package row alone is enough to render UI without round-tripping
// Stripe. The Stripe Price id is created lazily on first checkout
// (stripe_price_id) and cached. interval is null for one_time.
//
// is_active gates whether new checkouts can be opened. Past purchases
// remain valid even after a package is deactivated.
model CoachPackage {
  id                String    @id @default(uuid())
  coach_id          String
  coach             User      @relation("CoachPackageCoach", fields: [coach_id], references: [id])
  name              String
  description       String?
  amount_cents      Int
  currency          String    @default("usd")
  billing_type      String    @default("one_time") // one_time | recurring
  interval          String? // month | year — only for billing_type=recurring
  interval_count    Int       @default(1)
  // Number of billing periods to bill for (recurring only). null = until canceled.
  // For one_time, this is the number of weeks/sessions the program lasts (for
  // entitlement expiry) — null means "lifetime" / no expiry.
  duration_periods  Int?
  // Stripe Price id, created lazily on first checkout. Cached here so
  // subsequent checkouts reuse the same price. Re-created when amount
  // or currency changes (the old price is preserved on Stripe's side).
  stripe_price_id   String?
  // Stripe Product id, parent of the Price. Created lazily with the Price.
  stripe_product_id String?
  is_active         Boolean   @default(true)
  archived_at       DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  purchases ClientPurchase[]

  // R43 Storefront Phase 1 — guest-checkout share links.
  // share_token is minted on demand via POST /packages/:id/share-link and
  // never rotated. share_link_enabled lets a coach pause acquisitions
  // without throwing the token away (so existing pasted links 404 cleanly
  // and can be re-enabled later). share_link_generated_at records the
  // first mint timestamp — never updated on subsequent reads (idempotent).
  // Audit #4 P2-4 — share_link_expires_at is an optional hard wall-clock
  // expiry the coach can set (e.g. a 30-day campaign). share_link_revoked_at
  // marks a permanently dead token; revocation is a one-way operation and
  // a fresh mint after revoke produces a new token rather than reviving
  // the old one.
  share_token             String?   @unique
  share_link_enabled      Boolean   @default(true)
  share_link_generated_at DateTime?
  share_link_expires_at   DateTime?
  share_link_revoked_at   DateTime?

  // R43 — each package may have many guest checkout attempts (one row per
  // distinct idempotency_key).
  guest_checkouts GuestCheckout[]

  // PR-3 Packages & Drip-Feed foundation. Coaches mark a package as
  // sellable once it has attachable content; until then every package
  // behaves exactly as today (paywall-only, zero content rows).
  is_sellable Boolean               @default(false)
  contents    CoachPackageContent[]

  // PR-6 — draft/publish lifecycle. null = DRAFT (not purchasable); a
  // non-null timestamp = PUBLISHED (purchasable, value is the most
  // recent publish time). New packages start as DRAFT so an empty
  // package isn't live the instant the coach saves it. The migration
  // backfills published_at = NOW() for pre-existing rows so
  // already-selling packages stay live with no behavior change.
  published_at DateTime?

  // PR-6 — operator decision #1 second-price config. A package can
  // have a one-time price (the existing amount_cents/billing_type
  // triple as the PRIMARY price), a recurring price, or BOTH
  // (one-time charge today + an ongoing subscription). The recurring_*
  // columns model the optional second Stripe Price; recurring cadence
  // is week|month|year. recurring_stripe_price_id is the lazy cache
  // mirroring stripe_price_id for the first price. All null on
  // existing rows (single-price packages) so behaviour is unchanged.
  recurring_amount_cents    Int?
  recurring_interval        String? // week | month | year
  recurring_interval_count  Int?
  recurring_stripe_price_id String?

  // B5 — Layer 2 (Coach Service Agreement) opt-in. When requires_contract
  // is true AND contract_template_id is set, the checkout gate creates a
  // ContractEnvelope (after the Layer-1 platform-waiver gate clears) and
  // HARD-BLOCKS the Stripe charge until that envelope is SIGNED. Both
  // columns are additive + nullable/defaulted so every pre-existing package
  // keeps its exact current behavior (no contract step).
  requires_contract    Boolean           @default(false)
  contract_template_id String?
  contract_template    ContractTemplate? @relation("PackageContractTemplate", fields: [contract_template_id], references: [id])

  @@index([coach_id, is_active])
  @@index([coach_id, archived_at])
  @@index([coach_id, published_at])
  @@index([stripe_price_id])
  @@index([contract_template_id])
}

// R43 Storefront Phase 1 — guest checkout state machine.
//
// One row per non-authed purchase attempt against a CoachPackage share
// link. Created when the storefront calls POST /packages/public/join/:token
// /checkout; mutated only by the Stripe webhook handler and the
// post-payment account-creation flow.
//
// Status lifecycle:
//   pending → paid       (webhook payment_intent.succeeded)
//   pending → failed     (webhook payment_intent.payment_failed)
//   paid    → converted  (Supabase user + ClientPurchase row created)
//
// RLS: ENABLE + FORCE + restrictive deny-all for anon / authenticated
// roles. The Prisma service-role connection bypasses RLS, which is the
// ONLY write path. See the migration_sql block in
// prisma/migrations/<timestamp>_r43_storefront_phase1/migration.sql.
model GuestCheckout {
  id         String       @id @default(uuid())
  package_id String
  package    CoachPackage @relation(fields: [package_id], references: [id])

  stripe_payment_intent_id String  @unique
  stripe_customer_id       String?

  /// PR-14 — storefront recurring (and one-time+recurring combo) support.
  /// When the package has a recurring component the storefront mints a
  /// Stripe Subscription whose first invoice's PaymentIntent the guest
  /// confirms client-side. We persist the subscription id here so the
  /// convert-to-user $transaction can copy it onto ClientPurchase, where
  /// the existing applySubscriptionUpdated webhook already keys lifecycle
  /// claims by stripe_subscription_id. Null on one-time-only checkouts
  /// and on all pre-PR-14 rows.
  stripe_subscription_id String? @unique

  guest_email String
  guest_name  String

  /// State machine — enforced by a CHECK constraint at the DB layer:
  ///   pending                    → paid                          (Stripe webhook)
  ///   paid                       → converted                     (Supabase + DB OK)
  ///   paid                       → conversion_failed_retryable   (transient failure)
  ///   conversion_failed_retryable → converted                    (reconciliation OK)
  ///   conversion_failed_retryable → conversion_failed_terminal   (>= 5 retries)
  ///   pending                    → failed                        (Stripe PI failed)
  ///   paid|converted             → refunded                      (charge.refunded — full)
  ///   paid|converted             → disputed                      (charge.dispute.created)
  /// `failed` is the legacy terminal state for the pre-checkout
  /// failure path (Stripe rejected the PI). It is NOT reachable from
  /// `paid` — once we have money, the row only moves through retryable
  /// reconciliation. Audit #3 P1-6 added that durability.
  /// A276 P0-1: `refunded` and `disputed` are first-class terminals
  /// admitted by the GuestCheckout_status_check constraint (see
  /// migration 20260921000000_add_refunded_disputed_to_guest_checkout_status).
  status String @default("pending")

  /// FK to User row created after payment succeeds. Null until converted.
  created_user_id String?
  created_user    User?   @relation("GuestCheckoutUser", fields: [created_user_id], references: [id])

  /// UUID v4 generated by the storefront and sent with POST /checkout.
  /// Server dedups via the unique constraint + P2002 catch so retries
  /// collapse to the same row.
  idempotency_key String @unique

  /// Audit #3 P1-6 — reconciliation bookkeeping. retry_count counts
  /// Supabase-create / DB-transaction reconciliation attempts on
  /// `conversion_failed_retryable` rows; last_error stores the
  /// short tag (e.g. `supabase_timeout`, `db_unique_violation`) for
  /// operator dashboards; last_retry_at lets the worker back off and
  /// prevents tight-loop reprocessing. Hard cap is 5 — past that the
  /// row moves to `conversion_failed_terminal` and pages on-call.
  retry_count   Int       @default(0)
  last_error    String?
  last_retry_at DateTime?

  created_at DateTime @default(now())

  /// Pending intents older than this are considered stale. Set to
  /// created_at + 24h at row creation. Webhook handlers refuse to fulfil
  /// rows past this point.
  expires_at DateTime

  /// Audit #3 P2-3 — PII retention deadline. Set to created_at + 13
  /// months at row creation. A daily scrub job hashes guest_email and
  /// redacts guest_name on rows past this deadline that never
  /// converted to a real User (created_user_id IS NULL) — converted
  /// rows have a User record that holds the same identity data with
  /// its own retention rules. 13 months is the default GDPR-style
  /// retention window for transactional purchase records.
  data_retention_at DateTime?

  /// Audit #3 P2-3 — set once the scrub job has anonymised this row
  /// so a future run skips it without paying the hash compute.
  scrubbed_at DateTime?

  /// R47 Phase 3 — landing page referrer.  When a checkout originated
  /// from a CoachLandingPage's primary CTA the storefront stamps this
  /// column so analytics can compute $/visitor per page.  Nullable —
  /// direct storefront URLs (not from a landing page) leave it null.
  /// No FK relation declared to avoid Prisma generating an inverse
  /// relation on CoachLandingPage; analytics queries filter by id only.
  landing_page_id String?

  /// r48 Hardening — lost-webhook reconciler bookkeeping.  The
  /// CheckoutReconcileScheduler scans pending rows older than 30s with
  /// last_reconciled_at older than 10s and calls
  /// stripe.paymentIntents.retrieve to recover from a dropped webhook.
  /// NULL = never reconciled yet.
  last_reconciled_at DateTime?
  /// Capped at 30 polls (5 min). Past that the row is moved to
  /// `conversion_failed_terminal` and on-call is paged (A279-P1-1).
  reconcile_attempts Int       @default(0)
  /// r48 Hardening — package snapshot taken at PaymentIntent create.
  /// Guards against a coach editing the package mid-checkout: the guest
  /// gets the price/name they saw at intent time, not at fulfillment
  /// time. Shape: { name, price_cents, currency, description, billing_period }.
  package_snapshot   Json?
  /// r48 Hardening — refund/dispute bookkeeping.  Stripe's charge.refunded
  /// → refunded_at + status='refunded'.  charge.dispute.created →
  /// disputed_at + dispute_reason + status='disputed'.  Coach is alerted
  /// via the existing notifications path.
  refunded_at        DateTime?
  disputed_at        DateTime?
  dispute_reason     String?   @db.VarChar(500)
  /// r48 Hardening — branded PDF receipt URL (local:// in dev, s3:// in
  /// prod). Set by the post-success ReceiptScheduler after generation.
  receipt_url        String?

  @@index([package_id])
  @@index([status])
  // Audit #4 P2-6 — raw email index removed. Indexing guest_email
  // gave an attacker with read access to the index pages a
  // material privacy surface (it inverts the salted scrub) without
  // any equivalent query benefit; we never look guests up by raw
  // email at runtime. The scrub job streams rows by
  // (data_retention_at, scrubbed_at), so removing the email index
  // does not regress the scrub plan.
  @@index([stripe_payment_intent_id])
  // Reconciliation worker scans status='conversion_failed_retryable'
  // rows ordered by last_retry_at NULLS FIRST. The composite index
  // serves both the scan filter and the ordering.
  @@index([status, last_retry_at])
  // Audit #3 P2-3 — scrub worker scans rows whose data_retention_at
  // has elapsed and that have not been scrubbed yet.
  @@index([data_retention_at, scrubbed_at])
  // R47 — analytics: revenue rollup for a landing page filters by
  // landing_page_id + status. Index supports the GET /analytics query.
  @@index([landing_page_id, status])
  // r48 — lost-webhook reconciler scans pending rows ordered by
  // (status, last_reconciled_at NULLS FIRST). The composite serves
  // both the filter and the order-by.
  @@index([status, last_reconciled_at])
}

// Phase 3 Connect — Per-client Stripe Customer on the platform account.
//
// Saved cards / billing identity lives on this row. Created on the first
// checkout session, reused on every subsequent checkout for the same
// client across coaches. One row per client user.
//
// We are NOT creating customers on the coach's connected account (Direct
// charges with `customer` only work on the Direct path; we use Destination
// charges with `transfer_data` so the platform Customer is the right shape).
model ConnectCustomer {
  id                        String   @id @default(uuid())
  client_user_id            String   @unique
  client                    User     @relation(fields: [client_user_id], references: [id])
  stripe_customer_id        String   @unique
  // Mirror of `invoice_settings.default_payment_method` — convenience for
  // mobile "saved cards" UI. Updated by customer.updated webhook.
  default_payment_method_id String?
  default_card_brand        String?
  default_card_last4        String?
  default_card_exp_month    Int?
  default_card_exp_year     Int?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  @@index([stripe_customer_id])
}

// Phase 2-3 Connect — One row per checkout session / purchase intent.
//
// Created at checkout-session creation time in status=pending. Lifecycle
// is driven by webhooks:
//   - checkout.session.completed -> status=paid (one_time) or active
//     (recurring) + entitlement_active=true.
//   - customer.subscription.updated -> mirror status (active|past_due|...).
//   - customer.subscription.deleted -> status=canceled, entitlement_active=false.
//   - payment_intent.payment_failed -> status=payment_failed.
//
// Entitlement is the derived "does this client currently have access to
// this package?" bit. Computed and persisted on every status change so
// that authorization checks are a single indexed read.
//
// One row per checkout session. Failed sessions are kept (status=expired
// or =canceled) for analytics / chargeback investigations.
model ClientPurchase {
  id                         String       @id @default(uuid())
  client_user_id             String
  client                     User         @relation("ClientPurchaseClient", fields: [client_user_id], references: [id])
  coach_user_id              String
  coach                      User         @relation("ClientPurchaseCoach", fields: [coach_user_id], references: [id])
  package_id                 String
  package                    CoachPackage @relation(fields: [package_id], references: [id])
  // Snapshot of price at purchase time. Source of truth for what the
  // client actually paid even if the package later changes price.
  amount_cents               Int
  currency                   String       @default("usd")
  billing_type               String       @default("one_time") // one_time | recurring — snapshotted
  // Stripe ids. checkout_session_id is set at creation; the others are
  // populated as the lifecycle webhooks fire.
  stripe_checkout_session_id String       @unique
  stripe_payment_intent_id   String?
  stripe_subscription_id     String?      @unique
  stripe_customer_id         String?
  // Connect destination account — the coach's Express account. Persisted
  // for revenue reconciliation; the Stripe Charge has the same value on
  // its `destination` field.
  stripe_destination_account String?
  // Lifecycle.
  status                     String       @default("pending")
  // ^ pending | paid | active | past_due | canceled | payment_failed | expired
  entitlement_active         Boolean      @default(false)
  // When does access end. Null = no expiry / open-ended.
  // For one_time with duration_periods=N weeks, set to created_at + N weeks
  // at purchase time. For recurring, mirrors current_period_end.
  access_expires_at          DateTime?
  current_period_end         DateTime?
  cancel_at_period_end       Boolean      @default(false)
  canceled_at                DateTime?
  // Idempotency key used when minting the Stripe Checkout session. Stored
  // so retries collapse to the same row.
  idempotency_key            String       @unique
  // Cached Stripe PaymentIntent secrets for idempotent retries on the
  // PaymentIntent path. Null on Checkout-session (web redirect) flows.
  // Populated by createPaymentIntentForClient.
  stripe_client_secret       String?
  stripe_ephemeral_key       String?
  // Free-form error message from Stripe on the last failed transition
  // (e.g. last_payment_error.message). Surfaced in mobile billing UI.
  last_error                 String?
  created_at                 DateTime     @default(now())
  updated_at                 DateTime     @updatedAt

  splits         SplitLedgerEntry[]
  transfers      ConnectTransfer[]
  dunning        DunningState?
  reminders      PaymentReminder[]
  refunds        ChargeRefund[]
  disputes       ChargeDispute[]
  reconciliation ReconciliationSnapshot?

  /// PR-14 — landing page attribution. GuestCheckout already captures the
  /// referring landing page (R47); convertGuestToUser now copies the id
  /// onto this column inside its conversion $transaction so per-page
  /// revenue / LTV joins read directly off ClientPurchase. Nullable: in-app
  /// purchases and direct-storefront guest checkouts leave it null.
  landing_page_id String?

  // PR-3 Packages & Drip-Feed foundation. scheduled_drops is the
  // per-buyer schedule snapshotted at purchase; fanout is the 1:1
  // bookkeeping row tracking the package→schedule materialisation job.
  scheduled_drops ScheduledDrop[]
  fanout          PurchaseFanout?

  // B5 — Digital Contracts. One signed envelope binds to one realized
  // purchase. Nullable + @unique: existing purchases keep null (no
  // backfill), and the FK is set ONLY after Stripe payment success so the
  // signed PDF is linked to the realized purchase (spec §3.3 / §4.1).
  contract_envelope_id String?           @unique
  contract_envelope    ContractEnvelope? @relation("PurchaseContractEnvelope", fields: [contract_envelope_id], references: [id])

  @@index([client_user_id, status])
  @@index([coach_user_id, status])
  @@index([package_id])
  @@index([stripe_subscription_id])
  @@index([entitlement_active, access_expires_at])
  @@index([landing_page_id])
  @@index([contract_envelope_id])
}

// Phase 4 Connect — Per-coach fee policy override.
//
// Default platform policy is hard-coded in FeePolicyService:
//   - 2% application fee to platform (TGP) on every coach-package charge.
//   - 5% transfer to head coach when the selling coach is a sub-coach
//     (resolved via TeamSubCoachAssignment, non-archived).
//
// This row lets us override either side of that for a specific coach
// (e.g. legacy white-glove deals, enterprise gym contracts). Both basis-
// point fields are nullable — null falls back to the global default.
//
// Why bps not percent: bps lets a fee like 2.5% live in an integer column.
// 200 bps = 2.00%. The split engine always rounds toward platform safety
// (i.e. floors the destination amount; the platform absorbs the rounding
// fraction to avoid landing a sub-cent in the connected account).
model FeePolicy {
  id                           String   @id @default(uuid())
  // Owning coach this override applies to. Same coach who sells packages.
  // When the head-coach split is in play, this row's coach_id is the
  // SELLER (sub-coach) — the head-coach split bps lives here because
  // the rate is "what the sub-coach gives up", not "what the head coach
  // takes". This keeps "I sell, I see my own policy" simple.
  coach_id                     String   @unique
  coach                        User     @relation("FeePolicyCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  // Override of the 2% platform fee. Null = use global default.
  platform_application_fee_bps Int?
  // Override of the 5% head-coach split (only applies when coach is a
  // sub-coach). Null = use global default.
  head_coach_split_bps         Int?
  // Hard cap so a bad write can't accidentally route 100% of revenue to
  // platform/head-coach. Both halves combined must be < 5000 bps (50%).
  // Enforced in FeePolicyService.assertSane().
  notes                        String?
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt
}

// Phase 4 Connect — Immutable money-split ledger.
//
// One row per (purchase, payee, fee_kind). Written by the webhook
// pipeline AFTER Stripe confirms the charge succeeded, so every row
// corresponds to real money that actually moved. Composite unique on
// (purchase_id, kind, payee_user_id) ensures retries collapse onto the
// same row and never double-credit.
//
// Lifecycle:
//   - pending  : row written at split-plan time; no Stripe call yet.
//   - posted   : Stripe transfer/application-fee succeeded. Has a
//                stripe_transfer_id (for `transfer` kind) or the parent
//                charge id (for `application_fee` and `destination`).
//   - reversed : a refund or transfer_reversal was applied. amount_cents
//                may differ from the original (partial reversal).
//   - failed   : the transfer attempt errored. last_error has the
//                Stripe-reported message. Retried by the dunning job.
model SplitLedgerEntry {
  id                        String         @id @default(uuid())
  purchase_id               String
  purchase                  ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  // What this row represents — see comment block above.
  //   application_fee : the platform's 2% cut (deducted via Stripe
  //                     application_fee_amount on the destination charge).
  //                     payee is platform itself (payee_user_id=null).
  //   destination     : the selling coach's gross share routed via
  //                     transfer_data[destination]. payee_user_id = seller.
  //   head_coach_split: a follow-on Transfer the platform mints to the
  //                     head coach when the seller is a sub-coach.
  //                     payee_user_id = head coach.
  kind                      String
  // The user receiving this slice. Null for application_fee (platform).
  payee_user_id             String?
  payee                     User?          @relation("SplitLedgerPayee", fields: [payee_user_id], references: [id], onDelete: SetNull)
  // Stripe connected account that received the funds. Null for
  // application_fee (platform retains).
  payee_stripe_account_id   String?
  amount_cents              Int
  currency                  String         @default("usd")
  status                    String         @default("pending") // pending | posted | reversed | failed
  // Stripe ids that locate this slice in Stripe's books.
  //  - For kind=application_fee: stripe_charge_id + stripe_application_fee_id.
  //  - For kind=destination    : stripe_charge_id + (auto) transfer id on charge.transfer.
  //  - For kind=head_coach_split: stripe_transfer_id (the follow-on transfer
  //                                we minted) + stripe_charge_id as source.
  stripe_charge_id          String?
  stripe_application_fee_id String?
  stripe_transfer_id        String?
  // For partial-reversal accounting: how much of this slice has been
  // reversed back to the platform. Always <= amount_cents.
  reversed_cents            Int            @default(0)
  // Idempotency-key we sent to Stripe when posting this slice. Lets the
  // worker retry safely. Globally unique.
  idempotency_key           String?        @unique
  last_error                String?
  posted_at                 DateTime?
  reversed_at               DateTime?
  created_at                DateTime       @default(now())
  updated_at                DateTime       @updatedAt

  @@unique([purchase_id, kind, payee_user_id])
  @@index([purchase_id])
  @@index([status])
  @@index([kind, status])
  @@index([payee_user_id, status])
}

// Phase 4 Connect — Follow-on Connect transfer record.
//
// Distinct from SplitLedgerEntry: the ledger tells us "who owes whom how
// much"; ConnectTransfer is the operational receipt for each Stripe
// /v1/transfers POST. One transfer row per outgoing Stripe transfer
// (e.g. the head-coach 5% split). application_fee splits are not
// transfers (they're deducted at charge time) so they live only in the
// ledger.
//
// Status drives the retry worker: pending -> in_flight -> succeeded |
// failed. failed rows get retried up to max_attempts with exponential
// backoff (next_attempt_at); the dunning sweeper picks them up.
model ConnectTransfer {
  id                            String         @id @default(uuid())
  purchase_id                   String
  purchase                      ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  ledger_entry_id               String?        @unique
  // Destination connected account (head coach for the sub-coach split).
  destination_stripe_account_id String
  destination_user_id           String?
  destination                   User?          @relation("ConnectTransferDestination", fields: [destination_user_id], references: [id], onDelete: SetNull)
  amount_cents                  Int
  currency                      String         @default("usd")
  // Source charge id (the original payment intent's charge). Stripe needs
  // this on `source_transaction` so the transfer is paid out of that
  // charge's available balance and reconciles against the same payment.
  source_stripe_charge_id       String?
  stripe_transfer_id            String?
  status                        String         @default("pending") // pending | succeeded | failed | reversed
  attempts                      Int            @default(0)
  max_attempts                  Int            @default(6)
  next_attempt_at               DateTime?
  last_attempt_at               DateTime?
  last_error                    String?
  // Idempotency-key used on the Stripe /v1/transfers call.
  idempotency_key               String         @unique
  posted_at                     DateTime?
  reversed_at                   DateTime?
  reversed_amount_cents         Int            @default(0)
  created_at                    DateTime       @default(now())
  updated_at                    DateTime       @updatedAt

  @@index([status, next_attempt_at])
  @@index([destination_user_id])
  @@index([purchase_id])
}

// Phase 5 Connect — Dunning state per recurring purchase.
//
// One row per ClientPurchase with billing_type=recurring once Stripe
// reports a failed renewal. We track the dunning window (which renewal
// attempt are we on, when does the grace period end, was a final cancel
// scheduled). The reminder cron uses this row to drive in-app + email
// nudges; cancel scheduling honors the dunning_status state machine.
//
// Lifecycle:
//   none -> active -> resolved | abandoned
//
//   active: at least one payment failure has fired in the current window
//   resolved: a subsequent invoice.paid cleared the window
//   abandoned: max_attempts reached or grace_period_ends_at elapsed —
//              the purchase will be canceled by the next sweeper run.
model DunningState {
  id                       String         @id @default(uuid())
  purchase_id              String         @unique
  purchase                 ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  status                   String         @default("active") // active | resolved | abandoned
  failure_count            Int            @default(0)
  // Highest attempt count reported by Stripe (invoice.attempt_count).
  // Drives "this is your 3rd failed attempt" copy in reminders.
  last_attempt_number      Int?
  last_failed_amount_cents Int?
  last_failure_at          DateTime?
  last_failure_reason      String?
  grace_period_ends_at     DateTime?
  // Scheduled cancellation — when this fires, the recurring sub will be
  // canceled by the sweeper and entitlement turned off. Null while still
  // in the grace window.
  cancel_scheduled_at      DateTime?
  resolved_at              DateTime?
  abandoned_at             DateTime?
  // DUNNING-V1 — cadence state. step_index is the highest cadence step
  // that has fired (-1 = none yet, 0 = soft sent, 1 = urgent sent, 2 =
  // final sent, 3 = cancelled). next_attempt_at = scheduled_for of the
  // earliest pending DunningAttempt, denormalized so the tick loop can
  // index-scan on (status, next_attempt_at).
  step_index               Int            @default(-1)
  next_attempt_at          DateTime?
  entered_at               DateTime?
  recovered_at             DateTime?
  escalated_at             DateTime?
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt
  // DUNNING-V2 (B3 §2.2) — Day-10 hard-lockout marker. Null until the
  // lockout sweep flips it; cleared back to null on same-request recovery.
  // Nullable: every existing row and read path is preserved unchanged.
  locked_out_at            DateTime?
  // DUNNING-V2 (B3 §2.2 / §6) — late-reversal cycle counter. 0 = first /
  // normal dunning cycle. Incremented once per cycle-open when a cleared
  // charge is later reversed. Drives regular-vs-"again" copy selection.
  // Defaulted: existing rows read back 0 (zero-mutation-elsewhere).
  reversal_count           Int            @default(0)

  attempts DunningAttempt[]

  @@index([status])
  @@index([status, cancel_scheduled_at])
  @@index([status, next_attempt_at])
}

// DUNNING-V2 (B3 §2.1) — branded JWT recovery links. NEW TABLE ONLY; no FK
// alter on any existing table. `dunning_attempt_id` is a bare unique string
// (no Prisma @relation) so DunningAttempt is not mutated. The row exists for
// revocation + audit; JWT verification is signature + exp + jti-live +
// used_at IS NULL. Gated entirely behind FEATURE_DUNNING_V2 at the service
// layer — no v1 path reads or writes this table.
model PaymentRecoveryToken {
  id                 String    @id @default(uuid())
  dunning_attempt_id String    @unique // 1:1 with the attempt that minted it
  jwt_jti            String    @unique // the JWT's jti claim; revoke without storing the token
  expires_at         DateTime
  used_at            DateTime?
  ip                 String?
  ua                 String?
  created_at         DateTime  @default(now())

  @@index([expires_at])
  @@index([jwt_jti])
}

// DUNNING-V1 — one row per scheduled cadence step.
//
// At first failure DunningService schedules N attempts (one per cadence
// day) all with status='pending'. The tick loop drains any whose
// scheduled_for <= now. (dunning_state_id, step_index) is unique so
// re-running recordFailure is idempotent. Once sent, sent_at is stamped
// and email_idempotency_key is the dedup key handed to EmailService.
model DunningAttempt {
  id                    String       @id @default(uuid())
  dunning_state_id      String
  dunning_state         DunningState @relation(fields: [dunning_state_id], references: [id], onDelete: Cascade)
  // 0..N — position in the cadence. -1 reserved for ad-hoc "trigger now"
  // re-fires created by admin override.
  step_index            Int
  // soft | urgent | final | recovered | cancelled
  kind                  String
  scheduled_for         DateTime
  // pending | sending | sent | failed | failed_permanent | skipped | cancelled
  //
  // 'sending' is the in-flight CAS claim slot used by tick() to prevent the
  // race window described in PR #281 P1-1: a pending row is atomically flipped
  // to 'sending' via updateMany({where: status=pending}) before the outbound
  // email is dispatched. recordResolution() then only flips status=pending
  // rows to cancelled, leaving any in-flight 'sending' row alone — which means
  // the tick worker's subsequent 'sending' → 'sent' write is safe and a late
  // payment-success webhook cannot resurrect a cancelled row.
  status                String       @default("pending")
  sent_at               DateTime?
  email_idempotency_key String?      @unique
  provider_message_id   String?
  failure_reason        String?
  // Send-retry bookkeeping (PR #281 P2-3). When email.send() throws or
  // returns a failed provider response, the row is flipped to status='failed'
  // and next_retry_at is set to now + exponential backoff. The tick loop
  // re-picks status='failed' rows whose next_retry_at <= now, up to
  // retry_count >= DUNNING_MAX_SEND_RETRIES, after which the row is marked
  // 'failed_permanent' and dropped (and a dunning_attempt_failed_permanent_total
  // counter increments so ops can alert).
  retry_count           Int          @default(0)
  next_retry_at         DateTime?
  // Set when a concurrent recordResolution() raced ahead of a send the tick
  // worker had already claimed (status='sending'). Lets ops audit "customer
  // got a reminder after they paid" cases — these are expected and rare but
  // we want visibility. PR #281 P1-1.
  superseded_at         DateTime?
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  @@unique([dunning_state_id, step_index])
  @@index([status, scheduled_for])
  @@index([status, next_retry_at])
  @@index([dunning_state_id, status])
}

// Phase 5 Connect — Outbound reminder log.
//
// One row per reminder we attempted to deliver (email / in-app / push).
// Append-only audit feed; the reminder cron uses (purchase_id, kind,
// status) to avoid double-sending the same reminder in the same dunning
// window. The status mirrors the delivery worker outcome.
model PaymentReminder {
  id                String         @id @default(uuid())
  purchase_id       String
  purchase          ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  // What event we are reminding about.
  //  payment_failed   : first failure (or first failure in window)
  //  retry_scheduled  : Stripe will retry on date X
  //  final_warning    : last reminder before cancel_scheduled_at fires
  //  canceled_for_nonpayment : the sub was canceled
  kind              String
  // Which surface we attempted: email | inapp | push
  channel           String
  // Who we were notifying — typically the client; may also be the seller
  // coach when the failure is on a high-value purchase.
  recipient_user_id String
  recipient         User           @relation("PaymentReminderRecipient", fields: [recipient_user_id], references: [id], onDelete: Cascade)
  status            String         @default("queued") // queued | sent | failed | skipped
  sent_at           DateTime?
  failure_reason    String?
  // Idempotency window the reminder belongs to. For payment_failed we
  // use the Stripe invoice id; for retry_scheduled we use the next
  // attempt date stringified. Same (purchase_id, kind, window_key)
  // collapses to a single row.
  window_key        String
  created_at        DateTime       @default(now())

  @@unique([purchase_id, kind, channel, window_key])
  @@index([purchase_id, kind])
  @@index([status])
  @@index([recipient_user_id])
}

// Phase 6 Connect — Cached snapshot of a coach's Stripe Connect balance
// and most-recent payout state. Stripe is the source of truth; this row
// is a poll-cached read for the admin/coach UIs so dashboards don't hit
// the Stripe API on every page load.
//
// Refreshed by:
//   - The /v1/admin/payments/coaches/:id/payout-readiness endpoint (on read).
//   - The payout.* webhook handlers (on Stripe-driven change).
//   - A periodic sweeper (best-effort).
//
// stale_after is a soft TTL — readers older than this should refresh.
// Lifecycle:
//   "ready" : charges_enabled && payouts_enabled && no requirements && positive available.
//   "needs_action" : Stripe requirements_due is non-empty or disabled_reason set.
//   "no_account" : no ConnectAccount row at all (this row will not exist).
//   "deauthorized" : ConnectAccount.deauthorized_at is set.
//   "negative_balance" : available_cents <= 0 with pending positive.
model PayoutSnapshot {
  id                          String    @id @default(uuid())
  coach_user_id               String    @unique
  coach                       User      @relation("PayoutSnapshotCoach", fields: [coach_user_id], references: [id], onDelete: Cascade)
  stripe_account_id           String
  // High-level readiness verdict (see comment above).
  readiness_status            String    @default("needs_action")
  // Mirror of Stripe Connect account flags at snapshot time.
  charges_enabled             Boolean   @default(false)
  payouts_enabled             Boolean   @default(false)
  details_submitted           Boolean   @default(false)
  // Free-form list of Stripe requirements (currently_due, eventually_due,
  // past_due, disabled_reason). Stored verbatim so the UI can render the
  // exact next-action steps.
  requirements_due            Json?
  disabled_reason             String?
  // Stripe Balance object — split into available + pending. Stripe returns
  // these as arrays of {amount, currency, source_types}; we collapse to a
  // single integer per currency (the default) and stash the raw payload
  // on raw_balance for UIs that want the full breakdown.
  available_cents             Int       @default(0)
  pending_cents               Int       @default(0)
  // Total amount currently in "in_transit" payouts (Stripe object).
  in_transit_cents            Int       @default(0)
  // Reserved funds Stripe has locked (rolling reserve).
  reserved_cents              Int       @default(0)
  currency                    String    @default("usd")
  raw_balance                 Json?
  // Most-recent payout from Stripe (drives the "last paid out" widget).
  last_payout_stripe_id       String?
  last_payout_amount_cents    Int?
  last_payout_status          String? // pending | in_transit | paid | failed | canceled
  last_payout_arrival_at      DateTime?
  last_payout_failure_message String?
  // When the next scheduled payout will land (Stripe automatic schedule).
  next_payout_at              DateTime?
  // Soft TTL — UIs/cron consider a snapshot older than this for refresh.
  refreshed_at                DateTime  @default(now())
  stale_after                 DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  @@index([readiness_status])
  @@index([stripe_account_id])
}

// ============================================================
// Bank-Account Payouts v2 (spec §2 — FEATURE_BANK_PAYOUTS_V2, default OFF)
// ============================================================
//
// The architecture (spec §1.2, LOCKED) ships v1 on Stripe Connect Custom +
// Stripe Financial Connections: coaches link a bank account through the
// Stripe-hosted Financial Connections widget; we create an `external_account`
// on the coach's Connect Custom account and route payouts there (T+2 ACH).
// Stripe remains the merchant-of-record and the 1099-K filer in EVERY case
// (see §5 KYC/1099 posture below) — the backend never moves money itself and
// holds NO custody/ledger responsibility in v1.
//
// KYC / 1099 posture (spec §5, read-only in this PR): because we stay on
// Stripe Connect Custom, Stripe issues the 1099-K and handles W-9 collection,
// state 1099s, backup withholding, and IRS B-notices. TGP does NONE of that
// for v1. This schema therefore stores NO tax-identity fields (no W-9, no TIN,
// no withholding state) — deliberately, so we never become a TPSO / payment
// facilitator. The actual 1099 generator is explicitly a LATER PR.
//
// Treasury upgrade path (spec §6): `STRIPE_TREASURY` is reserved in the kind
// enum so the Option B -> Option C migration is a flag-flip
// (`FEATURE_STRIPE_TREASURY_PAYOUTS`) plus a per-coach opt-in, with no
// re-architecture. The routing switch (§2.5) already has an inert branch for it.

enum PayoutMethodKind {
  STRIPE_EXPRESS
  STRIPE_CONNECT_CUSTOM_BANK
  STRIPE_TREASURY
}

enum PayoutMethodStatus {
  PENDING_VERIFICATION
  VERIFIED
  DISABLED
}

// A coach-linked payout destination. NET-NEW table (spec §2.2). One row per
// linked bank account; `default` marks the coach's active destination and is
// mirrored by `User.default_payout_method_id`. `stripe_external_account_id`
// holds the Stripe `ba_...` / `fca_...` id (null for a pure Express fallback
// row). Lifecycle: PENDING_VERIFICATION -> VERIFIED (driven by the Stripe
// `account.external_account.updated` webhook) -> DISABLED (soft-delete).
model PayoutMethod {
  id                         String             @id @default(cuid())
  coach_id                   String
  kind                       PayoutMethodKind
  stripe_external_account_id String? // ba_... or fca_... ; null for pure Express
  last4                      String?
  bank_name                  String?
  status                     PayoutMethodStatus @default(PENDING_VERIFICATION)
  default                    Boolean            @default(false)
  created_at                 DateTime           @default(now())

  coach       User   @relation("CoachPayoutMethods", fields: [coach_id], references: [id], onDelete: Cascade)
  // Back-relation for User.default_payout_method (the nullable FK lives on User).
  default_for User[] @relation("UserDefaultPayoutMethod")

  @@index([coach_id])
  @@index([coach_id, status])
}

// Phase 6 Connect — Refund record per ClientPurchase.
//
// Source of truth is Stripe's Refund object; this table is the local
// mirror so admin/coach UIs can list refunds without hitting the Stripe
// API. Refunds may be created by us (admin tooling, POST refund) OR by
// Stripe (chargeback workflow that issues a refund automatically) — both
// paths converge here via the charge.refunded / charge.refund.updated
// webhook.
//
// A refund triggers (a) a ledger reversal on the matching destination
// slice (b) a follow-on Transfer reversal on the head-coach slice if
// present. Both happen in PurchaseSplitHandlerService.onRefund().
model ChargeRefund {
  id                   String         @id @default(uuid())
  purchase_id          String
  purchase             ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  // Stripe ids — both indexed for webhook idempotency lookup.
  stripe_refund_id     String         @unique
  stripe_charge_id     String
  amount_cents         Int
  currency             String         @default("usd")
  // Stripe-side status: pending | requires_action | succeeded | failed | canceled
  status               String         @default("pending")
  // Refund reason (Stripe: duplicate | fraudulent | requested_by_customer | expired_uncaptured_charge).
  reason               String?
  // Free-form admin note (only set when we initiated the refund).
  note                 String?
  // Who issued the refund: admin_user_id when one of our owners did it,
  // null when Stripe / the bank dispute workflow created it.
  initiated_by_user_id String?
  failure_reason       String?
  // Whether we've reversed the matching ledger entry / head-coach transfer.
  ledger_reversed      Boolean        @default(false)
  transfer_reversed    Boolean        @default(false)
  posted_at            DateTime?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  @@index([purchase_id])
  @@index([status])
  @@index([stripe_charge_id])
}

// Phase 6 Connect — Dispute (chargeback) record per ClientPurchase.
//
// Mirror of Stripe's Dispute object. Lifecycle (Stripe statuses):
//   warning_needs_response | warning_under_review | warning_closed
//   needs_response | under_review | charge_refunded | won | lost
//
// On dispute open we mark the matching ClientPurchase status as
// `disputed` for UI display but DO NOT reverse the ledger automatically
// — the funds remain in the destination account until Stripe issues a
// chargeback. If the dispute is lost, Stripe withdraws funds via a
// negative balance transaction; we then post a reversal in the ledger
// via ReconciliationService.applyDisputeLoss(). If won, we no-op (the
// disputed_until_resolved flag is cleared).
model ChargeDispute {
  id                     String         @id @default(uuid())
  purchase_id            String
  purchase               ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  stripe_dispute_id      String         @unique
  stripe_charge_id       String
  amount_cents           Int
  currency               String         @default("usd")
  status                 String         @default("needs_response")
  reason                 String? // generic | fraudulent | duplicate | product_not_received | ...
  // Stripe-set deadline for responding to the dispute.
  evidence_due_by        DateTime?
  // Whether evidence has been submitted (by an admin, or auto-submitted).
  evidence_submitted_at  DateTime?
  // Final outcome ledger reversal — set when the dispute was lost and we
  // reversed the destination ledger entry.
  ledger_reversed        Boolean        @default(false)
  // Final outcome flag — closed_at is set on `won` | `lost` | `charge_refunded`.
  closed_at              DateTime?
  // Stripe-side balance transaction id for the chargeback debit (when lost).
  // Used to reconcile the negative balance against our ledger.
  balance_transaction_id String?
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt

  @@index([purchase_id])
  @@index([status])
  @@index([stripe_charge_id])
}

// Phase 6 Connect — Reconciliation snapshot per ClientPurchase.
//
// One row per purchase, written whenever ReconciliationService runs
// against a purchase (on-demand via admin endpoint, or by the nightly
// sweeper). Captures the diff between (a) Stripe's books for the
// underlying Charge / Transfers / Refunds and (b) our SplitLedgerEntry
// + ConnectTransfer rows. drift_cents=0 + status=ok means real money
// matches our model.
//
// Lifecycle:
//   - ok        : Stripe & ledger agree.
//   - drift     : Stripe & ledger disagree by drift_cents (non-zero).
//                 The admin UI shows this purchase as "needs review".
//   - unknown   : Stripe call failed (network/auth) — drift_cents is
//                 null; the snapshot is informational only.
model ReconciliationSnapshot {
  id                           String         @id @default(uuid())
  purchase_id                  String         @unique
  purchase                     ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  status                       String         @default("ok") // ok | drift | unknown
  drift_cents                  Int?
  // Stripe-side gross / refunded / application_fee / transfers.
  stripe_amount_cents          Int?
  stripe_refunded_cents        Int?
  stripe_application_fee_cents Int?
  stripe_transfers_cents       Int?
  // Ledger-side rollups.
  ledger_destination_cents     Int?
  ledger_application_fee_cents Int?
  ledger_head_coach_cents      Int?
  ledger_reversed_cents        Int?
  notes                        String?
  last_checked_at              DateTime       @default(now())
  created_at                   DateTime       @default(now())
  updated_at                   DateTime       @updatedAt

  @@index([status])
}

// Phase 8 Connect / Team-mode mobile-contract models.
//
// TeamProfile is a *minimal* org/gym record attached to the head coach.
// We deliberately do NOT model gyms as first-class tenants — Phase 8
// only needs a name + shareable code + cached aggregate counters so the
// mobile coach team screen can render real numbers instead of empty
// states. When (if) we promote gyms to first-class tenants this row will
// migrate into a `team_id` FK; the head coach link stays around as the
// owner pointer.
//
// `team_code` is the public shareable string (`GP-TEAM-XXXX` shape).
// Unique across all teams so a client signing up with the code lands on
// the right head coach.
//
// `client_capacity` + `clients_assigned` are denormalized aggregates
// owned by service-layer math: the head-coach screen reads them with a
// single indexed lookup. They are recomputed when sub-coaches are
// added/removed or when a client is reassigned.
model TeamProfile {
  id               String   @id @default(uuid())
  // The owning head coach. One profile per head coach (1:1).
  head_coach_id    String   @unique
  head_coach       User     @relation("TeamProfileHeadCoach", fields: [head_coach_id], references: [id], onDelete: Cascade)
  business_name    String
  // Shareable team / gym code (unique). Generated on first PUT; rotates
  // only on explicit caller request (TBD: write endpoint not exposed in
  // Phase 8 — the head coach edits business_name; the code is fixed at
  // creation time so existing client signup links keep working).
  team_code        String   @unique
  client_capacity  Int      @default(0)
  clients_assigned Int      @default(0)
  // Mirror of ConnectAccount.payouts_enabled — surfaced on the team
  // screen as a hint that revenue/payouts are one tap away. Source of
  // truth still ConnectAccount; this is a cached read.
  payouts_enabled  Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([team_code])
}

// Phase 8 — Email-based sub-coach invite.
//
// One row per outbound invite. `token_hash` is the SHA-256 hex digest of
// the raw URL-safe token returned to the caller; the plaintext token is
// never persisted. On accept/preview the presented token is hashed before
// the DB lookup so a DB-dump does not yield consumable tokens.
//
// Transition window: the legacy `token` column (plaintext) is kept nullable
// for the backwards-compatibility window while pre-rollout unredeemed
// invites expire (INVITE_TTL_DAYS = 14 days). New writes populate
// `token_hash` only and leave `token` null. Accept/preview first tries
// the hash lookup; if not found it falls back to a plaintext `token`
// lookup for legacy rows. A follow-up migration drops `token` once all
// pre-rollout invites have expired or been revoked.
//
// Revocation: `revoked_at` + `revoked_by_user_id` makes the audit trail
// queryable; the same column also short-circuits the accept endpoint.
//
// Optional `max_clients` ceiling: when the sub-coach accepts, this is
// snapshotted onto their CoachProfile so the head coach's per-seat cap
// preference is preserved.
model SubCoachInvite {
  id                  String    @id @default(uuid())
  head_coach_id       String
  head_coach          User      @relation("SubCoachInviteIssuer", fields: [head_coach_id], references: [id], onDelete: Cascade)
  email               String
  name                String?
  max_clients         Int?
  // DEPRECATED: plaintext token kept for legacy unredeemed invites issued
  // before the token_hash rollout. New writes set this to null. Drop in the
  // follow-up migration once all pre-rollout invites have expired (14 days).
  token               String?   @unique
  // SHA-256 hex digest of the raw invite token. This is what gets stored
  // for all new invites. Unique enforced by DB index (see migration).
  token_hash          String?   @unique
  expires_at          DateTime
  accepted_at         DateTime?
  accepted_by_user_id String?
  accepted_by         User?     @relation("SubCoachInviteAccepter", fields: [accepted_by_user_id], references: [id], onDelete: SetNull)
  revoked_at          DateTime?
  revoked_by_user_id  String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([head_coach_id, accepted_at])
  @@index([email])
}

// ─── Video library: ExerciseCatalogItem ────────────────────────────────────
//
// Canonical, owner-curated exercise catalog used by the mobile workout flow.
// Coexists with the legacy ExerciseDB proxy in src/exercise-library: this
// table is the source of truth for any exercise the platform has its own
// demo video for, while the ExerciseDB proxy remains as a wide-catalog
// fallback for the workout builder.
//
// Video state machine:
//
//   none       — no Mux asset yet. mux_* columns null. playbackUrl=null.
//   uploading  — owner created a direct-upload URL; Mux has not finalized
//                the asset yet (no asset id in webhook fan-out).
//   processing — asset created on Mux; transcoding in flight. mux_asset_id
//                is set, but mux_playback_id is not yet usable.
//   ready      — webhook `video.asset.ready` landed; mux_playback_id is
//                usable. The /exercise-catalog/:idOrSlug detail route
//                mints a playback URL when this state is reached.
//   errored    — webhook `video.asset.errored` landed. mux_error_message
//                carries the upstream reason. Treated identically to
//                `none` for playback (playbackUrl=null).
//
// Slugs are hand-derived from the seed catalog (`seed:push-001` →
// "barbell-bench-press") and used by the mobile client when navigating
// from a workout assignment row to the exercise detail screen. Slugs are
// unique and stable; renaming requires a migration.
model ExerciseCatalogItem {
  id                String   @id @default(uuid())
  // Stable URL slug — e.g. "barbell-bench-press". Mobile client navigates
  // via /exercise-catalog/:idOrSlug so either the uuid or the slug works.
  slug              String   @unique
  name              String
  category          String
  primary_muscle    String
  secondary_muscles String[] @default([])
  equipment         String[] @default([])
  // Free-text label (beginner | intermediate | advanced). Not an enum so
  // we can extend without a migration.
  difficulty        String   @default("beginner")
  instructions      String[] @default([])
  // Optional source pointer for provenance — e.g. "seed:push-001" when the
  // catalog row was derived from SEED_EXERCISES, or "wger:75" if a future
  // import path lands.
  source_ref        String?

  // Mux state. All four are null until an owner attaches a video.
  mux_asset_id         String?
  mux_playback_id      String?
  // 'public' (direct HLS) or 'signed' (requires MUX_SIGNING_KEY). The
  // detail route uses this to decide whether to mint a JWT or hand back
  // the bare URL. Defaults to 'public' for v1 simplicity.
  mux_playback_policy  String              @default("public")
  mux_asset_status     ExerciseVideoStatus @default(none)
  mux_duration_seconds Float?
  mux_error_message    String?
  // Direct-upload bookkeeping: when an owner POSTs /video/upload we
  // create a Mux Direct Upload and remember its id so the webhook can
  // resolve the upload back to the catalog row when the asset is born.
  mux_upload_id        String?             @unique

  // Third-party video provider enrichment (YMove / MuscleWiki).
  // Populated by scripts/enrich-exercise-catalog-videos.ts.
  // video_url stores a stable MuscleWiki MP4 CDN URL or a YMove slug
  // sentinel (prefix: "ymove:") — never the expiring signed URL.
  // video_provider is 'ymove' | 'musclewiki' | null.
  video_url      String?
  video_provider String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category])
  @@index([primary_muscle])
  @@index([mux_asset_id])
  @@index([video_provider])
}

enum ExerciseVideoStatus {
  none
  uploading
  processing
  ready
  errored
}

// ─── Email Send Log ─────────────────────────────────────────────────────
//
// Idempotency + send-receipts ledger for transactional email.
//
// One row per send attempt. The `idempotency_key` is a stable opaque
// caller-supplied string (e.g. "invite:<invite_code_id>"). A unique
// constraint on the key makes EmailService.send a no-op on retry — the
// second insert hits P2002 and the call returns status:'skipped' without
// re-hitting the provider.
//
// status lifecycle:
//   sending → sent     (provider 2xx)
//   sending → failed   (provider non-2xx or render error)
//   sending → logged   (EMAIL_TRANSPORT=log; payload only printed)
//
// We never delete rows — support uses this table to confirm "did we send
// the X email to Y on date Z" without needing to query the provider.
model EmailSendLog {
  id                  String    @id @default(uuid())
  idempotency_key     String    @unique
  // One of EmailTemplateKey values (free-text on the DB side to keep
  // adding new templates from a single source — src/email/email.types.ts).
  template_key        String
  // Lower-cased at write time. Indexed for support lookups.
  recipient_email     String
  // sending | sent | failed | logged
  status              String    @default("sending")
  // Provider message id when status='sent'. Null otherwise.
  provider_message_id String?
  // Truncated to 500 chars by the service layer. Null when no error.
  error               String?
  sent_at             DateTime?
  created_at          DateTime  @default(now())

  @@index([recipient_email, created_at])
  @@index([template_key, created_at])
  @@index([status, created_at])
}

// Phase 11 — Sub-coach assignment join table.
//
// User.coach_id always points at the HEAD COACH for a client. Sub-coach
// assignment is an overlay: a row here means the client is currently
// delegated to a sub-coach inside the head coach's team. unassigned_at
// is set when the delegation ends (history preserved). At most one open
// (unassigned_at IS NULL) row per client at a time — enforced by a
// partial unique index in the migration.
model SubCoachAssignment {
  id             String    @id @default(uuid())
  head_coach_id  String
  head_coach     User      @relation("SubCoachAssignmentHead", fields: [head_coach_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  sub_coach_id   String
  sub_coach      User      @relation("SubCoachAssignmentSub", fields: [sub_coach_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  client_id      String
  client         User      @relation("SubCoachAssignmentClient", fields: [client_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  assigned_at    DateTime  @default(now())
  unassigned_at  DateTime?
  assigned_by_id String?
  assigned_by    User?     @relation("SubCoachAssignmentActor", fields: [assigned_by_id], references: [id], onUpdate: Cascade, onDelete: SetNull)
  reason         String?

  @@index([head_coach_id])
  @@index([sub_coach_id, unassigned_at])
  @@index([client_id, unassigned_at])
}

// Phase 11 — Idempotency table for sub-coach mutation endpoints.
// Keyed by (actor_id, idempotency_key) so two retries from the same
// actor return the original stored result instead of executing twice.
// The unique index in the migration enforces the contract at the DB
// level; first-writer-wins, all later retries read the row back.
model SubCoachMutationIdempotency {
  id              String   @id @default(uuid())
  actor_id        String
  actor           User     @relation("SubCoachIdempotencyActor", fields: [actor_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  idempotency_key String
  action          String
  // Hash of the canonical request body. Allows replay-with-different-body
  // to be rejected with 422 rather than silently returning the wrong result.
  request_hash    String?
  // 'in_progress' while the mutation transaction is open; 'completed' once
  // the response is stored. Concurrent retries that lose the unique-key
  // race read the stored row and return its response.
  status          String   @default("completed")
  response        Json
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@unique([actor_id, idempotency_key], name: "SubCoachMutationIdempotency_actor_key")
  @@index([created_at])
}

// ChurnIntervention — Coach Command Center re-engagement message lifecycle.
//
// Stores a single AI-drafted re-engagement message for a specific at-risk
// client, its approval state (status), and its send outcome.
//
// Lifecycle:
//   DRAFT     → coach views Claude-drafted message
//   EDITED    → coach modified the draft text (edited_text != null)
//   SENT      → message was dispatched via CoachNudge + push
//   DISMISSED → coach skipped without sending
//
// Idempotency: idempotency_key is the mobile-generated UUID, unique per row.
// Duplicate draft creations for the same key return the existing row.
//
// Delivery: the actual message is persisted as a CoachNudge row (in-app);
// the row's nudge_id back-references the CoachNudge. Push notification is
// fire-and-forget (best-effort). Email is NOT used.
//
// RLS: ENABLE + FORCE ROW LEVEL SECURITY. Coaches can only read/write
// their own rows (coach_id = auth.uid()); clients have no access at all.
model ChurnIntervention {
  id                   String    @id @default(uuid())
  coach_id             String
  coach                User      @relation("ChurnInterventionCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  client_id            String
  client               User      @relation("ChurnInterventionClient", fields: [client_id], references: [id], onDelete: Cascade)
  draft_text           String
  edited_text          String?
  // 'draft' | 'edited' | 'sent' | 'dismissed'
  status               String    @default("draft")
  alert_id             String?
  risk_score_at_draft  Float?
  top_factor           String?
  idempotency_key      String    @unique
  // Separate idempotency key for the send transition. Distinct from
  // the draft `idempotency_key` so a coach can retry a send (a network
  // failure on POST /send) without colliding with the draft key. Unique
  // to dedup concurrent or replayed send requests.
  send_idempotency_key String?   @unique
  created_at           DateTime  @default(now())
  sent_at              DateTime?
  dismissed_at         DateTime?
  // FK to the CoachNudge row created when sent (null until sent). Not a
  // hard relation — CoachNudge may be SetNull on user delete, and we
  // tolerate the dangle.
  nudge_id             String?

  @@index([coach_id, status, created_at])
  @@index([client_id, created_at])
  @@index([coach_id, client_id])
}

// ── RecentAuthNonce (A1-C5-P1-3) ─────────────────────────────────────────────
// Single-use store for RecentAuthGuard HMAC tokens. Each token may be
// presented exactly once within its TTL window. A second presentation of
// the same token is rejected with 403 RECENT_AUTH_TOKEN_ALREADY_USED.
//
// The `hmac_suffix` column stores the first 16 hex characters of the full
// HMAC — sufficient to uniquely identify a token within the 5-minute TTL
// window without storing the full 64-char HMAC. The unique constraint on
// hmac_suffix is the enforcement mechanism; Prisma P2002 on insert = replay.
//
// A background cron (or the guard itself) SHOULD clean up expired nonces.
// The @@index([expires_at]) supports efficient sweeps. Until a cleanup job
// is wired, rows are bounded by the 5-minute TTL and low traffic volume.
model RecentAuthNonce {
  id          String   @id @default(cuid())
  hmac_suffix String   @unique
  user_id     String
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([expires_at])
  @@map("recent_auth_nonce")
}

// R43 — CoachBrief. One row per (coach_id, brief_date). Generation is
// idempotent via the unique constraint. brief_date is a YYYY-MM-DD string
// in the coach's local timezone (bucketDateLocal). brief_mode drives both
// which Claude prompt was used and which UI sections the mobile renders.
model CoachBrief {
  id                    String    @id @default(uuid())
  coach_id              String
  coach                 User      @relation("CoachBriefCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  brief_date            String
  status                String    @default("pending")
  generated_at          DateTime?
  // Stream 1 dormancy guard — set by the brief-render path when the coach
  // opens the brief in-app. Null = unread; the AI dormancy guard skips
  // auto-generation when the most recent 3 briefs are all unread.
  // Indexed below to keep the dormancy check cheap (~ms regardless of
  // brief history depth).
  read_at               DateTime?
  // Lease timestamp written when status flips to 'generating'. A
  // CoachBriefService caller may atomically reclaim rows where the lease
  // is older than the TTL (BRIEF_GENERATION_LEASE_MS) — this prevents a
  // crashed worker from leaving the row stuck in 'generating' forever.
  generation_started_at DateTime?
  narrative             String?
  brief_context         Json?
  action_items          Json?
  generated_by          String?
  brief_mode            String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@unique([coach_id, brief_date], name: "CoachBrief_coach_date_key")
  @@index([coach_id, brief_date])
  @@index([coach_id, status])
}

// R43 — CoachDailyLog. One free-text log per (coach_id, log_date). The
// coach writes this themselves; content max 4000 chars enforced at DTO.
model CoachDailyLog {
  id         String   @id @default(uuid())
  coach_id   String
  coach      User     @relation("CoachDailyLogCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  log_date   String
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([coach_id, log_date], name: "CoachDailyLog_coach_log_date_key")
  @@index([coach_id, log_date])
}

// R43 — CoachBriefPreferences. One row per coach. notification_time is
// HH:MM in 24h format, timezone is an IANA tz string. enabled=false
// removes the coach from the daily cron dispatch.
model CoachBriefPreferences {
  id                String   @id @default(uuid())
  coach_id          String   @unique
  coach             User     @relation("CoachBriefPrefsCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  notification_time String   @default("05:00")
  timezone          String   @default("America/Los_Angeles")
  enabled           Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([enabled, notification_time])
}

// R43 — Server-only push-dedup ledger. last_push_attempt_date and
// last_push_date were originally on CoachBriefPreferences, but coaches
// hold a direct UPDATE RLS policy on that table, which let them poison
// the dedup state and silently suppress their own push. The ledger has
// no coach RLS policies at all (service_role bypass only), so writes
// only happen through CoachBriefScheduler.
model CoachBriefPushLedger {
  id                       String    @id @default(uuid())
  coach_id                 String    @unique
  coach                    User      @relation("CoachBriefPushLedgerCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  // last_push_attempt_date — the day for which the most recent push
  // ATTEMPT was scoped. Used together with push_attempts_today to track
  // a bounded retry budget per day (P1-4 fix round 5).
  last_push_attempt_date   String?
  // last_push_date — the day for which delivery was actually confirmed
  // (Expo ticket status='ok'). Only this column is the "this coach got
  // their brief today" sentinel; last_push_attempt_date is observability
  // only.
  last_push_date           String?
  // P1-4 fix round 5: short-lived lease so two cron instances cannot
  // call pushToUser at the same minute. Set to now+90s right before
  // the Expo call; cleared on terminal outcome (delivered OR retry
  // budget exhausted). A stale lease (older than 90s) is reclaimable
  // so a crashed worker cannot wedge the day's push.
  push_attempt_lease_until DateTime?
  // P1-4 fix round 5: how many push attempts the scheduler has fired
  // for last_push_attempt_date so far. Capped at MAX_PUSH_ATTEMPTS
  // (5) so a long Expo outage cannot drive unbounded retries; resets
  // when last_push_attempt_date rolls over to a new day.
  push_attempts_today      Int       @default(0)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
}

// ============================================================
// R46 — COACH LANDING PAGE BUILDER (Phase 1: schema + RLS)
// Routes, services, and CRM adapters come in PR #2–#3.
// ============================================================

// LandingPageTemplate — four opinionated, locked-design templates.
// Coach chooses once at creation; the design system is frozen per
// template (spec §2 principle 8). Rename requires a new page.
enum LandingPageTemplate {
  transformation
  authority
  community
  offer
}

// LandingPageStatus — simple lifecycle state machine:
//   draft → published → archived
// `archived` is the post-unpublish state; public renderer returns 404.
// Spec §3.1: one-tap pause/unpublish is immediate.
enum LandingPageStatus {
  draft
  published
  archived
}

// LandingCtaType — what happens when a visitor hits the primary CTA.
//   checkout   → routes through TGP GuestCheckout (ZERO EXCEPTIONS, spec §3.2)
//   lead_form  → captures lead into CoachLandingLead, optional CRM push
//   book_call  → creates CoachBooking row (internal calendar, no Calendly)
enum LandingCtaType {
  checkout
  lead_form
  book_call
}

// LandingSectionKind — landing-page section archetypes a coach can place on
// a page (≤ 6 active; Miller's Law hard cap per spec §2 #3).  Payload JSON
// shape is enforced per-kind in the service layer (PR #2).
//
// R52 renderer-v2 (PR-LP-RENDERER-V2) adds three persuasion-arc kinds:
//   - problem_solution : 2-column "what's broken / what changes"
//   - mechanism        : 3-step how-it-works with iconography
//   - trust            : credentials, press, numeric proof
// The pre-existing kinds (before_after, pricing, offer_stack, guarantee)
// stay for backwards compatibility with pages built in Phase 1/2; the
// v2 renderer still draws them with the SaaS-brand token system.
enum LandingSectionKind {
  hero
  before_after
  testimonials
  pricing
  faq
  lead_form
  offer_stack
  guarantee
  problem_solution
  mechanism
  trust
}

// CrmSyncStatus — state of a CoachLandingLead's outbound CRM push.
// Lead is written with `pending` first; background worker transitions
// to `synced`, `failed` (after 3 retries), or `skipped` (no integration).
enum CrmSyncStatus {
  pending
  // Audit #6 P0-6 — transient state set by the lead-sync worker via
  // SKIP LOCKED claim. A row in 'syncing' is owned by exactly one
  // worker replica; recovery cron returns stuck rows to 'pending'.
  syncing
  synced
  failed
  skipped
}

// CrmProvider — the five CRM/automation targets we support in v1.
// `webhook` covers generic HTTP destinations (Zapier, Make, n8n, custom).
enum CrmProvider {
  hubspot
  gohighlevel
  mailchimp
  activecampaign
  webhook
}

// CoachLandingPage — a single coach-owned public sales page.
// A coach may hold at most 6 pages (enforced in service, not DB).
// URL pattern: app.trygrowthproject.com/p/<coach-slug>/<slug>
// Custom domain (Pro+): CNAME → custom_domain when verified.
model CoachLandingPage {
  id       String              @id @default(cuid())
  coach_id String
  coach    User                @relation("CoachLandingPagesCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  // slug is unique per coach — forms the last path segment of the URL.
  // Validated as URL-safe lowercase in the service layer (PR #2).
  slug     String
  template LandingPageTemplate
  status   LandingPageStatus   @default(draft)

  // ─── Content ────────────────────────────────────────────────────────────
  headline       String  @db.VarChar(120)
  subheadline    String? @db.VarChar(280)
  // hero_image_url is an S3 object key written by MediaService (existing).
  // EXIF-stripped, content-type allow-listed, max 5 MB per spec §4.3.
  hero_image_url String?
  // accent_color is validated as #RRGGBB, matching InviteLandingService.
  // Coach may pick from 8 curated swatches or a custom hex (spec §8.2).
  accent_color   String?

  // ─── Conversion ─────────────────────────────────────────────────────────
  primary_cta_type  LandingCtaType
  primary_cta_label String         @db.VarChar(40)

  // ─── Pricing ────────────────────────────────────────────────────────────
  // Denormalized refs to CoachPackage rows; coach picks which packages
  // appear on this page (max 3, enforced in service). We do NOT FK into
  // CoachPackage here to avoid cascade complexity and because the service
  // layer already validates package ownership at write time.
  package_ids String[]

  // ─── Lead capture ───────────────────────────────────────────────────────
  // lead_capture_fields values: ["name", "email", "phone", "goal"].
  // name + email are always included when CTA type is lead_form.
  lead_capture_fields String[]
  crm_integration_id  String?
  crm_integration     CoachCrmIntegration? @relation(fields: [crm_integration_id], references: [id])

  // ─── Custom domain (Pro+ only) ──────────────────────────────────────────
  // Null on free-tier coaches; gated at POST /:id/custom-domain in PR #4.
  // custom_domain_verified_at is set by the cert-issuance cron on success.
  custom_domain             String?
  custom_domain_verified_at DateTime?

  // ─── Audit ──────────────────────────────────────────────────────────────
  published_at   DateTime?
  unpublished_at DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // ─── Relations ──────────────────────────────────────────────────────────
  sections CoachLandingPageSection[]
  leads    CoachLandingLead[]
  views    CoachLandingPageView[]

  // @@unique enforces per-coach slug uniqueness — two coaches can share a
  // slug word but not the same (coach_id, slug) pair.
  @@unique([coach_id, slug])
  // Custom-domain lookup for the SNI router (Fly cert + public renderer).
  // @@unique so two coaches cannot claim the same domain; Postgres unique
  // indexes treat multiple NULLs as distinct, so free-tier rows (null) do
  // not collide. Build CONCURRENTLY on staging/prod before deploying if
  // table is large — see R43 CoachPackage_share_token_key note.
  @@unique([custom_domain])
  // Primary coach-dashboard list query: filter by coach + status.
  @@index([coach_id, status])
  // Analytics feed: list published pages ordered by publish date.
  @@index([status, published_at])
}

// CoachLandingPageSection — an ordered content block within a page.
// Payload JSON shape is per-kind; the service layer validates it against
// a per-kind Zod schema (PR #2). We do not fan out to 8 separate tables
// for v1 — one JSONB column keeps the migration surface small.
model CoachLandingPageSection {
  id          String             @id @default(cuid())
  page_id     String
  page        CoachLandingPage   @relation(fields: [page_id], references: [id], onDelete: Cascade)
  kind        LandingSectionKind
  // order_index is 0-based; @@unique enforces no two sections share a
  // slot within the same page (reorder = UPDATE the index in a single tx).
  order_index Int
  // JSONB payload is validated per-kind by Zod in the service layer.
  // Examples: hero → {heroImageUrl, headline}; faq → [{q, a}, ...].
  payload     Json

  @@unique([page_id, order_index])
  // Page render: load all sections for a page ordered by index.
  @@index([page_id])
}

// CoachLandingLead — every form submission on any landing page.
// Written BEFORE the CRM push (pending) so a CRM outage can never
// lose a lead. background processor transitions crm_sync_status.
// See spec §7 for the retry / failure-surface strategy.
model CoachLandingLead {
  id                String           @id @default(cuid())
  page_id           String
  page              CoachLandingPage @relation(fields: [page_id], references: [id], onDelete: Cascade)
  // coach_id is denormalized from page.coach_id so the coach inbox query
  // (GET /coach/landing-pages/:id/leads) can hit a single index without
  // a join to CoachLandingPage.
  coach_id          String
  email             String
  name              String?
  phone             String?
  // Raw form values — stored in full for CRM field-mapping flexibility.
  payload           Json
  crm_sync_status   CrmSyncStatus    @default(pending)
  crm_synced_at     DateTime?
  crm_error         String?
  // R47 Phase 3 — per-provider sync state. `synced_to` lists CrmProvider
  // values that have successfully accepted this lead (e.g. ['hubspot',
  // 'mailchimp']). `external_ids` maps provider → external id returned by
  // the provider API, so we can dedupe future updates or correlate webhook
  // events. Both are written by the lead-sync worker (PR #3).
  synced_to         String[]
  external_ids      Json             @default("{}")
  // Set when this lead subsequently signs up and becomes a TGP User.
  // No FK — cross-table reference kept soft to survive user deletion.
  converted_user_id String?
  created_at        DateTime         @default(now())
  // R47 Phase 3 / Audit #6 P0-6 — persistent retry state. Survives
  // process restarts (the in-memory Map version reset attempts to 0 on
  // every boot, which let a poisoned lead retry indefinitely after a
  // deploy). `next_eligible_at` is the earliest UTC instant the worker
  // is allowed to try this lead again; the SKIP LOCKED claim filters on
  // it so a backed-off lead doesn't block the head of the queue.
  attempts          Int              @default(0)
  next_eligible_at  DateTime?

  // Coach lead inbox: list leads for a page, newest first.
  @@index([page_id, created_at])
  // Coach dashboard: all leads across pages for one coach, newest first.
  @@index([coach_id, created_at])
  // CRM sync worker: claim all pending leads in one index scan.
  @@index([crm_sync_status])
  // Audit #6 P0-6 — worker claim filter "pending AND eligible-now"
  // hits this composite on every tick.
  @@index([crm_sync_status, next_eligible_at])
}

// CoachLandingPageView — anonymized analytics event per page visit.
// IP and UA are SHA-256 hashed with a daily-rotating salt to satisfy
// GDPR (no PII stored; salt rotation means hashes are non-linkable
// across days). Inserted by sendBeacon at page unload (spec §5.3).
model CoachLandingPageView {
  id             String           @id @default(cuid())
  page_id        String
  page           CoachLandingPage @relation(fields: [page_id], references: [id], onDelete: Cascade)
  // ip_hash / ua_hash: SHA-256(rawValue + dailySalt). The salt rotates
  // every midnight UTC so hashes cannot be correlated across days.
  ip_hash        String
  ua_hash        String
  referrer_host  String?
  utm_source     String?
  utm_medium     String?
  utm_campaign   String?
  // scroll_depth: 0-100 integer, set by sendBeacon at unload. Null if
  // the visitor left before the JS payload fired.
  scroll_depth   Int?
  cta_clicked    Boolean          @default(false)
  form_submitted Boolean          @default(false)
  created_at     DateTime         @default(now())

  // Analytics time-series query: views for a page over a date range.
  @@index([page_id, created_at])
}

// CoachCrmIntegration — per-coach CRM connection config.
// A coach may have one integration per provider; multiple pages can
// share the same integration. Credentials are AES-256-GCM encrypted
// at rest with env key KMS_MASTER_KEY (decrypted only inside
// CoachCrmService, never returned to the client — spec §7).
// Audit #6 P1-9 — (coach_id, provider) must be unique so the upsert
// path in CoachCrmService cannot race itself into two rows for the
// same provider on the same coach (which would silently fan out
// duplicate leads on every sync tick). Enforced at the model below.
model CoachCrmIntegration {
  id                    String      @id @default(cuid())
  coach_id              String
  coach                 User        @relation("CoachCrmCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  provider              CrmProvider
  // AES-256-GCM ciphertext of the API key / OAuth token / webhook URL.
  // Format is the same as existing KmsService output (PLAINTEXT: prefix
  // when unconfigured in dev, encrypted blob in staging/prod).
  credentials_encrypted String
  // JSON map of TGP lead fields → CRM field IDs / list IDs.
  // Example HubSpot: {"email":"email","name":"firstname","phone":"phone"}
  field_mapping         Json
  enabled               Boolean     @default(true)
  last_synced_at        DateTime?
  last_error            String?
  created_at            DateTime    @default(now())

  // Back-relation: pages that use this integration.
  pages CoachLandingPage[]

  // Audit #6 P1-9 — prevents two rows for the same (coach, provider).
  @@unique([coach_id, provider])
  // Fast "get all integrations for coach" query from the CRM settings screen.
  @@index([coach_id])
}

// ============================================================
// Stream 1 — Coach AI Credits (combined coach+client budget + pack upsell)
// ============================================================
//
// One row per head coach, per period. Sub-coaches do NOT have their own
// budget rows — their AI calls debit their head coach's row. The Stripe-
// backed credit-pack upsell adds face-value displayed credit to the same
// row (and stores the underlying actual_credit_cents = paid_cents / 3.125).
//
// Spec: canonical_docs/STREAM_1_AI_CREDITS_SPEC.md (operator override
// 2026-05-28: multiplier 3.125×, displayed allowance $125, pack tiers
// $10 / $25 / $99 / Custom min $10 max $500).

model CoachAIBudget {
  id            String @id @default(uuid())
  // Head coach only (one row per head coach). Sub-coaches share via the
  // SubCoachAssignment.head_coach_id lookup in CoachAIBudgetService.
  coach_user_id String @unique
  coach         User   @relation("CoachAIBudgetUser", fields: [coach_user_id], references: [id], onDelete: Cascade)

  // Period bounds — usually a calendar month in the coach's timezone, but
  // the row holds whatever bounds the rollover cron pinned at creation
  // time. The cron uses period_end to detect rollover candidates.
  period_start DateTime
  period_end   DateTime

  // Locked numbers (spec §0). Stored on the row rather than read from env
  // every call so historical rows survive an env-var change without
  // retroactively repricing past usage.
  base_actual_cents    Int     @default(4000)
  // Decimal(6,3) keeps three decimals of precision (3.125 round-trips
  // exactly) and prevents Float drift. Banker's rounded in service code.
  value_multiplier     Decimal @default(3.125) @db.Decimal(6, 3)
  base_displayed_cents Int     @default(12500)

  // Pack additions accumulated this period. paid_cents = the money the
  // coach paid us (face value, the number shown in the UI). displayed
  // is the same number because packs are 1:1 face-value display.
  pack_paid_cents      Int @default(0)
  pack_displayed_cents Int @default(0)

  // Consumption — actual Anthropic spend, in cents. Displayed consumption
  // is `actual_used_cents * value_multiplier`, computed on read.
  actual_used_cents Int @default(0)

  // P1-8 fix — sum of per-pack actual_credit_cents (banker's rounded at
  // pack-purchase time). Tracking this as a stored column avoids the
  // drift between "sum of rounded values" and "round of summed values"
  // that crops up when many packs are credited in a single period.
  // recordUsage uses `base_actual_cents + total_pack_actual_cents` as
  // the ceiling, matching exactly what receipts (CCPP rows) show.
  total_pack_actual_cents Int @default(0)

  // Lifecycle bookkeeping. last_rollover_at is null until the first
  // rollover stamps it; created_at marks initial row creation.
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  last_rollover_at DateTime?

  pack_purchases CoachCreditPackPurchase[] @relation("CoachCreditPackBudget")

  // Rollover cron scans by period_end so the index keeps it cheap as the
  // coach population grows. Single-column index is sufficient — there is
  // exactly one row per coach so coach_user_id is unique enough on its own.
  @@index([period_end])
}

// One row per Stripe checkout session that the coach completed for an AI
// credit pack. Status is the small state machine: pending (session
// created) -> paid (invoice.payment_succeeded applied) | failed (Stripe
// reports a terminal failure) | refunded (owner-triggered refund).
//
// stripe_checkout_session_id is the natural idempotency key — the webhook
// path looks it up to refuse double-credit on a retry. The unique
// constraint enforces single-emit at the schema level so a service-layer
// bug can never accidentally double-credit.

model CoachCreditPackPurchase {
  id            String        @id @default(uuid())
  coach_user_id String
  coach         User          @relation("CoachCreditPackUser", fields: [coach_user_id], references: [id])
  budget_id     String
  budget        CoachAIBudget @relation("CoachCreditPackBudget", fields: [budget_id], references: [id])

  // Stripe. stripe_checkout_session_id is the @unique idempotency key — the
  // webhook path uses it to refuse double-credit. stripe_invoice_id is
  // also @unique (one invoice per session). stripe_payment_intent_id is
  // captured for support but not constrained.
  stripe_checkout_session_id String? @unique
  stripe_invoice_id          String? @unique
  stripe_payment_intent_id   String?

  // Money. paid_cents = face value (what the coach paid).
  // actual_credit_cents = paid_cents / 3.125 (banker's rounded; see §6 of
  // STREAM_1_AI_CREDITS_SPEC.md). displayed_credit_cents = paid_cents
  // because packs display face-value (mental model: "$25 buys $25 of AI").
  paid_cents             Int
  actual_credit_cents    Int
  displayed_credit_cents Int

  // 'pending' | 'paid' | 'refunded' | 'failed'. String not enum so adding
  // new states doesn't require a migration (auditor: this is intentional
  // — we expect 'chargeback' next).
  status      String
  applied_at  DateTime?
  refunded_at DateTime?

  // P0-1 fix — explicit flag distinguishing owner-tooling free grants
  // (paid_cents = 0, displayed_credit_cents > 0) from real Stripe-backed
  // purchases (paid_cents = displayed_credit_cents > 0). Required because
  // the relaxed CHECK constraint (displayed_credit_cents >= paid_cents)
  // alone no longer pins the two columns together; reports need to count
  // free-grant volume separately from gross-pack revenue.
  is_free_grant Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([coach_user_id, created_at])
  @@index([status])
}

// ============================================================
// PR-3 — Packages & Drip-Feed foundation (additive schema only)
// ============================================================
//
// Six new models behind one CoachPackage flag (`is_sellable`). Until a
// later PR attaches content to packages, every existing package keeps
// behaving exactly as today (paywall-only, zero content rows).
//
// Authoring side: CoachPackageContent (what the coach attaches to a
// sellable package) and CoachMediaAsset (the coach-owned PDF/video
// library that content rows can point at).
//
// Runtime side: PurchaseFanout (one row per ClientPurchase tracking the
// package→schedule materialisation job) and ScheduledDrop (the per-buyer
// schedule, snapshotted at purchase so later edits to the authoring side
// never retroactively shift a buyer's timeline). Entitlement for media
// assets is tracked in ClientAssetGrant.
//
// cadence_kind / cadence_payload stay as plain String / Json here — zod
// validation lives in a later PR.

// Authoring: items a coach attaches to a sellable CoachPackage.
model CoachPackageContent {
  id                String       @id @default(uuid())
  package_id        String
  package           CoachPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)
  asset_type        String // workout_program | workout_plan | meal_plan | pdf | video | auto_message
  asset_id          String
  asset_revision_id String?
  display_order     Int          @default(0)
  cadence_kind      String       @default("immediate") // immediate | relative_to_purchase | fixed_calendar | on_completion | on_milestone
  cadence_payload   Json
  display_title     String?
  display_caption   String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  removed_at        DateTime?

  @@index([package_id, removed_at, display_order])
  @@index([asset_type, asset_id])
}

// Runtime: per-buyer schedule, snapshotted at purchase. content_id is a
// snapshot ref (NOT an FK) — the authoring row can be soft-removed
// without invalidating already-scheduled drops.
model ScheduledDrop {
  id                  String         @id @default(uuid())
  client_purchase_id  String
  client_purchase     ClientPurchase @relation(fields: [client_purchase_id], references: [id], onDelete: Cascade)
  content_id          String // snapshot ref, NOT an FK (content can be soft-removed)
  asset_type          String
  asset_id            String
  asset_revision_id   String?
  cadence_kind        String
  cadence_payload     Json
  display_title       String?
  display_caption     String?
  fire_at             DateTime?
  fired_at            DateTime?
  status              String         @default("pending") // pending|due|fired|skipped|failed|canceled
  attempt_count       Int            @default(0)
  materialised_ref    String?
  failure_reason      String?
  // PR-10 — DripDispatcherCron retry/backoff + claim columns. All nullable
  // and additive (see migration 20261205000000_pr10_scheduled_drop_retry_lock).
  locked_at           DateTime?
  next_retry_at       DateTime?
  alert_dispatched_at DateTime?
  // PR-17 B1 — re-send sequence. Original fan-out + first-delivery pushes
  // use the default 0; a coach "re-send updated version" of an already-FIRED
  // drop (decision #5) inserts a NEW row at push_seq = prior max + 1 so the
  // immutable fired row is never mutated. Folded into the unique key below so
  // (client_purchase_id, content_id) can host multiple deliveries. The cron's
  // resolver-key bypass keys re-send (push_seq > 0) drops on scheduledDropId
  // only, so they materialise a fresh delivery instead of collapsing to the
  // cached marker/ledger result. See migration
  // 20261209000000_pr17_scheduled_drop_push_seq.
  push_seq            Int            @default(0)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  @@unique([client_purchase_id, content_id, push_seq])
  @@index([status, fire_at])
  @@index([client_purchase_id, status])
  @@index([status, next_retry_at, fire_at])
}

// Runtime bookkeeping: one row per ClientPurchase tracking the package→
// schedule fan-out job.
model PurchaseFanout {
  id          String         @id @default(uuid())
  purchase_id String         @unique
  purchase    ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  state       String         @default("pending") // pending|in_progress|succeeded|failed
  entrypoint  String // in_app_hosted | in_app_ps | storefront_guest
  started_at  DateTime?
  finished_at DateTime?
  retry_count Int            @default(0)
  last_error  String?
  created_at  DateTime       @default(now())
}

// PR-9 R1 audit-fix — durable, rollback-survivable idempotency marker
// for resolver side-effects whose downstream commit lands OUTSIDE the
// outer fan-out $transaction (today: auto_message via
// MessagingService.sendAsCoach, which commits to CoachMessage on its
// own connection). Workout uses the existing
// WorkoutBuilderIdempotencyKey ledger with a stable key
// (drip:workout:{purchase_id}:{content_id}) so it does not need a row
// here. Media + meal_plan ride the outer tx and roll back cleanly so
// they do not need a row here either.
//
// The marker is written in its OWN commit BEFORE the resolver fires
// the side-effect, then UPDATED with the materialised reference after
// the side-effect succeeds. The unique key is (purchase_id, content_id)
// — both stable across outer-tx rollback + Stripe webhook retry, so a
// retry observes the marker and short-circuits to the cached
// materialised_ref (or re-attempts if the prior attempt died before
// the UPDATE landed).
//
// purpose: the resolver namespace (today: 'auto_message') so a single
// table can host markers for future resolver types without a schema
// change; included in the unique key so independent resolvers cannot
// collide on the same content row.
model DripResolverMarker {
  id               String   @id @default(uuid())
  purpose          String // resolver namespace, e.g. 'auto_message'
  purchase_id      String
  content_id       String
  materialised_ref String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([purpose, purchase_id, content_id])
  @@index([purchase_id])
}

// Coach-uploaded media library (PDFs/videos) attachable to packages
// via CoachPackageContent.
model CoachMediaAsset {
  id                String    @id @default(uuid())
  coach_id          String
  coach             User      @relation("CoachMediaAssetCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  kind              String // pdf | video
  title             String
  description       String?
  storage_key       String
  provider          String // supabase | mux
  byte_size         BigInt?
  content_type      String?
  duration_sec      Int?
  page_count        Int?
  mux_playback_id   String?
  // PR-12 — async upload lifecycle. uploading -> ready (pdf, synchronous
  // confirm) OR uploading -> processing -> ready|errored (video, via Mux
  // webhook). MediaAssetResolver gates on status='ready' so a not-yet-ready
  // asset can never silently materialise into a buyer's grant.
  status            String    @default("ready") // uploading | processing | ready | errored
  // Mux Direct Upload id we minted when the coach started a video upload.
  // Unique so the Mux webhook can resolve a single CoachMediaAsset row by
  // upload id (mirrors the ExerciseCatalogItem.mux_upload_id pattern).
  mux_upload_id     String?   @unique
  mux_error_message String?
  created_at        DateTime  @default(now())
  archived_at       DateTime?

  @@index([coach_id, archived_at, kind])
  @@index([coach_id, archived_at, kind, status])
}

// PR-12 — durable Mux webhook idempotency for the coach-media pipeline.
// Same shape as StripeProcessedEvent: event id is the PK so a replay is a
// no-op at the INSERT layer regardless of which pod handles the redelivery.
// Used by CoachMediaMuxWebhookController; the existing
// src/video/mux-webhook.controller.ts (workout-demo path) keeps its
// in-memory dedup unchanged in this PR.
model MuxProcessedEvent {
  mux_event_id         String    @id
  type                 String
  processed_at         DateTime  @default(now())
  handler_completed_at DateTime?

  @@index([processed_at])
  @@index([handler_completed_at])
}

// Per-(client, media_asset) entitlement for PDFs/videos. Minted when a
// drop fires; revoked when entitlement lapses.
model ClientAssetGrant {
  id                  String    @id @default(uuid())
  client_id           String
  media_asset_id      String
  granted_via_drop_id String?
  granted_at          DateTime  @default(now())
  revoked_at          DateTime?

  @@unique([client_id, media_asset_id])
  @@index([client_id, revoked_at])
}

// =============================================================================
// Wave-0 schema (issues A1 + LTV-3). Pure data-layer additions landed in one
// migration so the downstream logic agents (A1-logic, LTV-3-logic) can run in
// parallel without colliding on schema.prisma. NO application logic here.
// =============================================================================

// Wave-0 (A1) — per-user DAILY AI token quota.
//
// Today only a 20/hr per-IP throttle exists on the AI gateway; A1 needs a
// persisted DAILY token counter per user so spend can be capped and observed
// across requests/instances. This table is the persistence layer only — the
// A1-logic agent owns the read/increment (atomic upsert keyed by the
// (user_id, quota_date) unique) and any enforcement policy.
//
// quota_date is the UTC day bucket (DateTime @db.Date) so each user has at
// most one row per calendar day. tokens_used / request_count are monotonic
// within a day and reset implicitly by a new day's row. onDelete: Cascade so
// a user's quota rows vanish on account hard-delete (consistent with other
// User-owned per-user ledgers like WorkoutBuilderIdempotencyKey).
model UserAIQuota {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation("UserAIQuotaUser", fields: [user_id], references: [id], onDelete: Cascade)
  quota_date    DateTime @db.Date
  tokens_used   Int      @default(0)
  request_count Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([user_id, quota_date], name: "UserAIQuota_user_id_quota_date_key")
  @@index([user_id])
  @@index([quota_date])
}

// Wave-0 (LTV-3) — persisted per-coach LTV peak.
//
// Persists zero_churn_streak and all_time_peak_rpcm per coach so they do not
// regress month-over-month (currently recomputed-not-persisted in
// LtvMetricsService.getMetrics, see ltv-metrics.service.ts:279-294 where the
// inline TODOs call for exactly this table). The LTV-3-logic agent owns the
// read/write — this is the data layer only.
//
// Coach scoping matches CoachEffectivenessScore exactly: coach_id is a
// User.id FK (the LTV service identifies a coach by coachUserId / a User row
// with role=coach), with onDelete: Cascade. One row per coach: coach_id is
// @unique (1:1 with the coach User), mirroring the CoachBriefPreferences /
// CoachOnboardingProgress 1:1 metric-table pattern.
//
// all_time_peak_rpcm is Decimal (matching the repo's Decimal @db.Decimal(20,6)
// convention) and stores RPCM (revenue per client month) in CENTS — the same
// integer-cents unit the LTV service computes (rpcmCents /
// all_time_peak_rpcm_cents). Decimal holds the cent value losslessly and
// leaves headroom for future sub-cent precision.
model CoachLtvPeak {
  id                 String   @id @default(uuid())
  coach_id           String   @unique
  coach              User     @relation("CoachLtvPeakCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  zero_churn_streak  Int      @default(0)
  all_time_peak_rpcm Decimal  @default(0) @db.Decimal(20, 6)
  updated_at         DateTime @updatedAt

  @@map("coach_ltv_peak")
}

// ============================================================
// PR-HK-0 — WEARABLES / HEALTHKIT FOUNDATION
// ============================================================
//
// Additive only. Schema mutex: PR-HK-0 is the ONLY PR that edits
// schema.prisma for the wearables expansion (see UNIFIED_BUILD_PLAN §7).
// Connector/insight PRs add NO models — every wearable model exists here.
//
// Doctrine baked in (50-Failures defenses):
//   #2  RLS — every table below ships ENABLE + FORCE RLS + explicit
//       policies in the SAME migration as table creation. No table is
//       ever born without RLS (the CPO "50-table RLS hole" lesson).
//   #1  Tokens — OAuth refresh/access tokens stored ONLY as KMS-wrapped
//       ciphertext via KmsService. Never plaintext, never in logs, never
//       in coach-readable projections (the encrypted_* columns are never
//       serialized by the read controllers — defense in depth).
//   #28/#29 dedup/replay — WearableSample.dedup_key is UNIQUE;
//       WearableProcessedEvent uses a composite (provider, event_id) PK.
//   #22 indexes — every FK is indexed; the documented composite read
//       indexes live on WearableSample.
//   #45/#47 additive — no destructive ALTER; provenance preserved
//       (two providers reporting the same window → distinct rows, resolved
//       at read time, never overwritten).

// External wearable / health data providers. Bucket is a property of the
// METRIC (WearableMetricDef.bucket), never of the provider — a single
// device can feed both buckets (an Apple Watch logs workouts AND sleep).
enum WearableProvider {
  APPLE_HEALTHKIT // iOS native, on-device push
  HEALTH_CONNECT // Android (Health Connect / Google Fit), on-device push
  GARMIN // Garmin Health API (cloud OAuth + webhook)
  FITBIT // Fitbit Web API (cloud OAuth + subscription webhook)
  STRAVA // Strava API v3 (cloud OAuth + push subscription) — H&F
  POLAR // Polar AccessLink (cloud OAuth + webhook)
  SAMSUNG_HEALTH // Samsung Health SDK, on-device (Android)
  WAHOO // Wahoo Cloud API (cloud OAuth + webhook)
  WITHINGS // Withings API (cloud OAuth + notify subscription)
  PELOTON // Peloton (partner/unofficial) — v2 / feature-flagged
  MYFITNESSPAL // MyFitnessPal nutrition — optional v2 / feature-flagged
  OURA // Oura Cloud API v2 (cloud OAuth + x-oura-signature webhook)
  WHOOP // WHOOP API v2 (cloud OAuth, offline scope, UUID webhooks)
  EIGHT_SLEEP // Eight Sleep API (unofficial) — v2 / feature-flagged
  BEDDIT // via HealthKit (sub-source)
}

// The two UX buckets. A metric belongs to exactly one PRIMARY bucket
// (resting HR is dual-relevant but its primary home is SLEEP_RECOVERY,
// surfaced as a read-only reference chip in HEALTH_FITNESS).
enum WearableMetricBucket {
  HEALTH_FITNESS // Bucket A — warm, "capable"
  SLEEP_RECOVERY // Bucket B — cool, "reassured" (CALM treatment)
}

// Canonical metric taxonomy. Provider-native fields are normalized into
// exactly these by each connector's normalizer; anything unlisted is
// dropped (no speculative ingestion, #42).
enum WearableMetricType {
  // ── Health & Fitness ──
  STEPS
  ACTIVE_ENERGY_KCAL
  RESTING_HEART_RATE_BPM
  HEART_RATE_BPM
  VO2_MAX
  WORKOUT_DURATION_MIN
  WORKOUT_DISTANCE_M
  TRAINING_LOAD
  BODY_WEIGHT_KG
  BODY_FAT_PCT
  BLOOD_PRESSURE_SYS
  BLOOD_PRESSURE_DIA
  // ── Sleep & Recovery ──
  SLEEP_TOTAL_MIN
  SLEEP_REM_MIN
  SLEEP_DEEP_MIN
  SLEEP_LIGHT_MIN
  SLEEP_AWAKE_MIN
  SLEEP_DURATION_MIN
  SLEEP_ONSET_ISO
  SLEEP_WAKE_ISO
  SLEEP_EFFICIENCY_PCT
  HRV_MS
  RECOVERY_SCORE
  READINESS_SCORE
  STRAIN_SCORE
  BODY_BATTERY
  BODY_TEMP_DEVIATION_C
  RESPIRATORY_RATE_BRPM
  SPO2_PCT
}

// Per-user external wearable connection. Modeled on CalendarConnection:
// KMS-wrapped tokens, external account id, webhook channel tracking,
// last-sync, soft-disconnect, fail-explicit status. On-device providers
// (HealthKit / Samsung) leave the token columns null — they push samples.
model WearableConnection {
  id                      String           @id @default(uuid())
  user_id                 String
  user                    User             @relation("WearableConnectionUser", fields: [user_id], references: [id], onDelete: Cascade)
  provider                WearableProvider
  // External provider account id (e.g. Oura/Whoop user id). Deliberately
  // NOT the raw token.
  external_account_id     String?
  // Pointer to secret-store entry for app-level provider secrets (optional).
  credentials_secret_ref  String?
  // KMS-wrapped OAuth refresh token (AES-256-GCM envelope via KmsService:
  // base64(JSON({v,iv,tag,ct}))). Never plaintext. On-device providers
  // leave this null — they push samples, no server token.
  //
  // SECURITY: the encrypted_* token columns (and the *_secret_ref pointers)
  // are REVOKED from non-service-role SELECT at the migration level
  // (20260531000000_wearables_foundation) — service_role only. Coach/client
  // reads go through the WearableConnectionSafe projection view, which omits
  // these columns. Do not expose them via any PostgREST/table-level grant.
  encrypted_refresh_token String?
  // KMS-wrapped short-lived access token (optional cache; refresh is the
  // source of truth).
  encrypted_access_token  String?
  access_token_expires_at DateTime?
  // Granted OAuth scopes (provider-native strings) for audit + re-consent.
  scopes                  String[]         @default([])
  // Webhook subscription tracking (Oura/Whoop/Strava/Fitbit/Withings/Garmin).
  webhook_subscription_id String?
  webhook_secret_ref      String?
  channel_expires_at      DateTime?
  // Connection lifecycle: connected | expired | error | disconnected.
  // Fail-explicit: a provider outage sets status='error' + last_error,
  // surfaced to the coach — NEVER silently degraded to 'connected'.
  status                  String           @default("connected")
  last_error              String?
  last_synced_at          DateTime?
  // Backfill bookkeeping — earliest data we have pulled.
  backfilled_until        DateTime?
  disconnected_at         DateTime? // soft-disconnect; audit survives re-link
  created_at              DateTime         @default(now())
  updated_at              DateTime         @default(now()) @updatedAt
  samples                 WearableSample[]

  @@unique([user_id, provider, external_account_id], name: "WearableConnection_user_provider_account_key")
  @@index([user_id])
  @@index([status])
  @@index([channel_expires_at])
}

// Seeded reference table: canonical metric → bucket/unit/display/aggregation/
// norm-band. Single source of truth so the UI bucket filter and the AI
// norm-comparison both read identical metadata without a code deploy
// (#40 single source of truth). Seeded in the PR-HK-0 migration.
model WearableMetricDef {
  metric       WearableMetricType   @id
  bucket       WearableMetricBucket
  unit         String // "min", "bpm", "ms", "kg", "%", "kcal", "score", "m", "br/min", "°C"
  display_name String // PLAIN-LANGUAGE (e.g. "Light sleep", never "N1/N2")
  // Time-bucketing aggregation semantics: "sum" | "avg" | "last" | "max".
  aggregation  String
  // Scientific norm band as JSON for AI norm comparison, e.g.
  // { "min": 20, "max": 25 }. Nullable.
  norm_band    Json?
  sort_order   Int                  @default(0)
}

// Canonical normalized fact table. Provider-native payloads map into rows
// here via each connector's normalizer. Two providers reporting the same
// metric for the same window → DISTINCT rows (provenance preserved);
// overlap resolution is a READ-time policy (resolveBest), never a
// write-time overwrite.
model WearableSample {
  id               String               @id @default(uuid())
  user_id          String
  user             User                 @relation("WearableSampleUser", fields: [user_id], references: [id], onDelete: Cascade)
  connection_id    String
  connection       WearableConnection   @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  provider         WearableProvider
  metric           WearableMetricType
  bucket           WearableMetricBucket // denormalized from metric def for fast bucket-filtered reads
  value            Float
  unit             String
  // Observation window. start==end for instantaneous; sleep spans a night.
  start_at         DateTime
  end_at           DateTime
  // IANA timezone the provider reported the sample in. Stored to avoid
  // off-by-one-day bucketing across DST / travel.
  source_tz        String?
  // Deterministic dedup key: sha256(user_id|provider|metric|start_iso|end_iso).
  // Guarantees idempotent re-ingestion; cross-provider overlap is distinct
  // rows (different provider segment) resolved at read time.
  dedup_key        String               @unique
  // Provider-native id for the source record (backfill reconciliation).
  source_record_id String?
  recorded_at      DateTime             @default(now()) // when WE ingested it
  raw_ref          String? // optional pointer to raw payload archive

  @@index([user_id, bucket, start_at])
  @@index([user_id, metric, start_at])
  @@index([connection_id, start_at])
  @@index([provider, source_record_id])
}

// Webhook idempotency — modeled on StripeProcessedEvent. Composite natural
// key (provider, provider_event_id). A scheduled prune keeps rows ≥ the
// longest provider redelivery window (≥14d). No end-user access:
// service_role only (deny-all for public via RLS with no public policies).
model WearableProcessedEvent {
  provider             WearableProvider
  provider_event_id    String
  type                 String
  processed_at         DateTime         @default(now())
  handler_completed_at DateTime?

  @@id([provider, provider_event_id])
  @@index([processed_at])
  @@index([handler_completed_at])
}

// Per-(user, side, bucket, window) cached AI insight payload. Modeled on
// HolisticInsightCache. side='client' rows are readable by the client and
// their coach; side='coach' rows (hypotheses + draft messages) are NEVER
// readable by the client (enforced by RLS policies).
model WearableInsightCache {
  id             String               @id @default(uuid())
  user_id        String // subject client
  user           User                 @relation("WearableInsightUser", fields: [user_id], references: [id], onDelete: Cascade)
  side           String // "coach" | "client" — different prompt, different output schema
  bucket         WearableMetricBucket
  window_days    Int
  payload        Json // { observation, hypothesis?, suggested_action, suggested_message_draft?, confidence_level, source_metrics[] }
  model_used     String
  prompt_version String
  generated_at   DateTime             @default(now())
  expires_at     DateTime // generated_at + 6h unless a new sync arrives

  @@unique([user_id, side, bucket, window_days], name: "WearableInsight_subject_side_bucket_window_key")
  @@index([user_id])
  @@index([expires_at])
}

// Read-time precedence override (UNIFIED_BUILD_PLAN §3.1). When a client
// connects two providers that both report a metric, resolveBest() returns
// the preferred provider's samples if a row exists here, else falls back
// to the most-recently-recorded provider.
model WearableUserMetricPreference {
  id                 String             @id @default(uuid())
  user_id            String
  user               User               @relation("WearablePrefUser", fields: [user_id], references: [id], onDelete: Cascade)
  metric             WearableMetricType
  preferred_provider WearableProvider
  updated_at         DateTime           @default(now()) @updatedAt
  created_at         DateTime           @default(now())

  @@unique([user_id, metric], name: "WearablePref_user_metric_key")
  @@index([user_id])
}

// ============================================================
// COMMUNITY EXPANSION v1-1 — workspace, cohorts, messages,
// posts, reactions, events, challenges, moderation.
//
// Three space types only (product plan): The Lab (fixed coach
// broadcast hall, scope=hall), Cohort (scope=cohort), and Direct
// (scope=dm). Every row is workspace-scoped; RLS (defined in the
// v1_1 migration via app.current_user_id() — the repo convention,
// see prisma/migrations/rls_fitness_backend.sql) enforces tenant
// isolation. Workspace deletion cascades to all child rows; the
// User who authors content is RESTRICT-protected so history is not
// silently lost, while membership/RSVP/participation rows cascade
// on user delete. Ships schema-only behind FEATURE_COMMUNITY_SCHEMA;
// no controllers until FEATURE_COMMUNITY_API (v1-2).
// ============================================================

enum CommunityCohortStatus {
  draft
  active
  archived
}

enum CommunityMembershipRole {
  coach
  assistant
  student
}

enum CommunityMembershipStatus {
  invited
  active
  muted
  removed
}

enum CommunityMessageScope {
  cohort
  dm
}

enum CommunityMessageKind {
  text
  voice
  system
}

enum CommunityPostScope {
  hall
  cohort
}

enum CommunityPostType {
  text
  lesson
  replay
  poll
  win
}

enum CommunityResponseTargetType {
  message
  post
  comment
  event
  challenge
}

enum CommunityEventState {
  scheduled
  tomorrow
  live
  replay
  reflected
}

enum CommunityEventRsvpStatus {
  going
  maybe
  declined
  attended
  missed
}

enum CommunityChallengeStatus {
  draft
  active
  completed
  archived
}

enum CommunityModerationTargetType {
  message
  post
  reaction
  event
  challenge
  member
}

enum CommunityModerationStatus {
  open
  reviewed
  actioned
  dismissed
}

model CommunityWorkspace {
  id                 String    @id @default(uuid()) @db.Uuid
  coach_id           String    @db.Uuid
  name               String    @db.VarChar(120)
  slug               String    @unique @db.VarChar(80)
  description        String?   @db.Text
  dm_enabled_default Boolean   @default(false)
  hall_enabled       Boolean   @default(true)
  events_enabled     Boolean   @default(false)
  challenges_enabled Boolean   @default(false)
  max_cohort_members Int?      @db.Integer
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  archived_at        DateTime? @db.Timestamptz(6)

  coach                    User                              @relation("CommunityWorkspaceCoach", fields: [coach_id], references: [id], onDelete: Cascade)
  cohorts                  CommunityCohort[]
  memberships              CommunityMembership[]
  posts                    CommunityPost[]
  responses                CommunityResponse[]
  events                   CommunityEvent[]
  event_rsvps              CommunityEventRsvp[]
  challenges               CommunityChallenge[]
  challenge_participations CommunityChallengeParticipation[]
  moderation_actions       CommunityModerationAction[]

  // Coach dashboard: list a coach's non-archived workspaces.
  @@index([coach_id, archived_at])
  // Ops/analytics: recent-workspace scans by creation time.
  @@index([created_at])
  @@map("community_workspaces")
}

model CommunityCohort {
  id           String                @id @default(uuid()) @db.Uuid
  workspace_id String                @db.Uuid
  name         String                @db.VarChar(120)
  description  String?               @db.Text
  status       CommunityCohortStatus @default(active)
  starts_at    DateTime?             @db.Timestamptz(6)
  ends_at      DateTime?             @db.Timestamptz(6)
  capacity     Int?                  @db.Integer
  sort_order   Int                   @default(0)
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at   DateTime              @updatedAt @db.Timestamptz(6)
  archived_at  DateTime?             @db.Timestamptz(6)

  workspace   CommunityWorkspace    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  memberships CommunityMembership[]
  posts       CommunityPost[]
  events      CommunityEvent[]
  challenges  CommunityChallenge[]

  @@unique([workspace_id, name])
  // Cohort list ordered for a workspace (coach + client surfaces).
  @@index([workspace_id, status, sort_order])
  // Archived-cohort filtering within a workspace.
  @@index([workspace_id, archived_at])
  @@map("community_cohorts")
}

model CommunityMembership {
  id                   String                    @id @default(uuid()) @db.Uuid
  workspace_id         String                    @db.Uuid
  cohort_id            String                    @db.Uuid
  user_id              String                    @db.Uuid
  role                 CommunityMembershipRole   @default(student)
  status               CommunityMembershipStatus @default(active)
  dm_enabled           Boolean?
  notify_level         String                    @default("digest") @db.VarChar(32)
  joined_at            DateTime?                 @db.Timestamptz(6)
  last_read_message_at DateTime?                 @db.Timestamptz(6)
  created_at           DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                  @updatedAt @db.Timestamptz(6)
  removed_at           DateTime?                 @db.Timestamptz(6)

  workspace CommunityWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  cohort    CommunityCohort    @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  user      User               @relation("CommunityMembershipUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([cohort_id, user_id])
  // Membership lookup for a user within a workspace (RLS shared-cohort checks).
  @@index([workspace_id, user_id, status])
  // "My active memberships" across workspaces.
  @@index([user_id, status])
  // Cohort roster filtered by role/status.
  @@index([cohort_id, status, role])
  @@map("community_memberships")
}

model CommunityMessage {
  id                   String                @default(uuid()) @db.Uuid
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  workspace_id         String                @db.Uuid
  cohort_id            String?               @db.Uuid
  scope                CommunityMessageScope
  dm_key               String?               @db.VarChar(160)
  recipient_user_id    String?               @db.Uuid
  sender_id            String                @db.Uuid
  kind                 CommunityMessageKind  @default(text)
  body                 String?               @db.VarChar(4000)
  voice_url            String?               @db.Text
  voice_duration_ms    Int?                  @db.Integer
  voice_mime_type      String?               @db.VarChar(80)
  voice_size_bytes     Int?                  @db.Integer
  plan_context_type    String?               @db.VarChar(40)
  plan_context_id      String?               @db.Uuid
  plan_week_start      DateTime?             @db.Date
  plan_context_payload Json?                 @db.JsonB // v2-1: rich plan-context discriminated union (week_index, day_index, exercise_id, meal_id, package_id, check_in_id). Nullable, defaults to NULL. Existing scalars (plan_context_type, plan_context_id, plan_week_start) remain in use for COMMENT_CONTEXT_TYPE discrimination across inbox/posts/reactions.
  parent_message_id    String?               @db.Uuid
  parent_message_at    DateTime?             @db.Timestamptz(6)
  coach_seen_at        DateTime?             @db.Timestamptz(6)
  coach_acked_at       DateTime?             @db.Timestamptz(6)
  coach_replied_at     DateTime?             @db.Timestamptz(6)
  visibility           String                @default("active") @db.VarChar(24)
  deleted_at           DateTime?             @db.Timestamptz(6)
  updated_at           DateTime              @updatedAt @db.Timestamptz(6)

  // RESTRICT on sender/recipient so a hard user delete cannot silently
  // orphan or vanish conversation history; the GDPR scrubber soft-deletes.
  sender    User  @relation("community_message_sender", fields: [sender_id], references: [id], onDelete: Restrict)
  recipient User? @relation("community_message_recipient", fields: [recipient_user_id], references: [id], onDelete: Restrict)

  // Composite PK includes the partition key (created_at) — required for
  // Postgres native range partitioning on community_messages.
  @@id([id, created_at])
  // Workspace timeline (coach all-message reads).
  @@index([workspace_id, created_at])
  // Cohort thread pagination.
  @@index([cohort_id, created_at])
  // DM thread pagination by deterministic dm_key.
  @@index([dm_key, created_at])
  // Recipient inbox scans for DMs.
  @@index([recipient_user_id, created_at])
  // Sender outbox / authored-message scans.
  @@index([sender_id, created_at])
  // Plan-context tag filtering (v2-1 plan tags).
  @@index([workspace_id, plan_context_type, plan_context_id])
  // Visibility-filtered workspace timeline (moderation soft-deletes).
  @@index([workspace_id, visibility, created_at])
  @@map("community_messages")
}

model CommunityPost {
  id             String             @id @default(uuid()) @db.Uuid
  workspace_id   String             @db.Uuid
  cohort_id      String?            @db.Uuid
  author_id      String             @db.Uuid
  scope          CommunityPostScope
  type           CommunityPostType  @default(text)
  title          String?            @db.VarChar(160)
  body           String?            @db.Text
  media_asset_id String?            @db.Uuid
  event_id       String?            @db.Uuid
  pinned_at      DateTime?          @db.Timestamptz(6)
  release_at     DateTime?          @db.Timestamptz(6)
  expires_at     DateTime?          @db.Timestamptz(6)
  visibility     String             @default("active") @db.VarChar(24)
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  updated_at     DateTime           @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?          @db.Timestamptz(6)

  workspace CommunityWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  cohort    CommunityCohort?   @relation(fields: [cohort_id], references: [id], onDelete: Cascade)
  author    User               @relation("CommunityPostAuthor", fields: [author_id], references: [id], onDelete: Restrict)

  // Hall/cohort feed: pinned-first then recent, per scope.
  @@index([workspace_id, scope, pinned_at, created_at])
  // Cohort feed pagination.
  @@index([cohort_id, created_at])
  // Scheduled-release sweeps.
  @@index([workspace_id, release_at])
  // Visibility-filtered feed (moderation soft-deletes).
  @@index([workspace_id, visibility, created_at])
  @@map("community_posts")
}

model CommunityResponse {
  id                String                      @id @default(uuid()) @db.Uuid
  workspace_id      String                      @db.Uuid
  target_type       CommunityResponseTargetType
  target_id         String                      @db.Uuid
  target_created_at DateTime?                   @db.Timestamptz(6)
  user_id           String                      @db.Uuid
  response_kind     String                      @db.VarChar(32)
  created_at        DateTime                    @default(now()) @db.Timestamptz(6)

  workspace CommunityWorkspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User               @relation("CommunityResponseUser", fields: [user_id], references: [id], onDelete: Cascade)

  // One response of a given emoji per user per target (idempotency).
  @@unique([target_type, target_id, user_id, response_kind])
  // Response-count aggregation for a target.
  @@index([workspace_id, target_type, target_id])
  // A user's recent responses.
  @@index([user_id, created_at])
  @@map("community_responses")
}

model CommunityEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  workspace_id          String              @db.Uuid
  cohort_id             String?             @db.Uuid
  created_by_id         String              @db.Uuid
  title                 String              @db.VarChar(160)
  description           String?             @db.Text
  state                 CommunityEventState @default(scheduled)
  starts_at             DateTime            @db.Timestamptz(6)
  ends_at               DateTime?           @db.Timestamptz(6)
  live_url              String?             @db.Text
  replay_media_asset_id String?             @db.Uuid
  reflected_at          DateTime?           @db.Timestamptz(6)
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime            @updatedAt @db.Timestamptz(6)
  canceled_at           DateTime?           @db.Timestamptz(6)

  workspace  CommunityWorkspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
