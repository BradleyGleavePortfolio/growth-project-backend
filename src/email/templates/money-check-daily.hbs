<!doctype html>
<html lang="en">
  <body style="font-family: -apple-system, system-ui, sans-serif; max-width: 560px; margin: 0 auto; padding: 32px 24px; color: #1a1a1a;">
    <h1 style="font-size: 22px; margin: 0 0 16px;">{{title}}</h1>
    <p>{{body}}</p>
    <p>Day checked: {{day}} (UTC).</p>
    <hr style="border: 0; border-top: 1px solid #eaeaea; margin: 32px 0;" />
    <p style="font-size: 12px; color: #888;">This email holds counts only: no names, amounts or purchase ids. The daily money check sends it once a day, after its 11:00 UTC run, to the address in the server setting OWNER_ALERT_EMAIL.</p>
  </body>
</html>
