<!doctype html>
<html lang="en">
  <body style="font-family: -apple-system, system-ui, sans-serif; max-width: 560px; margin: 0 auto; padding: 40px 24px; color: #1a1a1a; line-height: 1.6;">
    <h1 style="font-size: 22px; font-weight: 500; margin: 0 0 20px; letter-spacing: -0.01em;">Your code is {{code}}</h1>
    <p style="margin: 0 0 16px;">{{#if first_name}}Hi {{first_name}}, enter{{else}}Enter{{/if}} this code on the checkout page to keep going with your purchase on TGP Fitness.</p>
    <p style="margin: 0 0 16px; font-size: 32px; font-weight: 600; letter-spacing: 0.2em;">{{code}}</p>
    <p style="margin: 0 0 16px;">The code works once and expires in 10 minutes.</p>
    <hr style="border: 0; border-top: 1px solid #eaeaea; margin: 40px 0 24px;" />
    <p style="font-size: 13px; color: #2C2C2C; margin: 0;">If you didn't try to buy anything on TGP Fitness, you can ignore this email. Nobody can sign in with this code.</p>
  </body>
</html>
