<!doctype html>
<html lang="en">
  <body style="font-family: -apple-system, system-ui, sans-serif; max-width: 560px; margin: 0 auto; padding: 32px 24px; color: #1a1a1a;">
    <h1 style="font-size: 22px; margin: 0 0 16px;">Receipt for your subscription</h1>
    <p>Hi{{#if recipient_name}} {{recipient_name}}{{/if}}, thanks — your payment was received.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
      <tr>
        <td style="padding: 8px; border-bottom: 1px solid #eee; color: #555;">Amount</td>
        <td style="padding: 8px; border-bottom: 1px solid #eee; text-align: right; font-weight: 600;">{{amount_display}}</td>
      </tr>
      <tr>
        <td style="padding: 8px; border-bottom: 1px solid #eee; color: #555;">Paid on</td>
        <td style="padding: 8px; border-bottom: 1px solid #eee; text-align: right;">{{paid_at}}</td>
      </tr>
      <tr>
        <td style="padding: 8px; border-bottom: 1px solid #eee; color: #555;">Plan</td>
        <td style="padding: 8px; border-bottom: 1px solid #eee; text-align: right;">{{plan_name}}</td>
      </tr>
      <tr>
        <td style="padding: 8px; color: #555;">Receipt #</td>
        <td style="padding: 8px; text-align: right; font-family: monospace;">{{receipt_number}}</td>
      </tr>
    </table>
    {{#if invoice_url}}
      <p style="margin: 24px 0;">
        <a href="{{invoice_url}}" style="display: inline-block; background: #4f46e5; color: #fff; padding: 12px 22px; border-radius: 8px; text-decoration: none; font-weight: 600;">View full invoice</a>
      </p>
    {{/if}}
    <hr style="border: 0; border-top: 1px solid #eaeaea; margin: 32px 0;" />
    <p style="font-size: 12px; color: #888;">Keep this email for your records.</p>
  </body>
</html>
