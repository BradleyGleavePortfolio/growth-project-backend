        "coerce": "string"
      }
    },
    "client_history": {
      "clientSourceId": {
        "paths": [["links", "athlete", "ref"], ["athleteRef"]],
        "coerce": "string_or_finite_number"
      },
      "label": {
        "paths": [["meta", "headline"], ["summary"]],
        "coerce": "string"
      }
    }
  }
