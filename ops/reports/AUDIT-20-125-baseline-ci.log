2026-10-06T21:00:57.8346478Z     // ─── Main tab navigator ───────────────────────────────────────────────────────·
2026-10-06T21:00:57.8346573Z     /**
2026-10-06T21:00:57.8346896Z      * CommunityTabBarIcon — the Community tab icon with a LIVE unread badge. The
2026-10-06T21:00:57.8347171Z      * badge count comes from useCommunityBadge, which is driven by the Supabase
2026-10-06T21:00:57.8347440Z      * Realtime subscription (a broadcast ping invalidates community/me and the
2026-10-06T21:00:57.8347765Z      * authoritative unread counts refetch over REST) — NOT polling. Rendered only
2026-10-06T21:00:57.8348024Z      * when featureFlags.communityTab is true, since the tab itself is flag-gated.
2026-10-06T21:00:57.8348111Z      */
2026-10-06T21:00:57.8348325Z     function CommunityTabBarIcon({ color }: { color: string }) {
2026-10-06T21:00:57.8348460Z       const client = useCurrentUser();
2026-10-06T21:00:57.8348614Z       const badge = useCommunityBadge(client?.id);
2026-10-06T21:00:57.8348713Z       return (
2026-10-06T21:00:57.8348868Z         <View style={styles.communityIconWrap}>
2026-10-06T21:00:57.8349096Z           <Ionicons name=\"chatbubbles-outline\" size={24} color={color} />
2026-10-06T21:00:57.8349365Z           <UnreadBadge count={badge.total} corner testID=\"community-tab-badge\" />
2026-10-06T21:00:57.8349468Z         </View>
2026-10-06T21:00:57.8349559Z       );
2026-10-06T21:00:57.8349655Z     }·
2026-10-06T21:00:57.8349914Z     // Order must match the rendered <Tab.Screen> order (the overlay spotlights
2026-10-06T21:00:57.8350020Z     // tab N of this list).
2026-10-06T21:00:57.8350115Z     const TUTORIAL_TABS = [
2026-10-06T21:00:57.8350204Z       'Home',
2026-10-06T21:00:57.8350303Z       'WorkoutTab',
2026-10-06T21:00:57.8350394Z       'Log',
2026-10-06T21:00:57.8350599Z       ...(featureFlags.clientCalendar ? ['CalendarTab'] : []),
2026-10-06T21:00:57.8350691Z       'MoreTab',
2026-10-06T21:00:57.8350885Z       ...(featureFlags.communityTab ? ['CommunityTab'] : []),
2026-10-06T21:00:57.8350976Z     ];·
2026-10-06T21:00:57.8351131Z     export default function ClientNavigator() {
2026-10-06T21:00:57.8351364Z       // Sol B-310-5: a Roman and AI withdrawal from onboarding that the ledger
2026-10-06T21:00:57.8351545Z       // has not confirmed yet is sent when the app opens.
2026-10-06T21:00:57.8351646Z       useAiWithdrawalDrain();
2026-10-06T21:00:57.8351895Z       // Latest tab-screen navigation object, captured from screenListeners, so
2026-10-06T21:00:57.8352117Z       // the tutorial overlay (which sits outside the navigator) can offer
2026-10-06T21:00:57.8352273Z       // \"Take me there\" for screens behind a menu.
2026-10-06T21:00:57.8352615Z       const tabNavRef = React.useRef<{ navigate: (name: string, params?: object) => void } | null>(null);
2026-10-06T21:00:57.8352878Z       const onTutorialNavigate = React.useCallback((t: TutorialNavTarget) => {
2026-10-06T21:00:57.8352970Z         try {
2026-10-06T21:00:57.8353094Z           tabNavRef.current?.navigate(
2026-10-06T21:00:57.8353189Z             t.tab,
2026-10-06T21:00:57.8353483Z             t.screen ? { screen: t.screen, ...(t.params ? { params: t.params } : {}) } : undefined,
2026-10-06T21:00:57.8353571Z           );
2026-10-06T21:00:57.8353659Z         } catch (err) {
2026-10-06T21:00:57.8354019Z           logger.warn('ClientNavigator', 'tutorial navigate failed', err);
2026-10-06T21:00:57.8354105Z         }
2026-10-06T21:00:57.8354273Z       }, []);
2026-10-06T21:00:57.8354363Z       return (
2026-10-06T21:00:57.8354599Z         <TutorialHost tabs={TUTORIAL_TABS} onNavigate={onTutorialNavigate}>
2026-10-06T21:00:57.8354849Z         <Tab.Navigator
2026-10-06T21:00:57.8354949Z           screenOptions={{
2026-10-06T21:00:57.8355069Z             headerShown: false,
2026-10-06T21:00:57.8355192Z             tabBarShowLabel: false,
2026-10-06T21:00:57.8355320Z             tabBarHideOnKeyboard: true,
2026-10-06T21:00:57.8355471Z             tabBarActiveTintColor:   colors.ink,
2026-10-06T21:00:57.8355623Z             tabBarInactiveTintColor: colors.stone,
2026-10-06T21:00:57.8355719Z             tabBarStyle: {
2026-10-06T21:00:57.8355850Z               backgroundColor: colors.bone,
2026-10-06T21:00:57.8355975Z               borderTopWidth: 0.5,
2026-10-06T21:00:57.8356116Z               borderTopColor: colors.stone,
2026-10-06T21:00:57.8356206Z               height: 64,
2026-10-06T21:00:57.8356295Z             },
2026-10-06T21:00:57.8356383Z           }}
2026-10-06T21:00:57.8356523Z           screenListeners={({ navigation }) => {
2026-10-06T21:00:57.8356774Z             if (featureFlags.clientTutorial) tabNavRef.current = navigation;
2026-10-06T21:00:57.8356867Z             return {
2026-10-06T21:00:57.8356989Z               tabPress: () => {
2026-10-06T21:00:57.8357204Z                 // Phase 11 / Track 3: haptic selection feedback on tab switch
2026-10-06T21:00:57.8357344Z                 HapticService.selection();
2026-10-06T21:00:57.8357436Z               },
2026-10-06T21:00:57.8357664Z               // Clinic tutorial: report the focused route path so route gates
2026-10-06T21:00:57.8357862Z               // (e.g. \"tap Train\") are satisfied by real navigation only.
2026-10-06T21:00:57.8357960Z               state: (e) => {
2026-10-06T21:00:57.8358134Z                 if (!featureFlags.clientTutorial) return;
2026-10-06T21:00:57.8358345Z                 const data = e.data as { state?: NavStateLike } | undefined;
2026-10-06T21:00:57.8358607Z                 setTutorialRoute(withInitialLeaf(focusedRoutePath(data?.state)));
2026-10-06T21:00:57.8358697Z               },
2026-10-06T21:00:57.8358784Z             };
2026-10-06T21:00:57.8358864Z           }}
2026-10-06T21:00:57.8358950Z         >
2026-10-06T21:00:57.8359046Z           <Tab.Screen
2026-10-06T21:00:57.8359134Z             name=\"Home\"
2026-10-06T21:00:57.8359273Z             component={HomeStackNavigator}
2026-10-06T21:00:57.8359370Z             options={{
2026-10-06T21:00:57.8359518Z               tabBarAccessibilityLabel: 'Home',
2026-10-06T21:00:57.8359646Z               tabBarIcon: ({ color }) => (
2026-10-06T21:00:57.8359854Z                 <Ionicons name=\"home-outline\" size={24} color={color} />
2026-10-06T21:00:57.8359942Z               ),
2026-10-06T21:00:57.8360021Z             }}
2026-10-06T21:00:57.8360111Z           />
2026-10-06T21:00:57.8360201Z           <Tab.Screen
2026-10-06T21:00:57.8360316Z             name=\"WorkoutTab\"
2026-10-06T21:00:57.8360469Z             component={WorkoutStackNavigator}
2026-10-06T21:00:57.8360562Z             options={{
