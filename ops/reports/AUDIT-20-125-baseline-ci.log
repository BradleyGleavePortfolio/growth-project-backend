2026-10-06T21:00:57.8468294Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-06T21:00:57.8468906Z     function useCoachNotificationUnreadCount(): number {
2026-10-06T21:00:57.8469164Z       const [count, setCount] = useState(0);
2026-10-06T21:00:57.8469534Z       useEffect(() => {
2026-10-06T21:00:57.8469721Z         let mounted = true;
2026-10-06T21:00:57.8469959Z         const refresh = async () => {
2026-10-06T21:00:57.8470118Z           try {
2026-10-06T21:00:57.8470375Z             const n = await fetchUnreadCount();
2026-10-06T21:00:57.8470599Z             if (mounted) setCount(n);
2026-10-06T21:00:57.8470767Z           } catch (err) {
2026-10-06T21:00:57.8471204Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-06T21:00:57.8471753Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-06T21:00:57.8472188Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-06T21:00:57.8472345Z           }
2026-10-06T21:00:57.8472490Z         };
2026-10-06T21:00:57.8472661Z         refresh();
2026-10-06T21:00:57.8472974Z         const interval = setInterval(refresh, 30000);
2026-10-06T21:00:57.8473346Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-06T21:00:57.8473595Z           if (state === 'active') refresh();
2026-10-06T21:00:57.8473746Z         });
2026-10-06T21:00:57.8473909Z         return () => {
2026-10-06T21:00:57.8474069Z           mounted = false;
2026-10-06T21:00:57.8474286Z           clearInterval(interval);
2026-10-06T21:00:57.8474449Z           sub.remove();
2026-10-06T21:00:57.8474591Z         };
2026-10-06T21:00:57.8474986Z       }, []);
2026-10-06T21:00:57.8475164Z       return count;
2026-10-06T21:00:57.8475360Z     }·
2026-10-06T21:00:57.8475613Z     function ClientsStackNavigator() {
