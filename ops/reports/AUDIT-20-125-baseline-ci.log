2026-10-06T21:00:57.7948399Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-06T21:00:57.7948712Z     function useCoachNotificationUnreadCount(): number {
2026-10-06T21:00:57.7948927Z       const [count, setCount] = useState(0);
2026-10-06T21:00:57.7949074Z       useEffect(() => {
2026-10-06T21:00:57.7949227Z         let mounted = true;
2026-10-06T21:00:57.7949429Z         const refresh = async () => {
2026-10-06T21:00:57.7949571Z           try {
2026-10-06T21:00:57.7949802Z             const n = await fetchUnreadCount();
2026-10-06T21:00:57.7949989Z             if (mounted) setCount(n);
2026-10-06T21:00:57.7950148Z           } catch (err) {
2026-10-06T21:00:57.7950586Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-06T21:00:57.7951061Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-06T21:00:57.7951453Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-06T21:00:57.7951587Z           }
2026-10-06T21:00:57.7951723Z         };
2026-10-06T21:00:57.7951865Z         refresh();
2026-10-06T21:00:57.7952148Z         const interval = setInterval(refresh, 30000);
2026-10-06T21:00:57.7952539Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-06T21:00:57.7952772Z           if (state === 'active') refresh();
2026-10-06T21:00:57.7952921Z         });
2026-10-06T21:00:57.7953084Z         return () => {
2026-10-06T21:00:57.7953255Z           mounted = false;
2026-10-06T21:00:57.7953471Z           clearInterval(interval);
2026-10-06T21:00:57.7953639Z           sub.remove();
2026-10-06T21:00:57.7953788Z         };
2026-10-06T21:00:57.7953928Z       }, []);
2026-10-06T21:00:57.7954101Z       return count;
2026-10-06T21:00:57.7954281Z     }·
2026-10-06T21:00:57.7954518Z     function ClientsStackNavigator() {
