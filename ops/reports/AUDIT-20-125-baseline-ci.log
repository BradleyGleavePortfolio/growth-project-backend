2026-10-06T21:00:57.8477781Z             headerRight: () => (
2026-10-06T21:00:57.8477974Z               <TouchableOpacity
2026-10-06T21:00:57.8478341Z                 onPress={() => navigation.navigate('NotificationCenter')}
2026-10-06T21:00:57.8478578Z                 style={styles.bellButton}
2026-10-06T21:00:57.8478800Z                 accessibilityRole=\"button\"
2026-10-06T21:00:57.8479002Z                 accessibilityLabel={
