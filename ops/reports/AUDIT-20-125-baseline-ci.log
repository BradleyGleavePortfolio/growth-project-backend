2026-10-06T21:00:57.8606070Z               paddingBottom: 4,
2026-10-06T21:00:57.8606248Z               paddingTop: 4,
2026-10-06T21:00:57.8606407Z               height: 60,
2026-10-06T21:00:57.8606565Z             },
2026-10-06T21:00:57.8606791Z             tabBarLabelStyle: {
2026-10-06T21:00:57.8606945Z               fontSize: 10,
