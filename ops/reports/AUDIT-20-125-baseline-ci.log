2026-10-06T21:00:57.8009115Z     function useCoachUnreadPolling(): number {
2026-10-06T21:00:57.8009256Z       const [total, setTotal] = useState(0);
2026-10-06T21:00:57.8009495Z       useEffect(() => {
2026-10-06T21:00:57.8009597Z         let mounted = true;
2026-10-06T21:00:57.8009723Z         const refresh = async () => {
2026-10-06T21:00:57.8009811Z           try {
2026-10-06T21:00:57.8009980Z             const res = await coachApi.getUnreadCounts();
2026-10-06T21:00:57.8010097Z             if (!mounted) return;
2026-10-06T21:00:57.8010244Z             setTotal(Number(res.data?.total ?? 0));
2026-10-06T21:00:57.8010333Z           } catch (err) {
2026-10-06T21:00:57.8010567Z             // Non-fatal: the unread total holds and the next 30s tick retries.
2026-10-06T21:00:57.8010875Z             // Never swallow silently (Law #36) — log so the failure is observable.
2026-10-06T21:00:57.8011120Z             logger.warn('coach.notifications.unread_polling_refresh', { err });
2026-10-06T21:00:57.8011206Z           }
2026-10-06T21:00:57.8011294Z         };
2026-10-06T21:00:57.8011386Z         refresh();
2026-10-06T21:00:57.8011523Z         const id = setInterval(refresh, 30000);
2026-10-06T21:00:57.8011743Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-06T21:00:57.8011877Z           if (state === 'active') refresh();
2026-10-06T21:00:57.8011960Z         });
2026-10-06T21:00:57.8012047Z         return () => {
2026-10-06T21:00:57.8012143Z           mounted = false;
2026-10-06T21:00:57.8012242Z           clearInterval(id);
2026-10-06T21:00:57.8012328Z           sub.remove();
2026-10-06T21:00:57.8012497Z         };
2026-10-06T21:00:57.8012649Z       }, []);
2026-10-06T21:00:57.8012804Z       return total;
2026-10-06T21:00:57.8012969Z     }·
2026-10-06T21:00:57.8013214Z     export default function CoachNavigator() {
2026-10-06T21:00:57.8013486Z       const unreadCount = useCoachUnreadPolling();
