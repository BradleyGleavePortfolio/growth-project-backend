2026-10-06T21:00:57.8590186Z     function useCoachUnreadPolling(): number {
2026-10-06T21:00:57.8590423Z       const [total, setTotal] = useState(0);
2026-10-06T21:00:57.8590595Z       useEffect(() => {
2026-10-06T21:00:57.8590765Z         let mounted = true;
2026-10-06T21:00:57.8590986Z         const refresh = async () => {
2026-10-06T21:00:57.8591131Z           try {
2026-10-06T21:00:57.8591457Z             const res = await coachApi.getUnreadCounts();
2026-10-06T21:00:57.8591663Z             if (!mounted) return;
2026-10-06T21:00:57.8591931Z             setTotal(Number(res.data?.total ?? 0));
2026-10-06T21:00:57.8592095Z           } catch (err) {
2026-10-06T21:00:57.8592514Z             // Non-fatal: the unread total holds and the next 30s tick retries.
2026-10-06T21:00:57.8593098Z             // Never swallow silently (Law #36) — log so the failure is observable.
2026-10-06T21:00:57.8593533Z             logger.warn('coach.notifications.unread_polling_refresh', { err });
2026-10-06T21:00:57.8593683Z           }
2026-10-06T21:00:57.8593829Z         };
2026-10-06T21:00:57.8593979Z         refresh();
2026-10-06T21:00:57.8594241Z         const id = setInterval(refresh, 30000);
2026-10-06T21:00:57.8594878Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-06T21:00:57.8595136Z           if (state === 'active') refresh();
2026-10-06T21:00:57.8595275Z         });
2026-10-06T21:00:57.8595794Z         return () => {
2026-10-06T21:00:57.8595962Z           mounted = false;
2026-10-06T21:00:57.8596131Z           clearInterval(id);
2026-10-06T21:00:57.8596466Z           sub.remove();
2026-10-06T21:00:57.8596621Z         };
2026-10-06T21:00:57.8596766Z       }, []);
2026-10-06T21:00:57.8596932Z       return total;
2026-10-06T21:00:57.8597142Z     }·
2026-10-06T21:00:57.8597426Z     export default function CoachNavigator() {
2026-10-06T21:00:57.8597712Z       const unreadCount = useCoachUnreadPolling();
2026-10-06T21:00:57.8598159Z       // P0-1: TeamStack must only mount for head coaches. Sub-coaches who land
2026-10-06T21:00:57.8598628Z       // on team-management surfaces hit `/sub-coaches` 403s the screen treats as
2026-10-06T21:00:57.8599171Z       // a permanent retry-error — a feature they don't own. The hook fails
2026-10-06T21:00:57.8599622Z       // closed (returns 'unknown' until a positive head-coach signal), so the
2026-10-06T21:00:57.8600048Z       // tab disappears for sub-coaches and during the initial resolution
2026-10-06T21:00:57.8600225Z       // window.
2026-10-06T21:00:57.8600494Z       const coachRoleType = useCoachRoleType();
2026-10-06T21:00:57.8600848Z       const showTeamTab = coachRoleType === 'head_coach';
2026-10-06T21:00:57.8601268Z       // Audit P0: while the Command Center API still ships only mock data
2026-10-06T21:00:57.8601718Z       // (__USING_MOCK_DATA driven by EXPO_PUBLIC_USE_MOCK_COMMAND_CENTER), the
2026-10-06T21:00:57.8602157Z       // initial tab for a real coach is ClientsStack. Mock-mode builds (demo,
2026-10-06T21:00:57.8602511Z       // screenshots) keep the CommandCenter landing surface.
2026-10-06T21:00:57.8602958Z       const initialTab = __USING_MOCK_DATA ? 'CommandCenter' : 'ClientsStack';
2026-10-06T21:00:57.8603106Z       return (
2026-10-06T21:00:57.8603291Z         <FirstPaymentWowHost>
2026-10-06T21:00:57.8603454Z         <Tab.Navigator
2026-10-06T21:00:57.8603695Z           initialRouteName={initialTab}
2026-10-06T21:00:57.8603873Z           screenOptions={{
