2026-10-06T21:00:57.8361135Z               ),
2026-10-06T21:00:57.8361215Z             }}
2026-10-06T21:00:57.8361302Z           />
2026-10-06T21:00:57.8361391Z           <Tab.Screen
2026-10-06T21:00:57.8361479Z             name=\"Log\"
2026-10-06T21:00:57.8361613Z             component={ProtectedLogScreen}
