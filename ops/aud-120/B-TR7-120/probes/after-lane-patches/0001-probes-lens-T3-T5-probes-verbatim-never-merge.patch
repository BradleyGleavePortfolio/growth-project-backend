+  const stripe = stub<StripeConnectApiService>({
+    cancelSubscription,
+    // B-TR3-118 (B-673-1) — the worker reads Stripe's state first: still trialing.
+    retrieveSubscription: jest.fn(async (id: string) => ({
+      id,
+      status: 'trialing',
+      trial_end: epoch(new Date(Date.now() + 30 * 864e5)),
