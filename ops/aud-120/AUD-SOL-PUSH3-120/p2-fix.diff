+      const expected = fail ? [['push', false]] : [['inapp', false], ['push', true]];
+      expect(w.inbox.map((r) => [r.channel, r.inbox_hidden])).toEqual(expected);
+      expect(await w.notifications.getUnreadCount('u-1')).toBe(1);
