+  startDate: startIso,
+  endDate: new Date(Date.parse(startIso) + HOUR).toISOString(),
+});
+
+function okFence(): SessionFence {
+  return {
+    userId: SCOPE.userId,
+    assertCurrent: jest.fn(async () => undefined),
+    throwIfStopped: jest.fn(),
+    cancel: jest.fn(),
+  };
+}
