+      level: 'error',
+      fingerprint: ['transfer-reversal-unattributed', 'tr-p-o'],
+      tags: { code: 'TRANSFER_REVERSAL_UNATTRIBUTED' },
+      extra: {
+        connect_transfer_id: 'tr-p-o',
+        purchase_id: 'p-o',
