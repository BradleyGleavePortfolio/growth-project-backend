+ALTER TABLE "DunningState" ADD COLUMN IF NOT EXISTS "client_canceled_at" TIMESTAMP(3);
+ALTER TABLE "DunningState" ADD COLUMN IF NOT EXISTS "sweep_checked_at" TIMESTAMP(3);
+
