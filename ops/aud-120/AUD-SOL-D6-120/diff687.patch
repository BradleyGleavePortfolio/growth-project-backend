+  key_attempt      Int?
+  created_at       DateTime     @default(now())
+  updated_at       DateTime     @updatedAt
+
+  @@index([status, next_attempt_at])
+  @@index([dunning_state_id, cycle_key])
+}
+
+/// S-DUNNING-R5 (B-628-8) — one Stripe dispute obligation on one purchase,
+/// as the dunning v2 path saw it. Written under the purchase's DunningState
