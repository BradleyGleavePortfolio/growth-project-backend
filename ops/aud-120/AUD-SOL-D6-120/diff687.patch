+  const creates = (d: string) =>
+    [...sql(d).matchAll(/CREATE TABLE (?:IF NOT EXISTS )?"(\w+)"/g)].map((m) => m[1]);
+
+  it('every referenced table is created by an earlier-sorting migration', () => {
+    const refs = new Set(
+      [...sql(mine).matchAll(/(?:REFERENCES|ALTER TABLE) "(\w+)"/g)].map((m) => m[1]),
