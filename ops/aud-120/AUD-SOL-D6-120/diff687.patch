+/// whose next_attempt_at has passed is retried by the hourly sweep.
+model DunningNoticeDelivery {
+  id               String       @id
+  dunning_state_id String
+  dunning_state    DunningState @relation(fields: [dunning_state_id], references: [id], onDelete: Cascade)
+  cycle_key        String
+  step_index       Int
+  channel          String
+  status           String       @default("pending")
+  attempts         Int          @default(0)
+  last_error       String?
+  next_attempt_at  DateTime?
+  sent_at          DateTime?
