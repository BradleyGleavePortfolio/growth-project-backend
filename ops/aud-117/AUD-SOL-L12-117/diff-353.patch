+  const utils = await render(
+    <DunningLockoutProvider
+      enabled
+      {...handlers}
+      getCurrentRouteName={() => nav.route}
+      subscribeToRouteChanges={(fn) => {
+        nav.listeners.add(fn);
+        return () => nav.listeners.delete(fn);
