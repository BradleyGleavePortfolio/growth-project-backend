+    expect(url.startsWith(`mailto:${SUPPORT_EMAIL}?subject=`)).toBe(true);
+    expect(decodeURIComponent(url)).toContain('Request reference: req-1');
+    expect(decodeURIComponent(url)).toContain('Paused plan: payment help');
