+  let paused = false;
+  const hold = async <T>(data: Record<string, unknown>, out: T): Promise<T> => {
+    if (!paused && data.attempts !== undefined) {
+      paused = true;
+      g.reached();
+      await g.opened;
+    }
+    return out;
+  };
+  const ops = f.prisma.transferReversalOp;
+  const update = ops.update.getMockImplementation()!;
