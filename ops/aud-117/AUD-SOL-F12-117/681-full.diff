diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index fd5c9270..ef118c23 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -3859,6 +3859,8 @@ model ClientPurchase {
 
   splits                 SplitLedgerEntry[]
   transfers              ConnectTransfer[]
+  // S-FEE — one settlement per Stripe charge (first charge + every renewal).
+  settlements            ChargeSettlement[]
   dunning                DunningState?
   reminders              PaymentReminder[]
   refunds                ChargeRefund[]
@@ -3995,7 +3997,10 @@ model SplitLedgerEntry {
   // reversed back to the platform. Always <= amount_cents.
   reversed_cents            Int            @default(0)
   // Idempotency-key we sent to Stripe when posting this slice. Lets the
-  // worker retry safely. Globally unique.
+  // worker retry safely. Globally unique. S-FEE round 11 (B-681-2): a legacy
+  // per-purchase row carries its durable identity here
+  // (sfee-legacy-ledger:<purchase>:<kind>:<payee account>, ids only), so two
+  // concurrent legacy planners can never create a second row.
   idempotency_key           String?        @unique
   last_error                String?
   posted_at                 DateTime?
@@ -4003,11 +4008,17 @@ model SplitLedgerEntry {
   created_at                DateTime       @default(now())
   updated_at                DateTime       @updatedAt
 
-  @@unique([purchase_id, kind, payee_user_id])
+  // S-FEE: the ledger is per CHARGE. A recurring purchase has one set of rows
+  // per renewal, distinguished by stripe_charge_id. Kinds written by
+  // ChargeSettlementService: application_fee (TGP's 2%), stripe_fee (Stripe's
