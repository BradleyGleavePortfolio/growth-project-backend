+    currently_due: string[];
+    past_due: string[];
+    current_deadline: string | null;
+    disabled_reason: string | null;
+  };
+}
+
+export interface MoneyAttentionDto {
+  count: number;
+  items: MoneyAttentionItem[];
+}
+
+interface SliceRow {
+  kind: string;
+  payee_user_id: string | null;
+  amount_cents: number;
+  reversed_cents: number;
+  status: string;
+  purchase_id: string;
+  currency: string;
+}
+
+const COUNTED_SLICE_STATUSES = ['posted', 'reversed'];
+const LOST_DISPUTE_STATUS_LIST: string[] = [...LOST_DISPUTE_STATUSES];
+
+/**
+ * A purchase was paid when its status says so OR the ledger holds a posted
+ * coach slice for it (a paid purchase that later canceled or expired keeps
+ * its ledger rows, so it still counts as a sale) — unless the money went back
+ * to the client: a fully refunded purchase or a lost chargeback is never
+ * "paid", never a new client and never the coach's first client payment
+ * (B-641-2). An open dispute still counts until the bank decides; a won
+ * dispute flips the purchase back to `paid`.
+ */
+export const PAID_WHERE = {
+  AND: [
+    { status: { notIn: [CHARGEBACK_LOST_PURCHASE_STATUS, REFUNDED_PURCHASE_STATUS] } },
+    { disputes: { none: { status: { in: [...LOST_DISPUTE_STATUSES] } } } },
+    {
+      OR: [
+        { status: { in: [...PAID_PURCHASE_STATUSES] } },
+        { splits: { some: { kind: 'destination', status: { in: COUNTED_SLICE_STATUSES } } } },
+      ],
+    },
+  ],
+};
+
+/** `refunded` filter: money went back by refund OR by a lost chargeback. */
+export const REFUNDED_WHERE = {
+  OR: [
+    { refunds: { some: { status: 'succeeded' } } },
+    { status: CHARGEBACK_LOST_PURCHASE_STATUS },
+    { disputes: { some: { status: { in: [...LOST_DISPUTE_STATUSES] } } } },
+  ],
+};
+
+/** `disputed` filter: open disputes and lost chargebacks. */
+export const DISPUTED_WHERE = {
+  OR: [
+    { status: CHARGEBACK_LOST_PURCHASE_STATUS },
+    {
+      disputes: {
+        some: { status: { in: [...OPEN_DISPUTE_STATUSES, ...LOST_DISPUTE_STATUSES] } },
+      },
+    },
+  ],
+};
+
+function emptyTotals(): MoneyTotals {
+  return {
+    gross_cents: 0,
+    processing_cents: 0,
+    platform_fee_cents: 0,
+    head_coach_split_cents: 0,
+    refunded_cents: 0,
+    head_coach_income_cents: 0,
+    net_cents: 0,
+    charge_count: 0,
+    processing_paid_by: 'none',
+  };
+}
+
+/**
+ * Pure fold of ledger slices into coach-facing totals. Exported for tests.
+ *
+ * `sellerSlices` are every slice of purchases the coach SOLD; `incomeSlices`
+ * are head_coach_split slices where the coach is the PAYEE on a sub-coach's
+ * sale. A reversal never counts twice: each slice contributes
+ * amount - reversed exactly once.
+ */
+export function foldTotals(
+  coachId: string,
+  sellerSlices: readonly SliceRow[],
+  incomeSlices: readonly SliceRow[],
+): MoneyTotals {
+  const t = emptyTotals();
+  const chargesWithDestination = new Set<string>();
+  const chargesWithStripeFee = new Set<string>();
+  for (const s of sellerSlices) {
+    const kept = Math.max(0, s.amount_cents - s.reversed_cents);
+    t.gross_cents += s.amount_cents;
+    switch (s.kind) {
+      case 'destination':
+        if (s.payee_user_id === coachId) {
+          t.net_cents += kept;
+          t.refunded_cents += s.reversed_cents;
+          chargesWithDestination.add(s.purchase_id);
+        }
+        break;
+      case 'application_fee':
+        t.platform_fee_cents += kept;
+        break;
+      case 'head_coach_split':
+        t.head_coach_split_cents += kept;
+        break;
+      case 'stripe_fee':
+        t.processing_cents += s.amount_cents;
+        chargesWithStripeFee.add(s.purchase_id);
+        break;
+      default:
+        break;
+    }
+  }
+  for (const s of incomeSlices) {
+    if (s.kind !== 'head_coach_split' || s.payee_user_id !== coachId) continue;
+    const kept = Math.max(0, s.amount_cents - s.reversed_cents);
+    t.head_coach_income_cents += kept;
+    t.net_cents += kept;
+  }
+  t.charge_count = chargesWithDestination.size;
+  if (chargesWithDestination.size === 0) t.processing_paid_by = 'none';
+  else {
+    let coachPaid = 0;
+    for (const id of chargesWithDestination) if (chargesWithStripeFee.has(id)) coachPaid += 1;
+    t.processing_paid_by =
+      coachPaid === 0 ? 'platform' : coachPaid === chargesWithDestination.size ? 'coach' : 'mixed';
+  }
+  return t;
+}
+
+/** One refund or lost chargeback that took money back from a charge. */
+export interface ReversalEvent {
+  kind: 'refund' | 'chargeback';
+  at: Date;
+  /** What the client got back in this event. */
+  amount_cents: number;
+  stripe_charge_id: string | null;
+  /** ChargeRefund / ChargeDispute id (matches SplitLedgerReversal.source_id). */
+  source_id?: string;
+}
+
+/** B-676-1: what one event took back from one slice, posted once by the writer. */
+export interface ReversalPosting {
+  source_kind: string;
+  source_id: string;
+  cents: number;
+  posted_at: Date;
+}
+
+/** A ledger slice with its timing, for windowed totals and the tax export. */
+export interface TimedSliceRow extends SliceRow {
+  stripe_charge_id: string | null;
+  posted_at: Date | null;
+  reversed_at: Date | null;
+  created_at: Date;
+  client_name: string | null;
+  package_name: string | null;
+}
+
+/** A slice with reversed_cents > 0 and the events that reversed it. */
+export interface ReversedSliceRow extends TimedSliceRow {
+  events: ReversalEvent[];
+  postings?: ReversalPosting[];
+}
+
+export interface ReversalPortion {
+  /** `reversal` = no refund / dispute row explains it (legacy rows). */
+  kind: 'refund' | 'chargeback' | 'reversal';
+  at: Date;
+  cents: number;
+  /** What the client got back in the event (null for `reversal`). */
+  event_amount_cents: number | null;
+}
+
+/** When a slice was posted (legacy rows without posted_at use created_at). */
+export function slicePostedAt(s: { posted_at: Date | null; created_at: Date }): Date {
+  return s.posted_at ?? s.created_at;
+}
+
+function inWindow(at: Date, w: MoneyWindow): boolean {
+  return at.getTime() >= w.from.getTime() && at.getTime() < w.to.getTime();
+}
+
+/**
+ * C-641-1 — split a slice's `reversed_cents` across the refunds / lost
+ * chargebacks that caused it, so each part lands at the time its event
+ * happened. The ledger keeps one cumulative `reversed_cents` per slice
+ * (SplitLedgerService.applyReversal), and the refund pipeline reverses each
+ * event proportionally to its amount, so the parts are allocated in
+ * proportion to the event amounts, oldest first, the newest event taking
+ * the rounding remainder: the parts always sum to exactly `reversed_cents`.
+ * Events of another charge of the same purchase (per-charge ledger rows
+ * after #627) never count. A reversal with no matching event row falls back
+ * to the slice's `reversed_at` (else its posting time).
+ */
+export function allocateReversal(slice: ReversedSliceRow): ReversalPortion[] {
+  // B-676-1 (B-CM1-116): an event's posting is exactly what the writer took
+  // back, at the event's own time, and never changes. Only cents with no
+  // posting (legacy rows) are split across the events that have none.
+  const postings = slice.postings ?? [];
+  const posted: ReversalPortion[] = postings.map((p) => {
+    const kind = p.source_kind === 'refund' ? 'refund' : 'chargeback';
+    const e = slice.events.find((x) => x.kind === kind && x.source_id === p.source_id);
+    return { kind, at: p.posted_at, cents: p.cents, event_amount_cents: e?.amount_cents ?? null };
+  });
+  const total = slice.reversed_cents - posted.reduce((acc, p) => acc + p.cents, 0);
+  if (total <= 0) return posted;
+  const events = slice.events
+    .filter((e) => !postings.some((p) => p.source_id === e.source_id))
+    .filter(
+      (e) =>
+        !slice.stripe_charge_id ||
+        !e.stripe_charge_id ||
+        e.stripe_charge_id === slice.stripe_charge_id,
+    )
+    .slice()
+    .sort((a, b) => a.at.getTime() - b.at.getTime());
+  if (events.length === 0) {
+    return [
+      ...posted,
+      {
+        kind: 'reversal',
+        at: slice.reversed_at ?? slicePostedAt(slice),
+        cents: total,
+        event_amount_cents: null,
+      },
+    ];
+  }
+  const weight = events.reduce((acc, e) => acc + Math.max(0, e.amount_cents), 0);
+  const out: ReversalPortion[] = posted;
+  let left = total;
+  events.forEach((e, i) => {
+    const last = i === events.length - 1;
+    const share = last
+      ? left
+      : weight > 0
+        ? Math.min(left, Math.floor((total * Math.max(0, e.amount_cents)) / weight))
+        : 0;
+    left -= share;
+    if (share > 0) {
+      out.push({ kind: e.kind, at: e.at, cents: share, event_amount_cents: e.amount_cents });
+    }
+  });
+  return out;
+}
+
+/** Cents of a slice's reversal that happened inside the window. */
+export function reversedInWindow(slice: ReversedSliceRow, window: MoneyWindow): number {
+  return allocateReversal(slice)
+    .filter((p) => inWindow(p.at, window))
+    .reduce((acc, p) => acc + p.cents, 0);
+}
+
+export interface WindowSlices {
+  /** Slices of the coach's own sales posted in the window. */
+  salesSeller: TimedSliceRow[];
+  /** head_coach_split slices paid to the coach, posted in the window. */
+  salesIncome: TimedSliceRow[];
+  /** Reversed slices of the coach's own sales with a reversal that may fall in the window. */
+  reversedSeller: ReversedSliceRow[];
+  /** Reversed head_coach_split slices paid to the coach. */
+  reversedIncome: ReversedSliceRow[];
+}
+
+/**
+ * Pure windowed fold (C-641-1). Sales count in the window they were posted
+ * in at their full amount; every refund / chargeback reversal counts in the
+ * window it happened in. Over a window that covers both, this equals
+ * `foldTotals` (each slice contributes amount - reversed exactly once).
+ * Exported for tests.
+ */
+export function foldWindowTotals(
+  coachId: string,
+  window: MoneyWindow,
+  slices: WindowSlices,
+): MoneyTotals {
+  const t = emptyTotals();
+  const chargesWithDestination = new Set<string>();
+  const chargesWithStripeFee = new Set<string>();
+  const chargeKey = (s: SliceRow & { stripe_charge_id: string | null }) =>
+    `${s.purchase_id}|${s.stripe_charge_id ?? ''}`;
+  for (const s of slices.salesSeller) {
+    t.gross_cents += s.amount_cents;
+    switch (s.kind) {
+      case 'destination':
+        if (s.payee_user_id === coachId) {
+          t.net_cents += s.amount_cents;
+          chargesWithDestination.add(chargeKey(s));
+        }
+        break;
+      case 'application_fee':
+        t.platform_fee_cents += s.amount_cents;
+        break;
+      case 'head_coach_split':
+        t.head_coach_split_cents += s.amount_cents;
+        break;
+      case 'stripe_fee':
+        t.processing_cents += s.amount_cents;
+        chargesWithStripeFee.add(chargeKey(s));
+        break;
+      default:
+        break;
+    }
+  }
+  for (const s of slices.salesIncome) {
+    if (s.kind !== 'head_coach_split' || s.payee_user_id !== coachId) continue;
+    t.head_coach_income_cents += s.amount_cents;
+    t.net_cents += s.amount_cents;
+  }
+  for (const s of slices.reversedSeller) {
+    const r = reversedInWindow(s, window);
+    if (r === 0) continue;
+    switch (s.kind) {
+      case 'destination':
+        if (s.payee_user_id === coachId) {
+          t.net_cents -= r;
+          t.refunded_cents += r;
+        }
+        break;
+      case 'application_fee':
+        t.platform_fee_cents -= r;
+        break;
+      case 'head_coach_split':
+        t.head_coach_split_cents -= r;
+        break;
+      default:
+        // Stripe keeps its processing fee on a refund; a stripe_fee slice is
+        // never reported as returned (parity with foldTotals).
+        break;
+    }
+  }
+  for (const s of slices.reversedIncome) {
+    if (s.kind !== 'head_coach_split' || s.payee_user_id !== coachId) continue;
+    const r = reversedInWindow(s, window);
+    t.head_coach_income_cents -= r;
+    t.net_cents -= r;
+  }
+  t.charge_count = chargesWithDestination.size;
+  if (chargesWithDestination.size === 0) t.processing_paid_by = 'none';
+  else {
+    let coachPaid = 0;
+    for (const id of chargesWithDestination) if (chargesWithStripeFee.has(id)) coachPaid += 1;
+    t.processing_paid_by =
+      coachPaid === 0 ? 'platform' : coachPaid === chargesWithDestination.size ? 'coach' : 'mixed';
+  }
+  return t;
+}
+
+/** B-641-3 — currencies a package can be sold in (packages.dto). */
+export const MONEY_SUPPORTED_CURRENCIES: readonly string[] = ['usd', 'gbp', 'eur', 'aud', 'cad'];
+
+/** Validate an optional `?currency=`; returns the lower-case code or null when absent. */
+export function parseCurrency(raw: string | undefined): string | null {
+  if (raw === undefined || raw.trim() === '') return null;
+  const code = raw.trim().toLowerCase();
+  if (!MONEY_SUPPORTED_CURRENCIES.includes(code)) {
+    throw new BadRequestException({
+      code: 'MONEY_CURRENCY_INVALID',
+      message: `currency must be one of ${MONEY_SUPPORTED_CURRENCIES.join(', ')}. Pick one of the currencies listed in the summary's currencies field.`,
+    });
+  }
+  return code;
+}
+
+/**
+ * B-641-3 — the summary currency when the app does not ask for one: USD if
+ * the coach has any USD activity (or none at all), otherwise their only
+ * currency, otherwise the alphabetically first one. Deterministic, and the
+ * response always names the currency it used.
+ */
+export function defaultCurrency(currencies: readonly string[]): string {
+  if (currencies.length === 0 || currencies.includes('usd')) return 'usd';
+  return [...currencies].sort()[0];
+}
+
+/** B-641-4 — billing cadence of one subscription. */
+export interface RecurringCadence {
+  amount_cents: number;
+  interval: string | null;
+  interval_count: number | null;
+}
+
+/**
+ * B-641-4 — monthly-equivalent of one recurring charge, unrounded, so a
+ * sum of many subscriptions is rounded once. A charge every N weeks counts
+ * 52 / 12 / N times a month, every N months 1 / N, every N years 1 / (12N).
+ * A missing interval is a monthly price (the package default).
+ */
+export function monthlyEquivalent(c: RecurringCadence): number {
+  const count = c.interval_count && c.interval_count > 0 ? c.interval_count : 1;
+  switch (c.interval) {
+    case 'week':
+      return (c.amount_cents * 52) / (12 * count);
+    case 'year':
+      return c.amount_cents / (12 * count);
+    case 'month':
+    default:
+      return c.amount_cents / count;
+  }
+}
+
+/**
+ * B-641-4 — the recurring part of a purchase. For a one-time + recurring
+ * combo package the purchase amount is the one-time charge; the
+ * subscription bills the package's recurring companion price. For a pure
+ * subscription the purchase amount snapshot is the subscription price.
+ * The package cadence is stable for the life of the subscription: the
+ * pricing lock (PACKAGE_PRICING_LOCKED) refuses every price or cadence edit
+ * while the package has an active subscriber, which is exactly the set MRR
+ * counts.
+ */
+export function recurringCadenceOf(p: {
+  amount_cents: number;
+  package: {
+    interval: string | null;
+    interval_count: number;
+    recurring_amount_cents: number | null;
+    recurring_interval: string | null;
+    recurring_interval_count: number | null;
+  } | null;
+}): RecurringCadence {
+  const pkg = p.package;
+  if (pkg && pkg.recurring_amount_cents != null && pkg.recurring_interval) {
+    return {
+      amount_cents: pkg.recurring_amount_cents,
+      interval: pkg.recurring_interval,
+      interval_count: pkg.recurring_interval_count,
+    };
+  }
+  return {
+    amount_cents: p.amount_cents,
+    interval: pkg?.interval ?? null,
+    interval_count: pkg?.interval_count ?? null,
+  };
+}
+
+/** Subscription statuses that bill now (a free trial is not income yet). */
+export const MRR_SUBSCRIPTION_STATUSES: readonly string[] = ['active', 'past_due'];
+
+export function changePct(current: number, previous: number): number | null {
+  if (previous === 0) return null;
+  return Math.round(((current - previous) / Math.abs(previous)) * 1000) / 10;
+}
+
+/** Parse and bound a money window. Throws 400 with a stable code. */
+export function parseWindow(
+  fromRaw: string | undefined,
+  toRaw: string | undefined,
+  label: 'window' | 'compare',
+): MoneyWindow {
+  const code = label === 'window' ? 'MONEY_WINDOW_INVALID' : 'MONEY_COMPARE_WINDOW_INVALID';
+  const from = fromRaw ? new Date(fromRaw) : null;
+  const to = toRaw ? new Date(toRaw) : null;
+  if (!from || !to || Number.isNaN(from.getTime()) || Number.isNaN(to.getTime())) {
+    throw new BadRequestException({
+      code,
+      message: 'from and to must be ISO-8601 timestamps.',
+    });
+  }
+  if (from.getTime() >= to.getTime()) {
+    throw new BadRequestException({ code, message: 'from must be before to.' });
+  }
+  if (to.getTime() - from.getTime() > MONEY_MAX_WINDOW_DAYS * DAY_MS) {
+    throw new BadRequestException({
+      code,
+      message: `A window can span at most ${MONEY_MAX_WINDOW_DAYS} days.`,
+    });
+  }
+  return { from, to };
+}
+
+/** The slice of backend #627's PayeeRecovery delegate this module reads. */
+interface PayeeRecoveryReader {
+  findMany(args: {
+    where: { payee_user_id: string; status: string; currency: string };
+    select: { amount_cents: true; collected_cents: true };
+  }): Promise<Array<{ amount_cents: number; collected_cents: number }>>;
+}
+
+function isPayeeRecoveryReader(v: unknown): v is PayeeRecoveryReader {
+  return typeof v === 'object' && v !== null && typeof Reflect.get(v, 'findMany') === 'function';
+}
+
+/** The PayeeRecovery delegate when this Prisma client has the model, else null. */
+export function payeeRecoveryReader(prisma: object): PayeeRecoveryReader | null {
+  const delegate: unknown = Reflect.get(prisma, 'payeeRecovery');
+  return isPayeeRecoveryReader(delegate) ? delegate : null;
+}
+
+const CADENCE_UNITS = ['week', 'month', 'year'] as const;
+type CadenceUnit = (typeof CADENCE_UNITS)[number];
+
+/**
+ * B-332-2 (S-COACH-3): the cadence one charge bills at, from the same rule
+ * MRR uses (recurringCadenceOf: a combo package bills its recurring part at
+ * the companion interval). An interval this build does not know is null
+ * (the app then says "Recurring"), never a guess. Exported for tests.
+ */
+export function chargeCadence(
+  purchaseBillingType: string,
+  pkg: {
+    interval?: string | null;
+    interval_count?: number | null;
+    recurring_amount_cents?: number | null;
+    recurring_interval?: string | null;
+    recurring_interval_count?: number | null;
+  } | null,
+): { billing_interval: CadenceUnit | null; billing_interval_count: number | null } {
+  const none = { billing_interval: null, billing_interval_count: null };
+  if (purchaseBillingType !== 'recurring' || !pkg) return none;
+  const c = recurringCadenceOf({
+    amount_cents: 0,
+    package: {
+      interval: pkg.interval ?? null,
+      interval_count: pkg.interval_count ?? 1,
+      recurring_amount_cents: pkg.recurring_amount_cents ?? null,
+      recurring_interval: pkg.recurring_interval ?? null,
+      recurring_interval_count: pkg.recurring_interval_count ?? null,
+    },
+  });
+  const unit = CADENCE_UNITS.find((u) => u === c.interval);
+  if (!unit) return none;
+  return {
+    billing_interval: unit,
+    billing_interval_count:
+      typeof c.interval_count === 'number' && c.interval_count >= 1 ? c.interval_count : 1,
+  };
+}
+
+function displayName(u: { name?: string | null } | null | undefined): string {
+  const n = (u?.name ?? '').trim();
+  return n.length > 0 ? n : 'Client';
+}
+
+// ── tax CSV (C-641-4) ─────────────────────────────────────────────────
+
+/** Ledger rows per query the CSV export accepts before asking for a shorter period. */
+export const MONEY_EXPORT_MAX_ROWS = 20_000;
+
+export const MONEY_CSV_COLUMNS = [
+  'date_utc',
+  'type',
+  'charge_id',
+  'stripe_charge_id',
+  'client',
+  'package',
+  'currency',
+  'client_paid',
+  'client_refunded',
+  'processing_fee',
+  'tgp_fee',
+  'head_coach_share',
+  'net_to_you',
+] as const;
+
+type CsvRow = {
+  at: Date;
+  type: 'sale' | 'refund' | 'chargeback' | 'reversal' | 'team_share' | 'team_share_reversal';
+  charge_id: string;
+  stripe_charge_id: string;
+  client: string;
+  package: string;
+  currency: string;
+  client_paid: number | null;
+  client_refunded: number | null;
+  processing_fee: number;
+  tgp_fee: number;
+  head_coach_share: number;
+  net_to_you: number;
+};
+
+/** Integer cents to a plain decimal string (no float maths): -1234 -> "-12.34". */
+export function centsToDecimal(cents: number): string {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(Math.trunc(cents));
+  return `${sign}${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, '0')}`;
+}
+
+/**
+ * One CSV text cell: RFC 4180 quoting plus a formula-injection guard
+ * (a cell starting with = + - @ tab or CR is prefixed with an apostrophe so
+ * a spreadsheet never runs a client-supplied name as a formula).
+ */
+export function csvText(value: string): string {
+  let v = value;
+  if (/^[=+\-@\t\r]/.test(v)) v = `'${v}`;
+  return /[",\r\n]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v;
+}
+
+function emptyCsvRow(s: TimedSliceRow, at: Date, type: CsvRow['type'], withNames: boolean): CsvRow {
+  return {
+    at,
+    type,
+    charge_id: s.purchase_id,
+    stripe_charge_id: s.stripe_charge_id ?? '',
+    client: withNames ? (s.client_name ?? '') : '',
+    package: s.package_name ?? '',
+    currency: s.currency,
+    client_paid: null,
+    client_refunded: null,
+    processing_fee: 0,
+    tgp_fee: 0,
+    head_coach_share: 0,
+    net_to_you: 0,
+  };
+}
+
+/** Pure CSV builder over the same slices as foldWindowTotals. Exported for tests. */
+export function buildMoneyCsv(coachId: string, window: MoneyWindow, slices: WindowSlices): string {
+  const rows = new Map<string, CsvRow>();
+  const row = (key: string, make: () => CsvRow): CsvRow => {
+    let r = rows.get(key);
+    if (!r) {
+      r = make();
+      rows.set(key, r);
+    }
+    return r;
+  };
+  for (const s of slices.salesSeller) {
+    const at = slicePostedAt(s);
+    const r = row(`sale|${s.purchase_id}|${s.stripe_charge_id ?? ''}`, () =>
+      emptyCsvRow(s, at, 'sale', true),
+    );
+    if (at.getTime() < r.at.getTime()) r.at = at;
+    r.client_paid = (r.client_paid ?? 0) + s.amount_cents;
+    if (s.kind === 'destination' && s.payee_user_id === coachId) r.net_to_you += s.amount_cents;
+    else if (s.kind === 'application_fee') r.tgp_fee += s.amount_cents;
+    else if (s.kind === 'head_coach_split') r.head_coach_share += s.amount_cents;
+    else if (s.kind === 'stripe_fee') r.processing_fee += s.amount_cents;
+  }
+  for (const s of slices.salesIncome) {
+    if (s.kind !== 'head_coach_split' || s.payee_user_id !== coachId) continue;
+    const at = slicePostedAt(s);
+    const r = row(`team|${s.purchase_id}|${s.stripe_charge_id ?? ''}`, () =>
+      emptyCsvRow(s, at, 'team_share', false),
+    );
+    r.net_to_you += s.amount_cents;
+  }
+  for (const s of slices.reversedSeller) {
+    for (const p of allocateReversal(s)) {
+      if (!inWindow(p.at, window)) continue;
+      const key = `${p.kind}|${s.purchase_id}|${s.stripe_charge_id ?? ''}|${p.at.toISOString()}`;
+      const r = row(key, () => emptyCsvRow(s, p.at, p.kind, true));
+      if (p.event_amount_cents !== null) r.client_refunded = p.event_amount_cents;
+      if (s.kind === 'destination' && s.payee_user_id === coachId) r.net_to_you -= p.cents;
+      else if (s.kind === 'application_fee') r.tgp_fee -= p.cents;
+      else if (s.kind === 'head_coach_split') r.head_coach_share -= p.cents;
+    }
+  }
+  for (const s of slices.reversedIncome) {
+    if (s.kind !== 'head_coach_split' || s.payee_user_id !== coachId) continue;
+    for (const p of allocateReversal(s)) {
+      if (!inWindow(p.at, window)) continue;
+      const key = `team_rev|${s.purchase_id}|${s.stripe_charge_id ?? ''}|${p.at.toISOString()}`;
+      const r = row(key, () => emptyCsvRow(s, p.at, 'team_share_reversal', false));
+      r.net_to_you -= p.cents;
+    }
+  }
+  const sorted = [...rows.values()].sort(
+    (a, b) => a.at.getTime() - b.at.getTime() || a.charge_id.localeCompare(b.charge_id),
+  );
+  const money = (c: number | null) => (c === null ? '' : centsToDecimal(c));
+  const lines = [MONEY_CSV_COLUMNS.join(',')];
+  for (const r of sorted) {
+    lines.push(
+      [
+        r.at.toISOString(),
+        r.type,
+        csvText(r.charge_id),
+        csvText(r.stripe_charge_id),
+        csvText(r.client),
+        csvText(r.package),
+        csvText(r.currency.toUpperCase()),
+        money(r.client_paid),
+        money(r.client_refunded),
+        money(r.processing_fee),
+        money(r.tgp_fee),
+        money(r.head_coach_share),
+        money(r.net_to_you),
+      ].join(','),
+    );
+  }
+  return lines.join('\r\n') + '\r\n';
+}
+
+@Injectable()
+export class CoachMoneyService {
+  constructor(private readonly prisma: PrismaService) {}
+
+  // ── summary ──────────────────────────────────────────────────────────
+
+  async getSummary(
+    coachId: string,
+    window: MoneyWindow,
+    compare: MoneyWindow | null,
+    now: Date = new Date(),
+    requestedCurrency: string | null = null,
+  ): Promise<MoneySummaryDto> {
+    const currencies = await this.currenciesFor(coachId);
+    const currency = requestedCurrency ?? defaultCurrency(currencies);
+    const [totals, compareTotals, recurring, attention, held] = await Promise.all([
+      this.totalsFor(coachId, window, currency),
+      compare ? this.totalsFor(coachId, compare, currency) : Promise.resolve(null),
+      this.recurring(coachId, now, currency),
+      this.getAttention(coachId),
+      this.heldFromNextSale(coachId, currency),
+    ]);
+    return {
+      currency,
+      currencies,
+      window: { from: window.from.toISOString(), to: window.to.toISOString() },
+      compare: compare ? { from: compare.from.toISOString(), to: compare.to.toISOString() } : null,
+      totals,
+      compare_totals: compareTotals,
+      change_cents: compareTotals ? totals.net_cents - compareTotals.net_cents : null,
+      change_pct: compareTotals ? changePct(totals.net_cents, compareTotals.net_cents) : null,
+      recurring,
+      attention_count: attention.count,
+      held_from_next_sale_cents: held,
+      generated_at: now.toISOString(),
+    };
+  }
+
+  /** B-641-3 — every currency the coach has counted ledger activity in. */
+  async currenciesFor(coachId: string): Promise<string[]> {
+    const rows = await this.prisma.splitLedgerEntry.findMany({
+      where: {
+        status: { in: COUNTED_SLICE_STATUSES },
+        OR: [
+          { purchase: { coach_user_id: coachId, source: null } },
+          { kind: 'head_coach_split', payee_user_id: coachId },
+        ],
+      },
+      select: { currency: true },
+      distinct: ['currency'],
+    });
+    return [...new Set(rows.map((r) => r.currency.toLowerCase()))].sort();
+  }
+
+  private windowRange(window: MoneyWindow) {
+    return { gte: window.from, lt: window.to };
+  }
+
+  private postedInWindow(window: MoneyWindow) {
+    // A slice belongs to the window it was posted in; slices without a
+    // posted_at (legacy rows) fall back to their creation time.
+    const range = this.windowRange(window);
+    return {
+      OR: [{ posted_at: range }, { posted_at: null, created_at: range }],
+    };
+  }
+
+  private reversedPossiblyInWindow(window: MoneyWindow) {
+    // Candidate slices for reversals inside the window: the event rows that
+    // explain a reversal (succeeded refund, lost dispute) or, for legacy
+    // rows with no event, the slice's own reversal / posting time. The
+    // exact in-window share is decided by allocateReversal.
+    const range = this.windowRange(window);
+    return {
+      reversed_cents: { gt: 0 },
+      OR: [
+        { reversed_at: range },
+        { reversed_at: null, posted_at: range },
+        { reversed_at: null, posted_at: null, created_at: range },
+        { reversal_postings: { some: { posted_at: range } } },
+        // B-641-6 (S-COACH-3): a refund is booked when it SUCCEEDED
+        // (posted_at, stamped by the refund pipeline on the pending ->
+        // succeeded transition), not when it was requested. Legacy succeeded
+        // rows written before posted_at existed fall back to created_at.
+        {
+          purchase: {
+            refunds: {
+              some: {
+                status: 'succeeded',
+                OR: [{ posted_at: range }, { posted_at: null, created_at: range }],
+              },
+            },
+          },
+        },
+        {
+          purchase: {
+            disputes: { some: { status: { in: [...LOST_DISPUTE_STATUSES] }, closed_at: range } },
+          },
+        },
+      ],
+    };
+  }
+
+  private timedSliceSelect() {
+    return {
+      kind: true,
+      payee_user_id: true,
+      amount_cents: true,
+      reversed_cents: true,
+      status: true,
+      purchase_id: true,
+      currency: true,
+      stripe_charge_id: true,
+      posted_at: true,
+      reversed_at: true,
+      created_at: true,
+      reversal_postings: {
+        select: { source_kind: true, source_id: true, cents: true, posted_at: true },
+      },
+      purchase: {
+        select: {
+          client: { select: { name: true } },
+          package: { select: { name: true } },
+          refunds: {
+            where: { status: 'succeeded' },
+            select: {
+              id: true,
+              amount_cents: true,
+              posted_at: true,
+              created_at: true,
+              stripe_charge_id: true,
+            },
+          },
+          disputes: {
+            where: { status: { in: LOST_DISPUTE_STATUS_LIST } },
+            select: {
+              id: true,
+              amount_cents: true,
+              closed_at: true,
+              updated_at: true,
+              stripe_charge_id: true,
+            },
+          },
+        },
+      },
+    } as const;
+  }
+
+  private toTimed(
+    r: {
+      kind: string;
+      payee_user_id: string | null;
+      amount_cents: number;
+      reversed_cents: number;
+      status: string;
+      purchase_id: string;
+      currency: string;
+      stripe_charge_id: string | null;
+      posted_at: Date | null;
+      reversed_at: Date | null;
+      created_at: Date;
+      reversal_postings?: ReversalPosting[];
+      purchase: {
+        client: { name: string | null } | null;
+        package: { name: string } | null;
+        refunds: Array<{
+          id?: string;
+          amount_cents: number;
+          posted_at?: Date | null;
+          created_at: Date;
+          stripe_charge_id: string;
+        }>;
+        disputes: Array<{
+          id?: string;
+          amount_cents: number;
+          closed_at: Date | null;
+          updated_at: Date;
+          stripe_charge_id: string;
+        }>;
+      } | null;
+    },
+    withClient: boolean,
+  ): ReversedSliceRow {
+    const events: ReversalEvent[] = [
+      ...(r.purchase?.refunds ?? []).map((x): ReversalEvent => ({
+        kind: 'refund',
+        // B-641-6: completion time; created_at only for legacy rows.
+        at: x.posted_at ?? x.created_at,
+        amount_cents: x.amount_cents,
+        stripe_charge_id: x.stripe_charge_id ?? null,
+        source_id: x.id,
+      })),
+      ...(r.purchase?.disputes ?? []).map((x): ReversalEvent => ({
+        kind: 'chargeback',
+        at: x.closed_at ?? x.updated_at,
+        amount_cents: x.amount_cents,
+        stripe_charge_id: x.stripe_charge_id ?? null,
+        source_id: x.id,
+      })),
+    ];
+    return {
+      kind: r.kind,
+      payee_user_id: r.payee_user_id,
+      amount_cents: r.amount_cents,
+      reversed_cents: r.reversed_cents,
+      status: r.status,
+      purchase_id: r.purchase_id,
+      currency: r.currency,
+      stripe_charge_id: r.stripe_charge_id,
+      posted_at: r.posted_at,
+      reversed_at: r.reversed_at,
+      created_at: r.created_at,
+      // Head-coach income rows come from a sub-coach's sale: the client is
+      // the sub-coach's buyer, so the name is not carried.
+      client_name: withClient ? displayName(r.purchase?.client) : null,
+      package_name: r.purchase?.package?.name ?? null,
+      events,
+      postings: r.reversal_postings ?? [],
+    };
+  }
+
+  /** Load every slice the window's totals and tax export need. */
+  async loadWindow(
+    coachId: string,
+    window: MoneyWindow,
+    opts: { currency?: string; limit?: number } = {},
+  ): Promise<WindowSlices> {
+    const { currency, limit } = opts;
+    const select = this.timedSliceSelect();
+    const take: number | undefined = limit === undefined ? undefined : limit + 1;
+    // B-641-3: a money total only ever adds rows of one currency.
+    const currencyScope = currency === undefined ? {} : { currency };
+    const sellerScope = {
+      ...currencyScope,
+      status: { in: COUNTED_SLICE_STATUSES },
+      purchase: { coach_user_id: coachId, source: null },
+    };
+    const incomeScope = {
+      ...currencyScope,
+      status: { in: COUNTED_SLICE_STATUSES },
+      kind: 'head_coach_split',
+      payee_user_id: coachId,
+      purchase: { coach_user_id: { not: coachId } },
+    };
+    const [salesSeller, salesIncome, reversedSeller, reversedIncome] = await Promise.all([
+      this.prisma.splitLedgerEntry.findMany({
+        where: { ...sellerScope, ...this.postedInWindow(window) },
+        select,
+        take,
+      }),
+      this.prisma.splitLedgerEntry.findMany({
+        where: { ...incomeScope, ...this.postedInWindow(window) },
+        select,
+        take,
+      }),
+      this.prisma.splitLedgerEntry.findMany({
+        where: { ...sellerScope, ...this.reversedPossiblyInWindow(window) },
+        select,
+        take,
+      }),
+      this.prisma.splitLedgerEntry.findMany({
+        where: { ...incomeScope, ...this.reversedPossiblyInWindow(window) },
+        select,
+        take,
+      }),
+    ]);
+    if (
+      limit !== undefined &&
+      [salesSeller, salesIncome, reversedSeller, reversedIncome].some((rows) => rows.length > limit)
+    ) {
+      throw new BadRequestException({
+        code: 'MONEY_EXPORT_TOO_LARGE',
+        message: `This period has more than ${limit} ledger rows, which is too many for one file. Choose a shorter period, for example one quarter, and export each part.`,
+      });
+    }
+    // B-641-3 belt and braces: even if a query ever loses its currency
+    // scope, a total never adds a row in another currency.
+    const sameCurrency = (r: { currency: string }) =>
+      currency === undefined || r.currency.toLowerCase() === currency;
+    return {
+      salesSeller: salesSeller.filter(sameCurrency).map((r) => this.toTimed(r, true)),
+      salesIncome: salesIncome.filter(sameCurrency).map((r) => this.toTimed(r, false)),
+      reversedSeller: reversedSeller.filter(sameCurrency).map((r) => this.toTimed(r, true)),
+      reversedIncome: reversedIncome.filter(sameCurrency).map((r) => this.toTimed(r, false)),
+    };
+  }
+
+  async totalsFor(coachId: string, window: MoneyWindow, currency: string): Promise<MoneyTotals> {
+    return foldWindowTotals(coachId, window, await this.loadWindow(coachId, window, { currency }));
+  }
+
+  /**
+   * C-641-4 — "Export CSV for taxes". One row per sale (per charge) posted
+   * in the window and one row per refund / chargeback that happened in the
+   * window, from the same ledger fold as the summary: the `net_to_you`
+   * column, per currency, sums to the summary's `totals.net_cents` for the
+   * same window and currency. Every row names its currency (B-641-3); the
+   * file never adds amounts across currencies.
+   */
+  async exportCsv(
+    coachId: string,
+    window: MoneyWindow,
+    currency: string | null = null,
+  ): Promise<string> {
+    // C-641-6 (S-COACH-3): `?currency=` limits the file to one currency, so
+    // a spreadsheet sum of net_to_you is one meaningful number.
+    const slices = await this.loadWindow(coachId, window, {
+      limit: MONEY_EXPORT_MAX_ROWS,
+      ...(currency ? { currency } : {}),
+    });
+    return buildMoneyCsv(coachId, window, slices);
+  }
+
+  /**
+   * C-641-3 — open held-from-next-sale amount for the coach, read from the
+   * backend #627 PayeeRecovery ledger (open rows, amount - collected) when
+   * this server has it. Feature-detected on the Prisma client so this
+   * module has no compile-time dependency on #627: before #627 is deployed
+   * the delegate does not exist and the field is null; after, it reports
+   * the live number with no code change here.
+   */
+  async heldFromNextSale(coachId: string, currency: string): Promise<number | null> {
+    const reader = payeeRecoveryReader(this.prisma);
+    if (!reader) return null;
+    const rows = await reader.findMany({
+      where: { payee_user_id: coachId, status: 'open', currency },
+      select: { amount_cents: true, collected_cents: true },
+    });
+    return rows.reduce((acc, r) => acc + Math.max(0, r.amount_cents - r.collected_cents), 0);
+  }
+
+  private async recurring(coachId: string, now: Date, currency: string) {
+    const thirtyAgo = new Date(now.getTime() - 30 * DAY_MS);
+    const [active, churned, newPurchases] = await Promise.all([
+      this.prisma.clientPurchase.findMany({
+        where: {
+          coach_user_id: coachId,
+          entitlement_active: true,
+          source: null,
+          amount_cents: { gt: 0 },
+        },
+        select: {
+          client_user_id: true,
+          amount_cents: true,
+          currency: true,
+          billing_type: true,
+          status: true,
+          package: {
+            select: {
+              interval: true,
+              interval_count: true,
+              recurring_amount_cents: true,
+              recurring_interval: true,
+              recurring_interval_count: true,
+            },
+          },
+        },
+      }),
+      this.prisma.clientPurchase.findMany({
+        where: {
+          coach_user_id: coachId,
+          source: null,
+          amount_cents: { gt: 0 },
+          canceled_at: { gte: thirtyAgo, lte: now },
+        },
+        select: { client_user_id: true },
+      }),
+      this.prisma.clientPurchase.findMany({
+        where: {
+          coach_user_id: coachId,
+          source: null,
+          amount_cents: { gt: 0 },
+          ...PAID_WHERE,
+          created_at: { gte: thirtyAgo, lte: now },
+        },
+        select: { client_user_id: true },
+      }),
+    ]);
+    // B-641-4: MRR is the monthly equivalent of every billing subscription
+    // in the summary currency (B-641-3), at its real cadence (week / month /
+    // year x interval count; a combo package's recurring companion price),
+    // summed unrounded and rounded once.
+    // A free trial is counted apart (trial_*), never in MRR or paying clients.
+    let mrrExact = 0;
+    let trialExact = 0;
+    const trialIds = new Set<string>();
+    for (const p of active) {
+      if (p.billing_type !== 'recurring') continue;
+      if (p.currency.toLowerCase() !== currency) continue;
+      if (p.status === 'trialing') {
+        trialIds.add(p.client_user_id);
+        trialExact += monthlyEquivalent(recurringCadenceOf(p));
+        continue;
+      }
+      // A canceled / expired subscription keeps entitlement to the period
+      // end but will not bill again.
+      if (!MRR_SUBSCRIPTION_STATUSES.includes(p.status)) continue;
+      mrrExact += monthlyEquivalent(recurringCadenceOf(p));
+    }
+    const mrr = Math.round(mrrExact);
+    const payingIds = new Set(
+      active.filter((p) => p.status !== 'trialing').map((p) => p.client_user_id),
+    );
+    // A client counts as new when their first paid purchase with this coach
+    // is inside the last 30 days.
+    const candidateIds = [...new Set(newPurchases.map((p) => p.client_user_id))];
+    let newClients = 0;
+    if (candidateIds.length > 0) {
+      const earlier = await this.prisma.clientPurchase.findMany({
+        where: {
+          coach_user_id: coachId,
+          source: null,
+          amount_cents: { gt: 0 },
+          client_user_id: { in: candidateIds },
+          created_at: { lt: thirtyAgo },
+          ...PAID_WHERE,
+        },
+        select: { client_user_id: true },
+      });
+      const returning = new Set(earlier.map((p) => p.client_user_id));
+      newClients = candidateIds.filter((id) => !returning.has(id)).length;
+    }
+    // Churned = clients who canceled in the window and hold no other active
+    // paid purchase with this coach today.
+    const churnedIds = new Set(
+      churned.map((p) => p.client_user_id).filter((id) => !payingIds.has(id)),
+    );
+    return {
+      mrr_cents: mrr,
+      paying_clients: payingIds.size,
+      trial_clients: trialIds.size,
+      trial_mrr_cents: Math.round(trialExact),
+      churned_30d: churnedIds.size,
+      new_clients_30d: newClients,
+    };
+  }
+
+  // ── charges ──────────────────────────────────────────────────────────
+
+  async listCharges(
+    coachId: string,
+    opts: { status: ChargeStatusFilter; cursor?: string | null; limit?: number },
+  ): Promise<{ charges: MoneyChargeDto[]; next_cursor: string | null }> {
+    const limit = Math.min(
+      Math.max(opts.limit ?? MONEY_CHARGES_PAGE_DEFAULT, 1),
+      MONEY_CHARGES_PAGE_MAX,
+    );
+    const statusWhere =
+      opts.status === 'paid'
+        ? PAID_WHERE
+        : opts.status === 'failed'
+          ? { status: { in: [...FAILED_PURCHASE_STATUSES] } }
+          : opts.status === 'refunded'
+            ? REFUNDED_WHERE
+            : opts.status === 'disputed'
+              ? DISPUTED_WHERE
+              : {};
+    const rows = await this.prisma.clientPurchase.findMany({
+      where: { coach_user_id: coachId, source: null, amount_cents: { gt: 0 }, ...statusWhere },
+      orderBy: [{ created_at: 'desc' }, { id: 'desc' }],
+      take: limit + 1,
+      ...(opts.cursor ? { cursor: { id: opts.cursor }, skip: 1 } : {}),
+      select: this.chargeSelect(),
+    });
+    const hasMore = rows.length > limit;
+    const page = hasMore ? rows.slice(0, limit) : rows;
+    return {
+      charges: page.map((r) => this.toCharge(r)),
+      next_cursor: hasMore ? page[page.length - 1].id : null,
+    };
+  }
+
+  async getChargeBreakdown(coachId: string, purchaseId: string): Promise<MoneyChargeBreakdownDto> {
+    const row = await this.prisma.clientPurchase.findFirst({
+      where: { id: purchaseId, coach_user_id: coachId, source: null },
+      select: this.chargeSelect(),
+    });
+    if (!row) {
+      throw new NotFoundException({
+        code: 'MONEY_CHARGE_NOT_FOUND',
+        message: 'This charge is not one of your sales.',
+      });
+    }
+    const slices = await this.prisma.splitLedgerEntry.findMany({
+      where: { purchase_id: row.id, status: { in: COUNTED_SLICE_STATUSES } },
+      select: {
+        kind: true,
+        payee_user_id: true,
+        amount_cents: true,
+        reversed_cents: true,
+        status: true,
+        purchase_id: true,
+        currency: true,
+      },
+    });
+    const t = foldTotals(coachId, slices, []);
+    const settled = slices.some((s) => s.kind === 'destination');
+    return {
+      charge: this.toCharge(row),
+      breakdown: {
+        price_cents: settled ? t.gross_cents : row.amount_cents,
+        processing_cents: t.processing_cents,
+        platform_fee_cents: t.platform_fee_cents,
+        head_coach_split_cents: t.head_coach_split_cents,
+        refunded_cents: t.refunded_cents,
+        net_cents: t.net_cents,
+        processing_paid_by: settled ? t.processing_paid_by : 'none',
+        settled,
+      },
+    };
+  }
+
+  private chargeSelect() {
+    return {
+      id: true,
+      amount_cents: true,
+      currency: true,
+      billing_type: true,
+      status: true,
+      created_at: true,
+      client: { select: { id: true, name: true } },
+      package: {
+        select: {
+          id: true,
+          name: true,
+          interval: true,
+          interval_count: true,
+          recurring_amount_cents: true,
+          recurring_interval: true,
+          recurring_interval_count: true,
+        },
+      },
+      refunds: { where: { status: 'succeeded' }, select: { amount_cents: true } },
+      disputes: { select: { status: true, amount_cents: true } },
+      splits: {
+        where: { kind: 'destination', status: { in: COUNTED_SLICE_STATUSES } },
+        select: { id: true },
+        take: 1,
+      },
+    } as const;
+  }
+
+  private toCharge(r: {
+    id: string;
+    amount_cents: number;
+    currency: string;
+    billing_type: string;
+    status: string;
+    created_at: Date;
+    client: { id: string; name: string | null } | null;
+    package: {
+      id: string;
+      name: string;
+      interval?: string | null;
+      interval_count?: number | null;
+      recurring_amount_cents?: number | null;
+      recurring_interval?: string | null;
+      recurring_interval_count?: number | null;
+    } | null;
+    refunds: Array<{ amount_cents: number }>;
+    disputes: Array<{ status: string; amount_cents: number }>;
+    splits: Array<{ id: string }>;
+  }): MoneyChargeDto {
+    const refunded = r.refunds.reduce((acc, x) => acc + x.amount_cents, 0);
+    const openDispute = r.disputes.some((d) =>
+      (OPEN_DISPUTE_STATUSES as readonly string[]).includes(d.status),
+    );
+    const lostDisputes = r.disputes.filter((d) =>
+      (LOST_DISPUTE_STATUSES as readonly string[]).includes(d.status),
+    );
+    const chargedBackCents = lostDisputes.reduce((acc, d) => acc + d.amount_cents, 0);
+    const chargedBack = r.status === CHARGEBACK_LOST_PURCHASE_STATUS || lostDisputes.length > 0;
+    let state: MoneyChargeDto['state'];
+    // B-641-2: a lost chargeback is checked first — the ledger keeps its
+    // (reversed) destination slice, which must never read as `paid`.
+    if (chargedBack) state = 'charged_back';
+    else if (openDispute) state = 'disputed';
+    else if (refunded > 0 && refunded >= r.amount_cents) state = 'refunded';
+    else if (refunded > 0) state = 'partially_refunded';
+    else if ((FAILED_PURCHASE_STATUSES as readonly string[]).includes(r.status)) state = 'failed';
+    else if (
+      (PAID_PURCHASE_STATUSES as readonly string[]).includes(r.status) ||
+      r.splits.length > 0
+    )
+      state = 'paid';
+    else if (r.status === 'canceled' || r.status === 'expired') state = 'canceled';
+    else state = 'pending';
+    return {
+      id: r.id,
+      client: { id: r.client?.id ?? '', name: displayName(r.client) },
+      package: { id: r.package?.id ?? '', name: r.package?.name ?? 'Package' },
+      amount_cents: r.amount_cents,
+      currency: r.currency,
+      billing_type: r.billing_type === 'recurring' ? 'recurring' : 'one_time',
+      ...chargeCadence(r.billing_type, r.package),
+      state,
+      refunded_cents: refunded,
+      charged_back_cents: chargedBackCents,
+      created_at: r.created_at.toISOString(),
+    };
+  }
+
+  // ── needs attention ──────────────────────────────────────────────────
+
+  async getAttention(coachId: string): Promise<MoneyAttentionDto> {
+    const [failed, disputes, account] = await Promise.all([
+      this.prisma.clientPurchase.findMany({
+        where: {
+          coach_user_id: coachId,
+          source: null,
+          status: { in: [...FAILED_PURCHASE_STATUSES] },
+        },
+        orderBy: { updated_at: 'desc' },
+        take: 50,
+        select: {
+          id: true,
+          amount_cents: true,
+          currency: true,
+          updated_at: true,
+          last_error: true,
+          client: { select: { id: true, name: true } },
+          package: { select: { name: true } },
+          dunning: {
+            select: {
+              status: true,
+              failure_count: true,
+              step_index: true,
+              next_attempt_at: true,
+              locked_out_at: true,
+              last_failed_amount_cents: true,
+              last_failure_at: true,
+              last_failure_reason: true,
+              // B-641-1: the production write. DunningService.fireAttempt
+              // stamps status 'sent' + sent_at on the attempt once the
+              // reminder email (with the "Update payment" button) is
+              // accepted by the provider. A reopened cycle deletes the old
+              // cycle's attempts, so this is always the current cycle.
+              attempts: {
+                where: {
+                  status: 'sent',
+                  sent_at: { not: null },
+                  kind: { in: [...CARD_UPDATE_LINK_ATTEMPT_KINDS] },
+                },
+                orderBy: { sent_at: 'desc' },
+                take: 1,
+                select: { sent_at: true },
+              },
+            },
+          },
+        },
+      }),
+      this.prisma.chargeDispute.findMany({
+        where: {
+          status: { in: [...OPEN_DISPUTE_STATUSES] },
+          purchase: { coach_user_id: coachId },
+        },
+        orderBy: { created_at: 'desc' },
+        take: 50,
+        select: {
+          id: true,
+          purchase_id: true,
+          amount_cents: true,
+          currency: true,
+          status: true,
+          reason: true,
+          evidence_due_by: true,
+          created_at: true,
+          purchase: { select: { client: { select: { id: true, name: true } } } },
+        },
+      }),
+      this.prisma.connectAccount.findUnique({
+        where: { coach_user_id: coachId },
+        select: { requirements_due: true, disabled_reason: true },
+      }),
+    ]);
+
+    const maxAttempts = DUNNING_V2_CADENCE_DAYS.length;
+    const items: MoneyAttentionItem[] = [];
+    for (const p of failed) {
+      const d = p.dunning;
+      const attempt = Math.min(
+        maxAttempts,
+        Math.max(1, d ? Math.max(d.failure_count, d.step_index + 1) : 1),
+      );
+      items.push({
+        kind: 'failed_payment',
+        id: `failed:${p.id}`,
+        client: p.client ? { id: p.client.id, name: displayName(p.client) } : null,
+        amount_cents: d?.last_failed_amount_cents ?? p.amount_cents,
+        currency: p.currency,
+        created_at: (d?.last_failure_at ?? p.updated_at).toISOString(),
+        failed_payment: {
+          purchase_id: p.id,
+          package_name: p.package?.name ?? 'Package',
+          attempt,
+          max_attempts: maxAttempts,
+          next_retry_at: d?.next_attempt_at ? d.next_attempt_at.toISOString() : null,
+          locked_out_at: d?.locked_out_at ? d.locked_out_at.toISOString() : null,
+          card_update_link_sent_at: d?.attempts[0]?.sent_at
+            ? d.attempts[0].sent_at.toISOString()
+            : null,
+          last_failure_reason: d?.last_failure_reason ?? p.last_error ?? null,
+        },
+      });
+    }
+    for (const dsp of disputes) {
+      const c = dsp.purchase?.client;
+      items.push({
+        kind: 'dispute',
+        id: `dispute:${dsp.id}`,
+        client: c ? { id: c.id, name: displayName(c) } : null,
+        amount_cents: dsp.amount_cents,
+        currency: dsp.currency,
+        created_at: dsp.created_at.toISOString(),
+        dispute: {
+          purchase_id: dsp.purchase_id,
+          status: dsp.status,
+          reason: dsp.reason,
+          evidence_due_by: dsp.evidence_due_by ? dsp.evidence_due_by.toISOString() : null,
+        },
+      });
+    }
+    const req = readRequirements(account?.requirements_due);
+    if (req.currently_due.length > 0 || req.past_due.length > 0) {
+      items.push({
+        kind: 'stripe_requirements',
+        id: 'stripe_requirements',
+        client: null,
+        amount_cents: null,
+        currency: null,
+        created_at: null,
+        stripe_requirements: {
+          currently_due: req.currently_due,
+          past_due: req.past_due,
+          current_deadline: req.current_deadline,
+          disabled_reason: account?.disabled_reason ?? null,
+        },
+      });
+    }
+    return { count: items.length, items };
+  }
+}
+
+export interface ParsedRequirements {
+  currently_due: string[];
+  past_due: string[];
+  eventually_due: string[];
+  pending_verification: string[];
+  current_deadline: string | null;
+}
+
+/** Read Stripe's `requirements` hash as mirrored on ConnectAccount. */
+export function readRequirements(raw: unknown): ParsedRequirements {
+  const out: ParsedRequirements = {
+    currently_due: [],
+    past_due: [],
+    eventually_due: [],
+    pending_verification: [],
+    current_deadline: null,
+  };
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return out;
+  const r = raw as Record<string, unknown>;
+  const list = (k: string): string[] =>
+    Array.isArray(r[k])
+      ? (r[k] as unknown[]).filter((x): x is string => typeof x === 'string')
+      : [];
+  out.currently_due = list('currently_due');
+  out.past_due = list('past_due');
+  out.eventually_due = list('eventually_due');
+  out.pending_verification = list('pending_verification');
+  const deadline = r['current_deadline'];
+  if (typeof deadline === 'number' && Number.isFinite(deadline) && deadline > 0) {
+    out.current_deadline = new Date(deadline * 1000).toISOString();
+  }
+  return out;
+}
