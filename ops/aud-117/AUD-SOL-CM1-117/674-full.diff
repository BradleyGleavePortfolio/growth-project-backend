+
+  it('lists rows in review oldest first with ids only', async () => {
+    const h = await inReview();
+    const rows = await h.svc.listTransferReversalsInReview();
+    expect(rows).toEqual([
+      expect.objectContaining({
+        charge_refund_id: 'r-late',
+        purchase_id: 'p-late',
