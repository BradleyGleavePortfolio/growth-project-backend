+describe('LX-SOL-126 ordinary subset-volume regression', () => {
+  it('keeps the server hard-set limit when the coach keeps only the increase from a balanced redistribution', () => {
+    const baseline: PlanSnapshot = {
+      meta: { name: 'Chest', type: 'strength', duration_estimate_minutes: 45 },
+      exercises: ['seed:push-001', 'seed:push-002', 'seed:push-003'].map((id, i) => ({
+        client_ref: `r${i}`, exercise_external_id: id, order: i, sets: 4, reps_or_duration_seconds: 8,
+        weight_lbs: null, rest_seconds: 90, superset_group_id: null, notes: null,
+      })),
+    };
+    const library = new Map<string, LibraryExercise>(
+      baseline.exercises.map((r) => [r.exercise_external_id, {
+        id: r.exercise_external_id, name: r.exercise_external_id, category: 'strength', muscle: 'chest', thumbnail_url: null,
+      }]),
+    );
+    const validated = validateProposedChanges({
+      baseline, library, injuries: [], instruction: 'Redistribute the chest volume', screeningFlag: false,
+      rawChanges: [
+        { op: { kind: 'update_exercise', client_ref: 'r0', sets: 2 }, reason: 'Move two sets to the next lift.' },
+        { op: { kind: 'update_exercise', client_ref: 'r1', sets: 6 }, reason: 'Keep the total weekly volume.' },
+      ],
+    });
+    expect(validated.changes.map((c) => c.change_id)).toEqual(['c0', 'c1']);
+    expect(validated.snapshot.exercises.reduce((sum, r) => sum + r.sets, 0)).toBe(12);
+    const accepted = selectAcceptedOps(validated.changes.map((c) => c.op), ['c1']);
+    const applied = applyWorkoutDiff(baseline, accepted);
+    expect(applied.exercises.reduce((sum, r) => sum + r.sets, 0)).toBeLessThanOrEqual(12);
+  });
+});
