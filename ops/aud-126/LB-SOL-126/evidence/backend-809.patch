+        summary: 'Knee-friendly pulling work. This will heal the knee.',
+        changes: [
+          { op: { kind: 'add_exercise', client_ref: 'ai-1', exercise_external_id: 'seed:legs-001', sets: 3, reps_or_duration_seconds: 8 }, reason: 'Legs.' },
