+      await expect(svc.propose(coach, { ...edit, client_id: CLIENT })).rejects.toMatchObject({ status: 403 });
+      expect(anthropic).not.toHaveBeenCalled();
+      expect(prisma.aiActionDraft.create).not.toHaveBeenCalled();
