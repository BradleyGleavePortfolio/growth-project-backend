+    expect(api.calls[0].form.get('cancel_at_period_end')).toBe('false');
+    expect(api.calls[0].headers['Idempotency-Key']).toBe('tgp-resume-1');
+    expect(api.calls[1].form.get('default_payment_method')).toBe('pm_1');
