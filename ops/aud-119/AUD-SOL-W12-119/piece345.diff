+        for (const payouts of [true, false]) {
+          const c = connectCopy(
+            view({ state, chargesEnabled: charges, payoutsEnabled: payouts }),
+          );
+          expect(`${c.title} ${c.body}`).not.toMatch(
+            /\b(we|We|us|our|Our)\b|!/,
+          );
+        }
+    }
+  });
+});
