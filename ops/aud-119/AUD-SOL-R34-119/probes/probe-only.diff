+    expect(h.row()).toMatchObject({ status: 'unpaid', entitlement_active: false });
+    // Redelivery or settlement-without-regrant is acceptable; stale activation is not.
+    try { await h.handler.handle(payment, h.db, pre); } catch (err) {
