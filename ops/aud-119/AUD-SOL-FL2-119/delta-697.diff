+  it('the send signal aborts on its timer and on any read past its limit, with the given reason', () => {
+    jest.useFakeTimers({ now: 1_000_000 });
+    try {
+      const reason = new Error('window');
+      const timed = noticeSendSignal(1_000_500, () => reason);
