From 88659e21806ace4fc0c883d624de1abc07413b6d Mon Sep 17 00:00:00 2001
From: Bradley Gleave <bradley@bradleytgpcoaching.com>
Date: Sun, 4 Oct 2026 22:00:41 +0000
Subject: [PATCH 2/4] fix(plans): a cancel receipt stands only while a newer
 read has the same access end and trial or paid kind (B-344-3)

---
 src/components/purchase/YourPlansPanel.tsx | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/components/purchase/YourPlansPanel.tsx b/src/components/purchase/YourPlansPanel.tsx
index 101bd10..da06ddc 100644
--- a/src/components/purchase/YourPlansPanel.tsx
+++ b/src/components/purchase/YourPlansPanel.tsx
@@ -117,11 +117,17 @@ const endsInTrial = (p: ClientPlan, o: CancelOutcome) =>
   !!p.trialEndsAt &&
   Date.parse(o.accessEndsAt) <= Date.parse(p.trialEndsAt);
 
-/** B-344-3: a receipt stands only while a newer read agrees with it. */
+const sameInstant = (a: string | null, b: string | null) =>
+  a === b || (!!a && !!b && Date.parse(a) === Date.parse(b));
+/** B-344-3: a receipt stands only while a newer read agrees with it: the
+ * same access end and the same trial or paid kind. */
 const agrees = (r: Receipt, p: ClientPlan | undefined) =>
   !!p &&
   (r.result.outcome === "scheduled"
-    ? p.cancelAtPeriodEnd && p.state !== "ended"
+    ? p.cancelAtPeriodEnd &&
+      p.state !== "ended" &&
+      sameInstant(p.accessEndsAt, r.result.accessEndsAt) &&
+      endsInTrial(p, r.result) === r.trial
     : p.state === "ended");
 
 export default function YourPlansPanel({
-- 
