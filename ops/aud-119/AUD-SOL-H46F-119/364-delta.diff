+    const set = AsyncStorage.setItem.bind(AsyncStorage);
+    jest.spyOn(AsyncStorage, 'setItem').mockImplementationOnce(async (key, value) => {
+      invoked.resolve();
+      await commit.promise;
+      await set(key, value);
