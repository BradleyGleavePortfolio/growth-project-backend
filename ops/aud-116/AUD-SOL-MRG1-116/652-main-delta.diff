+    });
+    expect(validateWelcomeTemplate('Hi {firstname}')).toMatchObject({
+      ok: false,
+      code: 'unknown_placeholder',
+    });
+    expect(validateWelcomeTemplate('Hi {first_name')).toMatchObject({
+      ok: false,
+      code: 'unbalanced_braces',
