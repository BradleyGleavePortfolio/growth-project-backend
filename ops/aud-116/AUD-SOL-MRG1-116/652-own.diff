+  let db: InMemoryPrisma;
+  let faults: Faults;
+  let storage: {
+    bucket: () => string;
+    removeObjects: jest.Mock;
+    objectGone: jest.Mock;
+    removeOwnerFolder: jest.Mock;
+    ownerFolderEmpty: jest.Mock;
