+<!doctype html>
+<html lang="en">
+  <body style="font-family: -apple-system, system-ui, sans-serif; max-width: 560px; margin: 0 auto; padding: 32px 24px; color: #1a1a1a;">
+    <h1 style="font-size: 22px; margin: 0 0 16px;">{{title}}</h1>
+    <p>Hi{{#if recipient_name}} {{recipient_name}}{{/if}},</p>
+    <p>{{summary}}</p>
+    <table style="width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 15px;">
+      <tr><td style="padding: 6px 0;">The sale</td><td style="padding: 6px 0; text-align: right;">{{charge_display}}</td></tr>
+      <tr><td style="padding: 6px 0;">What the client got back</td><td style="padding: 6px 0; text-align: right;">{{customer_refunded_display}}</td></tr>
+      <tr><td style="padding: 6px 0;">Taken back from that sale's payout</td><td style="padding: 6px 0; text-align: right;">{{reversed_display}}</td></tr>
+      {{#if reinstated_display}}<tr><td style="padding: 6px 0;">Paid back to you after the dispute</td><td style="padding: 6px 0; text-align: right;">{{reinstated_display}}</td></tr>{{/if}}
+    </table>
+    {{#if has_hold}}
+    <p>Held for this sale in total: {{held_display}}. It is made up of:</p>
+    <table style="width: 100%; border-collapse: collapse; margin: 8px 0 16px; font-size: 15px;">
