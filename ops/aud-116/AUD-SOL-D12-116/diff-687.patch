+/// S-DUNNING-R3 (B-628-9) — per-purchase billing-action lease with a
+/// monotonic fence. A client card update that pays open invoices and a
+/// client cancel that voids them claim it by CAS (free when holder is null
+/// or holder_until has passed; every claim increments fence). The holder
+/// re-checks it (CAS on holder) before every Stripe money call and inside
+/// every money-write transaction, so a stalled holder whose lease expired
+/// can never write after a newer holder took over. One row per purchase,
+/// created on first use, so it works when no DunningState exists.
+model ClientBillingLease {
+  purchase_id  String         @id
+  purchase     ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
+  holder       String?
+  holder_until DateTime?
+  fence        Int            @default(0)
+  created_at   DateTime       @default(now())
+  updated_at   DateTime       @updatedAt
+}
+
+/// S-DUNNING-R3 (B-628-2/5) — durable journal of one client billing
+/// operation on one purchase. kind 'card_pay' (owner 1A: pay the approved
+/// open invoices with the card just saved; one row per purchase and
+/// SetupIntent) or 'cancel' (owner 2A: written BEFORE the first void).
+/// phase records how far it got; completed_at null + stale updated_at is
+/// resumed by the hourly reconciler. lines holds per-invoice integer-cent
+/// results ([{invoice_id, currency, amount_due_cents, amount_paid_cents,
+/// result}]); never summed across currencies.
+model ClientBillingOperation {
+  id              String         @id @default(uuid())
+  purchase_id     String
+  purchase        ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
+  kind            String
+  phase           String
+  fence           Int
+  setup_intent_id String?
+  lines           Json?
+  error_code      String?
+  created_at      DateTime       @default(now())
+  updated_at      DateTime       @updatedAt
+  completed_at    DateTime?
+
+  @@index([purchase_id, kind, completed_at])
+  @@index([kind, completed_at, updated_at])
+  @@index([setup_intent_id])
+}
+
+/// S-DUNNING-R3 (B-628-6) — durable per-channel delivery record for one
+/// dunning v2 notice step of one cycle. id is deterministic
+/// "<dunning_state_id>:<cycle_key>:<step_index>:<channel>" so a step is
+/// recorded once per cycle; cycle_key is the cycle's entered_at instant, so
+/// a later renewal cycle on the same DunningState never reuses a key.
+/// status pending | sent | failed | skipped | dead. A pending or failed row
+/// whose next_attempt_at has passed is retried by the hourly sweep.
+model DunningNoticeDelivery {
+  id               String       @id
+  dunning_state_id String
+  dunning_state    DunningState @relation(fields: [dunning_state_id], references: [id], onDelete: Cascade)
+  cycle_key        String
+  step_index       Int
+  channel          String
+  status           String       @default("pending")
+  attempts         Int          @default(0)
+  last_error       String?
+  next_attempt_at  DateTime?
+  sent_at          DateTime?
+  /// S-DUNNING-R4 (B-628-6): the worker that claimed this delivery
+  /// ('sending'; next_attempt_at is then the claim's expiry). Only that
+  /// holder may write the receipt.
+  claim_token      String?
+  /// Transport idempotency attempt of the current claim; a takeover of an
+  /// expired claim reuses it so an email that did go out is not sent again.
+  key_attempt      Int?
+  created_at       DateTime     @default(now())
+  updated_at       DateTime     @updatedAt
+
+  @@index([status, next_attempt_at])
+  @@index([dunning_state_id, cycle_key])
+}
+
+/// S-DUNNING-R5 (B-628-8) — one Stripe dispute obligation on one purchase,
+/// as the dunning v2 path saw it. Written under the purchase's DunningState
+/// row lock by BOTH charge.dispute.created (status 'open') and
+/// charge.dispute.closed (the closing status), so a won dispute can never
+/// lift a purchase-wide reversal lock while another dispute on that purchase
+/// is open or lost, whichever webhook lands first. ChargeDispute (refund /
+/// dispute ledger) is read alongside it; a terminal status on either wins.
+model DunningDisputeObligation {
+  stripe_dispute_id String         @id
+  purchase_id       String
+  purchase          ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
+  stripe_charge_id  String?
+  /// open | won | warning_closed | lost | <other Stripe dispute status>
+  status            String
+  closed_at         DateTime?
+  created_at        DateTime       @default(now())
+  updated_at        DateTime       @updatedAt
+
+  @@index([purchase_id])
+}
