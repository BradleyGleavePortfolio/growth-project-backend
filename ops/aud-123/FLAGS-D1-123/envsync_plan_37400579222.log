2026-10-06T01:43:50.9377588Z # BEGIN fly_error_class (byte-identical in every step that calls flyctl; B-624-3)
2026-10-06T01:43:50.9378159Z # flyctl can echo a NAME=VALUE argument, a quoted value or a bare value
2026-10-06T01:43:50.9378666Z # in its errors, so no flyctl output is ever printed, filtered or
2026-10-06T01:43:50.9379161Z # uploaded: stdout goes to /dev/null (or, for `secrets list --json`,
2026-10-06T01:43:50.9379670Z # only through the jq name + status projection) and stderr goes to a
2026-10-06T01:43:50.9380207Z # 0600 file in the job directory that is only tested with `grep -q`
2026-10-06T01:43:50.9380716Z # against fixed patterns. fly_error_class prints one fixed word chosen
2026-10-06T01:43:50.9381230Z # by this script, never a byte of the file; an EXIT trap deletes the
2026-10-06T01:43:50.9381628Z # file on every path.
2026-10-06T01:43:50.9381896Z fly_error_class() {
2026-10-06T01:43:50.9382170Z   if [ ! -s "$1" ]; then echo no_output
2026-10-06T01:43:50.9383229Z   elif grep -qiE 'unauthori[sz]ed|not authori[sz]ed|authenticat|forbidden|access denied|invalid token|token (is )?(invalid|expired|not valid)' "$1"; then echo auth
2026-10-06T01:43:50.9384174Z   elif grep -qiE 'could not find app|app not found|no such app|app .* not found' "$1"; then echo app_not_found
2026-10-06T01:43:50.9384817Z   elif grep -qiE 'rate limit|too many requests' "$1"; then echo rate_limited
2026-10-06T01:43:50.9385516Z   elif grep -qiE 'health ?check|unhealthy|failed to update machine|machine .* failed' "$1"; then echo machine_health
2026-10-06T01:43:50.9386645Z   elif grep -qiE 'timeout|timed out|connection refused|connection reset|no such host|dial tcp|network is unreachable|tls handshake|unexpected eof|service unavailable|bad gateway' "$1"; then echo network
2026-10-06T01:43:50.9387533Z   else echo unclassified
2026-10-06T01:43:50.9387786Z   fi
2026-10-06T01:43:50.9387981Z }
2026-10-06T01:43:50.9388177Z fly_error_hint() {
2026-10-06T01:43:50.9388426Z   case "$1" in
2026-10-06T01:43:50.9389413Z     auth) echo "Fix: flyctl reported an authorization error; check that FLY_API_TOKEN is a valid token for ${APP} (create one with 'fly tokens create deploy -a ${APP}' and save it as the FLY_API_TOKEN secret available to the production environment), then re-run." ;;
2026-10-06T01:43:50.9390952Z     app_not_found) echo "Fix: flyctl could not find ${APP}; check that FLY_API_TOKEN is a valid token for ${APP} and belongs to the organization that owns it ('fly apps list'), then re-run." ;;
2026-10-06T01:43:50.9391949Z     rate_limited) echo "Fix: the Fly API is rate limiting this token; wait a few minutes, then re-run." ;;
2026-10-06T01:43:50.9393164Z     machine_health) echo "Fix: check machine health with 'fly status -a ${APP}' and 'fly logs -a ${APP}', fix the failing machine, then re-run." ;;
2026-10-06T01:43:50.9394228Z     network) echo "Fix: the Fly API could not be reached; check that FLY_API_TOKEN is a valid token for ${APP}, check https://status.flyio.net, then re-run." ;;
2026-10-06T01:43:50.9395677Z     *) echo "Fix: check that FLY_API_TOKEN is a valid token for ${APP} ('fly tokens create deploy -a ${APP}') and that the Fly API is reachable (https://status.flyio.net), then re-run; to read flyctl's full error, run 'fly secrets list -a ${APP}' from a trusted terminal." ;;
2026-10-06T01:43:50.9396714Z   esac
2026-10-06T01:43:50.9397123Z }
2026-10-06T01:43:50.9397342Z # END fly_error_class
