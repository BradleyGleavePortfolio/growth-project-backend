2026-10-06T01:43:50.9400489Z # bare name; jq projects name + status word only, so digests never
2026-10-06T01:43:50.9400979Z # reach a variable, the log or a file. Error codes are fixed strings.
2026-10-06T01:43:50.9401370Z fly_list_state() {
2026-10-06T01:43:50.9401646Z   local filter fly_rc jq_rc code cls
2026-10-06T01:43:50.9403011Z   filter='if type != "array" then error("ENVSYNC_NOT_ARRAY") else .[] | if type != "object" then error("ENVSYNC_ENTRY_NOT_OBJECT") else [(.name // .Name), ((.status // .Status // "Unknown") | tostring)] | if (.[0] | type) != "string" or .[0] == "" then error("ENVSYNC_ENTRY_NO_NAME") else @tsv end end end'
2026-10-06T01:43:50.9404088Z   (
2026-10-06T01:43:50.9404298Z     set +e
2026-10-06T01:43:50.9404747Z     flyctl secrets list -a "${APP}" --json 2> fly-list-stderr.txt | jq -r "${filter}" > "$1" 2> jq-stderr.txt
2026-10-06T01:43:50.9405343Z     echo "${PIPESTATUS[0]} ${PIPESTATUS[1]}" > list-status.txt
2026-10-06T01:43:50.9405704Z   )
2026-10-06T01:43:50.9405938Z   read -r fly_rc jq_rc < list-status.txt
2026-10-06T01:43:50.9406250Z   if [ "${fly_rc}" -ne 0 ]; then
2026-10-06T01:43:50.9406571Z     cls=$(fly_error_class fly-list-stderr.txt)
2026-10-06T01:43:50.9407371Z     echo "::error::flyctl secrets list --json failed (exit ${fly_rc}, error class ${cls}) for ${APP}, so $2. flyctl's own error text is withheld from this log. $(fly_error_hint "${cls}")"
2026-10-06T01:43:50.9408105Z     return 1
2026-10-06T01:43:50.9408322Z   fi
2026-10-06T01:43:50.9408534Z   if [ "${jq_rc}" -ne 0 ]; then
2026-10-06T01:43:50.9408915Z     code=$(grep -oE 'ENVSYNC_[A-Z_]+' jq-stderr.txt | head -n 1 || true)
2026-10-06T01:43:50.9410179Z     echo "::error::flyctl secrets list --json did not return a JSON array of objects with a string name field (${code:-ENVSYNC_INVALID_JSON}), so $2. Fix: the installed flyctl changed its JSON output; pin a flyctl version in the setup-flyctl step or update the jq filter in fly_list_state, then re-run."
2026-10-06T01:43:50.9411320Z     return 1
2026-10-06T01:43:50.9411538Z   fi
2026-10-06T01:43:50.9411727Z }
2026-10-06T01:43:50.9412070Z # In-machine value check. `prepare` builds the command (base64 only);
2026-10-06T01:43:50.9412891Z # the machine prints one marked line of match / differs / absent /
2026-10-06T01:43:50.9413372Z # present words. stdout goes to a 0600 scratch file that only
2026-10-06T01:43:50.9413865Z # parse-compare reads; stderr is only classified; both are deleted.
2026-10-06T01:43:50.9414279Z fly_machine_check() {
2026-10-06T01:43:50.9414533Z   local rc cls out
2026-10-06T01:43:50.9414777Z   out=machine.json
2026-10-06T01:43:50.9415015Z   set +e
2026-10-06T01:43:50.9415459Z   flyctl ssh console -a "${APP}" -C "$(cat compare.cmd)" < /dev/null > ssh-stdout.txt 2> fly-ssh-stderr.txt
2026-10-06T01:43:50.9415949Z   rc=$?
2026-10-06T01:43:50.9416157Z   set -e
2026-10-06T01:43:50.9416371Z   if [ "${rc}" -ne 0 ]; then
2026-10-06T01:43:50.9416679Z     cls=$(fly_error_class fly-ssh-stderr.txt)
2026-10-06T01:43:50.9417281Z     printf '{"unavailable":true,"errorClass":"%s"}\n' "${cls}" > "${out}"
2026-10-06T01:43:50.9418324Z     echo "::warning::flyctl ssh console failed (exit ${rc}, error class ${cls}), so the in-machine value check did not run and deployed values are unproven. flyctl's own output is withheld from this log. $(fly_error_hint "${cls}")"
2026-10-06T01:43:50.9419345Z   else
2026-10-06T01:43:50.9419636Z     "${FEM[@]}" parse-compare "${MANIFEST}" "${RULES}" . before
2026-10-06T01:43:50.9419985Z   fi
2026-10-06T01:43:50.9420231Z   rm -f ssh-stdout.txt fly-ssh-stderr.txt
2026-10-06T01:43:50.9420538Z }
2026-10-06T01:43:50.9420740Z # END fly_helpers
