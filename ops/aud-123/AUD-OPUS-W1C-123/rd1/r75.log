2026-10-06T01:49:42.1621313Z # workflow_dispatch carries no pull-request base. Rather than fabricate
2026-10-06T01:49:42.1621614Z # one (which would silently certify an unmeasured diff), this run is
2026-10-06T01:49:42.1621883Z # declared NON-CERTIFYING and does not assert R75 compliance.
2026-10-06T01:49:42.1622172Z if [ "$EVENT_NAME" != "pull_request" ]; then
2026-10-06T01:49:42.1622443Z   echo "NON-CERTIFYING RUN: event '$EVENT_NAME' provides no pull-request base."
2026-10-06T01:49:42.1622758Z   echo "R75 / R100.A2 was NOT measured. Only the pull_request run certifies R75."
2026-10-06T01:49:42.1622986Z   exit 0
2026-10-06T01:49:42.1623103Z fi
2026-10-06T01:49:42.1623288Z # In pull_request context a missing/malformed base is an infrastructure
2026-10-06T01:49:42.1623571Z # failure, never an empty diff that passes.
2026-10-06T01:49:42.1623751Z if [ -z "${BASE_SHA:-}" ]; then
2026-10-06T01:49:42.1623999Z   echo "FAIL — pull_request event carried no base SHA; refusing to certify R75." >&2
2026-10-06T01:49:42.1624426Z   exit 1
2026-10-06T01:49:42.1624566Z fi
2026-10-06T01:49:42.1624688Z if [ -z "${HEAD_SHA:-}" ]; then
2026-10-06T01:49:42.1624943Z   echo "FAIL — pull_request event carried no head SHA; refusing to certify R75." >&2
2026-10-06T01:49:42.1625172Z   exit 1
2026-10-06T01:49:42.1625285Z fi
