+        connected: true,
+        charges_enabled: true,
+        payouts_enabled: true,
+        details_submitted: true,
+        is_fully_onboarded: true,
+      });
+      expect(stripe.fetchImpl).toHaveBeenCalledTimes(1);
+      expect(String(stripe.fetchImpl.mock.calls[0][0])).toContain(
+        '/accounts/acct_abc',
