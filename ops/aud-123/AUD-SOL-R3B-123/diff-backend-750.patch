+          id: 'acct_abc',
+          country: 'US',
+          default_currency: 'usd',
+          charges_enabled: true,
+          payouts_enabled: true,
+          details_submitted: true,
+          requirements: { currently_due: [], disabled_reason: null },
+        }),
+      );
+      const out = await makeController(prisma, stripe).me(req);
