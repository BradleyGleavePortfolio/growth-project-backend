+      expect(prisma._accounts[0]).toMatchObject({
+        charges_enabled: true,
+        payouts_enabled: true,
+        details_submitted: true,
+      });
+    });
+
+    it('Stripe rejects the read -> me() returns the saved status unchanged', async () => {
+      const prisma = makePrismaStub();
