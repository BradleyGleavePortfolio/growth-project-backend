+
+class FakeNotifications {
+  rows: CreateNotificationInput[] = [];
+  pushes: RecordedPush[] = [];
+  /** The sender's answer; null = not queued (a retryable failure). */
+  pushResult: EnqueueResult | null = QUEUED;
