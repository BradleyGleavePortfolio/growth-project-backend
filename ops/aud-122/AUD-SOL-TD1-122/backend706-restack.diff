+        if (
+          !session ||
+          session.status !== 'scheduled' ||
+          session.start_at.getTime() !== at ||
+          at <= this.now().getTime()
+        ) {
+          return await this.finish(row, 'dropped', 'obsolete');
+        }
+      }
