2026-10-06T00:16:55.5213623Z # workflow_dispatch carries no pull-request base. Rather than fabricate
2026-10-06T00:16:55.5214047Z # one (which would silently certify an unmeasured diff), this run is
2026-10-06T00:16:55.5214416Z # declared NON-CERTIFYING and does not assert R75 compliance.
2026-10-06T00:16:55.5214728Z if [ "$EVENT_NAME" != "pull_request" ]; then
2026-10-06T00:16:55.5215076Z   echo "NON-CERTIFYING RUN: event '$EVENT_NAME' provides no pull-request base."
2026-10-06T00:16:55.5215501Z   echo "R75 / R100.A2 was NOT measured. Only the pull_request run certifies R75."
2026-10-06T00:16:55.5215813Z   exit 0
2026-10-06T00:16:55.5215979Z fi
2026-10-06T00:16:55.5216237Z # In pull_request context a missing/malformed base is an infrastructure
2026-10-06T00:16:55.5216614Z # failure, never an empty diff that passes.
2026-10-06T00:16:55.5216862Z if [ -z "${BASE_SHA:-}" ]; then
2026-10-06T00:16:55.5217207Z   echo "FAIL — pull_request event carried no base SHA; refusing to certify R75." >&2
2026-10-06T00:16:55.5217546Z   exit 1
2026-10-06T00:16:55.5217708Z fi
2026-10-06T00:16:55.5217892Z if [ -z "${HEAD_SHA:-}" ]; then
2026-10-06T00:16:55.5218218Z   echo "FAIL — pull_request event carried no head SHA; refusing to certify R75." >&2
2026-10-06T00:16:55.5218805Z   exit 1
2026-10-06T00:16:55.5218957Z fi
