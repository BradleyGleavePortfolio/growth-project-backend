+        steps('APPLE_HEALTH', 9999, '2026-09-30T18:00:00Z', '2026-09-30T01:00:00Z'),
+        night('OURA', 420, '2026-09-30T14:00:00Z'),
+      ] as unknown as Parameters<typeof summarizeWearables>[1],
+      TODAY,
