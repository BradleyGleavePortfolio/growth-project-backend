@@ -3706,0 +3712,2 @@ model CoachPackage {
+  // A1-COACHLESS — featured-coach configs that sell this package.
+  featured_coach_configs FeaturedCoachConfig[] @relation("FeaturedCoachConfigPackage")
@@ -7986,0 +7994,67 @@ model AiProcessingConsentEvent {
+// ─── A1-COACHLESS: coachless Home, scripted Roman pitch, coach code ─────────
+//
+// FeaturedCoachConfig is a singleton (id = 'default', CHECK-enforced) holding
+// the platform's featured-coach offer shown to coachless clients: the code,
+// the banner/offer/Roman copy and the Roman card frequency caps. Edited only
+// by the platform owner through PUT /admin/featured-coach (audited). The
+// "accepting clients" state served to clients is this row's switch AND the
+// featured coach being able to accept clients (code resolves, coach role,
+// CoachSubscription active/trialing/grandfathered).
+model FeaturedCoachConfig {
+  id                      String        @id @default("default")
+  coach_user_id           String?
+  coach                   User?         @relation("FeaturedCoachConfigCoach", fields: [coach_user_id], references: [id], onDelete: SetNull)
+  code                    String?
+  package_id              String?
+  package                 CoachPackage? @relation("FeaturedCoachConfigPackage", fields: [package_id], references: [id], onDelete: SetNull)
+  banner_title            String
+  offer_text              String?
+  roman_pitch_text        String?
+  accepting_clients       Boolean       @default(false)
+  roman_enabled           Boolean       @default(false)
+  roman_min_hours_between Int           @default(24)
+  roman_max_per_week      Int           @default(3)
+  roman_snooze_days       Int           @default(14)
+  roman_max_not_now       Int           @default(2)
+  updated_by_user_id      String?
+  created_at              DateTime      @default(now())
+  updated_at              DateTime      @updatedAt
+}
+
+// Idempotency ledger + attempt record for POST /coachless/coach-code/redeem.
+// One row per (user, Idempotency-Key). 'completed' rows replay their stored
+// response; 'failed' rows may be reclaimed by a retry of the same key;
+// 'in_progress' rows older than the stale window may be reclaimed after a
+// crash. Rows cascade with the user (account erasure).
+model CoachCodeRedemption {
+  id              String   @id @default(uuid())
+  user_id         String
+  user            User     @relation("CoachCodeRedemptionUser", fields: [user_id], references: [id], onDelete: Cascade)
+  idempotency_key String
+  request_hash    String
+  status          String   @default("in_progress")
+  outcome         String?
+  coach_id        String?
+  http_status     Int?
+  response        Json?
+  created_at      DateTime @default(now())
+  updated_at      DateTime @updatedAt
+
+  @@unique([user_id, idempotency_key])
+  @@index([user_id, created_at])
+}
+
+// Per-user state of the scripted coachless Roman card: impression counts for
+// the frequency cap and the persisted "Not now". Cascades with the user.
+model CoachlessPromptState {
+  user_id                 String    @id
+  user                    User      @relation("CoachlessPromptStateUser", fields: [user_id], references: [id], onDelete: Cascade)
+  roman_seen_count        Int       @default(0)
+  roman_window_started_at DateTime?
+  roman_last_seen_at      DateTime?
+  roman_not_now_count     Int       @default(0)
+  roman_not_now_at        DateTime?
+  created_at              DateTime  @default(now())
+  updated_at              DateTime  @updatedAt
+}
+
