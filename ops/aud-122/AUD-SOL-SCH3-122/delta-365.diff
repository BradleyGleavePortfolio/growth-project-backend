+          endDate: '2026-09-29T06:10:00.000-0700',
+        },
+      ],
+      // B-317-4: the client asks HealthKit for kilograms; the wire value is kg.
+      weight: [
+        {
+          value: 81.6,
+          startDate: '2026-09-29T06:40:00.000-0700',
+          endDate: '2026-09-29T06:40:00.000-0700',
+        },
+      ],
+      sleep: [
+        {
+          value: 'INBED',
