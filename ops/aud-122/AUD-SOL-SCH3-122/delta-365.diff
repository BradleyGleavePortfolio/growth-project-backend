+
+function response(bucket: string, s: ReturnType<typeof series>[]) {
+  return {
+    bucket,
+    window: {
+      from: '2026-09-01T00:00:00.000Z',
+      to: '2026-10-01T00:00:00.000Z',
+    },
+    series: s,
+    freshness: [],
+  };
