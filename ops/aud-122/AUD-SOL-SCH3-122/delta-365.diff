+    const metrics = new Set(all.map((s) => s.metric));
+    for (const m of [
+      'STEPS',
+      'ACTIVE_ENERGY_KCAL',
+      'RESTING_HEART_RATE_BPM',
+      'HRV_MS',
+      'SLEEP_DEEP_MIN',
+      'SLEEP_REM_MIN',
+      'SLEEP_LIGHT_MIN',
+      'SLEEP_AWAKE_MIN',
