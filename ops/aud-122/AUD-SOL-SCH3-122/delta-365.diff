+    getString: () => undefined,
+    getStringAsync: async () => undefined,
+    getAllKeys: async () => [],
+    delete: async () => undefined,
+    set: async () => undefined,
+  });
+  return {
+    clearAllStorage: jest.fn(async () => undefined),
+    prefsStorage: storage(),
+    cacheStorage: storage(),
+    secureStorage: storage(),
+  };
+});
