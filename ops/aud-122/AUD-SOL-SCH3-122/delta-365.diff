+  connectionId: string;
+  provider: string;
+  metric: string;
+  bucket: string;
+  value: number;
+  unit: string;
+  startAt: Date | string;
+  endAt: Date | string;
+  sourceTz?: string | null;
+  sourceRecordId?: string | null;
+  rawRef?: string | null;
