-  WORKOUT_DURATION_MIN: 'HEALTH_FITNESS',
-  WORKOUT_DISTANCE_M: 'HEALTH_FITNESS',
-  TRAINING_LOAD: 'HEALTH_FITNESS',
-  BODY_WEIGHT_KG: 'HEALTH_FITNESS',
-  BODY_FAT_PCT: 'HEALTH_FITNESS',
