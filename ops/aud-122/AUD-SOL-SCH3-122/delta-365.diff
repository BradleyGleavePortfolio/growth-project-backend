+}
+
+/** Health Connect read pass, shaped like `react-native-health-connect` records. */
+function healthConnectSamples() {
+  return normalizeAll(
+    { connectionId: HC_CONNECTION },
+    {
+      Steps: [
+        {
+          startTime: '2026-09-29T14:00:00.000Z',
