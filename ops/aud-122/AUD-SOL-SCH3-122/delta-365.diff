+    expect(screen.getByText(NAME)).toBeTruthy();
+    expect(screen.getByText(NOTE)).toBeTruthy();
+    expect(screen.getByText(MEASURE)).toBeTruthy();
+    expectNothingCaptured(r.container, 20);
+  });
