+
+describe('S14 ingest contract fixture', () => {
+  const built = serialize(buildFixture());
+
+  if (process.env.UPDATE_INGEST_CONTRACT === '1') {
+    fs.mkdirSync(path.dirname(FIXTURE_PATH), { recursive: true });
