-  if (!Array.isArray(stages)) return null;
-  let total = 0;
-  let matched = false;
-  for (const stage of stages) {
-    if (!stage || typeof stage !== 'object') continue;
-    const s = stage as { stage?: string; startTime?: string; endTime?: string };
