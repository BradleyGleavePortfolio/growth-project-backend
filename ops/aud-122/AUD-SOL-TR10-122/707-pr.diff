+    ['200 but still draft', { body: { id: 'in_draft', status: 'draft' } }],
+    ['200 for another invoice', { body: { id: 'in_other', status: 'open' } }],
+  ])('finalize not confirmed (%s): no void of it, no DELETE, retried', async (_n, res) => {
