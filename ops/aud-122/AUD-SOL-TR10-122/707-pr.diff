+      status: 'owed',
+      last_error: 'draft_not_fenced',
+      lease_token: null,
+    });
+  });
+
+  it('a payment wins the finalized draft before its void: no DELETE; the next read supersedes', async () => {
+    let paid = false;
+    const w = await world({
+      ...base(),
+      paid: async () => page(paid ? [TRIAL_INVOICE, DRAFT_PAID] : [TRIAL_INVOICE]),
+      void: (id) => async () => {
