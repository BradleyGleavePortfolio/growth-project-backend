+describe('B-707-1 — ownership across every added await', () => {
+  const cases: Array<[string, (w: World) => Promise<void> | void, string]> = [
+    [
+      'a supersession',
+      (w) => w.service.supersede(w.db, 'pur-1', NOW).then(() => undefined),
+      'superseded',
+    ],
+    [
+      'a subscription-deleted webhook',
+      (w) => w.service.markCancelled(w.db, 'pur-1', NOW),
+      'cancelled',
+    ],
+    [
+      'another worker taking the lease',
+      (w) => {
+        w.row().lease_token = 'other-worker';
+        w.row().lease_until = new Date(NOW.getTime() + 120_000);
+      },
+      'owed',
+    ],
+  ];
+  const at = (when: string, change: (w: World) => Promise<void> | void) => {
+    let w!: World;
+    const hit =
+      <T>(x: T) =>
+      async () => {
+        await change(w);
+        return x;
+      };
+    const r = base();
+    if (when === 'draft read') r.draft = hit(page([{ id: 'in_draft' }]));
+    const make = world({
+      ...r,
+      finalize: when === 'finalize' ? (id) => hit(opened(id)) : undefined,
+      void:
+        when === 'draft void'
+          ? (id) => (id === 'in_draft' ? hit(voided(id)) : voided(id))
+          : undefined,
+      recheck: { ...r.recheck, ...(when === 'recheck' ? { uncollectible: hit(page([])) } : {}) },
+    });
+    return make.then((x) => (w = x));
+  };
+
+  for (const when of ['draft read', 'finalize', 'draft void', 'recheck']) {
+    it.each(cases)(`%s during the ${when}: stale, no DELETE`, async (_n, change, after) => {
+      const w = await at(when, change);
+      expect(await w.service.settle('pur-1', NOW)).toBe('stale');
+      expect(w.deletes()).toBe(0);
+      if (when === 'draft read') expect(w.posts()).toEqual([]);
+      if (when === 'finalize') expect(w.posts()).toEqual(['POST /invoices/in_draft/finalize']);
+      expect(w.row().status).toBe(after);
+      if (after === 'owed') expect(w.row().lease_token).toBe('other-worker');
+    });
+  }
+});
