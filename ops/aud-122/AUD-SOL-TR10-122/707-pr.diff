+type Lists = { draft?: Reply; open?: Reply; uncollectible?: Reply; paid?: Reply };
+
+/** First reads answer `r`; reads after the first void answer `r.recheck` (default: the same). */
+async function world(
+  r: Lists & {
+    sub: Reply;
+    recheck?: Lists;
+    finalize?: (id: string) => Reply;
+    void?: (id: string) => Reply;
+  },
+) {
+  const table = makeTrialConflictTable();
+  await table.createMany({
+    data: [
+      {
+        id: 'conflict-1',
+        purchase_id: 'pur-1',
+        stripe_subscription_id: 'sub_1',
+        next_attempt_at: NOW,
+      },
+    ],
+  });
+  const calls: string[] = [];
+  const bodies: string[] = [];
+  let fenced = false;
+  const reply = async (x: Reply) => {
+    const { status = 200, body } = typeof x === 'function' ? await x() : x;
+    return new Response(JSON.stringify(body), {
+      status,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  };
+  jest.spyOn(globalThis, 'fetch').mockImplementation(async (url, init) => {
+    const method = init?.method ?? 'GET';
+    const path = String(url).replace(/^https:\/\/api\.stripe\.com\/v1/, '');
+    calls.push(`${method} ${path}`);
+    if (method === 'DELETE') return reply({ body: { id: 'sub_1', status: 'canceled' } });
+    const act = /^\/invoices\/([^/?]+)\/(void|finalize)$/.exec(path);
+    if (method === 'POST' && act) {
+      bodies.push(`${act[2]} ${String(init?.body ?? '')}`);
+      const id = decodeURIComponent(act[1]);
+      if (act[2] === 'finalize') return reply((r.finalize ?? opened)(id));
+      fenced = true;
+      return reply((r.void ?? voided)(id));
+    }
+    if (path.startsWith('/invoices?')) {
+      const status = new URLSearchParams(path.split('?')[1]).get('status') as keyof Lists;
+      const lists: Lists = fenced ? { ...r, ...r.recheck } : r;
+      return reply(lists[status] ?? apiError);
+    }
+    return reply(r.sub);
+  });
+  const db = stub<C[0]>({ packageTrialConflict: table });
+  const service = new TrialConflictService(db, new StripeConnectApiService());
+  return {
+    table,
+    calls,
+    bodies,
+    db,
+    service,
+    deletes: () => calls.filter((c) => c.startsWith('DELETE')).length,
+    posts: () => calls.filter((c) => c.startsWith('POST /invoices/')),
+    row: () => table.rows[0],
+  };
+}
+type World = Awaited<ReturnType<typeof world>>;
+
+type Spec = Parameters<typeof world>[0];
+const base = (status = 'past_due'): Spec & { recheck: Lists } => ({
+  sub: sub(status),
+  draft: page([{ id: 'in_draft' }]),
+  open: page([{ id: 'in_open' }]),
+  uncollectible: page([]),
+  paid: page([TRIAL_INVOICE]),
+  recheck: { draft: page([]), open: page([]) },
+});
+
+describe("B-707-1 — the lenses' race: a renewal draft finalizes and pays inside the window", () => {
+  it.each(['past_due', 'unpaid'])(
+    '%s, draft absent from the first draft page, paid during the open void (Opus D1): the paid recheck supersedes, billed alert, no DELETE',
+    async (status) => {
+      let paidCents = 0;
+      const w = await world({
+        ...base(status),
+        draft: page([]),
+        recheck: { draft: page([]), open: page([]), paid: page([TRIAL_INVOICE, DRAFT_PAID]) },
+        void: (id) => async () => {
+          paidCents += 4900;
+          return voided(id);
+        },
+      });
+      expect(await w.service.settle('pur-1', NOW)).toBe('superseded');
+      expect(paidCents).toBe(4900);
+      expect(w.deletes()).toBe(0);
+      expect(w.row()).toMatchObject({ status: 'superseded', last_error: 'billing_started' });
+      expect(await w.service.alertSuperseded()).toBe(1);
+      expect(jest.mocked(Sentry.captureMessage)).toHaveBeenCalledWith(
+        'trial conflict billed before cancel',
+        expect.objectContaining({
+          tags: { code: 'TRIAL_CONFLICT_SUPERSEDED', purchase_id: 'pur-1' },
+        }),
+      );
+    },
+  );
+
+  it.each(['past_due', 'unpaid'])(
+    '%s, listed draft finalized and paid after the paid read (Sol): its finalize is refused, no void, no DELETE; the next read supersedes',
+    async (status) => {
+      let paid = false;
+      const w = await world({
+        ...base(status),
+        paid: async () => {
+          const res = page(paid ? [TRIAL_INVOICE, DRAFT_PAID] : [TRIAL_INVOICE]);
+          paid = true;
+          return res;
+        },
+        finalize: () => notDraft,
+      });
+      expect(await w.service.settle('pur-1', NOW)).toBe('retry');
+      expect(w.posts()).toEqual(['POST /invoices/in_draft/finalize']);
+      expect(w.deletes()).toBe(0);
+      expect(w.row()).toMatchObject({
+        status: 'owed',
+        last_error: 'draft_not_fenced',
+        lease_token: null,
+      });
+      w.row().next_attempt_at = NOW;
+      expect(await w.service.settle('pur-1', new Date(NOW.getTime() + 600_000))).toBe('superseded');
+      expect(w.deletes()).toBe(0);
+    },
+  );
+});
+
+describe('B-707-1 — the draft fence', () => {
+  it.each(['past_due', 'unpaid'])(
+    '%s never billed: draft read first, finalized without collection and voided before the open void, full recheck, one DELETE',
+    async (status) => {
+      const w = await world(base(status));
+      expect(await w.service.settle('pur-1', NOW)).toBe('cancelled');
+      expect(w.calls).toEqual([
+        'GET /subscriptions/sub_1',
+        LIST('draft'),
+        LIST('open'),
+        LIST('uncollectible'),
+        LIST('paid'),
+        'POST /invoices/in_draft/finalize',
+        'POST /invoices/in_draft/void',
+        'POST /invoices/in_open/void',
+        ...RECHECK,
+        'DELETE /subscriptions/sub_1',
+      ]);
+      expect(w.bodies[0]).toBe('finalize auto_advance=false');
+      expect(w.row()).toMatchObject({ status: 'cancelled', last_error: null, lease_token: null });
+    },
+  );
+
+  it.each<[string, Reply]>([
+    ['500', apiError],
+    ['404', { status: 404, body: { error: { type: 'invalid_request_error' } } }],
+    ['has_more', page([{ id: 'in_draft' }], true)],
+    ['has_more missing', { body: { data: [{ id: 'in_draft' }] } }],
+    ['data not a list', { body: { data: null, has_more: false } }],
+    ['null entry', page([null])],
+    ['numeric id', page([{ id: 7 }])],
+    ['empty id', page([{ id: '' }])],
+  ])('draft page unknown (%s): no finalize, no void, no DELETE, stays owed', async (_n, draft) => {
+    const w = await world({ ...base(), draft });
+    expect(await w.service.settle('pur-1', NOW)).toBe('retry');
+    expect(w.posts()).toEqual([]);
+    expect(w.deletes()).toBe(0);
+    expect(w.row()).toMatchObject({
+      status: 'owed',
+      last_error: 'invoices_unknown',
