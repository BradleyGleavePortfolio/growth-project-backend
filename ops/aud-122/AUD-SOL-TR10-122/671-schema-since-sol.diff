+// S-FEE round 4 (B-627-5) — one durable, keyed Stripe transfer reversal. It is
+// written before Stripe is called and resolved from Stripe's answer (or, when
+// the answer was lost, from the transfer's reversal list matched by
+// metadata.tgp_reversal_op = idempotency_key), so an uncertain outcome is
+// re-driven with the same key and never becomes a second recovery.
+model TransferReversalOp {
+  id                  String          @id @default(uuid())
+  transfer_id         String
+  transfer            ConnectTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
+  seq                 Int
+  idempotency_key     String          @unique
+  amount_cents        Int
+  // The transfer's reversed_amount_cents when the operation started.
+  base_reversed_cents Int
+  // adjust (refund / dispute convergence of THIS charge's transfer) | legacy.
+  // Owner decision OR-111-1: a transfer is only ever reversed for its own
+  // charge; another charge's debt is recovered by forward netting only.
+  purpose             String          @default("adjust")
+  // pending | succeeded | refused
+  status              String          @default("pending")
+  stripe_reversal_id  String?         @unique
+  attempts            Int             @default(0)
+  last_attempt_at     DateTime?
+  last_error          String?
+  resolved_at         DateTime?
+  created_at          DateTime        @default(now())
+  updated_at          DateTime        @updatedAt
+
+  @@unique([transfer_id, seq])
+  @@index([status, created_at])
+}
+
+// S-FEE — Charge settlement (one row per Stripe charge on a coach package).
+//
+// Mechanism: separate charges and transfers. The charge is created on the
+// platform with on_behalf_of = the coach's connected account (coach is the
+// settlement merchant) and NO transfer_data / application fee. After the
+// charge succeeds we read its balance_transaction (actual Stripe fee, in the
+// settlement currency) and compute the split once, in PlatformFeeService:
+//   coach_net = gross - stripe_fee - platform_fee - head_coach_split
+// then transfer coach_net and head_coach_split with source_transaction = the
+// charge. TGP keeps platform_fee and never pays the processing fee.
+//
+// Refunds / disputes re-derive targets (refunded_cents, dispute_*_cents) and
+// reverse transfers; anything a transfer reversal cannot recover becomes a
+// PayeeRecovery that is netted out of the payee's next transfers.
+//
+// status:
+//   awaiting_fee       : charge known, balance transaction not yet available
+//   settled            : split computed, transfers enqueued/posted
+//   legacy_destination : a pre-S-FEE destination charge (Stripe already moved
+//                        the funds via transfer_data); recorded, never transferred
+//   skipped_free       : $0 charge or grant; nothing to settle
+// S-FEE — single-runner lease for scheduled jobs (one row per job). A
+// machine runs the job only while it holds an unexpired lease; see
+// src/checkout/cron-lease.service.ts.
+model CronLease {
+  name        String   @id
+  holder      String
+  lease_until DateTime
+  acquired_at DateTime
+  updated_at  DateTime @updatedAt
+  // Resume position of a paged job (the S-FEE paid-invoice backfill keeps the
+  // last Stripe invoice id it examined). Null for plain leases.
+  cursor      String?
+}
+
+model ChargeSettlement {
+  id                            String         @id @default(uuid())
+  purchase_id                   String
+  purchase                      ClientPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
+  coach_user_id                 String
+  head_coach_user_id            String?
+  stripe_charge_id              String         @unique
+  stripe_balance_transaction_id String?
+  stripe_invoice_id             String?
+  // Settlement currency (balance_transaction.currency). All *_cents below are
+  // in this currency.
+  currency                      String         @default("usd")
+  // card | bank_debit (payment_method_details.type).
+  rail                          String         @default("card")
+  mechanism                     String         @default("separate_charge_transfer")
+  status                        String         @default("awaiting_fee")
+  // Snapshot of the policy used (bps), so a later policy edit never rewrites history.
+  platform_bps                  Int
+  head_coach_bps                Int            @default(0)
+  gross_cents                   Int
+  stripe_fee_cents              Int?
+  platform_fee_cents            Int?
+  head_coach_split_cents        Int?
+  coach_net_cents               Int?
+  // Adjustments (cumulative, mirrored from Stripe).
+  refunded_cents                Int            @default(0)
+  dispute_withdrawn_cents       Int            @default(0)
+  dispute_fee_cents             Int            @default(0)
+  // Current targets after adjustments (equal to the originals until a refund/dispute).
+  target_platform_fee_cents     Int?
+  target_head_coach_cents       Int?
+  target_coach_net_cents        Int?
+  settled_at                    DateTime?
+  adjusted_at                   DateTime?
+  last_error                    String?
+  // S-FEE round 4 (B-627-4) — an adjustment that could not establish
+  // canonical state (dispute unreadable, reversal outcome unknown, lock lost)
+  // flags the settlement; the sweeper re-runs it until it converges.
+  reconcile_requested_at        DateTime?
+  reconcile_dispute_id          String?
+  reconcile_reason              String?
+  created_at                    DateTime       @default(now())
+  updated_at                    DateTime       @updatedAt
+
+  transfers  ConnectTransfer[]
+  recoveries PayeeRecovery[]
+  notices    PayoutAdjustmentNotice[]
+
+  @@index([purchase_id])
+  @@index([coach_user_id, created_at])
+  @@index([status])
+  @@index([reconcile_requested_at])
+}
+
+// S-FEE — Money a payee owes TGP for one charge that a transfer reversal could
+// not recover (the non-returned processing fee on a full refund, a dispute fee,
+// or a reversal Stripe refused because the payee's balance was already paid
+// out). Collected by netting it out of the payee's next transfers (Stripe:
+// "reconcile any amount owed back to it by reducing subsequent transfer amounts
+// or by reversing transfers").
+//   status: open | collected | released (released = a won dispute cancelled it)
+model PayeeRecovery {
+  id              String           @id @default(uuid())
+  settlement_id   String
+  settlement      ChargeSettlement @relation(fields: [settlement_id], references: [id], onDelete: Cascade)
+  payee_user_id   String
+  amount_cents    Int
+  collected_cents Int              @default(0)
+  currency        String           @default("usd")
+  reason          String
+  status          String           @default("open")
+  // Deterministic per (charge, leg, adjustment state): replays collapse.
+  idempotency_key String           @unique
+  collected_at    DateTime?
+  created_at      DateTime         @default(now())
+  updated_at      DateTime         @updatedAt
+
+  @@index([payee_user_id, status])
+  @@index([settlement_id])
+}
+
+// S-FEE round 5 (owner decision OR-111-1) — the payee-facing record of one
+// refund / chargeback / dispute outcome on one charge: what the customer got
+// back, what was taken back from that sale's own payout, and what TGP holds
+// from the payee's next sale(s) (TGP 2% + every Stripe fee on the charge +
+// any share Stripe refused to reverse). Written under the charge lock after
+// the money converged, one row per (charge, payee leg, event, adjustment
+// state); the Money page reads it as "needs attention" and the dispatcher
+// sends the push / in-app alert / email once per row.
+//   role:  coach | head_coach
+//   event: refund | chargeback | dispute_won | dispute_lost
+//   held_cents = held_tgp_fee_cents + held_stripe_fee_cents
+//              + held_dispute_fee_cents + held_not_reversed_cents
+model PayoutAdjustmentNotice {
+  id                      String           @id @default(uuid())
+  settlement_id           String
+  settlement              ChargeSettlement @relation(fields: [settlement_id], references: [id], onDelete: Cascade)
+  payee_user_id           String
+  role                    String
+  purchase_id             String
+  stripe_charge_id        String
+  event                   String
+  currency                String           @default("usd")
+  charge_gross_cents      Int
+  customer_refunded_cents Int
+  // Round 13 (B-683-1): for a charge presented in another currency than it
+  // settled in, what the client got back in their own currency (the cents
+  // above are the settlement debit). Null when the two currencies match.
+  client_currency         String?
+  client_refunded_cents   Int?
+  reversed_cents          Int
+  reinstated_cents        Int              @default(0)
+  held_cents              Int
+  held_tgp_fee_cents      Int
+  held_stripe_fee_cents   Int
+  held_dispute_fee_cents  Int
+  held_not_reversed_cents Int
+  // Part of held_cents not yet netted out of a later sale when the row was written.
+  held_open_cents         Int
+  state_key               String
+  // Deterministic per (charge, leg, event, adjustment state): replays collapse.
+  idempotency_key         String           @unique
+  title                   String
+  body                    String
+  // Round 6 (B-627-6): each channel's outcome is kept, and a retry only
+  // re-runs the channels that are not done.
+  //   inapp: pending | sent | off | failed
+  //   push:  pending | sent | off | no_token | invalid_token | rate_limited | failed
+  //   email: pending | sent | logged | no_address | disabled | failed
+  inapp_status            String           @default("pending")
+  inapp_notification_id   String?
+  push_notification_id    String?
+  push_status             String           @default("pending")
+  email_status            String           @default("pending")
+  // Email attempts made; attempt k > 1 uses the key `${idempotency_key}:e${k}`.
+  email_attempts          Int              @default(0)
+  dispatch_attempts       Int              @default(0)
+  dispatch_claimed_at     DateTime?
+  dispatched_at           DateTime?
+  acknowledged_at         DateTime?
+  created_at              DateTime         @default(now())
+  updated_at              DateTime         @updatedAt
+
+  @@index([payee_user_id, created_at])
+  @@index([settlement_id])
+  @@index([dispatched_at, created_at])
 }
 
