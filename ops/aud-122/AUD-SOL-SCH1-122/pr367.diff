+    !!params.welcome && !params.rescheduleSessionId && !selectedTypeId && !!welcomeInfo &&
+    (!!welcomeInfo.active_session_id || !!welcomeInfo.completed_at);
+  useEffect(() => {
+    if (welcomeDone) emitTutorialSignal('welcome_call_booked');
