+export const AutosaveConflictSchema = z.object({
+  error: z.enum(['autosave_conflict_retry', 'autosave_lock_stale']),
+  head_revision_index: z.number().int().min(0),
+  lock_token: z.string().regex(LOCK_TOKEN_RE),
