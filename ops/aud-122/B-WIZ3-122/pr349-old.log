2026-10-03T20:57:09.1079187Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-03T20:57:09.1080138Z     function useCoachNotificationUnreadCount(): number {
2026-10-03T20:57:09.1080900Z       const [count, setCount] = useState(0);
2026-10-03T20:57:09.1081523Z       useEffect(() => {
2026-10-03T20:57:09.1082066Z         let mounted = true;
2026-10-03T20:57:09.1082669Z         const refresh = async () => {
2026-10-03T20:57:09.1083276Z           try {
2026-10-03T20:57:09.1083851Z             const n = await fetchUnreadCount();
2026-10-03T20:57:09.1084527Z             if (mounted) setCount(n);
2026-10-03T20:57:09.1085120Z           } catch (err) {
2026-10-03T20:57:09.1085925Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-03T20:57:09.1087306Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-03T20:57:09.1088323Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-03T20:57:09.1089094Z           }
2026-10-03T20:57:09.1089566Z         };
2026-10-03T20:57:09.1090029Z         refresh();
2026-10-03T20:57:09.1090912Z         const interval = setInterval(refresh, 30000);
2026-10-03T20:57:09.1091815Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-03T20:57:09.1092631Z           if (state === 'active') refresh();
2026-10-03T20:57:09.1093228Z         });
2026-10-03T20:57:09.1093714Z         return () => {
2026-10-03T20:57:09.1094240Z           mounted = false;
2026-10-03T20:57:09.1094818Z           clearInterval(interval);
2026-10-03T20:57:09.1095398Z           sub.remove();
2026-10-03T20:57:09.1095892Z         };
2026-10-03T20:57:09.1096343Z       }, []);
2026-10-03T20:57:09.1096823Z       return count;
2026-10-03T20:57:09.1097535Z     }·
