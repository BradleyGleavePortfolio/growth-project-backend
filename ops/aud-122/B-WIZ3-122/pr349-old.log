2026-10-03T20:58:46.8541528Z               <TouchableOpacity
2026-10-03T20:58:46.8543275Z                 onPress={() => navigation.navigate('NotificationCenter')}
2026-10-03T20:58:46.8544014Z                 style={styles.bellButton}
2026-10-03T20:58:46.8544574Z                 accessibilityRole=\"button\"
2026-10-03T20:58:46.8545127Z                 accessibilityLabel={
2026-10-03T20:58:46.8545648Z                   notifUnread > 0
