2026-10-03T20:58:46.8514748Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-03T20:58:46.8515629Z     function useCoachNotificationUnreadCount(): number {
2026-10-03T20:58:46.8516396Z       const [count, setCount] = useState(0);
2026-10-03T20:58:46.8516846Z       useEffect(() => {
2026-10-03T20:58:46.8517557Z         let mounted = true;
2026-10-03T20:58:46.8518436Z         const refresh = async () => {
2026-10-03T20:58:46.8518854Z           try {
2026-10-03T20:58:46.8519608Z             const n = await fetchUnreadCount();
2026-10-03T20:58:46.8520447Z             if (mounted) setCount(n);
2026-10-03T20:58:46.8520869Z           } catch (err) {
2026-10-03T20:58:46.8522788Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-03T20:58:46.8524446Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-03T20:58:46.8525816Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-03T20:58:46.8526469Z           }
2026-10-03T20:58:46.8526821Z         };
2026-10-03T20:58:46.8527297Z         refresh();
2026-10-03T20:58:46.8527801Z         const interval = setInterval(refresh, 30000);
2026-10-03T20:58:46.8528879Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-03T20:58:46.8529641Z           if (state === 'active') refresh();
2026-10-03T20:58:46.8530076Z         });
2026-10-03T20:58:46.8530378Z         return () => {
2026-10-03T20:58:46.8530727Z           mounted = false;
2026-10-03T20:58:46.8531389Z           clearInterval(interval);
2026-10-03T20:58:46.8531828Z           sub.remove();
2026-10-03T20:58:46.8532168Z         };
2026-10-03T20:58:46.8532466Z       }, []);
2026-10-03T20:58:46.8532781Z       return count;
2026-10-03T20:58:46.8533174Z     }·
2026-10-03T20:58:46.8533716Z     function ClientsStackNavigator() {
