2026-10-03T20:58:46.8725872Z     function useCoachUnreadPolling(): number {
2026-10-03T20:58:46.8726477Z       const [total, setTotal] = useState(0);
2026-10-03T20:58:46.8726985Z       useEffect(() => {
2026-10-03T20:58:46.8727534Z         let mounted = true;
2026-10-03T20:58:46.8728220Z         const refresh = async () => {
2026-10-03T20:58:46.8728690Z           try {
2026-10-03T20:58:46.8729198Z             const res = await coachApi.getUnreadCounts();
2026-10-03T20:58:46.8729799Z             if (!mounted) return;
2026-10-03T20:58:46.8730362Z             setTotal(Number(res.data?.total ?? 0));
2026-10-03T20:58:46.8730894Z           } catch (err) {
2026-10-03T20:58:46.8731654Z             // Non-fatal: the unread total holds and the next 30s tick retries.
2026-10-03T20:58:46.8733295Z             // Never swallow silently (Law #36) — log so the failure is observable.
2026-10-03T20:58:46.8734808Z             logger.warn('coach.notifications.unread_polling_refresh', { err });
2026-10-03T20:58:46.8735463Z           }
2026-10-03T20:58:46.8735828Z         };
2026-10-03T20:58:46.8736186Z         refresh();
2026-10-03T20:58:46.8736658Z         const id = setInterval(refresh, 30000);
2026-10-03T20:58:46.8737471Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-03T20:58:46.8738115Z           if (state === 'active') refresh();
2026-10-03T20:58:46.8738600Z         });
2026-10-03T20:58:46.8738975Z         return () => {
2026-10-03T20:58:46.8739388Z           mounted = false;
2026-10-03T20:58:46.8739825Z           clearInterval(id);
2026-10-03T20:58:46.8740288Z           sub.remove();
2026-10-03T20:58:46.8740687Z         };
2026-10-03T20:58:46.8741041Z       }, []);
2026-10-03T20:58:46.8741424Z       return total;
2026-10-03T20:58:46.8741833Z     }·
2026-10-03T20:58:46.8742283Z     export default function CoachNavigator() {
2026-10-03T20:58:46.8742935Z       const unreadCount = useCoachUnreadPolling();
2026-10-03T20:58:46.8743820Z       // P0-1: TeamStack must only mount for head coaches. Sub-coaches who land
2026-10-03T20:58:46.8745290Z       // on team-management surfaces hit `/sub-coaches` 403s the screen treats as
2026-10-03T20:58:46.8746717Z       // a permanent retry-error — a feature they don't own. The hook fails
2026-10-03T20:58:46.8748274Z       // closed (returns 'unknown' until a positive head-coach signal), so the
2026-10-03T20:58:46.8749591Z       // tab disappears for sub-coaches and during the initial resolution
2026-10-03T20:58:46.8750185Z       // window.
2026-10-03T20:58:46.8752503Z       const coachRoleType = useCoachRoleType();
2026-10-03T20:58:46.8753559Z       const showTeamTab = coachRoleType === 'head_coach';
