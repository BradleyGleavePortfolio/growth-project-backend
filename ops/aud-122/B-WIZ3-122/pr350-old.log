2026-10-03T20:57:13.0454728Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-03T20:57:13.0455079Z     function useCoachNotificationUnreadCount(): number {
2026-10-03T20:57:13.0455341Z       const [count, setCount] = useState(0);
2026-10-03T20:57:13.0455524Z       useEffect(() => {
2026-10-03T20:57:13.0455678Z         let mounted = true;
2026-10-03T20:57:13.0456047Z         const refresh = async () => {
2026-10-03T20:57:13.0456201Z           try {
2026-10-03T20:57:13.0456457Z             const n = await fetchUnreadCount();
2026-10-03T20:57:13.0456677Z             if (mounted) setCount(n);
2026-10-03T20:57:13.0456831Z           } catch (err) {
2026-10-03T20:57:13.0457235Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-03T20:57:13.0457776Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-03T20:57:13.0458138Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-03T20:57:13.0458251Z           }
2026-10-03T20:57:13.0458374Z         };
2026-10-03T20:57:13.0458508Z         refresh();
2026-10-03T20:57:13.0458791Z         const interval = setInterval(refresh, 30000);
2026-10-03T20:57:13.0459140Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-03T20:57:13.0459330Z           if (state === 'active') refresh();
2026-10-03T20:57:13.0459445Z         });
2026-10-03T20:57:13.0459577Z         return () => {
2026-10-03T20:57:13.0459720Z           mounted = false;
2026-10-03T20:57:13.0459889Z           clearInterval(interval);
2026-10-03T20:57:13.0460030Z           sub.remove();
2026-10-03T20:57:13.0460147Z         };
2026-10-03T20:57:13.0460276Z       }, []);
2026-10-03T20:57:13.0460434Z       return count;
2026-10-03T20:57:13.0460623Z     }·
