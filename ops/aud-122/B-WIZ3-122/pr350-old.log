2026-10-03T20:57:39.5974228Z             // Only persist locally after backend confirms. This ensures
2026-10-03T20:57:39.5975107Z             // AsyncStorage never drifts ahead of the source of truth.
2026-10-03T20:57:39.5976534Z             await AsyncStorage.setItem(COACH_SETTINGS_KEY + '_' + userId, JSON.stringify(updated));
2026-10-03T20:57:39.5977415Z           } catch (err) {
2026-10-03T20:57:39.5978214Z             // Roll back to previous state — server rejected the change.
2026-10-03T20:57:39.5978968Z             setSettings(previous);
