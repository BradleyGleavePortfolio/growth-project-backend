2026-10-03T20:58:44.4400526Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-03T20:58:44.4401363Z     function useCoachNotificationUnreadCount(): number {
2026-10-03T20:58:44.4402119Z       const [count, setCount] = useState(0);
2026-10-03T20:58:44.4402626Z       useEffect(() => {
2026-10-03T20:58:44.4403024Z         let mounted = true;
2026-10-03T20:58:44.4403484Z         const refresh = async () => {
2026-10-03T20:58:44.4403941Z           try {
2026-10-03T20:58:44.4404381Z             const n = await fetchUnreadCount();
2026-10-03T20:58:44.4404925Z             if (mounted) setCount(n);
2026-10-03T20:58:44.4405439Z           } catch (err) {
2026-10-03T20:58:44.4406188Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-03T20:58:44.4407187Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-03T20:58:44.4408069Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-03T20:58:44.4408785Z           }
2026-10-03T20:58:44.4409102Z         };
2026-10-03T20:58:44.4409424Z         refresh();
2026-10-03T20:58:44.4409892Z         const interval = setInterval(refresh, 30000);
2026-10-03T20:58:44.4410623Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-03T20:58:44.4411285Z           if (state === 'active') refresh();
2026-10-03T20:58:44.4411749Z         });
2026-10-03T20:58:44.4412078Z         return () => {
2026-10-03T20:58:44.4412455Z           mounted = false;
2026-10-03T20:58:44.4412919Z           clearInterval(interval);
2026-10-03T20:58:44.4413358Z           sub.remove();
2026-10-03T20:58:44.4413721Z         };
2026-10-03T20:58:44.4414030Z       }, []);
2026-10-03T20:58:44.4414375Z       return count;
2026-10-03T20:58:44.4414745Z     }·
