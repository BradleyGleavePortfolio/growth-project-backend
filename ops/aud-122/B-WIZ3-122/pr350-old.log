2026-10-03T20:57:39.5960305Z       const updateSetting = async <K extends keyof CoachSettings>(key: K, value: CoachSettings[K]) => {
2026-10-03T20:57:39.5961346Z         const previous = settings;
2026-10-03T20:57:39.5962146Z         const updated = { ...settings, [key]: value };·
2026-10-03T20:57:39.5963021Z         // Optimistic update — instant UI response.
2026-10-03T20:57:39.5963716Z         setSettings(updated);
2026-10-03T20:57:39.5964452Z         if (updated.hapticsEnabled) mediumTap();·
2026-10-03T20:57:39.5965330Z         // Sync notification toggles to backend. On failure, roll back both
2026-10-03T20:57:39.5966513Z         // the in-memory state and the AsyncStorage cache so UI matches server.
2026-10-03T20:57:39.5967599Z         const notifFieldMap: Partial<Record<keyof CoachSettings, string>> = {
2026-10-03T20:57:39.5968493Z           dailyCheckin: 'daily_checkin_enabled',
2026-10-03T20:57:39.5969238Z           newClientAlerts: 'new_client_alerts',
2026-10-03T20:57:39.5969969Z           weeklySummary: 'weekly_summary_enabled',
2026-10-03T20:57:39.5970627Z         };
2026-10-03T20:57:39.5971171Z         const notifField = notifFieldMap[key];
2026-10-03T20:57:39.5971830Z         if (notifField) {
2026-10-03T20:57:39.5972354Z           try {
