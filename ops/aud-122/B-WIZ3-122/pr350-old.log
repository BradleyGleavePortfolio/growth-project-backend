2026-10-03T20:57:39.5933412Z         try {
2026-10-03T20:57:39.5934431Z           // Canonical in-app deletion status (POST /me/delete-account flow). The
2026-10-03T20:57:39.5935581Z           // legacy /users/me/account status reflects a different, unused path.
2026-10-03T20:57:39.5936731Z           const res = await deletionApi.getDeletionStatus();
2026-10-03T20:57:39.5937438Z           const st = res.data;
2026-10-03T20:57:39.5938250Z           // C-313-2: only `confirmed` is scheduled. A legacy `requested` row is
2026-10-03T20:57:39.5939214Z           // finished from the Delete account screen, so it routes there.
2026-10-03T20:57:39.5940079Z           const scheduled = st?.state === 'confirmed';
2026-10-03T20:57:39.5940731Z           setAccountStatus({
2026-10-03T20:57:39.5941368Z             deletionScheduled: scheduled,
2026-10-03T20:57:39.5942496Z             permanentDeletionAt: scheduled ? (st?.purge_after ?? null) : null,
2026-10-03T20:57:39.5943313Z           });
2026-10-03T20:57:39.5943776Z         } catch (err) {
2026-10-03T20:57:39.5944748Z           // 404 means the backend has not yet shipped the status endpoint — treat
