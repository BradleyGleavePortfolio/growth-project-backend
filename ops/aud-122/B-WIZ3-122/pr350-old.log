2026-10-03T20:57:39.5980990Z             // so no rollback write needed here.
2026-10-03T20:57:39.5981989Z             console.warn('coach SettingsScreen: notification sync failed — rolled back', err);
2026-10-03T20:57:39.5982731Z           }
2026-10-03T20:57:39.5983232Z         } else {
2026-10-03T20:57:39.5984335Z           // Non-backend settings (haptics, display prefs) — persist locally only.
2026-10-03T20:57:39.5985828Z           await AsyncStorage.setItem(COACH_SETTINGS_KEY + '_' + userId, JSON.stringify(updated));
2026-10-03T20:57:39.5986970Z         }
2026-10-03T20:57:39.5987465Z       };·
