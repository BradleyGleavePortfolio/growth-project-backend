2026-10-05T22:58:35.7293072Z       const updateSetting = async <K extends keyof CoachSettings>(key: K, value: CoachSettings[K]) => {
2026-10-05T22:58:35.7293885Z         const previous = settings;
2026-10-05T22:58:35.7294525Z         const updated = { ...settings, [key]: value };·
2026-10-05T22:58:35.7295231Z         // Optimistic update — instant UI response.
2026-10-05T22:58:35.7295786Z         setSettings(updated);
2026-10-05T22:58:35.7296387Z         if (updated.hapticsEnabled) mediumTap();·
2026-10-05T22:58:35.7297130Z         // Sync notification toggles to backend. On failure, roll back both
2026-10-05T22:58:35.7297968Z         // the in-memory state and the AsyncStorage cache so UI matches server.
2026-10-05T22:58:35.7298840Z         const notifFieldMap: Partial<Record<keyof CoachSettings, string>> = {
2026-10-05T22:58:35.7299574Z           dailyCheckin: 'daily_checkin_enabled',
