2026-10-05T22:59:29.6433543Z         // Sync notification toggles to backend. On failure, roll back both
2026-10-05T22:59:29.6434713Z         // the in-memory state and the AsyncStorage cache so UI matches server.
2026-10-05T22:59:29.6435876Z         const notifFieldMap: Partial<Record<keyof CoachSettings, string>> = {
2026-10-05T22:59:29.6436301Z           dailyCheckin: 'daily_checkin_enabled',
