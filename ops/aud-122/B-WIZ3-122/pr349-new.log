2026-10-05T22:59:29.5519088Z     function useCoachNotificationUnreadCount(): number {
2026-10-05T22:59:29.5519580Z       const [count, setCount] = useState(0);
2026-10-05T22:59:29.5519962Z       useEffect(() => {
2026-10-05T22:59:29.5520255Z         let mounted = true;
2026-10-05T22:59:29.5520828Z         const refresh = async () => {
2026-10-05T22:59:29.5521179Z           try {
2026-10-05T22:59:29.5521759Z             const n = await fetchUnreadCount();
2026-10-05T22:59:29.5522249Z             if (mounted) setCount(n);
2026-10-05T22:59:29.5522633Z           } catch (err) {
2026-10-05T22:59:29.5524175Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-05T22:59:29.5525187Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-05T22:59:29.5526197Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-05T22:59:29.5526671Z           }
2026-10-05T22:59:29.5526900Z         };
2026-10-05T22:59:29.5527143Z         refresh();
2026-10-05T22:59:29.5527501Z         const interval = setInterval(refresh, 30000);
2026-10-05T22:59:29.5528550Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T22:59:29.5529049Z           if (state === 'active') refresh();
2026-10-05T22:59:29.5529385Z         });
2026-10-05T22:59:29.5529622Z         return () => {
2026-10-05T22:59:29.5529906Z           mounted = false;
2026-10-05T22:59:29.5530482Z           clearInterval(interval);
2026-10-05T22:59:29.5530828Z           sub.remove();
2026-10-05T22:59:29.5531104Z         };
2026-10-05T22:59:29.5531347Z       }, []);
2026-10-05T22:59:29.5531598Z       return count;
2026-10-05T22:59:29.5531998Z     }·
