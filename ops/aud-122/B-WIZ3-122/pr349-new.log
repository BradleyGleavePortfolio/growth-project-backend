2026-10-05T22:59:29.5879404Z       const updateSetting = async <K extends keyof CoachSettings>(key: K, value: CoachSettings[K]) => {
2026-10-05T22:59:29.5880021Z         const previous = settings;
2026-10-05T22:59:29.5880498Z         const updated = { ...settings, [key]: value };·
