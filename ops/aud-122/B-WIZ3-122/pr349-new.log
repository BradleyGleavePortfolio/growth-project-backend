2026-10-05T22:58:35.7305123Z             // AsyncStorage never drifts ahead of the source of truth.
2026-10-05T22:58:35.7306067Z             await AsyncStorage.setItem(COACH_SETTINGS_KEY + '_' + userId, JSON.stringify(updated));
2026-10-05T22:58:35.7306801Z           } catch (err) {
2026-10-05T22:58:35.7307503Z             // Roll back to previous state — server rejected the change.
2026-10-05T22:58:35.7308161Z             setSettings(previous);
