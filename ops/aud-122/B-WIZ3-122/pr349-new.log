2026-10-05T22:58:14.7597122Z     function useCoachUnreadPolling(): number {
2026-10-05T22:58:14.7597287Z       const [total, setTotal] = useState(0);
2026-10-05T22:58:14.7597411Z       useEffect(() => {
2026-10-05T22:58:14.7597534Z         let mounted = true;
2026-10-05T22:58:14.7597691Z         const refresh = async () => {
2026-10-05T22:58:14.7597806Z           try {
2026-10-05T22:58:14.7598033Z             const res = await coachApi.getUnreadCounts();
2026-10-05T22:58:14.7598181Z             if (!mounted) return;
2026-10-05T22:58:14.7598358Z             setTotal(Number(res.data?.total ?? 0));
2026-10-05T22:58:14.7598483Z           } catch (err) {
2026-10-05T22:58:14.7598768Z             // Non-fatal: the unread total holds and the next 30s tick retries.
2026-10-05T22:58:14.7599191Z             // Never swallow silently (Law #36) — log so the failure is observable.
2026-10-05T22:58:14.7599491Z             logger.warn('coach.notifications.unread_polling_refresh', { err });
2026-10-05T22:58:14.7599600Z           }
2026-10-05T22:58:14.7599705Z         };
2026-10-05T22:58:14.7599812Z         refresh();
2026-10-05T22:58:14.7599995Z         const id = setInterval(refresh, 30000);
2026-10-05T22:58:14.7600261Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T22:58:14.7600429Z           if (state === 'active') refresh();
2026-10-05T22:58:14.7600544Z         });
2026-10-05T22:58:14.7600657Z         return () => {
2026-10-05T22:58:14.7600780Z           mounted = false;
2026-10-05T22:58:14.7600898Z           clearInterval(id);
2026-10-05T22:58:14.7601029Z           sub.remove();
2026-10-05T22:58:14.7601139Z         };
2026-10-05T22:58:14.7601244Z       }, []);
2026-10-05T22:58:14.7601368Z       return total;
2026-10-05T22:58:14.7601523Z     }·
