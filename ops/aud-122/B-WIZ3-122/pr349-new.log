2026-10-05T22:59:29.5686247Z     function useCoachUnreadPolling(): number {
2026-10-05T22:59:29.5686690Z       const [total, setTotal] = useState(0);
2026-10-05T22:59:29.5687060Z       useEffect(() => {
2026-10-05T22:59:29.5687360Z         let mounted = true;
2026-10-05T22:59:29.5687826Z         const refresh = async () => {
2026-10-05T22:59:29.5688162Z           try {
2026-10-05T22:59:29.5688978Z             const res = await coachApi.getUnreadCounts();
