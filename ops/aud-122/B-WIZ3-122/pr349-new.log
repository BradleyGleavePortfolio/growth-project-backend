2026-10-05T22:58:14.7371515Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-05T22:58:14.7372428Z     function useCoachNotificationUnreadCount(): number {
2026-10-05T22:58:14.7372916Z       const [count, setCount] = useState(0);
2026-10-05T22:58:14.7373283Z       useEffect(() => {
2026-10-05T22:58:14.7373590Z         let mounted = true;
2026-10-05T22:58:14.7373941Z         const refresh = async () => {
2026-10-05T22:58:14.7374289Z           try {
2026-10-05T22:58:14.7374623Z             const n = await fetchUnreadCount();
2026-10-05T22:58:14.7375061Z             if (mounted) setCount(n);
2026-10-05T22:58:14.7375395Z           } catch (err) {
2026-10-05T22:58:14.7375887Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-05T22:58:14.7376706Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-05T22:58:14.7377359Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-05T22:58:14.7377829Z           }
2026-10-05T22:58:14.7378083Z         };
2026-10-05T22:58:14.7378334Z         refresh();
2026-10-05T22:58:14.7378693Z         const interval = setInterval(refresh, 30000);
2026-10-05T22:58:14.7379265Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T22:58:14.7379778Z           if (state === 'active') refresh();
2026-10-05T22:58:14.7380130Z         });
2026-10-05T22:58:14.7380392Z         return () => {
2026-10-05T22:58:14.7380682Z           mounted = false;
2026-10-05T22:58:14.7381023Z           clearInterval(interval);
2026-10-05T22:58:14.7381367Z           sub.remove();
2026-10-05T22:58:14.7381816Z         };
2026-10-05T22:58:14.7382058Z       }, []);
2026-10-05T22:58:14.7382311Z       return count;
2026-10-05T22:58:14.7382635Z     }·
