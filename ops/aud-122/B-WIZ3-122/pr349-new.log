2026-10-05T22:59:29.6429271Z       const updateSetting = async <K extends keyof CoachSettings>(key: K, value: CoachSettings[K]) => {
2026-10-05T22:59:29.6429604Z         const previous = settings;
2026-10-05T22:59:29.6430272Z         const updated = { ...settings, [key]: value };·
