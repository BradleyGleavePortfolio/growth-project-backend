2026-10-05T22:57:54.3984561Z     function useCoachUnreadPolling(): number {
2026-10-05T22:57:54.3984966Z       const [total, setTotal] = useState(0);
2026-10-05T22:57:54.3985290Z       useEffect(() => {
2026-10-05T22:57:54.3985668Z         let mounted = true;
2026-10-05T22:57:54.3986037Z         const refresh = async () => {
2026-10-05T22:57:54.3986669Z           try {
2026-10-05T22:57:54.3987171Z             const res = await coachApi.getUnreadCounts();
2026-10-05T22:57:54.3987532Z             if (!mounted) return;
2026-10-05T22:57:54.3987944Z             setTotal(Number(res.data?.total ?? 0));
2026-10-05T22:57:54.3988257Z           } catch (err) {
2026-10-05T22:57:54.3988829Z             // Non-fatal: the unread total holds and the next 30s tick retries.
2026-10-05T22:57:54.3989587Z             // Never swallow silently (Law #36) — log so the failure is observable.
2026-10-05T22:57:54.3990232Z             logger.warn('coach.notifications.unread_polling_refresh', { err });
2026-10-05T22:57:54.3990544Z           }
2026-10-05T22:57:54.3990848Z         };
2026-10-05T22:57:54.3991170Z         refresh();
2026-10-05T22:57:54.3991580Z         const id = setInterval(refresh, 30000);
2026-10-05T22:57:54.3992150Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T22:57:54.3992557Z           if (state === 'active') refresh();
2026-10-05T22:57:54.3992871Z         });
2026-10-05T22:57:54.3993195Z         return () => {
2026-10-05T22:57:54.3993544Z           mounted = false;
2026-10-05T22:57:54.3993896Z           clearInterval(id);
2026-10-05T22:57:54.3994233Z           sub.remove();
2026-10-05T22:57:54.3994545Z         };
2026-10-05T22:57:54.3994855Z       }, []);
2026-10-05T22:57:54.3995171Z       return total;
2026-10-05T22:57:54.3995499Z     }·
2026-10-05T22:57:54.3995911Z     export default function CoachNavigator() {
2026-10-05T22:57:54.3996626Z       const unreadCount = useCoachUnreadPolling();
