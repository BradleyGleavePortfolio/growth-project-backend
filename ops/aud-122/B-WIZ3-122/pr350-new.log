2026-10-05T22:57:54.3858249Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-05T22:57:54.3858833Z     function useCoachNotificationUnreadCount(): number {
2026-10-05T22:57:54.3859286Z       const [count, setCount] = useState(0);
2026-10-05T22:57:54.3859649Z       useEffect(() => {
2026-10-05T22:57:54.3860009Z         let mounted = true;
2026-10-05T22:57:54.3860411Z         const refresh = async () => {
2026-10-05T22:57:54.3860761Z           try {
2026-10-05T22:57:54.3861204Z             const n = await fetchUnreadCount();
2026-10-05T22:57:54.3861609Z             if (mounted) setCount(n);
2026-10-05T22:57:54.3861942Z           } catch (err) {
2026-10-05T22:57:54.3862607Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-05T22:57:54.3863371Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-05T22:57:54.3864030Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-05T22:57:54.3864351Z           }
2026-10-05T22:57:54.3864673Z         };
2026-10-05T22:57:54.3865236Z         refresh();
2026-10-05T22:57:54.3865755Z         const interval = setInterval(refresh, 30000);
2026-10-05T22:57:54.3866551Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T22:57:54.3867012Z           if (state === 'active') refresh();
2026-10-05T22:57:54.3867333Z         });
2026-10-05T22:57:54.3867675Z         return () => {
2026-10-05T22:57:54.3868017Z           mounted = false;
2026-10-05T22:57:54.3868426Z           clearInterval(interval);
2026-10-05T22:57:54.3868767Z           sub.remove();
2026-10-05T22:57:54.3869086Z         };
2026-10-05T22:57:54.3869373Z       }, []);
2026-10-05T22:57:54.3869676Z       return count;
2026-10-05T22:57:54.3870018Z     }·
