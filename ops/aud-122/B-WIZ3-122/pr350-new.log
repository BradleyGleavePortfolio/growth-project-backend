2026-10-05T22:59:36.0361412Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-05T22:59:36.0362357Z     function useCoachNotificationUnreadCount(): number {
2026-10-05T22:59:36.0363067Z       const [count, setCount] = useState(0);
2026-10-05T22:59:36.0363596Z       useEffect(() => {
2026-10-05T22:59:36.0364012Z         let mounted = true;
2026-10-05T22:59:36.0364547Z         const refresh = async () => {
2026-10-05T22:59:36.0365018Z           try {
2026-10-05T22:59:36.0365507Z             const n = await fetchUnreadCount();
2026-10-05T22:59:36.0366107Z             if (mounted) setCount(n);
2026-10-05T22:59:36.0366783Z           } catch (err) {
2026-10-05T22:59:36.0368274Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-05T22:59:36.0369667Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-05T22:59:36.0370881Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-05T22:59:36.0371570Z           }
2026-10-05T22:59:36.0371908Z         };
2026-10-05T22:59:36.0372249Z         refresh();
2026-10-05T22:59:36.0372762Z         const interval = setInterval(refresh, 30000);
2026-10-05T22:59:36.0373596Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T22:59:36.0374326Z           if (state === 'active') refresh();
2026-10-05T22:59:36.0374839Z         });
2026-10-05T22:59:36.0375192Z         return () => {
2026-10-05T22:59:36.0375604Z           mounted = false;
2026-10-05T22:59:36.0376087Z           clearInterval(interval);
2026-10-05T22:59:36.0376731Z           sub.remove();
2026-10-05T22:59:36.0377137Z         };
2026-10-05T22:59:36.0377491Z       }, []);
2026-10-05T22:59:36.0377856Z       return count;
2026-10-05T22:59:36.0378265Z     }·
