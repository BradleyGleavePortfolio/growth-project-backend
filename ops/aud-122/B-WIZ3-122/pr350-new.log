2026-10-05T22:58:22.7673243Z       const updateSetting = async <K extends keyof CoachSettings>(key: K, value: CoachSettings[K]) => {
2026-10-05T22:58:22.7674234Z         const previous = settings;
2026-10-05T22:58:22.7674884Z         const updated = { ...settings, [key]: value };·
2026-10-05T22:58:22.7675605Z         // Optimistic update — instant UI response.
2026-10-05T22:58:22.7676140Z         setSettings(updated);
2026-10-05T22:58:22.7676942Z         if (updated.hapticsEnabled) mediumTap();·
2026-10-05T22:58:22.7677713Z         // Sync notification toggles to backend. On failure, roll back both
2026-10-05T22:58:22.7678637Z         // the in-memory state and the AsyncStorage cache so UI matches server.
2026-10-05T22:58:22.7679644Z         const notifFieldMap: Partial<Record<keyof CoachSettings, string>> = {
2026-10-05T22:58:22.7680627Z           dailyCheckin: 'daily_checkin_enabled',
2026-10-05T22:58:22.7681224Z           newClientAlerts: 'new_client_alerts',
2026-10-05T22:58:22.7681822Z           weeklySummary: 'weekly_summary_enabled',
2026-10-05T22:58:22.7682327Z         };
2026-10-05T22:58:22.7682752Z         const notifField = notifFieldMap[key];
2026-10-05T22:58:22.7683256Z         if (notifField) {
2026-10-05T22:58:22.7683632Z           try {
2026-10-05T22:58:22.7684263Z             await notificationsApi.updatePreferences({ [notifField]: value });
2026-10-05T22:58:22.7685158Z             // Only persist locally after backend confirms. This ensures
2026-10-05T22:58:22.7686022Z             // AsyncStorage never drifts ahead of the source of truth.
2026-10-05T22:58:22.7687386Z             await AsyncStorage.setItem(COACH_SETTINGS_KEY + '_' + userId, JSON.stringify(updated));
2026-10-05T22:58:22.7688226Z           } catch (err) {
2026-10-05T22:58:22.7688953Z             // Roll back to previous state — server rejected the change.
2026-10-05T22:58:22.7689600Z             setSettings(previous);
2026-10-05T22:58:22.7690598Z             // AsyncStorage still holds previous value (we didn’t write yet),
2026-10-05T22:58:22.7691341Z             // so no rollback write needed here.
2026-10-05T22:58:22.7692343Z             console.warn('coach SettingsScreen: notification sync failed — rolled back', err);
2026-10-05T22:58:22.7693085Z           }
2026-10-05T22:58:22.7693399Z         } else {
2026-10-05T22:58:22.7694193Z           // Non-backend settings (haptics, display prefs) — persist locally only.
2026-10-05T22:58:22.7695354Z           await AsyncStorage.setItem(COACH_SETTINGS_KEY + '_' + userId, JSON.stringify(updated));
2026-10-05T22:58:22.7696155Z         }
2026-10-05T22:58:22.7697044Z       };·
