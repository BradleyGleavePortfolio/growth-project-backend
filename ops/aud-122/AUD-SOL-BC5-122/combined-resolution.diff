 +  // workout | meal_plan | booking | package | check_in
 +  card_type  String
 +  ref_id     String?
 +  snapshot   Json
 +  created_at DateTime     @default(now())
 +
 +  @@index([card_type, ref_id])
 +  @@map("coach_message_cards")
 +}
 +
 +// Saved replies: reusable message text per coach user.
