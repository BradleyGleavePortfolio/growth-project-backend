2026-10-05T23:38:49.0505395Z     function useCoachUnreadPolling(): number {
2026-10-05T23:38:49.0505995Z       const [total, setTotal] = useState(0);
2026-10-05T23:38:49.0506511Z       useEffect(() => {
2026-10-05T23:38:49.0506935Z         let mounted = true;
2026-10-05T23:38:49.0507422Z         const refresh = async () => {
2026-10-05T23:38:49.0507894Z           try {
2026-10-05T23:38:49.0508413Z             const res = await coachApi.getUnreadCounts();
2026-10-05T23:38:49.0509021Z             if (!mounted) return;
2026-10-05T23:38:49.0509575Z             setTotal(Number(res.data?.total ?? 0));
2026-10-05T23:38:49.0510103Z           } catch (err) {
2026-10-05T23:38:49.0511103Z             // Non-fatal: the unread total holds and the next 30s tick retries.
2026-10-05T23:38:49.0512082Z             // Never swallow silently (Law #36) — log so the failure is observable.
2026-10-05T23:38:49.0513242Z             logger.warn('coach.notifications.unread_polling_refresh', { err });
2026-10-05T23:38:49.0513919Z           }
2026-10-05T23:38:49.0514281Z         };
2026-10-05T23:38:49.0514637Z         refresh();
2026-10-05T23:38:49.0515120Z         const id = setInterval(refresh, 30000);
2026-10-05T23:38:49.0515791Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T23:38:49.0516437Z           if (state === 'active') refresh();
2026-10-05T23:38:49.0516922Z         });
2026-10-05T23:38:49.0517278Z         return () => {
2026-10-05T23:38:49.0517699Z           mounted = false;
2026-10-05T23:38:49.0518145Z           clearInterval(id);
2026-10-05T23:38:49.0518588Z           sub.remove();
2026-10-05T23:38:49.0518996Z         };
2026-10-05T23:38:49.0519345Z       }, []);
2026-10-05T23:38:49.0519714Z       return total;
2026-10-05T23:38:49.0520132Z     }·
2026-10-05T23:38:49.0520726Z     export default function CoachNavigator() {
2026-10-05T23:38:49.0521382Z       const unreadCount = useCoachUnreadPolling();
2026-10-05T23:38:49.0522138Z       // P0-1: TeamStack must only mount for head coaches. Sub-coaches who land
2026-10-05T23:38:49.0523853Z       // on team-management surfaces hit `/sub-coaches` 403s the screen treats as
2026-10-05T23:38:49.0525028Z       // a permanent retry-error — a feature they don't own. The hook fails
2026-10-05T23:38:49.0526417Z       // closed (returns 'unknown' until a positive head-coach signal), so the
2026-10-05T23:38:49.0529083Z       // tab disappears for sub-coaches and during the initial resolution
2026-10-05T23:38:49.0529758Z       // window.
2026-10-05T23:38:49.0530190Z       const coachRoleType = useCoachRoleType();
2026-10-05T23:38:49.0531377Z       const showTeamTab = coachRoleType === 'head_coach';
