2026-10-05T23:38:49.0286317Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-05T23:38:49.0287147Z     function useCoachNotificationUnreadCount(): number {
2026-10-05T23:38:49.0287788Z       const [count, setCount] = useState(0);
2026-10-05T23:38:49.0288275Z       useEffect(() => {
2026-10-05T23:38:49.0288713Z         let mounted = true;
2026-10-05T23:38:49.0289205Z         const refresh = async () => {
2026-10-05T23:38:49.0289670Z           try {
2026-10-05T23:38:49.0290096Z             const n = await fetchUnreadCount();
2026-10-05T23:38:49.0290824Z             if (mounted) setCount(n);
2026-10-05T23:38:49.0291353Z           } catch (err) {
2026-10-05T23:38:49.0291963Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-05T23:38:49.0292901Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-05T23:38:49.0293729Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-05T23:38:49.0294304Z           }
2026-10-05T23:38:49.0294813Z         };
2026-10-05T23:38:49.0295121Z         refresh();
2026-10-05T23:38:49.0295951Z         const interval = setInterval(refresh, 30000);
2026-10-05T23:38:49.0297825Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T23:38:49.0298663Z           if (state === 'active') refresh();
2026-10-05T23:38:49.0299203Z         });
2026-10-05T23:38:49.0299573Z         return () => {
2026-10-05T23:38:49.0300005Z           mounted = false;
2026-10-05T23:38:49.0300689Z           clearInterval(interval);
2026-10-05T23:38:49.0301180Z           sub.remove();
2026-10-05T23:38:49.0309060Z         };
2026-10-05T23:38:49.0309458Z       }, []);
2026-10-05T23:38:49.0309812Z       return count;
2026-10-05T23:38:49.0310413Z     }·
2026-10-05T23:38:49.0310802Z     function ClientsStackNavigator() {
