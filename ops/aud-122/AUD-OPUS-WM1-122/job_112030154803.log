2026-10-05T23:37:11.0582162Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-05T23:37:11.0582477Z     function useCoachNotificationUnreadCount(): number {
2026-10-05T23:37:11.0582706Z       const [count, setCount] = useState(0);
2026-10-05T23:37:11.0582861Z       useEffect(() => {
2026-10-05T23:37:11.0583016Z         let mounted = true;
2026-10-05T23:37:11.0583228Z         const refresh = async () => {
2026-10-05T23:37:11.0583373Z           try {
2026-10-05T23:37:11.0583603Z             const n = await fetchUnreadCount();
2026-10-05T23:37:11.0583801Z             if (mounted) setCount(n);
2026-10-05T23:37:11.0583959Z           } catch (err) {
2026-10-05T23:37:11.0584609Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-05T23:37:11.0585124Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-05T23:37:11.0585521Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-05T23:37:11.0585665Z           }
2026-10-05T23:37:11.0585791Z         };
2026-10-05T23:37:11.0585937Z         refresh();
2026-10-05T23:37:11.0586201Z         const interval = setInterval(refresh, 30000);
2026-10-05T23:37:11.0586559Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T23:37:11.0586775Z           if (state === 'active') refresh();
2026-10-05T23:37:11.0586910Z         });
2026-10-05T23:37:11.0587057Z         return () => {
2026-10-05T23:37:11.0587208Z           mounted = false;
2026-10-05T23:37:11.0587415Z           clearInterval(interval);
2026-10-05T23:37:11.0587569Z           sub.remove();
2026-10-05T23:37:11.0587703Z         };
2026-10-05T23:37:11.0587836Z       }, []);
2026-10-05T23:37:11.0587995Z       return count;
2026-10-05T23:37:11.0588163Z     }·
