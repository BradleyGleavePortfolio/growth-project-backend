2026-10-05T23:38:49.0535766Z       // initial tab for a real coach is ClientsStack. Mock-mode builds (demo,
2026-10-05T23:38:49.0536807Z       // screenshots) keep the CommandCenter landing surface.
2026-10-05T23:38:49.0538427Z       const initialTab = __USING_MOCK_DATA ? 'CommandCenter' : 'ClientsStack';
2026-10-05T23:38:49.0539111Z       return (
