2026-10-05T23:44:23.3198380Z     function useCoachNotificationUnreadCount(): number {
2026-10-05T23:44:23.3199031Z       const [count, setCount] = useState(0);
2026-10-05T23:44:23.3199517Z       useEffect(() => {
2026-10-05T23:44:23.3199908Z         let mounted = true;
2026-10-05T23:44:23.3200368Z         const refresh = async () => {
2026-10-05T23:44:23.3200820Z           try {
2026-10-05T23:44:23.3201251Z             const n = await fetchUnreadCount();
2026-10-05T23:44:23.3201805Z             if (mounted) setCount(n);
2026-10-05T23:44:23.3202259Z           } catch (err) {
2026-10-05T23:44:23.3202947Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-05T23:44:23.3203970Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-05T23:44:23.3205036Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-05T23:44:23.3205692Z           }
2026-10-05T23:44:23.3206008Z         };
2026-10-05T23:44:23.3206340Z         refresh();
2026-10-05T23:44:23.3206825Z         const interval = setInterval(refresh, 30000);
2026-10-05T23:44:23.3207559Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T23:44:23.3208245Z           if (state === 'active') refresh();
2026-10-05T23:44:23.3208704Z         });
2026-10-05T23:44:23.3209027Z         return () => {
2026-10-05T23:44:23.3209425Z           mounted = false;
2026-10-05T23:44:23.3209882Z           clearInterval(interval);
2026-10-05T23:44:23.3210323Z           sub.remove();
2026-10-05T23:44:23.3210708Z         };
2026-10-05T23:44:23.3211023Z       }, []);
2026-10-05T23:44:23.3211354Z       return count;
2026-10-05T23:44:23.3211728Z     }·
