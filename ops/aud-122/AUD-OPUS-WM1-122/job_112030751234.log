2026-10-05T23:42:36.5751319Z     // ─── Phase 9: unread count polling for the coach bell icon ───────────────────·
2026-10-05T23:42:36.5751648Z     function useCoachNotificationUnreadCount(): number {
2026-10-05T23:42:36.5751880Z       const [count, setCount] = useState(0);
2026-10-05T23:42:36.5752041Z       useEffect(() => {
2026-10-05T23:42:36.5752202Z         let mounted = true;
2026-10-05T23:42:36.5752407Z         const refresh = async () => {
2026-10-05T23:42:36.5752550Z           try {
2026-10-05T23:42:36.5752795Z             const n = await fetchUnreadCount();
2026-10-05T23:42:36.5753016Z             if (mounted) setCount(n);
2026-10-05T23:42:36.5753164Z           } catch (err) {
2026-10-05T23:42:36.5753605Z             // Non-fatal: the badge keeps its prior count until the next poll. Never
2026-10-05T23:42:36.5754123Z             // swallow silently (Law #36) — log so the failure is observable.
2026-10-05T23:42:36.5754771Z             logger.warn('coach.notifications.unread_count_refresh', { err });
2026-10-05T23:42:36.5755191Z           }
2026-10-05T23:42:36.5755355Z         };
2026-10-05T23:42:36.5755520Z         refresh();
2026-10-05T23:42:36.5755804Z         const interval = setInterval(refresh, 30000);
2026-10-05T23:42:36.5756198Z         const sub = AppState.addEventListener('change', (state) => {
2026-10-05T23:42:36.5756434Z           if (state === 'active') refresh();
2026-10-05T23:42:36.5756575Z         });
2026-10-05T23:42:36.5756737Z         return () => {
2026-10-05T23:42:36.5756906Z           mounted = false;
2026-10-05T23:42:36.5757130Z           clearInterval(interval);
2026-10-05T23:42:36.5757541Z           sub.remove();
2026-10-05T23:42:36.5757689Z         };
2026-10-05T23:42:36.5757844Z       }, []);
2026-10-05T23:42:36.5758001Z       return count;
2026-10-05T23:42:36.5758196Z     }·
