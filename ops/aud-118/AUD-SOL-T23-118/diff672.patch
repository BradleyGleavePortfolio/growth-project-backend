+    expect(a.status).toBe(201);
+    expect(a.body).toMatchObject({ coach_id: 'coach-1', trial_days: 7 });
+    expect(db.ledger()[0]).toMatchObject({ user_id: 'sub-1' });
+    // The head coach's own key space is separate: the same key is a new create.
