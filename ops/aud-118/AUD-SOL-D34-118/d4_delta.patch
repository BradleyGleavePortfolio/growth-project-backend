+  });
+
+  it('B-690-5: an unpaid plan in an active unlocked cycle keeps Days 0-9 access; Day 10 locks', async () => {
+    const w = world();
+    graceDay7(w, 'unpaid');
+    await expect(guard(w)).resolves.toBe(true);
+    w.state()!.locked_out_at = NOW;
