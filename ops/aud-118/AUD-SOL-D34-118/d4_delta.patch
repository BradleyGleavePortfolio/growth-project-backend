+  });
+
+  it('B-690-5: subscription.updated to unpaid keeps the grace entitlement; a locked cycle does not', async () => {
+    const w = world();
+    graceDay7(w, 'past_due');
+    await w.handler.handle(updated('evt_unpaid', 'unpaid'));
