+/** The characters outside `<...>` tags: the copy a reader sees (plus any inline CSS). */
+function textOutsideTags(html: string): string {
+  return html
+    .split('<')
+    .map((chunk, i) => (i === 0 ? chunk : chunk.slice(chunk.indexOf('>') + 1)))
+    .join(' ');
+}
