+        },
+        select: { ...common, closed_at: true, updated_at: true },
+        orderBy: { id: 'asc' },
+        take: opts.limit + 1,
+      }),
+    ]);
+    if (refunds.length > opts.limit || disputes.length > opts.limit) {
+      throw exportTooLarge(opts.limit);
