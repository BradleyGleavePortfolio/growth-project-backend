+  async loadOccurrences(
+    coachId: string,
+    window: MoneyWindow,
+    opts: { currency?: string; limit: number },
+  ): Promise<MoneyOccurrence[]> {
+    const range = this.windowRange(window);
+    const scope = {
+      purchase: {
+        coach_user_id: coachId,
+        source: null,
+        ...(opts.currency ? { currency: opts.currency } : {}),
