ndApplyRefund({\n-    purchase: (h.db.state.clientPurchase as Row[]).find((p) => p.id === id) as any,\n+    purchase: (h.db.state.clientPurchase as Row[]).find((p) => p.id === id) as ClientPurchase,\n     stripe_refund_id: `re_${id}`,\n     stripe_charge_id: `ch_${id}`,\n     amount_cents: 2450,"}]}