+    expect(rowOf(h, 'splitLedgerEntry', 'p-dup-destination').reversed_cents).toBe(4802);
+    expect((h.db.state.splitLedgerReversal as Row[]).map((p) => p.cents)).toEqual([4802]);
+  });
+});
