+  const totals = async (w: MoneyWindow) => (await svc.getSummary(coach, w, null, NOW)).totals;
+  return {
+    first: await totals(FIRST),
+    second: await totals(SECOND),
+    lifetime: await totals(LIFETIME),
+    csv: (await svc.exportCsv(coach, FIRST)).trim(),
+  };
