        } catch (err) {
          this.logger.error(`roman.spend_ledger_failed: ${romanErrorTag(err)}`);
          Sentry.captureException(romanSanitizedError('roman.spend_ledger_failed', err), {
            tags: { feature: 'roman', op: 'roman.spend' },
