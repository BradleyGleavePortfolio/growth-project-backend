    // ─── plan helpers ────────────────────────────────────────────────────────────·
    type RawExercise = {
      exercise_external_id: string;
      sets: number;
      reps_or_duration_seconds: number;
      notes: string | null;
    };
    type AssignmentRow = {
      scheduled_for: Date;
      completed_at: Date | null;
      post_rpe: number | null;
