      if (value === undefined) {
        delete process.env[FEATURE_ROMAN_COPY_V2_ENV];
      } else {
        process.env[FEATURE_ROMAN_COPY_V2_ENV] = value;
      }
      try {
        return body();
      } finally {
        if (prev === undefined) {
          delete process.env[FEATURE_ROMAN_COPY_V2_ENV];
        } else {
          process.env[FEATURE_ROMAN_COPY_V2_ENV] = prev;
        }
      }
    }·
