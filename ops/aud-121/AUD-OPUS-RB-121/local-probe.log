          await this.settleSpend(requestId, 0, 0, { outcome: 'over_cap' });
          this.logger.warn(`roman.capacity_reached cap_usd=${cap}`);
          Sentry.captureMessage('roman.capacity_reached', {
            level: 'warning',
            tags: { feature: 'roman', op: 'roman.spend' },
