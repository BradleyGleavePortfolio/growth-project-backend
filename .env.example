# Supabase (required)
DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# USDA FoodData Central API key — required at boot.
# Get one at https://fdc.nal.usda.gov/api-key-signup.html (free, 1000 req/hr per key).
# Without this the food search silently returned [] under load — we now fail fast.
USDA_API_KEY=

# Perplexity (AI chat) — optional; chat falls back to deterministic responder if unset.
PERPLEXITY_API_KEY=

# Deep-link target for Supabase email verification (mobile only).
SUPABASE_REDIRECT_URL=tgp://verified

# Legacy — kept for backwards compatibility with older clients. Not used by auth.
JWT_SECRET=unused-kept-for-legacy-compatibility

# Comma-separated list of allowed browser origins for CORS. Empty = deny all browsers.
# The React Native mobile app does not need this. Set only for web admin/dashboard
# (e.g. the coach console). Wildcard '*' is rejected at boot in any environment —
# always list explicit origins. Required in staging/production by env-validation.
# Example: CORS_ORIGINS=https://console.thegrowthproject.app,https://admin.thegrowthproject.app
CORS_ORIGINS=

# Sentry DSN for server-side error reporting. Required in staging/production
# (env-validation prints a warn on boot when missing in prod) so unhandled
# exceptions and 5xx responses are forwarded to Sentry. Leave unset in dev.
SENTRY_DSN=

# Redis URL backing the rate-limit storage. When set, ThrottlerModule shares
# limit counters across all Fly machines so a credential-stuffing attacker
# cannot multiplex across replicas. When unset (dev/test), the throttler
# falls back to an in-memory tracker. Must be redis:// or rediss://. Required
# in staging/production once the app scales beyond a single machine — see
# README "Rate limiting" for the named-throttler table.
# Example: REDIS_URL=rediss://default:PASSWORD@fly-tgp-redis.upstash.io:6379
REDIS_URL=

# PostHog key + host for product analytics. AnalyticsModule is a no-op when
# unset, so leaving these blank in dev is fine.
POSTHOG_KEY=
POSTHOG_HOST=

# Coach invite-code gate. When "true" the /auth signup endpoints reject
# requests that lack a valid coach invite code. Leave unset in dev.
COACH_CODE_GATE_ENABLED=

PORT=3000
NODE_ENV=development

# Public invite landing — server-rendered HTML at /join/:code and /invite/:code.
# All optional; sane defaults are baked in for dev and the placeholder store
# URLs. Override per environment via Fly secrets.
PUBLIC_INVITE_BASE_URL=https://app.tgp.com/join
PUBLIC_WEB_SIGNUP_URL=
APP_STORE_URL=
PLAY_STORE_URL=

# Stripe (coach SaaS billing). All four are optional in dev — when unset the
# /v1/coach/me/billing endpoint returns an empty mirror, the portal-session
# and start-subscription endpoints return STRIPE_NOT_CONFIGURED, and the
# webhook endpoint refuses every request. Required in production.
# Full setup guide: docs/stripe-setup.md.
# Local replay (no Stripe account needed): scripts/stripe-webhook-smoke.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_FITNESS=
STRIPE_PRICE_ID_FINANCE=

# Return URL Stripe redirects the coach to after the Customer Portal session
# ends. Optional — defaults to https://console.thegrowthproject.app/billing
# when unset. Set per-environment if the console host differs (e.g. staging).
STRIPE_BILLING_PORTAL_RETURN_URL=

# Hosted Stripe Customer Portal login link (Stripe dashboard → Settings →
# Billing → Customer portal → Login link). Used as a fallback by
# POST /v1/coach/me/billing/portal-session when STRIPE_SECRET_KEY is unset:
# the endpoint returns { url, fallback: true } pointing at this hosted page,
# where the coach authenticates with the email on file with Stripe. When
# STRIPE_SECRET_KEY is set, the per-coach SDK session takes precedence and
# this var is unused. Validated to match https://billing.stripe.com/p/login/.
# Production value lives in Fly secrets; do not commit a real link here.
STRIPE_CUSTOMER_PORTAL_LOGIN_URL=

# SubscriptionGuard rollout flag. Leave unset (or set to "observe") during
# rollout — the guard will run but allow every request. Set to "enforce" once
# Stripe is live and every coach has a CoachSubscription row.
# Default (unset / anything other than "enforce") = observe-only.
BILLING_ENFORCEMENT=

# Finance backend federation. All optional — when unset, the OWNER
# /admin/federation/* endpoints return fitness-only payloads with
# finance.status="not_configured". No fake data is ever substituted.
# See src/admin/federation/README.md for the full contract.
#
# FINANCE_SERVICE_TOKEN is used in both directions:
#   - Outbound: sent as a bearer token on calls FROM this backend TO the
#     finance backend (/api/admin/federation/*).
#   - Inbound: expected as a bearer token on calls FROM the finance backend
#     TO POST /api/admin/federation/ptm-signal (the finance-to-fitness PTM
#     signal endpoint). The endpoint returns 503 FEDERATION_DISABLED when
#     this variable is unset — fail-closed behaviour.
# Must be identical on both backends. Provision with: openssl rand -hex 32
FINANCE_API_BASE_URL=
FINANCE_SERVICE_TOKEN=
FINANCE_FEDERATION_TIMEOUT_MS=

# Self-service /auth/become-coach hard gate. Unset (or anything other than
# "true") = endpoint refuses with 403 self_service_promotion_disabled. Set to
# "true" only for legacy migrations where you knowingly want any logged-in
# user to self-elevate after a password re-auth.
ALLOW_SELF_SERVICE_BECOME_COACH=

# GDPR scrub worker controls (script: scripts/gdpr-scrub.ts).
# - GDPR_SCRUB_DRY_RUN=true reports candidate rows without writing deleted_at
#   or zeroing PII. Default = real scrub.
# - GDPR_SCRUB_BATCH_LIMIT caps the per-run row count. Defaults to 100.
GDPR_SCRUB_DRY_RUN=
GDPR_SCRUB_BATCH_LIMIT=

# ============================================================
# PTM (Predictive Tracking Model) — Phase 1
# ============================================================
# All PTM env vars are optional. Sensible defaults ship in code; override
# only to disable, retune, or troubleshoot. See src/ptm/README.md and
# docs/ptm.md for the full doctrine.

# Master kill switch. When "false" the nightly recompute cron and the
# admin teaching endpoints are disabled. Signal collection itself
# (PtmService.recordSignal) keeps writing rows so no data is lost while
# the engine is off. Defaults to true.
PTM_SCORING_ENABLED=true

# Cron expression (UTC) for the nightly PTM recompute. Defaults to
# "0 4 * * *" (04:00 UTC, 1h after the GDPR scrub at 03:00 UTC) to keep
# the two write-heavy jobs from competing for the connection pool.
PTM_SCORING_CRON=0 4 * * *

# Per-run cap on the number of clients the nightly cron will recompute.
# Defaults to 5000; clamped to [1, 50000]. Larger rosters are processed
# across multiple nights via a stable cursor on (last_computed_at, user_id).
PTM_RECOMPUTE_BATCH_LIMIT=5000

# Minimum number of labelled ClientOutcome rows before the weighted v2
# engine activates. Defaults to 20. Below this threshold every recompute
# uses heuristic_v1 (the hand-tuned engine).
PTM_WEIGHTED_ACTIVATION_OUTCOMES=20

# Default page size for GET /admin/ptm/risk-board. Defaults to 50;
# clamped to [1, 100] regardless of the caller-supplied limit.
PTM_RISK_BOARD_PAGE_SIZE=50

# Phase 3 — diagnostic + AI roadmap. Set to "false" to skip Perplexity
# calls and store a placeholder roadmap (used in CI and preview deploys
# that do not have a Perplexity key). Defaults to true.
DIAGNOSTIC_AI_ENABLED=true

# Per-IP hourly cap on POST /diagnostic/submit. Defaults to 5; clamped to
# [1, 1000]. The endpoint is unauthenticated by design (lead capture),
# so the rate limit is the primary defense against bulk-stuffing.
DIAGNOSTIC_RATE_LIMIT_PER_HOUR=5

# Phase 4 — Build Week feature flag. Set to "false" to disable writes to
# the Build Week controllers and zero the admin funnel. Defaults to true.
BUILD_WEEK_ENABLED=true

# Phase 4 — when "true", new client signups auto-enrol in Build Week.
# Defaults to false. Wiring is a follow-on PR; this PR exposes the flag
# so deployment configs can be staged ahead of the implementation.
BUILD_WEEK_AUTO_START_ON_SIGNUP=false

# ============================================================
# Phase 9 — Notifications Matrix
# ============================================================
# Email digest controls. Set EMAIL_DIGEST_*_ENABLED=off to disable
# sending for that role. Defaults are 'on'.
EMAIL_DIGEST_CLIENT_ENABLED=on
EMAIL_DIGEST_COACH_ENABLED=on

# Cron schedules for digest emails (UTC). All accept 5-field cron expressions.
# Default: client daily 07:00 UTC, coach daily 06:00 UTC, weekly Sunday 08:00 UTC.
CLIENT_DAILY_CRON=0 7 * * *
COACH_DAILY_CRON=0 6 * * *
WEEKLY_DIGEST_CRON=0 8 * * 0

# From address for all digest emails.
EMAIL_FROM_ADDRESS=noreply@thegrowthproject.app

# Email transport provider: 'resend' | 'sendgrid' | 'postmark' | 'log'
# Default is 'log' (dev/test — emails are logged, not sent).
# Set to a real provider in staging/production and supply the matching key.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# Base URLs for digest email links.
# APP_URL: client-facing CTA and unsubscribe links.
# CONSOLE_URL: coach console CTA links.
APP_URL=https://app.thegrowthproject.app
CONSOLE_URL=https://console.thegrowthproject.app
