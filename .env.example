# Supabase (required)
DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# USDA FoodData Central API key — required at boot.
# Get one at https://fdc.nal.usda.gov/api-key-signup.html (free, 1000 req/hr per key).
# Without this the food search silently returned [] under load — we now fail fast.
USDA_API_KEY=

# Perplexity (AI chat) — optional; chat falls back to deterministic responder if unset.
PERPLEXITY_API_KEY=

# AI Gateway (enterprise foundation — see docs/ai-gateway.md). Default fail
# closed: every gateway call returns a stub "[ai-disabled]" response unless
# the master switch + capability allow-list + provider key are all set.
# Never commit values — these are documentation-only here.
AI_GATEWAY_ENABLED=
AI_GATEWAY_PROVIDER=stub
# Comma-separated allow-list of capability strings, or "*" to allow all.
# Example: AI_GATEWAY_CAPABILITIES=chat.client_self,draft.coach_message
AI_GATEWAY_CAPABILITIES=
# Override default approval set. When unset, consequential capabilities
# (draft.coach_message, draft.meal_plan_change, draft.client_facing_claim,
# flag.escalation) require human approval automatically.
AI_GATEWAY_REQUIRE_APPROVAL=
# Optional provider-specific keys for future adapter implementations.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Deep-link target for Supabase email verification (mobile only).
SUPABASE_REDIRECT_URL=tgp://verified

# Legacy — kept for backwards compatibility with older clients. Not used by auth.
JWT_SECRET=unused-kept-for-legacy-compatibility

# Comma-separated list of allowed browser origins for CORS. Empty = deny all browsers.
# The React Native mobile app does not need this. Set only for web admin/dashboard
# (e.g. the coach console). Wildcard '*' is rejected at boot in any environment —
# always list explicit origins. Required in staging/production by env-validation.
# Example: CORS_ORIGINS=https://console.thegrowthproject.app,https://admin.thegrowthproject.app
CORS_ORIGINS=

# Sentry DSN for server-side error reporting. Required in staging/production
# (env-validation prints a warn on boot when missing in prod) so unhandled
# exceptions and 5xx responses are forwarded to Sentry. Leave unset in dev.
SENTRY_DSN=

# Redis URL backing the rate-limit storage. When set, ThrottlerModule shares
# limit counters across all Fly machines so a credential-stuffing attacker
# cannot multiplex across replicas. When unset (dev/test), the throttler
# falls back to an in-memory tracker. Must be redis:// or rediss://. Required
# in staging/production once the app scales beyond a single machine — see
# README "Rate limiting" and src/throttler/README.md for the named-throttler
# table and env-var reference.
# Example: REDIS_URL=rediss://default:PASSWORD@fly-tgp-redis.upstash.io:6379
REDIS_URL=

# ============================================================
# Rate limiting — Phase 10
# ============================================================
# All rate-limit env vars are optional. Safe defaults are baked in. Override
# only to tighten (lower numbers) or, for load tests only, loosen. All values
# are clamped to [1, max] in code so a typo cannot accidentally open DoS.
# See src/throttler/README.md for the full route table.

# Master kill switch. Set to "off" to disable all throttling. USE ONLY FOR
# LOAD-TEST RUNS AGAINST STAGING — never in production.
# Default: on
RATELIMIT_ENABLED=on

# Global authenticated default: max requests per minute per user-id.
# Applied to every route that carries no explicit @Throttle decorator.
# Default: 300
RATELIMIT_AUTHED_PER_MIN=300

# Global unauthenticated default: max requests per minute per IP.
# Default: 100
RATELIMIT_ANON_PER_MIN=100

# POST /auth/login, /auth/apple, /auth/google — per-minute burst cap per IP.
# Default: 5
AUTH_LOGIN_PER_MIN=5

# POST /auth/login, /auth/apple, /auth/google — per-hour sustained cap per IP.
# Default: 30
AUTH_LOGIN_PER_HOUR=30

# POST /auth/forgot-password — per-hour cap per IP.
# Default: 3
AUTH_PWD_RESET_PER_HOUR=3

# POST /coach/clients/:id/messages — per-minute cap per user.
# Default: 30
COACH_MESSAGES_PER_MIN=30

# PUT /notifications/preferences — per-minute cap per user.
# Default: 30
NOTIF_PREFS_PER_MIN=30

# POST /bloodwork/* — per-minute cap per user (applied when bloodwork module ships).
# Default: 30
BLOODWORK_WRITE_PER_MIN=30

# GET /coach/command-center/* — per-minute cap per user (applied when module ships).
# Default: 60
COACH_CMD_CENTER_PER_MIN=60

# PostHog key + host for product analytics. AnalyticsModule is a no-op when
# unset, so leaving these blank in dev is fine.
POSTHOG_KEY=
POSTHOG_HOST=

# Coach invite-code gate. When "true" the /auth signup endpoints reject
# requests that lack a valid coach invite code. Leave unset in dev.
COACH_CODE_GATE_ENABLED=

PORT=3000
NODE_ENV=development

# Public invite landing — server-rendered HTML at /join/:code and /invite/:code.
# All optional; sane defaults are baked in for dev and the placeholder store
# URLs. Override per environment via Fly secrets.
PUBLIC_INVITE_BASE_URL=https://app.tgp.com/join
PUBLIC_WEB_SIGNUP_URL=
APP_STORE_URL=
PLAY_STORE_URL=

# Stripe (coach SaaS billing). All four are optional in dev — when unset the
# /v1/coach/me/billing endpoint returns an empty mirror, the portal-session
# and start-subscription endpoints return STRIPE_NOT_CONFIGURED, and the
# webhook endpoint refuses every request. Required in production.
# Full setup guide: docs/stripe-setup.md.
# Local replay (no Stripe account needed): scripts/stripe-webhook-smoke.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: incoming Stripe webhook secret during a zero-downtime rotation.
# When set alongside STRIPE_WEBHOOK_SECRET, a request is accepted if it
# verifies against EITHER secret. Procedure: (1) add the new signing secret
# in Stripe dashboard, (2) deploy with both env vars set, (3) flip the
# Stripe endpoint to the new secret, (4) unset STRIPE_WEBHOOK_SECRET_NEXT
# and rotate STRIPE_WEBHOOK_SECRET to the new value. See
# docs/stripe-setup.md §6 for the runbook.
STRIPE_WEBHOOK_SECRET_NEXT=
STRIPE_PRICE_ID_FITNESS=
STRIPE_PRICE_ID_FINANCE=

# Return URL Stripe redirects the coach to after the Customer Portal session
# ends. Optional — defaults to https://console.thegrowthproject.app/billing
# when unset. Set per-environment if the console host differs (e.g. staging).
STRIPE_BILLING_PORTAL_RETURN_URL=

# Hosted Stripe Customer Portal login link (Stripe dashboard → Settings →
# Billing → Customer portal → Login link). Used as a fallback by
# POST /v1/coach/me/billing/portal-session when STRIPE_SECRET_KEY is unset:
# the endpoint returns { url, fallback: true } pointing at this hosted page,
# where the coach authenticates with the email on file with Stripe. When
# STRIPE_SECRET_KEY is set, the per-coach SDK session takes precedence and
# this var is unused. Validated to match https://billing.stripe.com/p/login/.
# Production value lives in Fly secrets; do not commit a real link here.
STRIPE_CUSTOMER_PORTAL_LOGIN_URL=

# ============================================================
# Stripe Connect — Phase 1 (coach payouts)
# ============================================================
# See /CONNECT_MASTER_PLAN.md §Phase 1 and docs/connect-setup.md for the
# one-time Stripe Dashboard setup (Connect → Get started → Express). Until
# Connect is enabled at the platform level, every /v1/connect/* endpoint
# returns 503 with an actionable message — we never serve fake account data.
#
# STRIPE_CONNECT_REFRESH_URL — where Stripe sends the coach if the
# onboarding link expires or they bail mid-flow. Mobile deep link in prod;
# any HTTPS URL acceptable in dev.
# Example: STRIPE_CONNECT_REFRESH_URL=growthproject://connect/onboarding/refresh
STRIPE_CONNECT_REFRESH_URL=

# STRIPE_CONNECT_RETURN_URL — where Stripe sends the coach after Express
# onboarding completes (regardless of pass/fail — we mirror the resulting
# state from the webhook, not from this return).
# Example: STRIPE_CONNECT_RETURN_URL=growthproject://connect/onboarding/return
STRIPE_CONNECT_RETURN_URL=

# --- Stripe Checkout (Connect Phase 2-3) ---
#
# STRIPE_CHECKOUT_SUCCESS_URL — where Stripe redirects the client after
# a successful checkout (their purchase becomes paid/active on the webhook,
# this URL is just a UX redirect). May include the literal placeholder
# {CHECKOUT_SESSION_ID} which Stripe expands. Mobile deep link in prod.
# Example: STRIPE_CHECKOUT_SUCCESS_URL=growthproject://checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_SUCCESS_URL=

# STRIPE_CHECKOUT_CANCEL_URL — where Stripe redirects the client if they
# bail out of the hosted checkout page.
# Example: STRIPE_CHECKOUT_CANCEL_URL=growthproject://checkout/cancel
STRIPE_CHECKOUT_CANCEL_URL=

# Required webhook events to subscribe in the Stripe Dashboard (in addition
# to Phase 1's account.*):
#   checkout.session.completed
#   checkout.session.expired
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   payment_intent.payment_failed
#   invoice.paid
#   invoice.payment_failed
#   customer.updated
#
# Webhook secret is the existing STRIPE_WEBHOOK_SECRET — same endpoint
# receives all event types.

# --- Stripe Connect Phase 4-5 (fee split + dunning) ---
#
# No env vars are introduced for Phase 4-5. The fee split policy
# (default 2% platform + 5% head-coach) lives in code (see
# src/connect/fees/fee-policy.service.ts) and can be overridden per
# coach via the FeePolicy table — operator writes via
# PATCH /v1/admin/payments/coaches/:id/fee-policy.
#
# Stripe Dashboard configuration required for Phase 4-5:
#   - Subscribe to the additional webhook events:
#       charge.refunded                    (refund -> ledger reversal)
#       charge.refund.updated              (partial refund state)
#       transfer.created                   (informational only)
#       transfer.reversed                  (head-coach reversal mirror)
#   - Enable "Transfer/payout schedule = manual" if you want platform
#     to control head-coach payout cadence; default automatic is fine.
#   - The platform account must hold a non-zero balance in the same
#     currency as packages to mint follow-on Transfers (or use
#     source_transaction which is what we do — funds come from the
#     parent charge).
#
# Operationally:
#   - The dunning sweeper + transfer retry sweeper are exposed under
#     POST /v1/admin/payments/dunning/run-sweeper and
#     POST /v1/admin/payments/transfers/run-sweeper. Schedule via
#     external cron or NestJS @Cron if desired.

# SubscriptionGuard rollout flag. Leave unset (or set to "observe") during
# rollout — the guard will run but allow every request. Set to "enforce" once
# Stripe is live and every coach has a CoachSubscription row.
# Default (unset / anything other than "enforce") = observe-only.
BILLING_ENFORCEMENT=

# Finance backend federation. All optional — when unset, the OWNER
# /admin/federation/* endpoints return fitness-only payloads with
# finance.status="not_configured". No fake data is ever substituted.
# See src/admin/federation/README.md for the full contract.
#
# FINANCE_SERVICE_TOKEN is used in both directions:
#   - Outbound: sent as a bearer token on calls FROM this backend TO the
#     finance backend (/api/admin/federation/*).
#   - Inbound: expected as a bearer token on calls FROM the finance backend
#     TO POST /api/admin/federation/ptm-signal (the finance-to-fitness PTM
#     signal endpoint). The endpoint returns 503 FEDERATION_DISABLED when
#     this variable is unset — fail-closed behaviour.
#
# Audit fix H-2 (2026-05-09): the variable name is canonical on both
# backends — same name, same value. The legacy `FEDERATION_SERVICE_TOKEN`
# alias has been removed; if you have a runbook still naming it, update
# the runbook. A stale alias on either side caused federation to silently
# degrade (auth_unconfigured / 503 FEDERATION_DISABLED) which was the
# original reason for this fix.
#
# Must be set under the SAME name on both backends. Provision with:
#   openssl rand -hex 32
FINANCE_API_BASE_URL=
FINANCE_SERVICE_TOKEN=
FINANCE_FEDERATION_TIMEOUT_MS=

# FINANCE_SERVICE_TOKEN_NEXT — dual-secret rotation for the inbound
# federation bearer (`POST /api/admin/federation/ptm-signal`). Mirrors
# the `STRIPE_WEBHOOK_SECRET_NEXT` rotation pattern shipped in PR #199.
#
# When set alongside `FINANCE_SERVICE_TOKEN`, a request is accepted if
# the bearer matches EITHER. A `_NEXT` match emits a structured log
# line `event=federation.auth.next-secret-used` so operators can confirm
# the new token is in use before promoting it. Leave unset in steady
# state.
#
# Rotation playbook (zero-downtime, no two-app coordination needed):
#   1. Generate a new token (`openssl rand -hex 32`). Set
#      `FINANCE_SERVICE_TOKEN_NEXT=<new>` on this app AND set
#      `FINANCE_SERVICE_TOKEN=<new>` on the finance app. Both deploy.
#   2. Confirm `event=federation.auth.next-secret-used` shows up in
#      this app's logs — that's the finance app authenticating with the
#      new token.
#   3. Promote: set `FINANCE_SERVICE_TOKEN=<new>` on this app and clear
#      `FINANCE_SERVICE_TOKEN_NEXT`. Redeploy. The old token is now
#      revoked everywhere.
FINANCE_SERVICE_TOKEN_NEXT=

# Self-service /auth/become-coach hard gate. Unset (or anything other than
# "true") = endpoint refuses with 403 self_service_promotion_disabled. Set to
# "true" only for legacy migrations where you knowingly want any logged-in
# user to self-elevate after a password re-auth.
ALLOW_SELF_SERVICE_BECOME_COACH=

# GDPR scrub worker controls (script: scripts/gdpr-scrub.ts).
# - GDPR_SCRUB_DRY_RUN=true reports candidate rows without writing deleted_at
#   or zeroing PII. Default = real scrub.
# - GDPR_SCRUB_BATCH_LIMIT caps the per-run row count. Defaults to 100.
GDPR_SCRUB_DRY_RUN=
GDPR_SCRUB_BATCH_LIMIT=

# ============================================================
# PTM (Predictive Tracking Model) — Phase 1
# ============================================================
# All PTM env vars are optional. Sensible defaults ship in code; override
# only to disable, retune, or troubleshoot. See src/ptm/README.md and
# docs/ptm.md for the full doctrine.

# Master kill switch. When "false" the nightly recompute cron and the
# admin teaching endpoints are disabled. Signal collection itself
# (PtmService.recordSignal) keeps writing rows so no data is lost while
# the engine is off. Defaults to true.
PTM_SCORING_ENABLED=true

# Cron expression (UTC) for the nightly PTM recompute. Defaults to
# "0 4 * * *" (04:00 UTC, 1h after the GDPR scrub at 03:00 UTC) to keep
# the two write-heavy jobs from competing for the connection pool.
PTM_SCORING_CRON=0 4 * * *

# Per-run cap on the number of clients the nightly cron will recompute.
# Defaults to 5000; clamped to [1, 50000]. Larger rosters are processed
# across multiple nights via a stable cursor on (last_computed_at, user_id).
PTM_RECOMPUTE_BATCH_LIMIT=5000

# Minimum number of labelled ClientOutcome rows before the weighted v2
# engine activates. Defaults to 20. Below this threshold every recompute
# uses heuristic_v1 (the hand-tuned engine).
PTM_WEIGHTED_ACTIVATION_OUTCOMES=20

# Default page size for GET /admin/ptm/risk-board. Defaults to 50;
# clamped to [1, 100] regardless of the caller-supplied limit.
PTM_RISK_BOARD_PAGE_SIZE=50

# Phase 3 — diagnostic + AI roadmap. Set to "false" to skip Perplexity
# calls and store a placeholder roadmap (used in CI and preview deploys
# that do not have a Perplexity key). Defaults to true.
DIAGNOSTIC_AI_ENABLED=true

# Per-IP hourly cap on POST /diagnostic/submit. Defaults to 5; clamped to
# [1, 1000]. The endpoint is unauthenticated by design (lead capture),
# so the rate limit is the primary defense against bulk-stuffing.
DIAGNOSTIC_RATE_LIMIT_PER_HOUR=5

# Phase 4 — Build Week feature flag. Set to "false" to disable writes to
# the Build Week controllers and zero the admin funnel. Defaults to true.
BUILD_WEEK_ENABLED=true

# Phase 4 — when "true", new client signups auto-enrol in Build Week.
# Defaults to false. Wiring is a follow-on PR; this PR exposes the flag
# so deployment configs can be staged ahead of the implementation.
BUILD_WEEK_AUTO_START_ON_SIGNUP=false

# Phase 7C — Peer Leaderboard.
# Kill switch: set to "off" to disable all leaderboard reads and writes.
# Defaults to "on".
LEADERBOARD_ENABLED=on

# Cron expression (UTC) for the nightly combined-score recompute across all
# opted-in users. Runs at 06:00 UTC by default (one hour after the Coach
# Effectiveness scheduler at 05:00 UTC) to avoid database contention.
# Override with any valid 5-field cron expression.
LEADERBOARD_RECOMPUTE_CRON=0 6 * * *

# ============================================================
# Phase 9 — Notifications Matrix
# ============================================================
# Email digest controls. Set EMAIL_DIGEST_*_ENABLED=off to disable
# sending for that role. Defaults are 'on'.
EMAIL_DIGEST_CLIENT_ENABLED=on
EMAIL_DIGEST_COACH_ENABLED=on

# Cron schedules for digest emails (UTC). All accept 5-field cron expressions.
# Default: client daily 07:00 UTC, coach daily 06:00 UTC, weekly Sunday 08:00 UTC.
CLIENT_DAILY_CRON=0 7 * * *
COACH_DAILY_CRON=0 6 * * *
WEEKLY_DIGEST_CRON=0 8 * * 0

# From address for all digest emails.
EMAIL_FROM_ADDRESS=noreply@thegrowthproject.app

# Email transport provider: 'resend' | 'log'
# Default is 'log' (dev/test — emails are logged, not sent).
# In staging/production set EMAIL_TRANSPORT=resend AND set RESEND_API_KEY +
# EMAIL_FROM_ADDRESS to a domain you have verified with Resend (DKIM + SPF +
# DMARC). When EMAIL_TRANSPORT=resend with no RESEND_API_KEY the app refuses
# to boot — no fake email success. See README §Resend setup.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
# Legacy provider keys retained only for the digest service's historical
# 'sendgrid' / 'postmark' branches. EmailService (the new launch path)
# accepts 'resend' or 'log' only.
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# Base URLs for digest email links.
# APP_URL: client-facing CTA and unsubscribe links.
# CONSOLE_URL: coach console CTA links.
APP_URL=https://app.thegrowthproject.app
CONSOLE_URL=https://console.thegrowthproject.app

# ============================================================
# Sprint B — Coach toolset (workout builder + insights)
# ============================================================
# RapidAPI key for exercisedb.p.rapidapi.com — required for the
# /exercises/* routes (ExerciseLibraryModule). When unset, the workout
# builder falls back to the in-process seed catalog (see
# src/exercise-library/seed-catalog.ts) so dev/preview boots cleanly.
EXERCISEDB_API_KEY=
EXERCISEDB_API_HOST=exercisedb.p.rapidapi.com

# ============================================================
# Video library v1 (Mux) — /exercise-catalog + /v1/webhooks/mux
# ============================================================
# Mux is OPTIONAL for read endpoints — /exercise-catalog list + detail
# work without it (detail just returns `playbackUrl: null`). Mux is
# REQUIRED for owner-side ingest: POST /admin/exercise-catalog/:id/video/upload
# and PUT /admin/exercise-catalog/:id/video both 503 with
# `{ error: 'mux_disabled', action: '...' }` when these are unset.
# Get tokens at https://dashboard.mux.com/settings/access-tokens
# (scope: Mux Video — Read + Write).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Webhook signing secret from https://dashboard.mux.com/settings/webhooks.
# POST /v1/webhooks/mux verifies the `Mux-Signature` header against this
# secret and rejects mismatches with 400. Unset means the webhook
# endpoint rejects every request — Mux can't notify ready/errored.
MUX_WEBHOOK_SECRET=
# Optional. Required ONLY when an exercise's playback policy is `signed`.
# v1 defaults newly-attached assets to `public`, so most deploys can
# leave these blank. The key id is a short token (e.g. "AbCdEf123") and
# the private key is the PEM contents (base64-wrapped is also accepted).
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# ============================================================
# Team Mode (ADR-0001 §10) — sub-coach billing + tier gate
# ============================================================
# Stripe price ids that the tier resolver maps to the canonical
# tier labels (growth | pro | enterprise). The resolver compares
# CoachSubscription.stripe_price_id to these env values; an
# unconfigured or unmatched price id resolves to "unknown" and
# the team-mode controllers deny by default.
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Recurring price id used to bill a Pro head coach for each
# sub-coach they assign. One Stripe subscription_item per
# sub-coach (quantity=1) so a removal can DELETE the item
# directly. Enterprise does not use this — staff seats are
# included on Enterprise. Leave blank in dev / preview to skip
# the outbound Stripe call (the assignment row + audit events
# still land locally).
STRIPE_PRICE_STAFF_SEAT=

# ============================================================
# Concierge scheduling (PR #142) — Google Calendar OAuth + flags
# ============================================================
# Phase 2 master switch for Google Calendar sync. Defaults to "false"
# (Phase 1 ships TGP-exclusive scheduling — open slots, overrides, and
# session bookings are computed from TGP state alone).
# When "false": GoogleOAuthService.isConfigured() returns false
# regardless of the OAUTH credentials below, all GoogleCalendarService
# methods short-circuit to NOT_CONFIGURED, and /scheduling/auth/google/*
# + /webhooks/google-calendar endpoints respond 404 (feature truly not
# available, not "configured but broken"). Flip to "true" per
# environment once the Google project has passed verification and the
# per-coach connection UI is shipped. See RFC 142 addendum.
FEATURE_GOOGLE_CALENDAR_SYNC=false

# Legacy master switch from PR #142 — retained for the stub-adapter
# fallback path. When unset or != "true", the scheduling module falls
# back to the stub calendar adapter for write paths regardless of the
# feature flag above.
GOOGLE_CALENDAR_ENABLED=

# OAuth client credentials for the Calendar API. These come from a
# Google Cloud project the user (Bradley) is provisioning via Pipedream;
# the values will land in Fly secrets when the project is verified.
# Leave blank for dev/preview — the OAuth controller short-circuits to
# a 503 envelope when these are missing.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public-facing redirect URI registered with the Google project. Must
# match the value configured in the GCP OAuth consent screen.
# Production:  https://api.thegrowthproject.app/scheduling/auth/google/callback
# Preview:     https://<preview-host>/scheduling/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Scopes the OAuth flow requests. Calendar read+write is sensitive and
# triggers Google verification before public launch; testing mode
# allows up to 100 users without verification. Comma-separated; spaces
# stripped by the loader. Defaults to read+write events on the
# primary calendar.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events

# Reserved — video provider flags (Google Meet, Zoom). Concierge v1
# does NOT mint video links; coaches paste their own (Zoom personal
# room, Whereby, FaceTime) into the session "video_url" field. The
# real adapters land in a follow-up.
GOOGLE_MEET_ENABLED=
ZOOM_ENABLED=
ZOOM_OAUTH_ACCOUNT_ID=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=

# At-rest encryption (KMS) for sensitive fields:
#   - BloodworkPanel.notes / BloodworkPanel.review_note
#   - CalendarConnection.encrypted_refresh_token
#
# Provider selection. Only "local" is implemented in this PR (AES-256-GCM
# keyed by KMS_MASTER_KEY). "aws" reserved for a follow-up that adds
# @aws-sdk/client-kms; the application falls back to "local" if unset.
KMS_PROVIDER=local
# Opaque labels persisted into BloodworkPanel.encryption_key_ref and
# BloodworkPanel.kms_key_version on every encrypted write. Lets ops
# trace which key encrypted which row when rotating.
KMS_KEY_ALIAS=local:v1
KMS_KEY_VERSION=1
# 32-byte symmetric key, base64-encoded. When unset, KmsService falls
# back to writing a "PLAINTEXT:" prefix so dev runs without secrets do
# not crash; isConfigured() returns false in that case.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_MASTER_KEY=
# Reserved — AWS KMS provider. Not consumed in this PR.
AWS_KMS_KEY_ID=
# ============================================================
# Phase 10 — Observability
# ============================================================
# All observability vars are optional with safe defaults. See
# src/observability/README.md for the full doctrine.

# Minimum log level: error | warn | log | debug | verbose.
# In production "warn" reduces volume once the system is stable.
# Defaults to "log".
LOG_LEVEL=log

# Log output format: "json" for Fly/Datadog/Better Stack, "pretty" for dev.
# Defaults to "json". Override to "pretty" in local dev if preferred.
LOG_FORMAT=json

# Enable/disable the Prometheus /metrics endpoint and in-process counters.
# "on" (default) enables. "off" disables the endpoint entirely.
METRICS_ENABLED=on

# Fraction of transactions sampled for Sentry Performance (0.0–1.0).
# Errors are always captured at 1.0 regardless of this setting.
# Defaults to 0.1 (10%). Increase once traffic baselines are established.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable the /debug/profile CPU profiler (OWNER role + this flag required).
# Defaults to "off". Leave "off" in production — the endpoint blocks Node.js
# for 30 seconds. Flip to "on" only while actively profiling.
PROFILE_ENABLED=off

# ============================================================
# Rate limiting — Phase 10
# ============================================================
# All rate-limit env vars are optional. Safe defaults are baked in. Override
# only to tighten (lower numbers) or, for load tests only, loosen. All values
# are clamped to [1, max] in code so a typo cannot accidentally open DoS.
# See src/throttler/README.md for the full route table.

# Master kill switch. Set to "off" to disable all throttling. USE ONLY FOR
# LOAD-TEST RUNS AGAINST STAGING — never in production.
# Default: on
RATELIMIT_ENABLED=on

# Global authenticated default: max requests per minute per user-id.
# Applied to every route that carries no explicit @Throttle decorator.
# Default: 300
RATELIMIT_AUTHED_PER_MIN=300

# Global unauthenticated default: max requests per minute per IP.
# Default: 100
RATELIMIT_ANON_PER_MIN=100

# POST /auth/login, /auth/apple, /auth/google — per-minute burst cap per IP.
# Default: 5
AUTH_LOGIN_PER_MIN=5

# POST /auth/login, /auth/apple, /auth/google — per-hour sustained cap per IP.
# Default: 30
AUTH_LOGIN_PER_HOUR=30

# POST /auth/forgot-password — per-hour cap per IP.
# Default: 3
AUTH_PWD_RESET_PER_HOUR=3

# POST /coach/clients/:id/messages — per-minute cap per user.
# Default: 30
COACH_MESSAGES_PER_MIN=30

# PUT /notifications/preferences — per-minute cap per user.
# Default: 30
NOTIF_PREFS_PER_MIN=30

# POST /bloodwork/* — per-minute cap per user (applied when bloodwork module ships).
# Default: 30
BLOODWORK_WRITE_PER_MIN=30

# GET /coach/command-center/* — per-minute cap per user (applied when module ships).
# Default: 60
COACH_CMD_CENTER_PER_MIN=60

# ─── Phase 10 — GDPR right to erasure (account-deletion module) ───────────────
#
# DELETION_GRACE_DAYS: calendar days between email confirmation and final PII
# scrub. GDPR "without undue delay" guidance is satisfied by 14 days; do not
# set below 3 (the minimum to give users a real cancel window).
DELETION_GRACE_DAYS=14

# DELETION_FINALIZE_CRON: cron expression for the nightly finalize job that
# scrubs PII on accounts whose grace period has expired. Runs at 03:00 UTC by
# default, one hour before the PTM recompute (04:00 UTC). Change this only if
# you have a maintenance window constraint.
DELETION_FINALIZE_CRON=0 3 * * *

# DELETION_TOKEN_TTL_HOURS: how long the email confirmation link is valid.
# Expired tokens are rejected — the user must re-request. 24 hours is the
# recommended minimum; do not set below 1.
DELETION_TOKEN_TTL_HOURS=24

# ─── Data Export (GDPR Article 20 — right to data portability) ───────────────
# Required in production: signs the 7-day download JWT. Must be at least 32
# characters. Leave unset in dev to use the insecure placeholder default.
DATA_EXPORT_TOKEN_SECRET=

# S3-compatible bucket for export files. When unset the module falls back to
# local filesystem (DATA_EXPORT_FS_DIR). Required in production.
# The bucket should have a lifecycle rule deleting objects under exports/ after
# 8 days as a belt-and-braces measure alongside the nightly cleanup cron.
DATA_EXPORT_BUCKET=

# Custom S3 endpoint for Fly / MinIO. Leave unset to use AWS default.
DATA_EXPORT_S3_ENDPOINT=

# Local filesystem fallback directory. Only used when DATA_EXPORT_BUCKET is unset.
# NOT suitable for production (no HA, cleared on machine restart).
DATA_EXPORT_FS_DIR=/tmp/exports

# Days a download link remains valid after the export completes. Defaults to 7.
DATA_EXPORT_EXPIRY_DAYS=7

# Hours between data export requests per user. Defaults to 24.
DATA_EXPORT_RATE_LIMIT_HRS=24

# SMTP settings for the "your export is ready" email.
# When SMTP_HOST is unset the module logs the download URL instead (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Growth Project" <no-reply@thegrowthproject.app>

# ============================================================
# Phase 10 — Audit logging
# ============================================================
# Kill switch. Set to "off" to disable all audit writes without removing
# call sites (useful for short-lived debugging windows only). Safe default
# is "on". Audit reads are unaffected — the existing log rows are still
# queryable by owners when this is off.
AUDIT_LOGGING_ENABLED=on

# ============================================================
# Phase 10 — Secrets Rotation (JWT dual-key support)
# ============================================================
# These two vars support zero-downtime JWT signing key rotation.
# See docs/runbooks/secrets-rotation.md and src/auth/README.md for
# the full dual-key rotation playbook.
#
# JWT_SIGNING_KEY: the current HMAC-SHA256 signing key. New tokens are
#   signed with this key. Generate with: openssl rand -hex 32
#   Set in Fly secrets: flyctl secrets set JWT_SIGNING_KEY=<value> -a backend-spring-lake-3890
#
# JWT_SIGNING_KEY_PREVIOUS: the old signing key, accepted during a 24-hour
#   transition window. Set this to the old value of JWT_SIGNING_KEY when you
#   rotate. Clear it after 24 hours:
#   flyctl secrets unset JWT_SIGNING_KEY_PREVIOUS -a backend-spring-lake-3890
#
# Both are optional (feature tier). When unset, the app uses Supabase's
# JWKS-based JWT verification for all user tokens (the standard path).
JWT_SIGNING_KEY=
JWT_SIGNING_KEY_PREVIOUS=
# ── Phase 10 — Re-auth hardening ─────────────────────────────────────────────
#
# RECENT_AUTH_SECRET: HMAC signing secret for short-lived re-auth tokens.
# Required when any endpoint uses RecentAuthGuard. Must be at least 32
# characters. Generate with: openssl rand -hex 32
# Never commit the real value — use a secrets manager in production.
RECENT_AUTH_SECRET=

# RECENT_AUTH_TTL_MS: Validity window in milliseconds for re-auth tokens.
# Default is 300000 (5 minutes). Reduce for higher-security environments.
# Applies to: DELETE /users/me/account, POST /admin/users/:id/promote,
#             POST /admin/gdpr/scrub, and any other RecentAuthGuard route.
RECENT_AUTH_TTL_MS=300000
