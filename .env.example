# Supabase (required)
DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# USDA FoodData Central API key — required at boot.
# Get one at https://fdc.nal.usda.gov/api-key-signup.html (free, 1000 req/hr per key).
# Without this the food search silently returned [] under load — we now fail fast.
USDA_API_KEY=

# Perplexity (AI chat) — optional; chat falls back to deterministic responder if unset.
PERPLEXITY_API_KEY=

# Deep-link target for Supabase email verification (mobile only).
SUPABASE_REDIRECT_URL=tgp://verified

# Legacy — kept for backwards compatibility with older clients. Not used by auth.
JWT_SECRET=unused-kept-for-legacy-compatibility

# Comma-separated list of allowed browser origins for CORS. Empty = deny all browsers.
# The React Native mobile app does not need this. Set only for web admin/dashboard
# (e.g. the coach console). Wildcard '*' is rejected at boot in any environment —
# always list explicit origins. Required in staging/production by env-validation.
# Example: CORS_ORIGINS=https://console.thegrowthproject.app,https://admin.thegrowthproject.app
CORS_ORIGINS=

# Sentry DSN for server-side error reporting. Required in staging/production
# (env-validation prints a warn on boot when missing in prod) so unhandled
# exceptions and 5xx responses are forwarded to Sentry. Leave unset in dev.
SENTRY_DSN=

# PostHog key + host for product analytics. AnalyticsModule is a no-op when
# unset, so leaving these blank in dev is fine.
POSTHOG_KEY=
POSTHOG_HOST=

# Coach invite-code gate. When "true" the /auth signup endpoints reject
# requests that lack a valid coach invite code. Leave unset in dev.
COACH_CODE_GATE_ENABLED=

PORT=3000
NODE_ENV=development

# Public invite landing — server-rendered HTML at /join/:code and /invite/:code.
# All optional; sane defaults are baked in for dev and the placeholder store
# URLs. Override per environment via Fly secrets.
PUBLIC_INVITE_BASE_URL=https://app.tgp.com/join
PUBLIC_WEB_SIGNUP_URL=
APP_STORE_URL=
PLAY_STORE_URL=

# Stripe (coach SaaS billing). All four are optional in dev — when unset the
# /v1/coach/me/billing endpoint returns an empty mirror, the portal-session
# and start-subscription endpoints return STRIPE_NOT_CONFIGURED, and the
# webhook endpoint refuses every request. Required in production.
# Full setup guide: docs/stripe-setup.md.
# Local replay (no Stripe account needed): scripts/stripe-webhook-smoke.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_FITNESS=
STRIPE_PRICE_ID_FINANCE=

# Return URL Stripe redirects the coach to after the Customer Portal session
# ends. Optional — defaults to https://console.thegrowthproject.app/billing
# when unset. Set per-environment if the console host differs (e.g. staging).
STRIPE_BILLING_PORTAL_RETURN_URL=

# SubscriptionGuard rollout flag. Leave unset (or set to "observe") during
# rollout — the guard will run but allow every request. Set to "enforce" once
# Stripe is live and every coach has a CoachSubscription row.
# Default (unset / anything other than "enforce") = observe-only.
BILLING_ENFORCEMENT=

# Finance backend federation (admin console only). All optional — when
# unset, the OWNER /admin/federation/* endpoints return fitness-only
# payloads with finance.status="not_configured". No fake data is ever
# substituted. See src/admin/federation/README.md for the full contract.
FINANCE_API_BASE_URL=
FINANCE_SERVICE_TOKEN=
FINANCE_FEDERATION_TIMEOUT_MS=
