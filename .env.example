DATABASE_URL=postgresql://postgres:your-db-password-here@your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_REDIRECT_URL=tgp://verified
PERPLEXITY_API_KEY=your-perplexity-api-key-here
USDA_API_KEY=your-usda-api-key-here
JWT_SECRET=unused-kept-for-legacy-compatibility
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS. Empty = deny all browsers.
# The React Native mobile app does not need this. Set only for web admin/dashboard.
# Example: CORS_ORIGINS=https://admin.yoursite.com,https://app.yoursite.com
CORS_ORIGINS=
