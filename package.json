{
  "name": "growth-project-backend",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "env:check": "ts-node -e \"require('./src/common/env-validation').assertEnv()\"",
    "secrets:print": "ts-node scripts/print-required-secrets.ts",
    "secrets:print:fly": "FORMAT=fly ts-node scripts/print-required-secrets.ts",
    "secrets:missing": "FORMAT=missing ts-node scripts/print-required-secrets.ts",
    "smoke": "ts-node scripts/smoke.ts",
    "smoke:staging": "SMOKE_BASE_URL=${SMOKE_BASE_URL:-https://api-staging.thegrowthproject.app} ts-node scripts/smoke.ts",
    "smoke:admin-federation": "ts-node scripts/admin-federation-smoke.ts",
    "openapi:export": "ts-node scripts/export-openapi.ts",
    "backfill:coach-subscriptions": "ts-node scripts/backfill-coach-subscriptions.ts"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^5.0.0",
    "@sentry/node": "~10.51.0",
    "@supabase/supabase-js": "^2.104.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "openai": "^4.0.0",
    "pdfkit": "^0.15.2",
    "posthog-node": "^5.30.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^30.3.0",
    "prisma": "^5.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
