{
  "name": "growth-project-backend",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "env:check": "ts-node -e \"require('./src/common/env-validation').assertEnv()\"",
    "secrets:print": "ts-node scripts/print-required-secrets.ts",
    "secrets:print:fly": "FORMAT=fly ts-node scripts/print-required-secrets.ts",
    "secrets:missing": "FORMAT=missing ts-node scripts/print-required-secrets.ts",
    "smoke": "ts-node scripts/smoke.ts",
    "smoke:staging": "SMOKE_BASE_URL=${SMOKE_BASE_URL:-https://api-staging.thegrowthproject.app} ts-node scripts/smoke.ts",
    "smoke:admin-federation": "ts-node scripts/admin-federation-smoke.ts",
    "openapi:export": "ts-node scripts/export-openapi.ts",
    "backfill:coach-subscriptions": "ts-node scripts/backfill-coach-subscriptions.ts",
    "seed:foods": "ts-node prisma/seed-foods.ts",
    "seed:exercise-catalog": "ts-node scripts/seed-exercise-catalog.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^5.0.0",
    "@sentry/node": "~10.53.1",
    "@supabase/supabase-js": "^2.106.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "expo-server-sdk": "^3.7.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "openai": "^4.0.0",
    "pdfkit": "^0.15.2",
    "posthog-node": "^5.33.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.23",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/passport-jwt": "^4.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "prisma": "^5.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "qs": "6.15.2",
    "diff": "^9.0.0",
    "minimatch": "^9.0.7"
  }
}
