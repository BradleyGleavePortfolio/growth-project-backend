{
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "properties": {
          "code": {
            "description": "Machine-readable failure discriminant, present only when the handler set one (e.g. `extension_refresh_invalid`, `invalid`). Absent for generic validation/guard errors.",
            "example": "invalid",
            "type": "string"
          },
          "error": {
            "description": "Short error class name (Nest default), e.g. `Bad Request`, `Unauthorized`.",
            "example": "Bad Request",
            "type": "string"
          },
          "message": {
            "description": "Human-readable message. A single string for most errors; an array of strings when the global ValidationPipe reports one entry per failed constraint.",
            "example": "Invalid pairing code.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "path": {
            "description": "Request path the error occurred on.",
            "example": "/api/scout/ingest",
            "type": "string"
          },
          "request_id": {
            "description": "Correlation id from RequestIdMiddleware; omitted when absent.",
            "example": "5f2c9b1e-6d3a-4c8b-9f0e-1a2b3c4d5e6f",
            "type": "string"
          },
          "statusCode": {
            "description": "HTTP status code, echoed in the body.",
            "example": 400,
            "type": "number"
          },
          "timestamp": {
            "description": "ISO-8601 instant the error envelope was built.",
            "example": "2026-07-13T18:30:00.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error",
          "timestamp",
          "path"
        ],
        "type": "object"
      },
      "ExtensionRefreshDto": {
        "properties": {
          "refresh_token": {
            "description": "Supabase refresh token issued by /auth/extension/login",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "type": "object"
      },
      "ExtensionRefreshResult": {
        "properties": {
          "access_token": {
            "description": "Rotated Supabase access token.",
            "type": "string"
          },
          "expires_at": {
            "description": "Absolute expiry as a unix timestamp (seconds).",
            "example": 1752086400,
            "type": "number"
          },
          "expires_in": {
            "description": "Access-token lifetime in seconds.",
            "example": 3600,
            "type": "number"
          },
          "refresh_token": {
            "description": "Rotated Supabase refresh token.",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "type": "object"
      },
      "PairInitDto": {
        "properties": {
          "chosen_platform": {
            "description": "Source coaching platform the coach is migrating from. Lowercase slug driven by the extension ROADMAP matrix (truecoach, trainerize, mypthub, …).",
            "example": "truecoach",
            "type": "string"
          }
        },
        "required": [
          "chosen_platform"
        ],
        "type": "object"
      },
      "PairInitResult": {
        "properties": {
          "expires_at": {
            "description": "ISO-8601 instant the code expires (short TTL, DESIGN §4).",
            "example": "2026-07-09T18:35:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "pairing_code": {
            "description": "6-digit numeric pairing code the coach reads out to the extension.",
            "example": "142856",
            "type": "string"
          }
        },
        "required": [
          "pairing_code",
          "expires_at"
        ],
        "type": "object"
      },
      "PairRedeemDto": {
        "properties": {
          "code": {
            "description": "6-digit numeric pairing code minted by POST /api/extension/pair/init.",
            "example": "142856",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "PairRedeemResult": {
        "properties": {
          "access_token": {
            "description": "Coach-bound Supabase access token.",
            "type": "string"
          },
          "chosen_platform": {
            "description": "Source platform the code was minted for (echoed to the extension).",
            "example": "truecoach",
            "type": "string"
          },
          "refresh_token": {
            "description": "Coach-bound Supabase refresh token.",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "chosen_platform"
        ],
        "type": "object"
      },
      "PairStatusDto": {
        "properties": {
          "code": {
            "description": "6-digit numeric pairing code to poll (the code the caller minted).",
            "example": "142856",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "PairStatusResult": {
        "properties": {
          "status": {
            "description": "Lifecycle state of the polled code.",
            "enum": [
              "pending",
              "paired",
              "expired"
            ],
            "example": "pending",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "RateLimitError": {
        "properties": {
          "error": {
            "description": "Always `Too Many Requests`.",
            "example": "Too Many Requests",
            "type": "string"
          },
          "message": {
            "description": "Generic backoff message (never echoes input or which limit fired).",
            "example": "Too many attempts. Please wait before trying again.",
            "type": "string"
          },
          "retryAfter": {
            "description": "Seconds to wait before retrying; matches the `Retry-After` header.",
            "example": 3600,
            "type": "number"
          },
          "statusCode": {
            "description": "Always 429.",
            "example": 429,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "retryAfter"
        ],
        "type": "object"
      },
      "ScoutCompleteDto": {
        "properties": {
          "error_summary": {
            "description": "Human-readable summary for partial/failed runs.",
            "maxLength": 2000,
            "type": "string"
          },
          "final_counts": {
            "additionalProperties": true,
            "description": "Optional per-entity final tally.",
            "type": "object"
          },
          "intent_id": {
            "description": "Crawl session id (snake_case outer envelope).",
            "example": "intent_2026_07_09_abc123",
            "maxLength": 128,
            "type": "string"
          },
          "terminal_status": {
            "description": "Terminal state the crawl settled into.",
            "enum": [
              "success",
              "partial",
              "failed"
            ],
            "example": "success",
            "type": "string"
          }
        },
        "required": [
          "intent_id",
          "terminal_status"
        ],
        "type": "object"
      },
      "ScoutCompleteResult": {
        "properties": {
          "acknowledged": {
            "description": "Always true on a successful (idempotent) settle.",
            "example": true,
            "type": "boolean"
          },
          "intent_id": {
            "description": "The intent id that was settled.",
            "example": "intent_2026_07_09_abc123",
            "type": "string"
          }
        },
        "required": [
          "acknowledged",
          "intent_id"
        ],
        "type": "object"
      },
      "ScoutEntityDto": {
        "properties": {
          "capturedAt": {
            "description": "Strict ISO-8601 timestamp with a mandatory \"T\" separator (new Date().toISOString()).",
            "example": "2026-07-09T18:30:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "description": "Opaque source record. Extractor-specific fields are preserved verbatim; the server strips a credential/prototype-pollution denylist before persistence.",
            "type": "object"
          },
          "sourceId": {
            "description": "Stable per-record id from the source platform (camelCase, top-level provenance).",
            "example": "tc_client_9f831",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "sourcePlatform": {
            "description": "Slug of the platform the record was captured from (camelCase, top-level).",
            "example": "truecoach",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "sourcePlatform",
          "capturedAt",
          "payload"
        ],
        "type": "object"
      },
      "ScoutImportEntityCountDto": {
        "properties": {
          "committed": {
            "description": "Entities actually committed (proof, not an estimate).",
            "minimum": 0,
            "type": "number"
          },
          "entity_type": {
            "description": "Entity family.",
            "example": "clients",
            "type": "string"
          }
        },
        "required": [
          "entity_type",
          "committed"
        ],
        "type": "object"
      },
      "ScoutImportStatusResult": {
        "properties": {
          "completed_at": {
            "description": "Settled at (ISO-8601); null while running.",
            "nullable": true,
            "type": "object"
          },
          "entity_counts": {
            "description": "Committed counts per entity.",
            "items": {
              "$ref": "#/components/schemas/ScoutImportEntityCountDto"
            },
            "type": "array"
          },
          "intent_id": {
            "description": "The intent id that was read.",
            "type": "string"
          },
          "started_at": {
            "description": "First observed (ISO-8601), if known.",
            "nullable": true,
            "type": "object"
          },
          "status": {
            "description": "Proven lifecycle state.",
            "enum": [
              "running",
              "success",
              "partial",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "intent_id",
          "status",
          "entity_counts",
          "started_at",
          "completed_at"
        ],
        "type": "object"
      },
      "ScoutIngestDto": {
        "properties": {
          "entities": {
            "description": "Crawled records for this batch (1..500).",
            "items": {
              "$ref": "#/components/schemas/ScoutEntityDto"
            },
            "maxItems": 500,
            "minItems": 1,
            "type": "array"
          },
          "entity_type": {
            "description": "Entity family carried by this batch (e.g. clients, workouts, library).",
            "example": "clients",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "intent_id": {
            "description": "Idempotency scope for this crawl session (snake_case outer envelope).",
            "example": "intent_2026_07_09_abc123",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "intent_id",
          "entity_type",
          "entities"
        ],
        "type": "object"
      },
      "ScoutIngestResult": {
        "properties": {
          "deduped": {
            "description": "Entities that produced no new row (idempotent replay).",
            "example": 3,
            "type": "number"
          },
          "received": {
            "description": "Entities in the accepted envelope.",
            "example": 42,
            "type": "number"
          }
        },
        "required": [
          "received",
          "deduped"
        ],
        "type": "object"
      },
      "ScoutProgressDto": {
        "properties": {
          "deviceId": {
            "description": "Client-minted stable device id (camelCase); part of the progress storage key.",
            "example": "dev_5f2c",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "intent_id": {
            "description": "Crawl session id (snake_case outer envelope).",
            "example": "intent_2026_07_09_abc123",
            "maxLength": 128,
            "type": "string"
          },
          "lastError": {
            "description": "Latest non-fatal error, if any.",
            "maxLength": 2000,
            "type": "string"
          },
          "progress": {
            "description": "Per-entity progress lines.",
            "items": {
              "$ref": "#/components/schemas/ScoutProgressEntryDto"
            },
            "maxItems": 64,
            "type": "array"
          }
        },
        "required": [
          "intent_id",
          "deviceId",
          "progress"
        ],
        "type": "object"
      },
      "ScoutProgressEntryDto": {
        "properties": {
          "count_committed": {
            "description": "Entities committed so far for this family.",
            "example": 12,
            "minimum": 0,
            "type": "number"
          },
          "entity_type": {
            "description": "Entity family this line reports on.",
            "example": "clients",
            "maxLength": 64,
            "type": "string"
          },
          "total_estimated": {
            "description": "Best-effort total the crawler expects.",
            "example": 40,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "entity_type",
          "count_committed",
          "total_estimated"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "Supabase-issued JWT. Send as `Authorization: Bearer <token>`. Tokens are verified against the Supabase JWKS in JwtAuthGuard.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Frozen public contract for the tgp-importer Chrome extension + mobile pairing surface. Generated from the backend @nestjs/swagger document — do not hand-edit. Run `npm run contract:importer` to regenerate.",
    "title": "Growth Project API — Importer Contract",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/extension/refresh": {
      "post": {
        "description": "Proxies Supabase refreshSession(refresh_token) and returns the rotated access/refresh pair. No backend-minted tokens — Supabase owns rotation and revocation. Rate-limited 30/min per IP.",
        "operationId": "AuthController_extensionRefresh",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtensionRefreshDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionRefreshResult"
                }
              }
            },
            "description": "Rotated token pair."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed body (global ValidationPipe: whitelist + forbidNonWhitelisted). Standard HttpExceptionFilter envelope; `message` is a string ARRAY of per-field constraint violations and there is no domain `code`."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorEnvelope"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "extension_refresh_invalid"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Refresh token invalid or expired. Structured HttpExceptionFilter envelope with `code: \"extension_refresh_invalid\"` — the extension keys off this to force a re-pair."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            },
            "description": "Rate limit exceeded (per-IP throttle)."
          }
        },
        "summary": "Extension token refresh (tgp-importer Chrome extension)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/extension/pair/init": {
      "post": {
        "description": "Mobile-authenticated coach mints a 6-digit code bound to their account + chosen source platform. Returns { pairing_code, expires_at }. Returns 404 when FEATURE_EXTENSION_PAIRING is off.",
        "operationId": "ExtensionPairController_init",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairInitDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairInitResult"
                }
              }
            },
            "description": "Pairing code minted."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorEnvelope"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "code_mint_failed"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Rejected init. Standard HttpExceptionFilter envelope. Two sources: the domain path sets `code: \"code_mint_failed\"` when the mint-retry budget is exhausted; a malformed body (chosen_platform failing the slug/length rules) is rejected by the global ValidationPipe with NO `code` and `message` as a string ARRAY of constraint violations. `code` is therefore optional here and pinned to `code_mint_failed` only when present."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid bearer token (global JwtAuthGuard runs before role checks)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Caller is not a coach."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Pairing feature disabled (uniform R-DARK-1 404)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            },
            "description": "Rate limit exceeded. This route carries no explicit @Throttle, so it is governed by the global authenticated default (UserThrottlerGuard, keyed by user id). Documented for parity with the other throttled importer routes."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Mint a pairing code (mobile app → extension bridge)",
        "tags": [
          "extension-pair"
        ]
      }
    },
    "/api/extension/pair/redeem": {
      "post": {
        "description": "UNAUTHENTICATED. The extension exchanges a 6-digit code for a coach-bound Supabase token pair + chosen_platform. Single-use: a second redeem of the same code returns 410 already_used. Expired → 410 expired; unknown/malformed → 400 invalid. After too many failed attempts a code is hard-locked → 410 locked. Rate-limited per IP. Returns 404 when FEATURE_EXTENSION_PAIRING is off.",
        "operationId": "ExtensionPairController_redeem",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairRedeemDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairRedeemResult"
                }
              }
            },
            "description": "Token pair issued."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorEnvelope"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "invalid"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Rejected pairing code. Standard HttpExceptionFilter envelope. Two sources: the domain path sets `code: \"invalid\"` with a string `message`; a malformed body (not 6 digits) is rejected by the global ValidationPipe with NO `code` and `message` as a string ARRAY of constraint violations. `code` is therefore optional here and pinned to `invalid` only when present."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Pairing feature disabled (uniform R-DARK-1 404)."
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorEnvelope"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "expired",
                            "already_used",
                            "locked"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "code"
                      ],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Code expired, already used, or locked. Standard envelope with a required `code` from the redeem 410 enum."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            },
            "description": "Rate limit exceeded (per-IP redeem throttle)."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Session mint failed after a successful code claim (upstream auth error). Standard HttpExceptionFilter envelope; no domain `code` is guaranteed."
          }
        },
        "summary": "Redeem a pairing code (extension bootstrap)",
        "tags": [
          "extension-pair"
        ]
      }
    },
    "/api/extension/pair/status": {
      "post": {
        "description": "Mobile-authenticated coach polls their OWN code. The code travels in the POST body (never a query string, which would leak into logs/history/APM). Returns { status: pending | paired | expired }. A code the caller did not mint reads as `expired` (never confirms another coach's code). Returns 404 when FEATURE_EXTENSION_PAIRING is off.",
        "operationId": "ExtensionPairController_status",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairStatusDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairStatusResult"
                }
              }
            },
            "description": "Pairing code status."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Malformed body (global ValidationPipe). The 6-digit code field uses the same `@Matches(/^[0-9]{6}$/)` rule as redeem; constraint failures yield a standard envelope with `message` as a string ARRAY and no domain `code`."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid bearer token (global JwtAuthGuard runs before role checks)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Caller is not a coach."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Pairing feature disabled (uniform R-DARK-1 404)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitError"
                }
              }
            },
